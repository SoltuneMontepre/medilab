  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests",
      "description": "HTTP requests Odoo answered in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({app=\"odoo\"} |~ \"\\\" \\\\d{3} \" | regexp \"\\\"(?P<method>[A-Z]+) (?P<path>[^\\\\s?]+)\\\\S* HTTP/[0-9.]+\\\" (?P<status>\\\\d{3}) (?P<body>\\\\S+) (?P<queries>\\\\d+) (?P<sql>[0-9.]+) (?P<python>[0-9.]+)\" | status != \"\" [$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
