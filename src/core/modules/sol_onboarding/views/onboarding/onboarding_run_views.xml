<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_onboarding_run_list" model="ir.ui.view">
        <field name="name">medilab.onboarding.run.list</field>
        <field name="model">medilab.onboarding.run</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="name" />
                <field name="organisation_id" />
                <field name="sector_ids" widget="many2many_tags" />
                <field name="requested_by_id" />
                <field name="started_at" />
                <field name="ended_at" />
                <field name="staged_count" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'running'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'failed'"
                    decoration-muted="state == 'cancelled'"
                />
            </list>
        </field>
    </record>

    <record id="view_medilab_onboarding_run_form" model="ir.ui.view">
        <field name="name">medilab.onboarding.run.form</field>
        <field name="model">medilab.onboarding.run</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <button
                        name="action_start"
                        type="object"
                        string="Start"
                        class="btn-primary"
                        invisible="state != 'draft'"
                        groups="sol_laboratory.group_permission_onboarding_run_edit_all"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state != 'running'"
                        groups="sol_laboratory.group_permission_onboarding_run_edit_all"
                    />
                    <button
                        name="action_refresh_organisations"
                        type="object"
                        string="Refresh Organisations"
                        groups="sol_laboratory.group_permission_onboarding_run_edit_all"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="organisation_id"
                                context="{'onboarding_suggest': True}"
                                options="{'no_create': True}"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="sector_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <group>
                            <field name="requested_by_id" readonly="state != 'draft'" />
                            <field name="started_at" />
                            <field name="ended_at" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Result" name="result">
                            <group>
                                <field name="page_count" />
                                <field name="skipped_count" />
                                <field name="staged_count" />
                            </group>
                        </page>
                        <page string="Log" name="log">
                            <field name="log" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_onboarding_run_search" model="ir.ui.view">
        <field name="name">medilab.onboarding.run.search</field>
        <field name="model">medilab.onboarding.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="organisation_id" />
                <field name="requested_by_id" />
                <filter name="running" string="Running" domain="[('state', '=', 'running')]" />
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]" />
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_onboarding_run" model="ir.actions.act_window">
        <field name="name">Collection Runs</field>
        <field name="res_model">medilab.onboarding.run</field>
        <field name="path">onboarding-runs</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
