<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_onboarding_staged_record_list" model="ir.ui.view">
        <field name="name">medilab.onboarding.staged.record.list</field>
        <field name="model">medilab.onboarding.staged.record</field>
        <field name="arch" type="xml">
            <list duplicate="0" create="0" delete="0">
                <header>
                    <button
                        name="action_accept"
                        type="object"
                        string="Accept"
                        groups="sol_laboratory.group_permission_onboarding_staged_record_edit_all"
                    />
                    <button
                        name="%(action_medilab_onboarding_reject)d"
                        type="action"
                        string="Reject"
                        groups="sol_laboratory.group_permission_onboarding_staged_record_edit_all"
                    />
                </header>
                <field name="kind" />
                <field name="external_key" />
                <field name="display_value" />
                <field name="action" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'to_review'"
                    decoration-success="state == 'accepted'"
                    decoration-danger="state == 'rejected'"
                    decoration-muted="state == 'superseded'"
                />
                <field name="match_suggested" string="Suggested" />
                <field name="page_url" widget="url" />
                <field name="error" />
            </list>
        </field>
    </record>

    <record id="view_medilab_onboarding_staged_record_origin_list" model="ir.ui.view">
        <field name="name">medilab.onboarding.staged.record.origin.list</field>
        <field name="model">medilab.onboarding.staged.record</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list duplicate="0" create="0" delete="0">
                <field name="kind" />
                <field name="page_url" widget="url" />
                <field name="page_fetched_at" />
                <field name="reviewed_at" string="Accepted At" />
            </list>
        </field>
    </record>

    <record id="view_medilab_onboarding_staged_record_form" model="ir.ui.view">
        <field name="name">medilab.onboarding.staged.record.form</field>
        <field name="model">medilab.onboarding.staged.record</field>
        <field name="arch" type="xml">
            <form duplicate="0" create="0" delete="0">
                <header>
                    <button
                        name="action_accept"
                        type="object"
                        string="Accept"
                        class="btn-primary"
                        invisible="state != 'to_review'"
                        groups="sol_laboratory.group_permission_onboarding_staged_record_edit_all"
                    />
                    <button
                        name="%(action_medilab_onboarding_reject)d"
                        type="action"
                        string="Reject"
                        invisible="state != 'to_review'"
                        groups="sol_laboratory.group_permission_onboarding_staged_record_edit_all"
                    />
                    <button
                        name="action_reopen"
                        type="object"
                        string="Reopen"
                        invisible="state != 'rejected'"
                        groups="sol_laboratory.group_permission_onboarding_staged_record_edit_all"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="to_review,accepted" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="kind" readonly="1" />
                            <field name="external_key" readonly="1" />
                            <field name="page_url" widget="url" />
                            <field name="page_fetched_at" />
                        </group>
                        <group>
                            <field name="reject_reason" invisible="state != 'rejected'" />
                            <field name="reviewed_by_id" invisible="not reviewed_by_id" />
                            <field name="reviewed_at" invisible="not reviewed_at" />
                            <field name="error" invisible="not error" />
                        </group>
                    </group>
                    <group string="Values">
                        <group>
                            <field
                                name="code"
                                invisible="kind not in ('certificate', 'testing_field', 'testing_method')"
                                readonly="state != 'to_review'"
                            />
                            <field
                                name="name"
                                invisible="kind not in ('testing_field', 'testing_method', 'sample_type', 'test_parameter')"
                                readonly="state != 'to_review'"
                            />
                            <field name="issuing_body" invisible="kind != 'certificate'" readonly="state != 'to_review'" />
                            <field name="valid_from" invisible="kind != 'certificate'" readonly="state != 'to_review'" />
                            <field name="valid_until" invisible="kind != 'certificate'" readonly="state != 'to_review'" />
                            <field
                                name="field_id"
                                invisible="kind not in ('certificate', 'testing_method')"
                                readonly="state != 'to_review'"
                                options="{'no_create': True}"
                            />
                            <field
                                name="main_group_id"
                                invisible="kind != 'test_parameter'"
                                readonly="state != 'to_review'"
                                options="{'no_create': True}"
                            />
                            <field
                                name="unit_id"
                                invisible="kind != 'parameter_method'"
                                readonly="state != 'to_review'"
                                options="{'no_create': True}"
                            />
                            <field
                                name="department_id"
                                invisible="kind != 'parameter_method'"
                                readonly="state != 'to_review'"
                                options="{'no_create': True}"
                            />
                        </group>
                        <group>
                            <field name="source_summary" readonly="1" />
                        </group>
                    </group>
                    <group string="Changes" invisible="action != 'update'">
                        <field name="changes" nolabel="1" colspan="2" readonly="1" />
                    </group>
                    <group string="Match">
                        <group>
                            <field name="action" readonly="1" />
                            <field name="match_ref" readonly="state != 'to_review'" />
                            <field name="match_suggested" invisible="1" />
                        </group>
                        <group invisible="not match_suggested or state != 'to_review'">
                            <button
                                name="action_confirm_match"
                                type="object"
                                string="Confirm match"
                                class="btn-primary"
                                groups="sol_laboratory.group_permission_onboarding_staged_record_edit_all"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_onboarding_staged_record_search" model="ir.ui.view">
        <field name="name">medilab.onboarding.staged.record.search</field>
        <field name="model">medilab.onboarding.staged.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_key" />
                <field name="run_id" />
                <filter name="to_review" string="To Review" domain="[('state', '=', 'to_review')]" />
                <filter name="accepted" string="Accepted" domain="[('state', '=', 'accepted')]" />
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]" />
                <filter name="superseded" string="Superseded" domain="[('state', '=', 'superseded')]" />
                <group>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}" />
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}" />
                    <filter name="group_run" string="Run" context="{'group_by': 'run_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_onboarding_staged_record" model="ir.actions.act_window">
        <field name="name">Staged Records</field>
        <field name="res_model">medilab.onboarding.staged.record</field>
        <field name="path">staged-records</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_review': 1, 'search_default_group_kind': 1}</field>
    </record>
</odoo>
