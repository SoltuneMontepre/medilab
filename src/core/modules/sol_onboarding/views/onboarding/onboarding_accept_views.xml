<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_onboarding_accept_form" model="ir.ui.view">
        <field name="name">medilab.onboarding.accept.form</field>
        <field name="model">medilab.onboarding.accept</field>
        <field name="arch" type="xml">
            <form string="Accept Staged Record">
                <group>
                    <field name="staged_record_id" readonly="1" />
                    <field name="code" invisible="not code_needed" required="code_needed" />
                    <field
                        name="field_id"
                        invisible="not field_needed"
                        required="field_needed"
                        options="{'no_create': True}"
                    />
                    <field
                        name="main_group_id"
                        invisible="not main_group_needed"
                        required="main_group_needed"
                        options="{'no_create': True}"
                    />
                    <field
                        name="unit_id"
                        invisible="not unit_needed"
                        required="unit_needed"
                        options="{'no_create': True}"
                    />
                    <field
                        name="department_id"
                        invisible="not department_needed"
                        required="department_needed"
                        options="{'no_create': True}"
                    />
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Accept" class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_onboarding_accept" model="ir.actions.act_window">
        <field name="name">Accept Staged Record</field>
        <field name="res_model">medilab.onboarding.accept</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
