<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_layout" inherit_id="web.login_layout" name="MediLab Authentication Layout"
        priority="40">
        <xpath expr="//t[@t-call='web.frontend_layout']" position="attributes">
            <attribute name="title.translate">Log in</attribute>
        </xpath>

        <xpath expr="//div[hasclass('container') and hasclass('py-5')]" position="attributes">
            <attribute name="class">container-fluid ml_auth_page</attribute>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
            <attribute name="t-attf-class">card border-0 mx-auto {{login_card_classes}}
                o_database_list ml_auth_shell</attribute>
            <attribute name="style">max-width: 960px;</attribute>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]/div[hasclass('card-body')]"
            position="before">
            <aside class="ml_auth_brand" aria-label="System introduction">
                <div class="ml_auth_brand_content">
                    <img class="ml_auth_brand_icon" src="/sol_theme/static/src/img/medilab.svg" alt="" />
                    <h1>Laboratory management system</h1>
                    <p>Manage samples, testing processes and results on a unified platform.</p>
                </div>
            </aside>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]/div[hasclass('card-body')]"
            position="attributes">
            <attribute name="class">card-body ml_auth_form_panel</attribute>
        </xpath>

        <xpath
            expr="//div[contains(@t-attf-class, 'o_database_list')]/div[hasclass('card-body')]/div[hasclass('text-center') and hasclass('border-bottom')]"
            position="attributes">
            <attribute name="class">ml_auth_logo text-center</attribute>
        </xpath>

        <xpath
            expr="//div[contains(@t-attf-class, 'o_database_list')]/div[hasclass('card-body')]/div[hasclass('ml_auth_logo')]/img"
            position="attributes">
            <attribute name="class">ml_auth_logo_image</attribute>
        </xpath>

        <xpath
            expr="//div[contains(@t-attf-class, 'o_database_list')]//div[hasclass('small') and hasclass('border-top')]"
            position="attributes">
            <attribute name="class">ml_auth_footer text-end</attribute>
        </xpath>

        <xpath expr="//a[@href='/web/database/manager']" position="replace">
            <a class="ml_auth_admin_link" href="/web/database/manager">System administration</a>
        </xpath>

        <xpath expr="//a[contains(@href, 'www.odoo.com')]" position="replace" />
    </template>
</odoo>