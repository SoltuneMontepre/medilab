<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sol_theme.BooleanButtonGroupField">
        <div class="o_boolean_button_group btn-group" role="group">
            <button type="button"
                class="btn"
                t-att-class="{ 'btn-primary': !this.value, 'btn-outline-secondary': this.value }"
                t-att-disabled="this.props.readonly"
                t-on-click="() => this.setValue(false)">
                <t t-out="this.falseLabel"/>
            </button>
            <button type="button"
                class="btn"
                t-att-class="{ 'btn-primary': this.value, 'btn-outline-secondary': !this.value }"
                t-att-disabled="this.props.readonly"
                t-on-click="() => this.setValue(true)">
                <t t-out="this.trueLabel"/>
            </button>
        </div>
    </t>

</templates>
