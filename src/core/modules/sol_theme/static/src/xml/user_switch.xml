<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.login_user_switch" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('list-group')]/t/button" position="attributes">
            <attribute name="t-att-aria-label">user.name</attribute>
        </xpath>
        <xpath expr="//i[@data-icon='close']" position="attributes">
            <attribute name="role">button</attribute>
            <attribute name="aria-label">Remove user from switcher</attribute>
        </xpath>
    </t>
</templates>
