<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.views.ViewButton" t-inherit-mode="extension">
        <xpath expr="//t[@t-tag='this.props.tag']" position="attributes">
            <attribute name="t-att-aria-label">!this.props.string and this.props.title ? this.props.title : false</attribute>
        </xpath>
    </t>
</templates>
