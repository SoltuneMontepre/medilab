<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The chatter beside a form collapses from the end of its top bar. -->
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Followers')]" position="after">
            <button
                t-if="this.webChatterProps.isChatterAside and this.env.collapseChatter"
                type="button"
                class="o-mail-ChatterCollapse btn btn-link text-muted px-1"
                aria-expanded="true"
                t-att-aria-label="this.env.collapseChatter.label"
                t-att-title="this.env.collapseChatter.label"
                t-on-click="() => this.env.collapseChatter.run()"
            >
                <i class="oi oi-fw" data-icon="keyboard_double_arrow_right" role="img"/>
            </button>
        </xpath>
    </t>

</templates>
