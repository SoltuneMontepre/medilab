<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_tax_vat10" model="medilab.tax">
        <field name="code">VAT10</field>
        <field name="name">VAT 10%</field>
        <field
            name="rate_ids"
            eval="[
                Command.create({'rate': 8, 'valid_from': '2025-01-01', 'valid_until': '2025-06-30'}),
                Command.create({'rate': 10, 'valid_from': '2025-07-01'}),
            ]"
        />
    </record>
    <record id="demo_tax_kct" model="medilab.tax">
        <field name="code">KCT</field>
        <field name="name">Not subject to VAT</field>
        <field name="rate_ids" eval="[Command.create({'rate': 0, 'valid_from': '2020-01-01'})]" />
    </record>
</odoo>
