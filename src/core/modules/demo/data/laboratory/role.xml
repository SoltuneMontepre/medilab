<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_role_sales" model="medilab.role">
        <field name="code">sales</field>
        <field name="name">Sales</field>
    </record>
    <record id="demo_role_head_of_sales" model="medilab.role">
        <field name="code">head_of_sales</field>
        <field name="name">Head of sales</field>
    </record>
    <record id="demo_role_accountant" model="medilab.role">
        <field name="code">accountant</field>
        <field name="name">Accountant</field>
    </record>
    <record id="demo_role_sample_delivery_staff" model="medilab.role">
        <field name="code">sample_delivery_staff</field>
        <field name="name">Sample delivery staff</field>
    </record>
    <record id="demo_role_tester" model="medilab.role">
        <field name="code">tester</field>
        <field name="name">Tester</field>
    </record>
    <record id="demo_role_head_of_department" model="medilab.role">
        <field name="code">head_of_department</field>
        <field name="name">Head of department</field>
        <field name="permission_ids" eval="[Command.set([ref('laboratory.permission_person_read_own_department'), ref('laboratory.permission_department_read_all')])]" />
    </record>
    <record id="demo_role_lab_head" model="medilab.role">
        <field name="code">lab_head</field>
        <field name="name">Lab head</field>
        <field name="permission_ids" eval="[Command.set([ref('laboratory.permission_person_read_all'), ref('laboratory.permission_department_read_all')])]" />
    </record>
    <record id="demo_role_storekeeper" model="medilab.role">
        <field name="code">storekeeper</field>
        <field name="name">Storekeeper</field>
    </record>
</odoo>
