<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo already shows an Inventory block, so the Inventory module's settings join it. -->
    <record id="res_config_settings_view_form_costing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sol_inventory.costing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='valuation_setting_container']" position="before">
                <block title="Costing" name="medilab_costing_setting_container">
                    <setting id="costing_method_setting">
                        <field name="costing_method" widget="radio" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
