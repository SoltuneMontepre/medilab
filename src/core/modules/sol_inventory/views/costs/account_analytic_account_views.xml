<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_cost_centre_list" model="ir.ui.view">
        <field name="name">account.analytic.account.cost.centre.list</field>
        <field name="model">account.analytic.account</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="code" string="Code" />
                <field name="name" string="Cost Centre" />
                <field name="department_id" />
            </list>
        </field>
    </record>

    <record id="view_medilab_cost_centre_form" model="ir.ui.view">
        <field name="name">account.analytic.account.cost.centre.form</field>
        <field name="model">account.analytic.account</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" string="Cost Centre" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" string="Code" required="1" />
                            <field name="department_id" required="1" options="{'no_create': True}" />
                            <field name="plan_id" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_cost_centre_search" model="ir.ui.view">
        <field name="name">account.analytic.account.cost.centre.search</field>
        <field name="model">account.analytic.account</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Cost Centre" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]" />
                <field name="department_id" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_cost_centre" model="ir.actions.act_window">
        <field name="name">Cost Centres</field>
        <field name="res_model">account.analytic.account</field>
        <field name="path">cost-centres</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('plan_id', '=', ref('analytic_plan_cost_centres'))]" />
        <field name="context" eval="{'default_plan_id': ref('analytic_plan_cost_centres')}" />
        <field name="search_view_id" ref="view_medilab_cost_centre_search" />
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_medilab_cost_centre_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_medilab_cost_centre_form')})]" />
    </record>
</odoo>
