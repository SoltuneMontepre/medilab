<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_receipt_list" model="ir.ui.view">
        <field name="name">stock.picking.list.receipt</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list
                decoration-muted="state == 'cancel'"
                decoration-success="state == 'done'"
                decoration-info="state in ('confirmed', 'assigned')"
            >
                <field name="name" />
                <field name="partner_id" string="Supplier" />
                <field name="origin" optional="show" />
                <field name="location_dest_id" string="To" optional="show" />
                <field name="scheduled_date" optional="show" />
                <field name="date_done" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'done'"
                    decoration-info="state in ('confirmed', 'assigned')"
                    decoration-danger="state == 'cancel'"
                />
            </list>
        </field>
    </record>

    <record id="view_picking_form_medilab" model="ir.ui.view">
        <field name="name">stock.picking.form.medilab</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <!-- Validating a receipt takes the receipt edit permission rather than Odoo's stock groups. -->
            <xpath expr="//header/button[@name='button_validate'][contains(@invisible, 'primary')]" position="attributes">
                <attribute name="groups">stock.group_stock_user,sol_laboratory.group_permission_receipt_edit_all</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_validate'][contains(@invisible, 'secondary')]" position="attributes">
                <attribute name="groups">stock.group_stock_user,sol_laboratory.group_permission_receipt_edit_all</attribute>
            </xpath>
            <!-- Done moves are never changed, so a done transfer is not unlocked. -->
            <xpath expr="//header/button[@name='action_toggle_is_locked'][contains(@invisible, 'not is_locked')]" position="attributes">
                <attribute name="invisible">not is_locked or state != 'cancel'</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_validate'][contains(@invisible, 'secondary')]" position="after">
                <button
                    name="action_print_container_labels"
                    type="object"
                    string="Labels 2 × 1 in"
                    class="btn-secondary"
                    invisible="state != 'done' or not container_count"
                />
                <button
                    name="action_print_small_container_labels"
                    type="object"
                    string="Labels 1.5 × 1 in"
                    class="btn-secondary"
                    invisible="state != 'done' or not container_count"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_containers"
                    type="object"
                    class="oe_stat_button"
                    icon="science"
                    invisible="not container_count"
                >
                    <field name="container_count" widget="statinfo" string="Containers" />
                </button>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']" position="after">
                <field name="purchase_line_id" column_invisible="True" />
                <field
                    name="price_unit"
                    string="Unit Price excl. VAT"
                    column_invisible="parent.picking_type_code != 'incoming'"
                    readonly="purchase_line_id or state in ('done', 'cancel')"
                />
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree_medilab" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.medilab</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="track_containers" column_invisible="True" />
                <field
                    name="container_count"
                    column_invisible="parent.picking_code != 'incoming'"
                    invisible="not track_containers"
                    readonly="state in ('done', 'cancel')"
                />
                <field
                    name="certificate_id"
                    widget="many2one_binary"
                    column_invisible="parent.picking_code != 'incoming'"
                    readonly="state in ('done', 'cancel')"
                />
            </xpath>
        </field>
    </record>

    <record id="action_medilab_receipt" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">stock.picking</field>
        <field name="path">lab-receipts</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("picking_type_code", "=", "incoming")]</field>
        <field name="context">{"restricted_picking_type_code": "incoming", "contact_display": "partner_address"}</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search" />
    </record>
    <record id="action_medilab_receipt_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_medilab_receipt_list" />
        <field name="act_window_id" ref="action_medilab_receipt" />
    </record>
</odoo>
