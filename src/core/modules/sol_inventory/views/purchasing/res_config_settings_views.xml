<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_medilab" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.purchase.medilab</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase" />
        <field name="arch" type="xml">
            <!-- The approval chain signs every purchase order, so Odoo's own approval of large orders is not offered. -->
            <xpath expr="//setting[@id='po_order_approval']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
