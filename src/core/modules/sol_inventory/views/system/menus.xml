<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_master_data_inventory" name="Inventory" parent="sol_laboratory.menu_master_data_root" sequence="25">
        <menuitem id="menu_stock_item" action="action_medilab_stock_item" sequence="10" />
        <menuitem
            id="menu_store"
            action="action_medilab_store"
            sequence="20"
            groups="sol_laboratory.group_permission_location_read_all"
        />
        <menuitem
            id="menu_location"
            action="action_medilab_location"
            sequence="30"
            groups="sol_laboratory.group_permission_location_read_all"
        />
        <menuitem id="menu_supplier" action="action_medilab_supplier" sequence="40" />
        <menuitem id="menu_recipe" action="action_medilab_recipe" sequence="45" />
        <menuitem
            id="menu_cost_centre"
            action="action_medilab_cost_centre"
            sequence="50"
            groups="sol_laboratory.group_permission_cost_centre_read_all,sol_laboratory.group_permission_cost_centre_read_own_department"
        />
    </menuitem>

    <!-- Odoo shows its Purchase and Inventory apps to its own groups; MediLab users reach them through permissions. -->
    <record id="purchase.menu_purchase_root" model="ir.ui.menu">
        <field
            name="group_ids"
            eval="[
                Command.link(ref('sol_laboratory.group_permission_purchase_order_read_all')),
                Command.link(ref('sol_laboratory.group_permission_purchase_order_read_own_department')),
            ]"
        />
    </record>
    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field
            name="group_ids"
            eval="[
                Command.link(ref('sol_laboratory.group_permission_receipt_read_all')),
                Command.link(ref('sol_laboratory.group_permission_container_edit_all')),
                Command.link(ref('sol_laboratory.group_permission_preparation_create_all')),
                Command.link(ref('sol_laboratory.group_permission_move_create_all')),
                Command.link(ref('sol_laboratory.group_permission_move_read_all')),
                Command.link(ref('sol_laboratory.group_permission_stock_read_all')),
            ]"
        />
    </record>
    <!-- MediLab signs every order before it is sent, so Odoo's lists of quotation requests and of confirmed orders are
         left to Odoo's purchase users. -->
    <record id="purchase.menu_purchase_rfq" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('purchase.group_purchase_user')])]" />
    </record>
    <record id="purchase.menu_purchase_form_action" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('purchase.group_purchase_user')])]" />
    </record>

    <menuitem id="menu_purchase_order" parent="purchase.menu_procurement_management" action="action_medilab_purchase_order" sequence="1" />
    <menuitem id="menu_receipt" parent="stock.menu_stock_warehouse_mgmt" action="action_medilab_receipt" sequence="0" />
    <menuitem
        id="menu_container_scan"
        name="Scan Container"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_medilab_container_scan"
        sequence="20"
        groups="sol_laboratory.group_permission_container_edit_all"
    />
    <menuitem
        id="menu_prepare_solution"
        name="Prepare Solution"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_medilab_preparation_make"
        sequence="30"
        groups="sol_laboratory.group_permission_preparation_create_all"
    />
    <menuitem
        id="menu_record_use"
        name="Record Use or Waste"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_medilab_stock_use"
        sequence="40"
        groups="sol_laboratory.group_permission_move_create_all"
    />
    <menuitem
        id="menu_move_stock"
        name="Move Stock"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_medilab_stock_relocation"
        sequence="42"
        groups="sol_laboratory.group_permission_move_create_all"
    />
    <menuitem
        id="menu_correct_stock"
        name="Correct Quantity"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_medilab_stock_correction"
        sequence="44"
        groups="sol_laboratory.group_permission_move_create_all"
    />
    <menuitem
        id="menu_disposal"
        name="Disposal"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_medilab_disposal"
        sequence="46"
        groups="sol_laboratory.group_permission_move_create_all"
    />
    <menuitem
        id="menu_preparation"
        name="Preparations"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_medilab_preparation"
        sequence="50"
    />
    <!-- Odoo's Replenishment suggests what to buy for the minimum quantities of the central store. -->
    <menuitem
        id="menu_replenishment"
        name="Replenishment"
        parent="stock.menu_stock_warehouse_mgmt"
        action="stock.action_replenishment"
        sequence="60"
        groups="sol_laboratory.group_permission_purchase_order_create_all"
    />
    <menuitem id="menu_container" parent="stock.menu_stock_inventory_control" action="action_medilab_container" sequence="101" />
    <menuitem
        id="menu_stock_move"
        name="Moves"
        parent="stock.menu_stock_inventory_control"
        action="action_medilab_stock_move"
        sequence="110"
        groups="sol_laboratory.group_permission_move_read_all"
    />
    <!-- Odoo's own overview, transfers, adjustments and procurement are for its stock users; MediLab users record
         use, waste and preparations through the menus above. -->
    <record id="stock.stock_picking_type_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('stock.group_stock_user')])]" />
    </record>
    <record id="stock.menu_stock_transfers" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('stock.group_stock_user')])]" />
    </record>
    <record id="stock.menu_stock_adjustments" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('stock.group_stock_user')])]" />
    </record>
    <record id="stock.menu_stock_procurement" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('stock.group_stock_user')])]" />
    </record>

    <!-- Odoo shows its Reporting menu to its stock managers only; the holders of the stock read permission reach the
         stock on hand and the stock expiring soon through it. Odoo's own reports under it see every store, so they stay
         with its stock managers. -->
    <record id="stock.menu_warehouse_report" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.link(ref('sol_laboratory.group_permission_stock_read_all'))]" />
    </record>
    <menuitem
        id="menu_stock_on_hand"
        name="Stock on Hand"
        parent="stock.menu_warehouse_report"
        action="action_medilab_stock_on_hand"
        sequence="1"
        groups="sol_laboratory.group_permission_stock_read_all"
    />
    <menuitem
        id="menu_expiring"
        name="Expiring Soon"
        parent="stock.menu_warehouse_report"
        action="action_medilab_expiring"
        sequence="2"
        groups="sol_laboratory.group_permission_stock_read_all"
    />
    <record id="stock.menu_product_stock" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('stock.group_stock_manager')])]" />
    </record>
    <record id="stock.menu_valuation" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('stock.group_stock_manager')])]" />
    </record>
    <record id="stock.stock_move_line_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('stock.group_stock_manager')])]" />
    </record>
    <record id="stock.stock_move_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('stock.group_stock_manager')])]" />
    </record>
</odoo>
