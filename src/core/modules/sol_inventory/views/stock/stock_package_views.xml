<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_container_list" model="ir.ui.view">
        <field name="name">stock.package.list.container</field>
        <field name="model">stock.package</field>
        <field name="arch" type="xml">
            <list
                create="false"
                decoration-muted="status in ('depleted', 'disposed', 'missing')"
                decoration-info="status == 'opened'"
            >
                <field name="name" string="Code" />
                <field name="item_id" />
                <field name="lot_id" />
                <field name="location_id" />
                <field name="quantity" />
                <field name="usable_until" />
                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'sealed'"
                    decoration-info="status == 'opened'"
                    decoration-danger="status in ('disposed', 'missing')"
                    decoration-muted="status == 'depleted'"
                />
            </list>
        </field>
    </record>

    <record id="view_medilab_container_form" model="ir.ui.view">
        <field name="name">stock.package.form.container</field>
        <field name="model">stock.package</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="sealed,opened,depleted" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Code" />
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="item_id" />
                            <field name="lot_id" />
                            <field name="quantity" />
                        </group>
                        <group>
                            <field name="location_id" readonly="1" />
                            <field name="usable_until" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_container_search" model="ir.ui.view">
        <field name="name">stock.package.search.container</field>
        <field name="model">stock.package</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Code" />
                <field name="location_id" />
                <filter name="filter_sealed" string="Sealed" domain="[('status', '=', 'sealed')]" />
                <filter name="filter_opened" string="Opened" domain="[('status', '=', 'opened')]" />
                <separator />
                <filter
                    name="filter_in_stock"
                    string="In stock"
                    domain="[('status', 'in', ('sealed', 'opened'))]"
                />
                <group>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}" />
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_container" model="ir.actions.act_window">
        <field name="name">Containers</field>
        <field name="res_model">stock.package</field>
        <field name="path">containers</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_filter_in_stock": 1}</field>
        <field name="search_view_id" ref="view_medilab_container_search" />
    </record>
    <record id="action_medilab_container_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_medilab_container_list" />
        <field name="act_window_id" ref="action_medilab_container" />
    </record>
    <record id="action_medilab_container_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_medilab_container_form" />
        <field name="act_window_id" ref="action_medilab_container" />
    </record>
</odoo>
