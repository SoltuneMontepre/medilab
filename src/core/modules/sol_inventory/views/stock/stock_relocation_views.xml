<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_stock_relocation_form" model="ir.ui.view">
        <field name="name">medilab.stock.relocation.form</field>
        <field name="model">medilab.stock.relocation</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="store_ids" invisible="1" />
                    <field name="container_scan" placeholder="Scan or type the container code" />
                    <field name="container_id" options="{'no_create': True}" />
                    <field name="item_id" readonly="container_id" options="{'no_create': True}" />
                    <field name="lot_id" readonly="container_id" options="{'no_create': True}" />
                    <field name="location_id" readonly="container_id" required="not container_id" options="{'no_create': True}" />
                    <field name="location_dest_id" required="1" options="{'no_create': True}" />
                    <field name="quantity" readonly="container_id" />
                    <field name="reason" required="1" />
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Move" class="btn-success" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_stock_relocation" model="ir.actions.act_window">
        <field name="name">Move Stock</field>
        <field name="res_model">medilab.stock.relocation</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="path">move-stock</field>
    </record>
</odoo>
