<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_stock_use_form" model="ir.ui.view">
        <field name="name">medilab.stock.use.form</field>
        <field name="model">medilab.stock.use</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="kind" widget="radio" />
                    <field name="store_ids" invisible="1" />
                    <field name="container_scan" placeholder="Scan or type the container code" />
                    <field name="container_id" options="{'no_create': True}" />
                    <field name="item_id" readonly="container_id" options="{'no_create': True}" />
                    <field name="lot_id" readonly="container_id" invisible="container_id" options="{'no_create': True}" />
                    <field name="location_id" invisible="container_id" required="not container_id" options="{'no_create': True}" />
                    <field name="quantity" />
                    <field name="reason_needed" invisible="1" />
                    <field
                        name="scrap_reason_tag_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                        invisible="kind != 'waste'"
                        required="kind == 'waste'"
                    />
                    <field name="reason" invisible="not reason_needed" required="reason_needed" />
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Record" class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_stock_use" model="ir.actions.act_window">
        <field name="name">Record Use or Waste</field>
        <field name="res_model">medilab.stock.use</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="path">record-use</field>
    </record>
</odoo>
