<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_container_scan_form" model="ir.ui.view">
        <field name="name">medilab.container.scan.form</field>
        <field name="model">medilab.container.scan</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="code" placeholder="Scan or type the container code" />
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Open" class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_container_scan" model="ir.actions.act_window">
        <field name="name">Scan Container</field>
        <field name="res_model">medilab.container.scan</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="path">containers-scan</field>
    </record>
</odoo>
