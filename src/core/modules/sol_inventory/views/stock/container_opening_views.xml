<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_container_opening_form" model="ir.ui.view">
        <field name="name">medilab.container.opening.form</field>
        <field name="model">medilab.container.opening</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="container_id" />
                    <field name="opened_by_id" options="{'no_create': True}" />
                    <field name="opened_at" />
                    <field name="note" placeholder="How the container came to be opened" />
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Record" class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_container_opening" model="ir.actions.act_window">
        <field name="name">Record Opening</field>
        <field name="res_model">medilab.container.opening</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
