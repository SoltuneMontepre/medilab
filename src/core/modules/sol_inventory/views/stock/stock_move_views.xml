<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_stock_move_list" model="ir.ui.view">
        <field name="name">stock.move.list.medilab</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="reference" />
                <field name="date" />
                <field name="move_kind" />
                <field name="product_id" />
                <field name="quantity" />
                <field name="uom_id" />
                <field name="location_id" />
                <field name="location_dest_id" />
                <field name="reason" />
                <field name="automatic" />
                <field name="company_currency_id" column_invisible="True" />
                <field name="unit_cost" />
                <field name="value" groups="stock.group_stock_manager,sol_laboratory.group_permission_stock_read_all" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="view_medilab_stock_move_form" model="ir.ui.view">
        <field name="name">stock.move.form.medilab</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="reference" />
                            <field name="move_kind" />
                            <field name="product_id" />
                            <field name="quantity" />
                            <field name="uom_id" />
                            <field name="state" />
                        </group>
                        <group>
                            <field name="date" />
                            <field name="location_id" />
                            <field name="location_dest_id" />
                            <field name="reason" />
                            <field name="automatic" />
                            <field name="preparation_id" />
                            <field name="test_result_id" />
                            <field name="scrap_reason_tag_ids" widget="many2many_tags" />
                            <field name="company_currency_id" invisible="1" />
                            <field name="unit_cost" />
                            <field name="value" groups="stock.group_stock_manager,sol_laboratory.group_permission_stock_read_all" />
                        </group>
                    </group>
                    <field name="move_line_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="quantity" />
                            <field name="uom_id" />
                            <field name="lot_id" />
                            <field name="package_id" />
                            <field name="result_package_id" />
                            <field name="location_id" />
                            <field name="location_dest_id" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_stock_move_search" model="ir.ui.view">
        <field name="name">stock.move.search.medilab</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference" />
                <field name="product_id" />
                <field name="reason" />
                <filter name="filter_receipt" string="Receipts" domain="[('move_kind', '=', 'receipt')]" />
                <filter name="filter_preparation" string="Preparations" domain="[('move_kind', '=', 'preparation')]" />
                <filter name="filter_consumption" string="Use" domain="[('move_kind', '=', 'consumption')]" />
                <filter name="filter_waste" string="Waste" domain="[('move_kind', '=', 'waste')]" />
                <filter name="filter_relocation" string="Relocations" domain="[('move_kind', '=', 'relocation')]" />
                <filter name="filter_adjustment" string="Adjustments" domain="[('move_kind', '=', 'adjustment')]" />
                <filter name="filter_disposal" string="Disposals" domain="[('move_kind', '=', 'disposal')]" />
                <group>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'move_kind'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_stock_move" model="ir.actions.act_window">
        <field name="name">Moves</field>
        <field name="res_model">stock.move</field>
        <field name="path">stock-moves</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_medilab_stock_move_search" />
        <field name="context">{"search_default_group_kind": 1}</field>
    </record>
    <record id="action_medilab_stock_move_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_medilab_stock_move_list" />
        <field name="act_window_id" ref="action_medilab_stock_move" />
    </record>
    <record id="action_medilab_stock_move_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_medilab_stock_move_form" />
        <field name="act_window_id" ref="action_medilab_stock_move" />
    </record>
</odoo>
