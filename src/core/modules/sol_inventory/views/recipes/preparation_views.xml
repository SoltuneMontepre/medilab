<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_preparation_list" model="ir.ui.view">
        <field name="name">medilab.preparation.list</field>
        <field name="model">medilab.preparation</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="display_name" string="Container" />
                <field name="recipe_id" />
                <field name="location_id" />
            </list>
        </field>
    </record>

    <record id="view_medilab_preparation_form" model="ir.ui.view">
        <field name="name">medilab.preparation.form</field>
        <field name="model">medilab.preparation</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" /></h1>
                    </div>
                    <group>
                        <field name="recipe_id" />
                        <field name="location_id" />
                        <field name="container_ids" />
                    </group>
                    <field name="move_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="move_kind" />
                            <field name="product_id" />
                            <field name="quantity" />
                            <field name="uom_id" />
                            <field name="location_id" />
                            <field name="location_dest_id" />
                            <field name="reason" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_medilab_preparation" model="ir.actions.act_window">
        <field name="name">Preparations</field>
        <field name="res_model">medilab.preparation</field>
        <field name="path">preparations</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
