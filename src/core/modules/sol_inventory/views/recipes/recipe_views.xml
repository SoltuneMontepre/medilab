<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_recipe_list" model="ir.ui.view">
        <field name="name">medilab.recipe.list</field>
        <field name="model">medilab.recipe</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="code" />
                <field name="solution_item_id" />
                <field name="yield_quantity" width="[150]" />
                <field name="uom_id" string="Unit" />
                <field name="shelf_life_days" width="[130]" />
            </list>
        </field>
    </record>

    <record id="view_medilab_recipe_form" model="ir.ui.view">
        <field name="name">medilab.recipe.form</field>
        <field name="model">medilab.recipe</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="solution_item_id" />
                        <h1><field name="solution_item_id" options="{'no_create': True}" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" required="0" placeholder="Filled from the sequence when left empty" />
                            <label for="yield_quantity" />
                            <div class="o_row">
                                <field name="yield_quantity" />
                                <field name="uom_id" options="{'no_open': True}" />
                            </div>
                        </group>
                        <group>
                            <field name="shelf_life_days" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Ingredients" name="ingredients">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="item_id" options="{'no_create': True}" />
                                    <field name="quantity" />
                                    <field name="uom_id" string="Unit" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_recipe_search" model="ir.ui.view">
        <field name="name">medilab.recipe.search</field>
        <field name="model">medilab.recipe</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="solution_item_id"
                    string="Recipe"
                    filter_domain="['|', ('code', 'ilike', self), ('solution_item_id', 'ilike', self)]"
                />
                <field name="line_ids" string="Ingredient" filter_domain="[('line_ids.item_id', 'ilike', self)]" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_recipe" model="ir.actions.act_window">
        <field name="name">Recipes</field>
        <field name="res_model">medilab.recipe</field>
        <field name="path">recipes</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
