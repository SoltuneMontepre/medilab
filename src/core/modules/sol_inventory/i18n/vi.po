#. odoo-python
#: code:addons/sol_inventory/models/recipes/product_product.py:0
msgid ""
"%(items)s cannot be archived while active recipes make or use them: "
"%(recipes)s."
msgstr ""
"Không thể lưu trữ %(items)s khi các công thức pha chế đang hoạt động vẫn pha"
" ra hoặc dùng chúng: %(recipes)s."

#. module: sol_inventory
#. odoo-python
#: code:addons/sol_inventory/models/catalog/product_product.py:0
