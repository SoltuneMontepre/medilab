#: code:addons/sol_inventory/models/stock/stock_move.py:0
msgid ""
"%(item)s still needs %(quantity)s %(unit)s. Scan another opened container."
msgstr ""
"%(item)s còn thiếu %(quantity)s %(unit)s. Quét thêm một chai đã mở nắp."

