<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_laboratory_contents_reconcile" model="ir.cron">
        <field name="name">Reconcile the laboratory files bucket</field>
        <field name="model_id" ref="model_medilab_scheduled_job" />
        <field name="state">code</field>
        <field name="code">model._run_key("laboratory_contents.reconcile")</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="scheduled_job_laboratory_contents_reconcile" model="medilab.scheduled.job">
        <field name="key">laboratory_contents.reconcile</field>
        <field name="name">Reconcile the laboratory files bucket</field>
        <field name="cron_id" ref="ir_cron_laboratory_contents_reconcile" />
        <field name="batch_size">100</field>
        <field name="max_attempts">3</field>
    </record>
</odoo>
