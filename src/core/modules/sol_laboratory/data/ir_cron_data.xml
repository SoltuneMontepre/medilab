<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_notifications_remind" model="ir.cron">
        <field name="name">Notification reminders</field>
        <field name="model_id" ref="model_medilab_scheduled_job" />
        <field name="state">code</field>
        <field name="code">model._run_key("notifications.remind")</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_notifications_email" model="ir.cron">
        <field name="name">Notification email</field>
        <field name="model_id" ref="model_medilab_scheduled_job" />
        <field name="state">code</field>
        <field name="code">model._run_key("notifications.email")</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_notifications_push" model="ir.cron">
        <field name="name">Notification push</field>
        <field name="model_id" ref="model_medilab_scheduled_job" />
        <field name="state">code</field>
        <field name="code">model._run_key("notifications.push")</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_sample_retention_reminders" model="ir.cron">
        <field name="name">Sample retention reminders</field>
        <field name="model_id" ref="model_medilab_scheduled_job" />
        <field name="state">code</field>
        <field name="code">model._run_key("sample.retention.reminders")</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
