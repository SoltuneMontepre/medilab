<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="task_type_general" model="medilab.task.type">
        <field name="code">general</field>
        <field name="name">General task</field>
        <field name="trigger">manual</field>
        <field name="route">person</field>
    </record>
    <record id="task_type_sample_collection" model="medilab.task.type">
        <field name="code">sample_collection</field>
        <field name="name">Sample collection</field>
        <field name="trigger">manual</field>
        <field name="route">person</field>
        <field name="document_model">medilab.sample</field>
        <field name="action">collect</field>
    </record>
    <record id="task_type_sample_test" model="medilab.task.type">
        <field name="code">sample_test</field>
        <field name="name">Sample test</field>
        <field name="trigger">sample_received</field>
        <field name="route">department</field>
        <field name="document_model">medilab.sample.test</field>
        <field name="action">test</field>
    </record>
    <record id="task_type_sample_retention" model="medilab.task.type">
        <field name="code">sample_retention</field>
        <field name="name">Sample retention</field>
        <field name="trigger">retention_due</field>
        <field name="route">department</field>
        <field name="document_model">medilab.sample</field>
        <field name="action">dispose</field>
    </record>
    <record id="task_type_report_signing" model="medilab.task.type">
        <field name="code">report_signing</field>
        <field name="name">Report signing</field>
        <field name="trigger">report_drafted</field>
        <field name="route">role</field>
        <field name="role_id" ref="role_administrator" />
        <field name="document_model">medilab.test.report</field>
        <field name="action">sign</field>
        <field name="deadline_hours">24</field>
    </record>
</odoo>
