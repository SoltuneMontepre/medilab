<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_laboratory_folder_retention_review" model="ir.cron">
        <field name="name">Flag expired laboratory folders for review</field>
        <field name="model_id" ref="model_medilab_scheduled_job" />
        <field name="state">code</field>
        <field name="code">model._run_key("laboratory_folder.retention_review")</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="scheduled_job_laboratory_folder_retention_review" model="medilab.scheduled.job">
        <field name="key">laboratory_folder.retention_review</field>
        <field name="name">Flag expired laboratory folders for review</field>
        <field name="cron_id" ref="ir_cron_laboratory_folder_retention_review" />
        <field name="batch_size">100</field>
        <field name="max_attempts">3</field>
    </record>
</odoo>
