#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/hr_department.py:0
msgid "%(team)s cannot belong to %(parent)s, which is a team itself."
msgstr "%(team)s không thể thuộc %(parent)s, vì %(parent)s cũng là một tổ."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/person.py:0
msgid "%(team)s is not a team of the department of %(person)s."
msgstr "%(team)s không phải là tổ thuộc phòng ban của %(person)s."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/permission.py:0
msgid ""
"%s has no team, so a permission on it cannot be limited to the person's "
"team."
msgstr "%s không có tổ, nên quyền trên nó không thể giới hạn trong tổ của nhân sự."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/hr_department.py:0
msgid ""
"%s has teams of its own or records that name it as their department, so it "
"cannot become a team."
msgstr "%s đã có các tổ riêng hoặc có bản ghi lấy nó làm phòng ban, nên không thể trở thành một tổ."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/hr_department.py:0
msgid ""
"The people of %s belong to its department; take them out of the team before "
"moving it."
msgstr "Nhân sự của %s thuộc phòng ban của tổ; hãy đưa họ ra khỏi tổ trước khi chuyển tổ."
