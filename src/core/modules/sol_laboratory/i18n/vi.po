#. module: sol_laboratory
#: model:ir.model.fields,field_description:sol_laboratory.field_medilab_customer__meeting_count
#: model:ir.model.fields,field_description:sol_laboratory.field_medilab_subcontractor__meeting_count
msgid "# Meetings"
msgstr "Số cuộc họp"

#. module: sol_laboratory
#: model:ir.model.fields,field_description:sol_laboratory.field_medilab_subcontractor__supplier_invoice_count
msgid "# Vendor Bills"
msgstr "# Hóa đơn mua hàng"

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/permission.py:0
msgid "%(document_type)s has no %(action)s permission."
msgstr "%(document_type)s không có quyền %(action)s."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/calendar_event.py:0
msgid ""
"%(location)s is already booked from %(start)s to %(stop)s: %(booking)s."
msgstr "%(location)s đã được đặt từ %(start)s đến %(stop)s: %(booking)s."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_editing_session.py:0
msgid "%(path)s, %(status)s"
msgstr "%(path)s, %(status)s"

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_file_version.py:0
msgid "%(path)s, version %(number)s"
msgstr "%(path)s, phiên bản %(number)s"

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_editing_session.py:0
msgid ""
"%(person)s cannot save the file (%(reason)s); the saved content is kept "
"under %(key)s."
msgstr ""
"%(person)s không lưu được tệp (%(reason)s); nội dung đã lưu được giữ tại "
"%(key)s."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/task_reassign.py:0
msgid "%(person)s is not in %(department)s."
msgstr "%(person)s không thuộc %(department)s."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_file_lock.py:0
msgid "%(user)s has locked %(file)s until %(until)s."
msgstr "%(user)s đã khóa %(file)s đến %(until)s."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/calendar_event.py:0
msgid "%s cannot be booked."
msgstr "Không thể đặt %s."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/permission.py:0
msgid ""
"%s does not tell editing from archiving yet, so it has no edit or "
"archive permission."
msgstr "%s chưa phân biệt sửa và lưu trữ, nên chưa có quyền sửa hoặc lưu trữ."

#. module: sol_laboratory
#. odoo-javascript
#: code:addons/sol_laboratory/static/src/tasks/dashboard/task_dashboard.js:0
msgid "%s due today"
msgstr "%s đến hạn hôm nay"

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/permission.py:0
msgid ""
"%s has no department, so a permission on it cannot be limited to the "
"person's department."
msgstr ""
"%s không có phòng ban, nên quyền trên loại chứng từ này không thể "
"giới hạn trong phòng ban của nhân sự."

#. module: sol_laboratory
#. odoo-javascript
#: code:addons/sol_laboratory/static/src/master_data/location_map/location_map.js:0
msgid "%s has no map. Add its picture to place the locations inside it."
msgstr "%s chưa có bản đồ. Thêm hình ảnh để đặt các vị trí bên trong lên đó."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/permission.py:0
msgid "%s has no user, so a permission on it cannot be limited to the person's own records."
msgstr "%s không có người dùng nên quyền trên đó không thể giới hạn trong các bản ghi của chính người đó."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/task.py:0
msgid "%s is already claimed."
msgstr "%s đã có người nhận."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/task.py:0
msgid "%s is already finished."
msgstr "%s đã kết thúc."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/master_data/parameter_method.py:0
msgid "%s is archived and cannot be chosen."
msgstr "%s đã được lưu trữ nên không thể được chọn."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/task.py:0
msgid "%s is cancelled by the system when its work is cancelled."
msgstr "%s được hệ thống hủy khi công việc của nhiệm vụ bị hủy."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/task.py:0
msgid "%s is done by the system once its work is done."
msgstr ""
"%s được hệ thống đánh dấu hoàn thành khi công việc của nhiệm vụ hoàn thành."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/task.py:0
msgid "%s is finished and cannot be assigned again."
msgstr "%s đã kết thúc và không thể giao lại."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/task.py:0
msgid "%s is not in the task's department."
msgstr "%s không thuộc phòng ban của nhiệm vụ."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/task.py:0
msgid "%s is not open."
msgstr "%s không còn mở."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/master_data/parameter_method.py:0
msgid ""
"%s is tested either in-house by a department or by a subcontractor, "
"not both."
msgstr ""
"%s được thử tại phòng thí nghiệm bởi một phòng ban hoặc bởi một thầu "
"phụ, không thể cả hai."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_editing_session.py:0
msgid "%s joined the session."
msgstr "%s đã tham gia phiên."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/mixins/archive_mixin.py:0
msgid "%s more"
msgstr "và %s bản ghi khác"

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/task.py:0
msgid "%s needs an assignee or a department whose queue holds it."
msgstr "%s cần có người thực hiện hoặc phòng ban giữ nhiệm vụ trong hàng đợi."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/master_data/parameter_method.py:0
msgid "%s needs the department that tests it, or a subcontractor."
msgstr "%s cần phòng ban thử nó, hoặc một thầu phụ."

#. module: sol_laboratory
#. odoo-javascript
#: code:addons/sol_laboratory/static/src/tasks/dashboard/task_dashboard.js:0
msgid "%s open"
msgstr "%s đang mở"

#. module: sol_laboratory
#. odoo-javascript
#: code:addons/sol_laboratory/static/src/tasks/dashboard/task_dashboard.js:0
msgid "%s overdue"
msgstr "%s quá hạn"

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/scheduled_job.py:0
msgid "%s runs within a minute."
msgstr "%s chạy trong vòng một phút."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/person.py:0
msgid ""
"%s signs in, so their login cannot be emptied; archive the person instead."
msgstr ""
"%s đang đăng nhập vào hệ thống, nên không thể xóa tên đăng nhập; hãy "
"lưu trữ nhân sự thay vào đó."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/task.py:0
msgid "%s waits in a queue you do not belong to."
msgstr "%s đang chờ trong hàng đợi mà bạn không thuộc về."

#. module: sol_laboratory
#: model:ir.actions.report,print_report_name:sol_laboratory.action_report_sample_label
msgid "'Label %s' % object.code"
msgstr "'Tem %s' % object.code"

#. module: sol_laboratory
#: model_terms:ir.ui.view,arch_db:sol_laboratory.view_calendar_event_form_quick_create_location
msgid "<i class=\"oi oi-filled\" data-icon=\"meeting_room\" title=\"Booked Location\"/>"
msgstr "<i class=\"oi oi-filled\" data-icon=\"meeting_room\" title=\"Vị trí được đặt\"/>"

#. module: sol_laboratory
#: model_terms:ir.ui.view,arch_db:sol_laboratory.report_sample_label
msgid "<span>Due</span>"
msgstr "<span>Hạn</span>"

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_approval_level_sequence_unique
msgid "A chain cannot have two levels in the same position."
msgstr "Một chuỗi không thể có hai cấp ở cùng một vị trí."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/approval_chain.py:0
msgid "A chain with signatures cannot be deleted; archive it instead. Signatures: %s"
msgstr "Không thể xóa chuỗi đã có chữ ký; hãy lưu trữ chuỗi. Chữ ký: %s"

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_device.py:0
msgid ""
"A computer signs in with its installation id and its name, never a path."
msgstr ""
"Máy tính đăng nhập bằng mã cài đặt và tên của nó, không bao giờ là một đường"
" dẫn."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_device.py:0
msgid ""
"A computer signs in with its installation id, its name and its platform."
msgstr "Máy tính đăng nhập bằng mã cài đặt, tên và hệ điều hành của nó."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_approval_chain_purpose_unique
msgid "A document type cannot have two chains for the same purpose."
msgstr "Một loại chứng từ không thể có hai chuỗi cho cùng một mục đích."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_laboratory_file_version_file_number_unique
msgid "A file has one version of each number."
msgstr "Mỗi số phiên bản chỉ có một phiên bản trong một tệp."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_file.py:0
msgid ""
"A file keeps its folder and its path; files are never moved or renamed."
msgstr ""
"Tệp giữ nguyên thư mục và đường dẫn; tệp không bao giờ được di chuyển hay "
"đổi tên."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_file.py:0
msgid "A file's current version changes only by saving or restoring the file."
msgstr "Phiên bản hiện hành của tệp chỉ thay đổi khi lưu hoặc khôi phục tệp."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_file.py:0
msgid "A file's current version only moves on to a newer version of the file."
msgstr ""
"Phiên bản hiện hành của tệp chỉ chuyển sang một phiên bản mới hơn của tệp."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_file.py:0
msgid ""
"A file's path is relative to its folder, such as HPLC/run-01.csv, never a "
"path on a computer: %s"
msgstr ""
"Đường dẫn của tệp là tương đối so với thư mục, ví dụ HPLC/run-01.csv, không "
"bao giờ là đường dẫn trên máy tính: %s"

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_laboratory_folder_member_folder_owner_unique
msgid "A folder has one owner; change the folder's owner instead."
msgstr "Mỗi thư mục chỉ có một chủ sở hữu; hãy đổi chủ sở hữu của thư mục."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_folder.py:0
msgid "A folder is named, such as HPLC, never given a path on a computer: %s"
msgstr ""
"Thư mục được đặt tên, ví dụ HPLC, không bao giờ là một đường dẫn trên máy "
"tính: %s"

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/master_data/parameter_group.py:0
msgid "A group that has parameters cannot have sub-groups: %s."
msgstr "Nhóm đã có chỉ tiêu không thể có nhóm con: %s."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_scheduled_job_key_unique
msgid "A job with this key already exists."
msgstr "Đã có tác vụ định kỳ với khóa này."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/approval_level.py:0
msgid "A level with signatures cannot be deleted. Signatures: %s"
msgstr "Không thể xóa cấp đã có chữ ký. Chữ ký: %s"

#. module: sol_laboratory
#: model:mail.message.subtype,description:sol_laboratory.event_location_booking_reminder
msgid "A location you booked or are invited to is about to be used"
msgstr "Vị trí bạn đã đặt hoặc được mời sắp đến giờ sử dụng"

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_file_lock_settings.py:0
msgid "A lock on a laboratory file must last at least 1 minute."
msgstr "Khóa trên tệp phòng thí nghiệm phải kéo dài ít nhất 1 phút."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/person.py:0
msgid "A login belongs to one person only."
msgstr "Mỗi tên đăng nhập chỉ thuộc về một nhân sự."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_measurement_unit_name_unique
msgid "A measurement unit with this symbol already exists."
msgstr "Đã có đơn vị đo với ký hiệu này."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_sync_rule.py:0
msgid ""
"A name pattern is a file name with *, such as run-*.csv, without a path: %s"
msgstr "Mẫu tên là tên tệp có *, ví dụ run-*.csv, không kèm đường dẫn: %s"

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/laboratory_files/laboratory_sync_rule.py:0
msgid ""
"A name prefix is the start of a file name, such as run-, without * or a "
"path: %s"
msgstr ""
"Tiền tố tên là phần đầu của tên tệp, ví dụ run-, không có * hay đường dẫn: "
"%s"

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_sample_test_quantity_positive
msgid "A parameter is tested at least once on a sample."
msgstr "Một chỉ tiêu được thử nghiệm ít nhất một lần trên mẫu."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_permission_identity_unique
msgid ""
"A permission for this action on this document type and scope already exists."
msgstr "Đã có quyền cho hành động này trên loại chứng từ và phạm vi này."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_permission_code_unique
msgid "A permission with this code already exists."
msgstr "Đã có quyền với mã này."

#. module: sol_laboratory
#: model:ir.model.fields.selection,name:sol_laboratory.selection__medilab_task_type__route__person
msgid "A person"
msgstr "Một nhân sự"

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/person.py:0
msgid "A person who signed cannot be deleted; archive them instead. Signatures: %s"
msgstr "Không thể xóa nhân sự đã ký; hãy lưu trữ nhân sự. Chữ ký: %s"

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_location_map_point_range
msgid "A point on a map lies between 0 and 1 of the image's width and height."
msgstr "Một điểm trên bản đồ phải nằm trong khoảng từ 0 đến 1 theo chiều rộng và chiều cao của hình ảnh."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_regulation_limit_regulation_parameter_unique
msgid "A regulation sets at most one limit per parameter."
msgstr "Mỗi quy chuẩn chỉ đặt tối đa một giới hạn cho mỗi chỉ tiêu."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/mixins/approval_mixin.py:0
#: code:addons/sol_laboratory/models/system/signature.py:0
msgid "A rejection needs a reason."
msgstr "Từ chối cần có lý do."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_role_code_unique
msgid "A role with this code already exists."
msgstr "Đã có vai trò với mã này."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_parameter_method_machine_run_minutes_positive
msgid "A run takes at least one minute."
msgstr "Một lần chạy mất ít nhất một phút."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/signature.py:0
msgid "A signature cannot be changed once it is given."
msgstr "Chữ ký đã ký thì không thể thay đổi."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/signature.py:0
msgid "A signature is given in force; only withdrawing it records a withdrawal."
msgstr "Chữ ký mới luôn có hiệu lực; chỉ việc rút chữ ký mới ghi nhận thời điểm rút."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/system/signature.py:0
msgid "A signature is withdrawn, not deleted."
msgstr "Chữ ký được rút lại, không bị xóa."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_testing_method_step_sequence_positive
msgid "A step number must be 1 or more."
msgstr "Số bước phải từ 1 trở lên."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_testing_method_step_duration_positive
msgid "A step takes at least one minute."
msgstr "Một bước mất ít nhất một phút."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_task_planned_period
msgid "A task cannot end before it starts."
msgstr "Nhiệm vụ không thể kết thúc trước khi bắt đầu."

#. module: sol_laboratory
#. odoo-python
#: code:addons/sol_laboratory/models/tasks/task.py:0
msgid "A task created by hand needs an assignee and a deadline."
msgstr "Nhiệm vụ tạo thủ công cần có người thực hiện và hạn chót."

#. module: sol_laboratory
#: code:addons/sol_laboratory/models/tasks/task.py:0
msgid "A task created by hand opens no document."
msgstr "Nhiệm vụ tạo thủ công không mở chứng từ nào."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_task_type_code_unique
msgid "A task type with this code already exists."
msgstr "Đã có loại nhiệm vụ với mã này."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_parameter_method_one_default
msgid "A test parameter has only one default way of testing."
msgstr "Mỗi chỉ tiêu chỉ có một cách thử mặc định."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_laboratory_editing_session_committed_version_unique
msgid "A version is saved by one editing session only."
msgstr "Mỗi phiên bản chỉ do một phiên chỉnh sửa lưu."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_laboratory_file_current_version_unique
msgid "A version is the current version of one file only."
msgstr "Một phiên bản chỉ là phiên bản hiện hành của một tệp."

#. module: sol_laboratory
#: model:ir.model.constraint,message:sol_laboratory.constraint_medilab_laboratory_file_version_sha256_format
msgid "A version's SHA-256 is 64 lowercase hexadecimal digits."
msgstr "SHA-256 của phiên bản gồm 64 chữ số thập lục phân viết thường."

#. module: sol_laboratory
