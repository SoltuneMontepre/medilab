<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_accreditation_certificate_list" model="ir.ui.view">
        <field name="name">medilab.accreditation.certificate.list</field>
        <field name="model">medilab.accreditation.certificate</field>
        <field name="arch" type="xml">
            <list decoration-muted="valid_until and valid_until &lt; current_date">
                <field name="code" />
                <field name="issuing_body" />
                <field name="valid_from" />
                <field name="valid_until" />
            </list>
        </field>
    </record>

    <record id="view_medilab_accreditation_certificate_form" model="ir.ui.view">
        <field name="name">medilab.accreditation.certificate.form</field>
        <field name="model">medilab.accreditation.certificate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_import_scope"
                        type="object"
                        string="Import Scope Lines"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="code" />
                        <h1><field name="code" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="issuing_body" />
                        </group>
                        <group>
                            <field name="valid_from" />
                            <field name="valid_until" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Scope" name="scope">
                            <field name="scope_line_ids">
                                <list editable="bottom" decoration-warning="to_confirm">
                                    <field name="method_id" />
                                    <field name="parameter_ids" widget="many2many_tags" />
                                    <field name="sample_type_ids" widget="many2many_tags" />
                                    <field name="to_confirm" optional="show" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_accreditation_certificate_search" model="ir.ui.view">
        <field name="name">medilab.accreditation.certificate.search</field>
        <field name="model">medilab.accreditation.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Number" />
                <field name="issuing_body" />
                <field name="method_ids" />
                <field name="scope_line_ids" string="Parameter" filter_domain="[('scope_line_ids.parameter_ids', 'ilike', self)]" />
                <field name="scope_line_ids" string="Sample Type" filter_domain="[('scope_line_ids.sample_type_ids', 'ilike', self)]" />
                <filter
                    name="to_confirm"
                    string="Lines to Confirm"
                    domain="[('scope_line_ids.to_confirm', '=', True)]"
                />
                <filter
                    name="expired"
                    string="Expired"
                    domain="[('valid_until', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_accreditation_certificate" model="ir.actions.act_window">
        <field name="name">Accreditation Certificates</field>
        <field name="res_model">medilab.accreditation.certificate</field>
        <field name="path">accreditation-certificates</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
