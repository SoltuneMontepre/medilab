<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_master_data" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sol_laboratory.master_data</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sol_laboratory']" position="inside">
                <block title="Quality Registration" name="quality_registration_setting_container">
                    <setting id="quality_registration_warning_setting">
                        <field name="quality_registration_warning_days" class="o_light_label" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
