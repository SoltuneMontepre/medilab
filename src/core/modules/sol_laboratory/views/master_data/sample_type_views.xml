<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_sample_type_list" model="ir.ui.view">
        <field name="name">medilab.sample.type.list</field>
        <field name="model">medilab.sample.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" />
                <field name="name" />
                <field name="parent_id" />
                <field name="is_retained" optional="hide" />
                <field name="retention_days" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_medilab_sample_type_form" model="ir.ui.view">
        <field name="name">medilab.sample.type.form</field>
        <field name="model">medilab.sample.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" required="0" placeholder="Filled from the sequence when left empty" />
                            <field name="parent_id" />
                        </group>
                        <group>
                            <label for="minimum_quantity" />
                            <div class="o_row">
                                <field name="minimum_quantity" />
                                <field name="minimum_quantity_unit_id" />
                            </div>
                            <field name="is_retained" />
                            <field name="retention_days" invisible="not is_retained" />
                        </group>
                    </group>
                    <group>
                        <field name="sampling_requirements" />
                        <field name="storage_conditions" />
                        <field name="post_test_requirements" />
                        <field name="disposal_method" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_sample_type_search" model="ir.ui.view">
        <field name="name">medilab.sample.type.search</field>
        <field name="model">medilab.sample.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Name" />
                <field name="parent_id" operator="child_of" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_sample_type" model="ir.actions.act_window">
        <field name="name">Sample Types</field>
        <field name="res_model">medilab.sample.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
