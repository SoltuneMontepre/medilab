<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_unit_category_list" model="ir.ui.view">
        <field name="name">medilab.unit.category.list</field>
        <field name="model">medilab.unit.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_medilab_unit_category_form" model="ir.ui.view">
        <field name="name">medilab.unit.category.form</field>
        <field name="model">medilab.unit.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <field name="unit_ids">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="factor" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_unit_category_search" model="ir.ui.view">
        <field name="name">medilab.unit.category.search</field>
        <field name="model">medilab.unit.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_unit_category" model="ir.actions.act_window">
        <field name="name">Unit Categories</field>
        <field name="res_model">medilab.unit.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
