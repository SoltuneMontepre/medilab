<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_chemical_list" model="ir.ui.view">
        <field name="name">medilab.chemical.list</field>
        <field name="model">medilab.chemical</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="code" />
                <field name="name" />
                <field name="cas_number" />
                <field name="formula" />
                <field name="grade" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_medilab_chemical_form" model="ir.ui.view">
        <field name="name">medilab.chemical.form</field>
        <field name="model">medilab.chemical</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="cas_number" />
                            <field name="formula" />
                            <field name="grade" />
                        </group>
                        <group>
                            <field name="storage_conditions" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Testing Methods" name="methods">
                            <field name="method_ids">
                                <list>
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="field_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_chemical_search" model="ir.ui.view">
        <field name="name">medilab.chemical.search</field>
        <field name="model">medilab.chemical</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Name" />
                <field name="method_ids" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_chemical" model="ir.actions.act_window">
        <field name="name">Chemicals</field>
        <field name="res_model">medilab.chemical</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
