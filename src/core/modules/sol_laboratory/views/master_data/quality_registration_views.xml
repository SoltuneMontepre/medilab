<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_quality_registration_list" model="ir.ui.view">
        <field name="name">medilab.quality.registration.list</field>
        <field name="model">medilab.quality.registration</field>
        <field name="arch" type="xml">
            <list decoration-muted="valid_until and valid_until &lt; current_date">
                <field name="code" />
                <field name="name" />
                <field name="issuing_authority" />
                <field name="valid_from" />
                <field name="valid_until" />
                <field name="report_mark" />
            </list>
        </field>
    </record>

    <record id="view_medilab_quality_registration_form" model="ir.ui.view">
        <field name="name">medilab.quality.registration.form</field>
        <field name="model">medilab.quality.registration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" required="0" placeholder="Filled from the sequence when left empty" />
                            <field name="issuing_authority" />
                            <field name="report_mark" />
                        </group>
                        <group>
                            <field name="valid_from" />
                            <field name="valid_until" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Covered Ways of Testing" name="parameter_methods">
                            <field name="parameter_method_ids">
                                <list>
                                    <field name="parameter_id" />
                                    <field name="method_id" />
                                    <field name="subcontractor_id" />
                                    <field name="unit_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_quality_registration_search" model="ir.ui.view">
        <field name="name">medilab.quality.registration.search</field>
        <field name="model">medilab.quality.registration</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Name" />
                <field name="parameter_method_ids" />
                <filter
                    name="expired"
                    string="Expired"
                    domain="[('valid_until', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_quality_registration" model="ir.actions.act_window">
        <field name="name">Quality Registrations</field>
        <field name="res_model">medilab.quality.registration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
