<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_testing_field_list" model="ir.ui.view">
        <field name="name">medilab.testing.field.list</field>
        <field name="model">medilab.testing.field</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="code" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_medilab_testing_field_form" model="ir.ui.view">
        <field name="name">medilab.testing.field.form</field>
        <field name="model">medilab.testing.field</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <group>
                        <field name="code" />
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_testing_field_search" model="ir.ui.view">
        <field name="name">medilab.testing.field.search</field>
        <field name="model">medilab.testing.field</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Name" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_testing_field" model="ir.actions.act_window">
        <field name="name">Testing Fields</field>
        <field name="res_model">medilab.testing.field</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
