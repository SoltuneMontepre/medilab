<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_task_reassign_form" model="ir.ui.view">
        <field name="name">medilab.task.reassign.form</field>
        <field name="model">medilab.task.reassign</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="task_ids" widget="many2many_tags" readonly="1" />
                    <field name="department_id" />
                    <field
                        name="assignee_id"
                        domain="[('department_id', '=', department_id)] if department_id else []"
                        options="{'no_create': True}"
                    />
                    <field name="reason_required" invisible="1" />
                    <field name="reason" invisible="not reason_required" required="reason_required" />
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Assign" class="btn-success" />
                    <button special="cancel" string="Discard" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_task_reassign" model="ir.actions.act_window">
        <field name="name">Assign</field>
        <field name="res_model">medilab.task.reassign</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_medilab_task" />
        <field name="binding_view_types">list</field>
        <field
            name="group_ids"
            eval="[Command.set([ref('group_permission_task_edit_all'), ref('group_permission_task_edit_own_department')])]"
        />
    </record>
</odoo>
