<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mobile_releases" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sol_laboratory.mobile_releases</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sol_laboratory']" position="inside">
                <block title="Medilab Mobile" name="mobile_release_setting_container">
                    <setting id="mobile_minimum_version_setting">
                        <field name="mobile_minimum_version" />
                    </setting>
                    <setting id="mobile_stopped_versions_setting">
                        <field name="mobile_stopped_versions" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
