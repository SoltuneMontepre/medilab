<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_audit_report_form" model="ir.ui.view">
        <field name="name">medilab.audit.report.form</field>
        <field name="model">medilab.audit.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group string="Period">
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                    <group string="Filters">
                        <field name="document_model" />
                        <field name="document_name" />
                        <field name="user_id" />
                        <field name="action" />
                        <field name="source" />
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print PDF" class="btn-success" />
                    <button name="action_export" type="object" string="Export Spreadsheet" class="btn-success" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_audit_report" model="ir.actions.act_window">
        <field name="name">Audit Report</field>
        <field name="res_model">medilab.audit.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
