<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_department_list" model="ir.ui.view">
        <field name="name">medilab.department.list</field>
        <field name="model">medilab.department</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_medilab_department_form" model="ir.ui.view">
        <field name="name">medilab.department.form</field>
        <field name="model">medilab.department</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <notebook>
                        <page string="People" name="people">
                            <field name="person_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="email" />
                                    <field name="phone" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_department_search" model="ir.ui.view">
        <field name="name">medilab.department.search</field>
        <field name="model">medilab.department</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">medilab.department</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
