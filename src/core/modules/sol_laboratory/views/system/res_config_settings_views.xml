<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_audit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sol_laboratory.audit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sol_laboratory']" position="inside">
                <block title="Audit Trail" name="audit_setting_container">
                    <setting id="audit_retention_setting">
                        <field name="audit_retention_days" class="o_light_label" />
                    </setting>
                </block>
                <block title="Cleanup" name="cleanup_setting_container">
                    <setting id="job_retention_setting">
                        <field name="job_retention_days" class="o_light_label" />
                    </setting>
                    <setting id="lock_retention_setting">
                        <field name="lock_retention_days" class="o_light_label" />
                    </setting>
                    <setting id="notification_retention_setting">
                        <field name="notification_retention_days" class="o_light_label" />
                    </setting>
                    <setting id="device_retention_setting">
                        <field name="device_retention_days" class="o_light_label" />
                    </setting>
                </block>
                <block title="Document Locks" name="lock_setting_container">
                    <setting id="lock_timeout_setting">
                        <field name="lock_timeout_minutes" class="o_light_label" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <!-- Internal users are created only through people, so the settings invite none. -->
    <record id="res_config_settings_view_form_through_people" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sol_laboratory.people</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="invite_users_setting" position="attributes">
                <attribute name="invisible">1</attribute>
            </setting>
        </field>
    </record>
</odoo>
