<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_role_list" model="ir.ui.view">
        <field name="name">medilab.role.list</field>
        <field name="model">medilab.role</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="code" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_medilab_role_form" model="ir.ui.view">
        <field name="name">medilab.role.form</field>
        <field name="model">medilab.role</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" readonly="code == 'administrator'" /></h1>
                    </div>
                    <group>
                        <field name="code" readonly="id" />
                    </group>
                    <notebook>
                        <page string="Permissions" name="permissions" groups="sol_laboratory.group_role_administrator">
                            <field name="permission_ids" readonly="code == 'administrator'">
                                <list>
                                    <field name="code" />
                                    <field name="name" />
                                </list>
                            </field>
                        </page>
                        <page string="People" name="people" groups="sol_laboratory.group_role_administrator">
                            <field name="person_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="department_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_role_search" model="ir.ui.view">
        <field name="name">medilab.role.search</field>
        <field name="model">medilab.role</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
            </search>
        </field>
    </record>

    <record id="action_medilab_role" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">medilab.role</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
