<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_department_form_teams" model="ir.ui.view">
        <field name="name">hr.department.form.teams</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form" />
        <field name="arch" type="xml">
            <field name="parent_id" position="attributes">
                <attribute name="string">Department</attribute>
                <attribute name="invisible">child_ids</attribute>
            </field>
            <sheet position="inside">
                <notebook>
                    <page string="Teams" name="teams" invisible="parent_id">
                        <field name="child_ids" context="{'default_parent_id': id}">
                            <list editable="bottom">
                                <field name="name" string="Team" />
                                <field name="manager_id" string="Team Lead" widget="many2one_avatar_employee" />
                            </list>
                        </field>
                    </page>
                    <page
                        string="Team Members"
                        name="team_members"
                        invisible="not parent_id"
                        groups="sol_laboratory.group_permission_person_read_all,sol_laboratory.group_permission_person_read_own_department,sol_laboratory.group_permission_person_read_own_team"
                    >
                        <field name="team_person_ids" readonly="1">
                            <list>
                                <field name="name" />
                                <field name="work_email" />
                                <field name="work_phone" />
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

    <record id="view_hr_department_team_list" model="ir.ui.view">
        <field name="name">hr.department.team.list</field>
        <field name="model">hr.department</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Team" />
                <field name="parent_id" string="Department" />
                <field name="manager_id" string="Team Lead" widget="many2one_avatar_employee" />
            </list>
        </field>
    </record>

    <record id="view_hr_department_team_search" model="ir.ui.view">
        <field name="name">hr.department.team.search</field>
        <field name="model">hr.department</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Team" />
                <field name="parent_id" string="Department" />
                <field name="manager_id" string="Team Lead" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
                <filter name="group_by_department" string="Department" context="{'group_by': 'parent_id'}" />
            </search>
        </field>
    </record>

    <record id="action_hr_department_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('parent_id', '!=', False)]</field>
        <field name="view_id" ref="view_hr_department_team_list" />
        <field name="search_view_id" ref="view_hr_department_team_search" />
    </record>
</odoo>
