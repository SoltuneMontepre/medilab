<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resource_calendar_leaves_public_holiday_list" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.public.holiday.list</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" string="Public Holiday" required="1" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="count_as" string="Count As" />
                <field name="calendar_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="action_medilab_public_holiday" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">resource.calendar.leaves</field>
        <field name="path">public-holidays</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_resource_calendar_leaves_public_holiday_list" />
        <field name="domain">[('resource_id', '=', False)]</field>
    </record>
</odoo>
