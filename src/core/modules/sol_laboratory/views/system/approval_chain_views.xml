<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_approval_chain_list" model="ir.ui.view">
        <field name="name">medilab.approval.chain.list</field>
        <field name="model">medilab.approval.chain</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="name" />
                <field name="document_model" />
                <field name="purpose" />
            </list>
        </field>
    </record>

    <record id="view_medilab_approval_chain_form" model="ir.ui.view">
        <field name="name">medilab.approval.chain.form</field>
        <field name="model">medilab.approval.chain</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <field name="document_model" />
                        <field name="purpose" />
                        <field name="active" invisible="1" />
                    </group>
                    <notebook>
                        <page string="Levels" name="levels">
                            <field name="level_ids">
                                <list editable="bottom">
                                    <field name="sequence" />
                                    <field name="name" />
                                    <field name="role_id" />
                                    <field name="same_department" />
                                    <field name="can_reject" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_approval_chain_search" model="ir.ui.view">
        <field name="name">medilab.approval.chain.search</field>
        <field name="model">medilab.approval.chain</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="document_model" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_approval_chain" model="ir.actions.act_window">
        <field name="name">Approval Chains</field>
        <field name="res_model">medilab.approval.chain</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
