<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_document_lock_list" model="ir.ui.view">
        <field name="name">medilab.document.lock.list</field>
        <field name="model">medilab.document.lock</field>
        <field name="arch" type="xml">
            <list duplicate="0" create="0" delete="0" decoration-muted="status != 'active'">
                <field name="display_name" string="Document" />
                <field name="document_model" optional="hide" />
                <field name="user_id" widget="many2one_avatar_user" />
                <field name="kind" />
                <field name="create_date" string="Locked Since" />
                <field name="last_activity_at" />
                <field name="status" widget="badge" decoration-warning="status == 'active'" />
                <field name="release_reason" optional="show" />
                <field name="released_by_id" optional="hide" />
                <button name="action_release" type="object" string="Release" icon="fa-unlock" class="btn-danger" invisible="status != 'active'" groups="sol_laboratory.group_permission_document_lock_edit_all" />
            </list>
        </field>
    </record>

    <record id="view_medilab_document_lock_form" model="ir.ui.view">
        <field name="name">medilab.document.lock.form</field>
        <field name="model">medilab.document.lock</field>
        <field name="arch" type="xml">
            <form duplicate="0" create="0" delete="0">
                <header>
                    <button name="action_release" type="object" string="Release" class="btn-danger" invisible="status != 'active'" groups="sol_laboratory.group_permission_document_lock_edit_all" />
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_model" />
                            <field name="document_id" />
                            <field name="user_id" widget="many2one_avatar_user" />
                            <field name="kind" />
                        </group>
                        <group>
                            <field name="create_date" string="Locked Since" />
                            <field name="last_activity_at" />
                            <field name="released_at" invisible="status == 'active'" />
                            <field name="release_reason" invisible="status == 'active'" />
                            <field name="released_by_id" invisible="not released_by_id" />
                        </group>
                    </group>
                    <group string="Watchers" name="watchers" invisible="not watcher_ids">
                        <field name="watcher_ids" nolabel="1" colspan="2" widget="many2many_avatar_user" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_document_lock_search" model="ir.ui.view">
        <field name="name">medilab.document.lock.search</field>
        <field name="model">medilab.document.lock</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id" />
                <field name="document_model" />
                <filter name="active_locks" string="Active" domain="[('status', '=', 'active')]" />
                <filter name="released" string="Released" domain="[('status', '=', 'released')]" />
                <filter name="expired" string="Expired" domain="[('status', '=', 'expired')]" />
                <separator />
                <filter name="editing" string="Editing" domain="[('kind', '=', 'edit')]" />
                <filter name="operation" string="Operation" domain="[('kind', '=', 'operation')]" />
                <filter name="group_by_user" string="Holder" context="{'group_by': 'user_id'}" />
                <filter name="group_by_status" string="Status" context="{'group_by': 'status'}" />
            </search>
        </field>
    </record>

    <record id="action_medilab_document_lock" model="ir.actions.act_window">
        <field name="name">Document Locks</field>
        <field name="res_model">medilab.document.lock</field>
        <field name="path">document-locks</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_active_locks": 1}</field>
    </record>
</odoo>
