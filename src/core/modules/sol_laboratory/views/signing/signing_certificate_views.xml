<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_signing_certificate_list" model="ir.ui.view">
        <field name="name">medilab.signing.certificate.list</field>
        <field name="model">medilab.signing.certificate</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0" decoration-muted="status != 'valid'">
                <header>
                    <button
                        name="action_refresh"
                        type="object"
                        string="Refresh from Viettel Sign"
                        class="btn-primary"
                        display="always"
                        groups="base.group_system"
                    />
                </header>
                <field name="name" />
                <field name="issuer" optional="show" />
                <field name="serial_number" optional="hide" />
                <field name="valid_from" optional="hide" />
                <field name="valid_to" />
                <field name="checked_at" optional="show" />
                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'valid'"
                    decoration-danger="status in ('expired', 'revoked')"
                />
            </list>
        </field>
    </record>

    <record id="view_medilab_signing_certificate_form" model="ir.ui.view">
        <field name="name">medilab.signing.certificate.form</field>
        <field name="model">medilab.signing.certificate</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subject" />
                            <field name="issuer" />
                            <field name="serial_number" />
                            <field name="credential_id" />
                        </group>
                        <group>
                            <field name="valid_from" />
                            <field name="valid_to" />
                            <field name="checked_at" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_medilab_signing_certificate" model="ir.actions.act_window">
        <field name="name">Signing Certificates</field>
        <field name="res_model">medilab.signing.certificate</field>
        <field name="path">signing-certificates</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
