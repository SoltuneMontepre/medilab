<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_digital_signature_list" model="ir.ui.view">
        <field name="name">medilab.digital.signature.list</field>
        <field name="model">medilab.digital.signature</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="document_name" />
                <field name="document_version" optional="show" />
                <field name="certificate_id" />
                <field name="signed_at" />
            </list>
        </field>
    </record>

    <record id="view_medilab_digital_signature_form" model="ir.ui.view">
        <field name="name">medilab.digital.signature.form</field>
        <field name="model">medilab.digital.signature</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_download" type="object" string="Download PDF" class="btn-secondary" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="document_name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_version" />
                            <field name="file_hash" />
                        </group>
                        <group>
                            <field name="certificate_id" />
                            <field name="signed_at" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_digital_signature_search" model="ir.ui.view">
        <field name="name">medilab.digital.signature.search</field>
        <field name="model">medilab.digital.signature</field>
        <field name="arch" type="xml">
            <search>
                <field name="certificate_id" />
                <field name="file_hash" />
                <group>
                    <filter name="group_certificate" string="Certificate" context="{'group_by': 'certificate_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_digital_signature" model="ir.actions.act_window">
        <field name="name">Digital Signatures</field>
        <field name="res_model">medilab.digital.signature</field>
        <field name="path">digital-signatures</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
