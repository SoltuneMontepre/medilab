<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_signing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sol_laboratory.signing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sol_laboratory']" position="inside">
                <block title="Digital Signing" name="digital_signing_setting_container">
                    <setting id="digital_signing_setting">
                        <field name="digital_signing_enabled" />
                        <div class="mt8" invisible="not digital_signing_enabled">
                            <button
                                name="%(action_medilab_signing_certificate)d"
                                type="action"
                                string="Certificates"
                                class="btn-link"
                                icon="oi-arrow-right"
                            />
                        </div>
                    </setting>
                    <setting id="signing_certificate_alert_setting" invisible="not digital_signing_enabled">
                        <field name="signing_certificate_alert_days" class="o_light_label" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
