<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_test_report_reject_form" model="ir.ui.view">
        <field name="name">medilab.test.report.reject.form</field>
        <field name="model">medilab.test.report.reject</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="report_id" invisible="1" />
                    <field name="available_result_ids" invisible="1" />
                    <field name="reason" />
                    <field name="result_ids" widget="many2many_tags" options="{'no_create': True}" />
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" />
                    <button special="cancel" string="Discard" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_test_report_reject" model="ir.actions.act_window">
        <field name="name">Reject the Report</field>
        <field name="res_model">medilab.test.report.reject</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
