<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_sample_test_cancel_form" model="ir.ui.view">
        <field name="name">medilab.sample.test.cancel.form</field>
        <field name="model">medilab.sample.test.cancel</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="sample_test_id" invisible="1" />
                    <field name="reason" />
                </group>
                <footer>
                    <button name="action_cancel" type="object" string="Cancel Test" class="btn-danger" />
                    <button special="cancel" string="Discard" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_sample_test_cancel" model="ir.actions.act_window">
        <field name="name">Cancel the Test</field>
        <field name="res_model">medilab.sample.test.cancel</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
