<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_sample_test_form" model="ir.ui.view">
        <field name="name">medilab.sample.test.form</field>
        <field name="model">medilab.sample.test</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0">
                <header>
                    <button
                        name="action_schedule"
                        type="object"
                        string="Schedule"
                        class="btn-primary"
                        invisible="not recommended_machine_id"
                    />
                    <button
                        name="%(action_medilab_sample_test_outsource)d"
                        type="action"
                        string="Outsource"
                        class="btn-success"
                        context="{'default_sample_test_id': id}"
                        invisible="status not in ('waiting', 'assigned') or not subcontracted_method_ids or not (outsourcing_suggested or tested_by_my_department)"
                        groups="sol_laboratory.group_permission_subcontract_dispatch_create_all"
                    />
                    <button
                        name="action_enter_result"
                        type="object"
                        string="Enter Result"
                        class="btn-primary"
                        invisible="not can_enter_result"
                        groups="sol_laboratory.group_permission_test_result_create_all"
                    />
                    <field name="can_enter_result" invisible="1" />
                    <button
                        name="%(action_medilab_sample_test_cancel)d"
                        type="action"
                        string="Cancel Test"
                        class="btn-danger"
                        context="{'default_sample_test_id': id}"
                        invisible="status not in ('waiting', 'assigned', 'testing')"
                        groups="sol_laboratory.group_permission_sample_test_edit_all"
                    />
                    <button
                        name="%(action_medilab_sample_test_due_date_change)d"
                        type="action"
                        string="Change Due Date"
                        context="{'default_sample_test_id': id, 'default_due_date': due_date}"
                        invisible="not can_change_due_date"
                    />
                    <button
                        name="action_clear_due_date"
                        type="object"
                        string="Use Automatic Due Date"
                        invisible="not can_change_due_date or not due_date_reason"
                    />
                    <field name="can_change_due_date" invisible="1" />
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not outsourcing_suggested">
                        No machine can finish this test before its due date. Outsource it through a subcontracted way of testing.
                    </div>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not due_date_conflict or status not in ('waiting', 'assigned', 'testing', 'outsourced')"
                    >
                        The due date was changed by hand and is now later than the date the request's expected date gives.
                    </div>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not due_on_non_working_day or status not in ('waiting', 'assigned', 'testing', 'outsourced')"
                    >
                        The due date is not a working day of the company calendar.
                    </div>
                    <field name="due_date_conflict" invisible="1" />
                    <field name="due_on_non_working_day" invisible="1" />
                    <div class="oe_title">
                        <h1><field name="sample_id" readonly="1" /></h1>
                        <h2><field name="parameter_id" readonly="1" /></h2>
                        <field name="is_urgent" invisible="1" />
                        <span class="badge text-bg-danger" invisible="not is_urgent">Urgent</span>
                    </div>
                    <group>
                        <group>
                            <field name="quantity" readonly="1" />
                            <field name="due_date" readonly="1" />
                            <field name="due_date_reason" invisible="not due_date_reason" />
                            <field name="parameter_method_id" readonly="1" />
                        </group>
                        <group string="Recommendation" invisible="not recommended_machine_id">
                            <field name="recommended_method_id" string="Way of Testing" />
                            <field name="recommended_machine_id" string="Machine" />
                            <field name="recommended_start" string="Start" />
                            <field name="recommended_end" string="End" />
                        </group>
                        <group string="Outsourcing" invisible="not outsourcing_suggested">
                            <field name="outsourcing_suggested" invisible="1" />
                            <field name="tested_by_my_department" invisible="1" />
                            <field name="subcontracted_method_ids" widget="many2many_tags" />
                        </group>
                        <group string="Emergency Outsourcing" invisible="not emergency_outsource_reason">
                            <field name="emergency_outsource_reason" string="Reason" />
                        </group>
                        <group string="Cancellation" invisible="not cancel_reason">
                            <field name="cancel_reason" />
                            <field name="cancelled_by_id" />
                            <field name="cancelled_at" />
                        </group>
                    </group>
                    <notebook>
                        <page
                            string="Results"
                            name="results"
                            groups="sol_laboratory.group_permission_test_result_read_all"
                        >
                            <field name="result_ids" readonly="1">
                                <list decoration-muted="not is_reported">
                                    <field name="attempt" />
                                    <field name="value_display" />
                                    <field name="unit_id" />
                                    <field name="conclusion" />
                                    <field name="is_reported" />
                                    <field name="entered_by_id" />
                                    <field name="entered_at" />
                                    <field
                                        name="status"
                                        widget="badge"
                                        decoration-warning="status == 'requested'"
                                        decoration-success="status == 'approved'"
                                        decoration-danger="status == 'rejected'"
                                    />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Dispatches"
                            name="dispatches"
                            invisible="not dispatch_ids"
                            groups="sol_laboratory.group_permission_subcontract_dispatch_read_all"
                        >
                            <field name="dispatch_ids">
                                <list>
                                    <field name="code" required="0" />
                                    <field name="subcontractor_id" />
                                    <field name="sent_date" />
                                    <field name="expected_date" />
                                    <field name="status" widget="badge" />
                                </list>
                            </field>
                        </page>
                        <page string="Bookings" name="bookings">
                            <field name="booking_ids" readonly="1">
                                <list decoration-muted="status in ('done', 'cancelled')">
                                    <field name="machine_id" />
                                    <field name="person_id" />
                                    <field name="starts_at" />
                                    <field name="ends_at" />
                                    <field name="status" widget="badge" />
                                    <button name="action_start" type="object" string="Start" invisible="status != 'scheduled'" />
                                    <button name="action_done" type="object" string="Done" invisible="status != 'in_progress'" />
                                    <button
                                        name="action_cancel"
                                        type="object"
                                        string="Cancel"
                                        invisible="status not in ('queued', 'scheduled')"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_sample_test_outsourcing_list" model="ir.ui.view">
        <field name="name">medilab.sample.test.outsourcing.list</field>
        <field name="model">medilab.sample.test</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="is_urgent" column_invisible="1" />
                <field name="sample_id" />
                <field name="parameter_id" />
                <field name="due_date" decoration-danger="is_urgent" />
                <field name="subcontracted_method_ids" widget="many2many_tags" />
                <field name="status" widget="badge" />
                <button
                    name="%(action_medilab_sample_test_outsource)d"
                    type="action"
                    string="Outsource"
                    class="btn-success"
                    context="{'default_sample_test_id': id}"
                    invisible="not subcontracted_method_ids"
                    groups="sol_laboratory.group_permission_subcontract_dispatch_create_all"
                />
            </list>
        </field>
    </record>

    <record id="action_medilab_sample_test_outsourcing" model="ir.actions.act_window">
        <field name="name">Outsourcing Suggestions</field>
        <field name="res_model">medilab.sample.test</field>
        <field name="path">outsourcing-suggestions</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_medilab_sample_test_outsourcing_list" />
        <field name="domain">[('outsourcing_suggested', '=', True), ('status', 'in', ('waiting', 'assigned'))]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
