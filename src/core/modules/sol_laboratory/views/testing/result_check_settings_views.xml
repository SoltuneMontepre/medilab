<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_result_check" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sol_laboratory.result_check</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='sample_retention_setting_container']" position="after">
                <block title="Result Check" name="result_check_setting_container">
                    <setting id="result_check_minimum_setting">
                        <field name="result_check_minimum_count" class="o_light_label" />
                    </setting>
                    <setting id="result_check_deviations_setting">
                        <field name="result_check_deviations" class="o_light_label" />
                    </setting>
                    <setting id="result_check_margin_setting">
                        <field name="result_check_limit_margin_percent" class="o_light_label" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
