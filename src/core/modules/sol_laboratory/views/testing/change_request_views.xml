<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_change_request_list" model="ir.ui.view">
        <field name="name">medilab.change.request.list</field>
        <field name="model">medilab.change.request</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="code" />
                <field name="document_name" />
                <field name="requested_by_id" />
                <field name="create_date" string="Requested At" />
                <field name="requested_change" optional="show" />
                <field
                    name="status"
                    widget="badge"
                    decoration-warning="status == 'requested'"
                    decoration-info="status == 'approved'"
                    decoration-success="status == 'applied'"
                    decoration-danger="status == 'rejected'"
                />
            </list>
        </field>
    </record>

    <record id="view_medilab_change_request_form" model="ir.ui.view">
        <field name="name">medilab.change.request.form</field>
        <field name="model">medilab.change.request</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0">
                <header>
                    <button
                        name="action_sign"
                        type="object"
                        string="Approve"
                        class="btn-success"
                        confirm="Approve this change request? The last approval creates the new version."
                        invisible="not approval_can_sign"
                    />
                    <button
                        name="%(action_medilab_change_request_reject)d"
                        type="action"
                        string="Reject"
                        class="btn-danger"
                        context="{'default_change_request_id': id}"
                        invisible="not approval_can_reject"
                    />
                    <button
                        name="action_withdraw"
                        type="object"
                        string="Withdraw Signature"
                        class="btn-secondary"
                        invisible="not approval_can_withdraw"
                    />
                    <button name="action_open_document" type="object" string="Open Document" />
                    <button
                        name="action_open_new_version"
                        type="object"
                        string="Open New Version"
                        invisible="not new_document_id"
                    />
                    <field name="status" widget="statusbar" statusbar_visible="requested,approved,applied" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code" required="0" placeholder="Filled from the sequence when left empty" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_name" />
                            <field name="requested_by_id" />
                            <field name="create_date" string="Requested At" />
                        </group>
                        <group>
                            <field name="requested_change" />
                            <field name="reason" />
                            <field name="rejection_reason" invisible="not rejection_reason" />
                        </group>
                    </group>
                    <field name="new_document_id" invisible="1" />
                    <field name="approval_can_sign" invisible="1" />
                    <field name="approval_can_reject" invisible="1" />
                    <field name="approval_can_withdraw" invisible="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_change_request_search" model="ir.ui.view">
        <field name="name">medilab.change.request.search</field>
        <field name="model">medilab.change.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="requested_by_id" />
                <filter name="requested" string="Requested" domain="[('status', '=', 'requested')]" />
                <filter name="mine" string="Raised by Me" domain="[('requested_by_id.user_id', '=', uid)]" />
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}" />
                    <filter name="group_document_model" string="Document Type" context="{'group_by': 'document_model'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_change_request" model="ir.actions.act_window">
        <field name="name">Change Requests</field>
        <field name="res_model">medilab.change.request</field>
        <field name="path">change-requests</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
