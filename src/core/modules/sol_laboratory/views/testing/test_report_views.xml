<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_test_report_list" model="ir.ui.view">
        <field name="name">medilab.test.report.list</field>
        <field name="model">medilab.test.report</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="status == 'replaced'">
                <field name="display_name" string="Report Number" />
                <field name="request_id" />
                <field name="customer_id" />
                <field name="version" optional="show" />
                <field name="language" />
                <field name="issued_at" optional="show" />
                <field name="delivered_at" optional="show" />
                <field
                    name="status"
                    widget="badge"
                    decoration-info="status == 'draft'"
                    decoration-warning="status == 'signing'"
                    decoration-success="status == 'issued'"
                />
            </list>
        </field>
    </record>

    <!-- Issued reports waiting for sample delivery staff, with how and to whom each is delivered. -->
    <record id="view_medilab_test_report_delivery_list" model="ir.ui.view">
        <field name="name">medilab.test.report.delivery.list</field>
        <field name="model">medilab.test.report</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="code" />
                <field name="request_id" />
                <field name="customer_id" />
                <field name="delivery_method" />
                <field name="delivery_note" />
                <field name="recipient_id" />
                <field name="issued_at" />
                <button name="action_record_delivery" type="object" string="Record Delivery" class="btn-primary" />
            </list>
        </field>
    </record>

    <record id="view_medilab_test_report_form" model="ir.ui.view">
        <field name="name">medilab.test.report.form</field>
        <field name="model">medilab.test.report</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0">
                <header>
                    <button
                        name="action_sign"
                        type="object"
                        string="Sign"
                        class="btn-primary"
                        confirm="Sign this report? The last signature issues it."
                        invisible="not approval_can_sign"
                    />
                    <button
                        name="%(action_medilab_test_report_reject)d"
                        type="action"
                        string="Reject"
                        class="btn-danger"
                        context="{'default_report_id': id}"
                        invisible="not approval_can_reject"
                    />
                    <button
                        name="action_withdraw"
                        type="object"
                        string="Withdraw Signature"
                        class="btn-secondary"
                        invisible="not approval_can_withdraw"
                    />
                    <button
                        name="action_record_delivery"
                        type="object"
                        string="Record Delivery"
                        class="btn-primary"
                        invisible="status != 'issued' or delivered_at"
                        groups="sol_laboratory.group_permission_test_report_edit_all"
                    />
                    <button name="action_download" type="object" string="Download PDF" invisible="not attachment_id" />
                    <button
                        name="action_retry_digital_signing"
                        type="object"
                        string="Retry Digital Signing"
                        class="btn-primary"
                        invisible="not digital_signing_pending"
                    />
                    <button
                        name="action_print_draft"
                        type="object"
                        string="Print Draft"
                        invisible="status in ('issued', 'replaced')"
                    />
                    <button
                        name="action_edit_draft"
                        type="object"
                        string="Edit Draft"
                        class="btn-primary"
                        invisible="not draft_editable"
                        groups="sol_laboratory.group_permission_test_report_edit_all"
                    />
                    <button
                        name="action_prepare_pdf"
                        type="object"
                        string="Prepare PDF"
                        invisible="not draft_editable"
                        groups="sol_laboratory.group_permission_test_report_edit_all"
                    />
                    <button
                        name="action_open_candidate"
                        type="object"
                        string="Review PDF"
                        class="btn-primary"
                        invisible="not has_candidate"
                        groups="sol_laboratory.group_permission_test_report_candidate_read_all"
                    />
                    <button
                        name="action_reopen_draft"
                        type="object"
                        string="Reopen Draft"
                        confirm="Reopen the draft? Its prepared PDF becomes obsolete, and a new one must be prepared and reviewed."
                        invisible="not has_candidate or status != 'draft'"
                        groups="sol_laboratory.group_permission_test_report_edit_all"
                    />
                    <button
                        name="%(action_medilab_test_report_template_change)d"
                        type="action"
                        string="Change Template"
                        context="{'default_report_id': id}"
                        invisible="not draft_editable"
                        groups="sol_laboratory.group_permission_test_report_edit_all"
                    />
                    <button
                        name="action_generate_draft"
                        type="object"
                        string="Generate Draft Again"
                        confirm="Generate the draft again from the template and the business records? The editors' changes are replaced."
                        invisible="not draft_editable or not draft_file_id"
                        groups="sol_laboratory.group_permission_test_report_edit_all"
                    />
                    <button
                        name="%(action_medilab_change_request_raise)d"
                        type="action"
                        string="Request a Change"
                        context="{'default_document_model': 'medilab.test.report', 'default_document_id': id}"
                        invisible="status != 'issued'"
                        groups="sol_laboratory.group_permission_test_report_edit_all"
                    />
                    <field name="status" widget="statusbar" statusbar_visible="draft,signing,issued" />
                </header>
                <div class="alert alert-info mb-0" role="status" invisible="not has_candidate or not candidate_current">A prepared draft PDF waits for the lab head's review. It is not issued and not digitally signed.</div>
                <div class="alert alert-warning mb-0" role="alert" invisible="not has_candidate or candidate_current">The prepared PDF no longer matches its template, its draft or the business records. Reopen the draft, then prepare and review the PDF again.</div>
                <div class="alert alert-warning mb-0" role="alert" invisible="not digital_signing_pending">Viettel Sign has not signed the PDF yet. It is retried automatically, and the customer is told once it is signed.</div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_id" />
                            <field name="customer_id" />
                            <field name="language" />
                            <field name="version" />
                            <field name="replaces_id" invisible="not replaces_id" />
                            <field name="issued_at" invisible="not issued_at" />
                            <field name="attachment_id" invisible="not attachment_id" />
                            <field name="digital_signature_id" invisible="not digital_signature_id" options="{'no_open': True}" />
                            <field
                                name="template_version_id"
                                invisible="not template_version_id"
                                groups="sol_laboratory.group_permission_report_template_version_read_all"
                            />
                        </group>
                        <group string="Delivery">
                            <field name="delivery_method" />
                            <field name="delivery_note" invisible="not delivery_note" />
                            <field name="recipient_id" />
                            <field name="delivered_at" invisible="not delivered_at" />
                            <field name="delivered_by_id" invisible="not delivered_by_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Results" name="results" groups="sol_laboratory.group_permission_test_result_read_all">
                            <field name="result_ids">
                                <list>
                                    <field name="sample_id" />
                                    <field name="parameter_id" />
                                    <field name="value_display" />
                                    <field name="unit_id" />
                                    <field name="conclusion" />
                                    <field name="status" widget="badge" decoration-success="status == 'approved'" />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Prepared PDFs"
                            name="candidates"
                            invisible="not candidate_ids"
                            groups="sol_laboratory.group_permission_test_report_candidate_read_all"
                        >
                            <field name="candidate_ids" readonly="1">
                                <list decoration-muted="status == 'obsolete'">
                                    <field name="report_number" />
                                    <field name="report_date" />
                                    <field name="template_version_id" />
                                    <field name="create_date" string="Prepared At" />
                                    <field name="create_uid" string="Prepared By" />
                                    <field name="invalidated_reason" optional="show" />
                                    <field name="sha256" optional="hide" />
                                    <field
                                        name="status"
                                        widget="badge"
                                        decoration-info="status == 'review'"
                                        decoration-success="status == 'issued'"
                                    />
                                    <button name="action_open" type="object" string="Open" />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Generated Drafts"
                            name="drafts"
                            invisible="not draft_ids"
                            groups="sol_laboratory.group_permission_test_report_draft_read_all"
                        >
                            <field name="draft_ids" readonly="1">
                                <list>
                                    <field name="template_version_id" />
                                    <field name="create_date" string="Generated At" />
                                    <field name="create_uid" string="Generated By" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="draft_file_id" invisible="1" groups="sol_laboratory.group_permission_test_report_edit_all" />
                    <field name="has_candidate" invisible="1" />
                    <field name="candidate_current" invisible="1" />
                    <field name="draft_editable" invisible="1" />
                    <field name="approval_can_sign" invisible="1" />
                    <field name="approval_can_reject" invisible="1" />
                    <field name="approval_can_withdraw" invisible="1" />
                    <field name="digital_signing_pending" invisible="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_test_report_search" model="ir.ui.view">
        <field name="name">medilab.test.report.search</field>
        <field name="model">medilab.test.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="request_id" />
                <field name="customer_id" />
                <filter name="issued" string="Issued" domain="[('status', '=', 'issued')]" />
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}" />
                    <filter name="group_delivery_method" string="Delivery Method" context="{'group_by': 'delivery_method'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_test_report" model="ir.actions.act_window">
        <field name="name">Test Reports</field>
        <field name="res_model">medilab.test.report</field>
        <field name="path">test-reports</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- The lab head's test requests whose results are all approved, and new versions of issued reports, waiting for
         signature. -->
    <record id="action_medilab_test_report_to_sign" model="ir.actions.act_window">
        <field name="name">Reports to Sign</field>
        <field name="res_model">medilab.test.report</field>
        <field name="path">reports-to-sign</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ('draft', 'signing')), '|', ('request_id.status', '=', 'completed'), ('replaces_id', '!=', False)]</field>
    </record>

    <record id="action_medilab_test_report_to_deliver" model="ir.actions.act_window">
        <field name="name">Reports to Deliver</field>
        <field name="res_model">medilab.test.report</field>
        <field name="path">reports-to-deliver</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_medilab_test_report_delivery_list" />
        <field name="domain">[('status', '=', 'issued'), ('delivered_at', '=', False), ('attachment_id', '!=', False)]</field>
    </record>
</odoo>
