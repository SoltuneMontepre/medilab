<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_test_result_list" model="ir.ui.view">
        <field name="name">medilab.test.result.list</field>
        <field name="model">medilab.test.result</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="not is_reported or is_replaced">
                <field name="sample_id" width="200px" />
                <field name="parameter_id" />
                <field name="version" optional="show" />
                <field name="is_replaced" column_invisible="1" />
                <field name="value_display" />
                <field name="unit_id" />
                <field name="conclusion" />
                <field name="is_reported" optional="show" />
                <field name="entered_by_id" />
                <field name="entered_at" optional="show" />
                <field
                    name="status"
                    widget="badge"
                    decoration-warning="status == 'requested'"
                    decoration-success="status == 'approved'"
                    decoration-danger="status == 'rejected'"
                />
            </list>
        </field>
    </record>

    <record id="view_medilab_test_result_form" model="ir.ui.view">
        <field name="name">medilab.test.result.form</field>
        <field name="model">medilab.test.result</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0">
                <header>
                    <button
                        name="action_sign"
                        type="object"
                        string="Send for Approval"
                        class="btn-primary"
                        invisible="status != 'none' or not is_reported or not approval_can_sign"
                    />
                    <button
                        name="action_sign"
                        type="object"
                        string="Approve"
                        class="btn-success"
                        invisible="status != 'requested' or not approval_can_sign"
                    />
                    <button
                        name="%(action_medilab_test_result_reject)d"
                        type="action"
                        string="Reject"
                        class="btn-danger"
                        context="{'default_result_id': id}"
                        invisible="status != 'requested' or not approval_can_reject"
                    />
                    <button
                        name="action_withdraw"
                        type="object"
                        string="Withdraw Signature"
                        class="btn-secondary"
                        invisible="not approval_can_withdraw"
                    />
                    <button
                        name="%(action_medilab_change_request_raise)d"
                        type="action"
                        string="Request a Change"
                        context="{'default_document_model': 'medilab.test.result', 'default_document_id': id}"
                        invisible="is_replaced or not (status == 'approved' or (status == 'rejected' and replaces_id))"
                        groups="sol_laboratory.group_permission_test_result_edit_all"
                    />
                    <field name="status" widget="statusbar" statusbar_visible="none,requested,approved" />
                </header>
                <sheet>
                    <div class="oe_title o_test_result_head" invisible="not id">
                        <h1><field name="display_name" /></h1>
                        <div class="o_test_result_meta">
                            <span class="o_test_result_chips">
                                <span class="o_test_result_chip">
                                    <span>Version</span>
                                    <field name="version" />
                                </span>
                                <field name="is_reported" invisible="1" />
                                <span class="o_test_result_chip o_chip_success" invisible="not is_reported">
                                    Reported Result
                                </span>
                                <field name="is_replaced" invisible="1" />
                                <span class="o_test_result_chip" invisible="not is_replaced">Replaced</span>
                            </span>
                            <span class="o_test_result_entered">
                                <field name="entered_by_id" class="o_field_inline" />
                                <field name="entered_at" class="o_field_inline" />
                            </span>
                            <span class="o_test_result_related">
                                <field name="sample_test_id" class="o_field_inline" readonly="1" force_save="1" />
                                <field name="replaces_id" class="o_field_inline" invisible="not replaces_id" />
                            </span>
                        </div>
                    </div>
                    <div class="o_test_result_card o_test_result_entry">
                        <h2 class="o_test_result_card_title">Result</h2>
                        <div class="o_test_result_inputs">
                            <div class="o_test_result_value" invisible="value_text">
                                <label for="value" />
                                <field name="value" readonly="status != 'none'" />
                            </div>
                            <div class="o_test_result_unit">
                                <label for="unit_id" />
                                <field name="unit_id" />
                            </div>
                            <div class="o_test_result_decimals" invisible="value_text">
                                <label for="value_decimals" />
                                <field name="value_decimals" readonly="status != 'none'" />
                            </div>
                        </div>
                        <div class="o_test_result_text">
                            <label for="value_text" />
                            <field name="value_text" readonly="status != 'none'" />
                        </div>
                        <div
                            class="alert alert-info mb-0 d-flex flex-wrap align-items-center gap-2"
                            role="status"
                            invisible="status != 'none' or value_text or not value_suggestion"
                        >
                            <span>Below the detection or quantification limit, report it as</span>
                            <field name="value_suggestion" class="fw-bold" />
                            <button
                                name="action_use_suggestion"
                                type="object"
                                string="Use This Text"
                                class="btn-secondary btn-sm"
                            />
                        </div>
                        <div class="o_test_result_display" invisible="not id">
                            <label for="value_display" />
                            <field name="value_display" />
                        </div>
                        <div class="alert alert-warning mb-0" role="alert" invisible="not check_preview">
                            <span>Check this value before sending it; you may still send it.</span>
                            <field name="check_preview" class="d-block" />
                        </div>
                        <div class="alert alert-warning mb-0" role="alert" invisible="not check_warning">
                            <span>Sent with a warning:</span>
                            <field name="check_warning" class="d-block" />
                        </div>
                        <div class="o_test_result_conclusion" invisible="not regulation_id or not comparison_requested">
                            <label for="conclusion" />
                            <field
                                name="conclusion"
                                widget="radio"
                                options="{'horizontal': true}"
                                readonly="status != 'none'"
                            />
                        </div>
                    </div>
                    <div class="o_test_result_cards">
                        <div class="o_test_result_card">
                            <h2 class="o_test_result_card_title">Measurement</h2>
                            <group>
                                <field name="parameter_method_id" />
                                <field name="sample_type_id" />
                                <field name="subcontractor_id" invisible="not subcontractor_id" />
                                <field name="machine_id" invisible="subcontractor_id" />
                                <field name="started_at" readonly="status != 'none'" />
                                <field name="lod" widget="nullable_float" />
                                <field name="loq" widget="nullable_float" />
                            </group>
                        </div>
                        <div class="o_test_result_card" invisible="not regulation_id">
                            <h2 class="o_test_result_card_title">Regulation</h2>
                            <group>
                                <field name="regulation_id" />
                                <div class="text-muted" colspan="2" invisible="comparison_requested">
                                    The regulation sets no limit for this parameter, so it is outside the requested
                                    comparison and takes no conclusion.
                                </div>
                                <field name="limit_min" invisible="not limit_min_set" />
                                <field name="limit_max" invisible="not limit_max_set" />
                                <field name="limit_text" invisible="not limit_text" />
                                <field name="limit_unit_id" invisible="not limit_unit_id" />
                                <div
                                    class="alert alert-warning mb-0"
                                    role="alert"
                                    colspan="2"
                                    invisible="not limit_missing"
                                >
                                    The regulation sets no limit for this parameter on the sample's type, so the result
                                    can only be assessed as insufficient basis.
                                </div>
                            </group>
                        </div>
                    </div>
                    <field name="comparison_requested" invisible="1" />
                    <field name="limit_min_set" invisible="1" />
                    <field name="limit_max_set" invisible="1" />
                    <field name="limit_missing" invisible="1" />
                    <field name="approval_can_sign" invisible="1" />
                    <field name="approval_can_reject" invisible="1" />
                    <field name="approval_can_withdraw" invisible="1" />
                    <notebook groups="sol_laboratory.group_permission_signature_read_all" invisible="not id">
                        <page string="Signatures" name="signatures">
                            <field name="signature_ids" mode="list" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_test_result_search" model="ir.ui.view">
        <field name="name">medilab.test.result.search</field>
        <field name="model">medilab.test.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="sample_id" />
                <field name="parameter_id" />
                <field name="entered_by_id" />
                <filter name="awaiting_approval" string="Awaiting Approval" domain="[('status', '=', 'requested')]" />
                <filter name="rejected" string="Rejected" domain="[('status', '=', 'rejected')]" />
                <filter name="mine" string="Entered by Me" domain="[('entered_by_id', '=', uid)]" />
                <group>
                    <filter name="group_sample_test" string="Sample Test" context="{'group_by': 'sample_test_id'}" />
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_test_result" model="ir.actions.act_window">
        <field name="name">Test Results</field>
        <field name="res_model">medilab.test.result</field>
        <field name="path">test-results</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
