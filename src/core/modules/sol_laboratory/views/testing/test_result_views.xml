<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_test_result_list" model="ir.ui.view">
        <field name="name">medilab.test.result.list</field>
        <field name="model">medilab.test.result</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="not is_reported">
                <field name="sample_id" />
                <field name="parameter_id" />
                <field name="attempt" />
                <field name="value_display" />
                <field name="unit_id" />
                <field name="conclusion" />
                <field name="is_reported" optional="show" />
                <field name="entered_by_id" />
                <field name="entered_at" optional="show" />
                <field
                    name="status"
                    widget="badge"
                    decoration-warning="status == 'requested'"
                    decoration-success="status == 'approved'"
                    decoration-danger="status == 'rejected'"
                />
            </list>
        </field>
    </record>

    <record id="view_medilab_test_result_form" model="ir.ui.view">
        <field name="name">medilab.test.result.form</field>
        <field name="model">medilab.test.result</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0">
                <header>
                    <button
                        name="action_sign"
                        type="object"
                        string="Send for Approval"
                        class="btn-primary"
                        invisible="status != 'none' or not is_reported or not approval_can_sign"
                    />
                    <button
                        name="action_sign"
                        type="object"
                        string="Approve"
                        class="btn-success"
                        invisible="status != 'requested' or not approval_can_sign"
                    />
                    <button
                        name="%(action_medilab_test_result_reject)d"
                        type="action"
                        string="Reject"
                        class="btn-danger"
                        context="{'default_result_id': id}"
                        invisible="status != 'requested' or not approval_can_reject"
                    />
                    <button
                        name="action_withdraw"
                        type="object"
                        string="Withdraw Signature"
                        class="btn-secondary"
                        invisible="not approval_can_withdraw"
                    />
                    <field name="status" widget="statusbar" statusbar_visible="none,requested,approved" />
                </header>
                <sheet>
                    <div class="oe_title" invisible="not id">
                        <h1><field name="display_name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sample_test_id" readonly="1" force_save="1" />
                            <field name="attempt" invisible="not id" />
                            <field name="is_reported" invisible="not id" />
                            <field name="entered_by_id" invisible="not id" />
                            <field name="entered_at" invisible="not id" />
                        </group>
                        <group>
                            <field name="machine_id" readonly="status != 'none'" />
                            <field name="started_at" readonly="status != 'none'" />
                        </group>
                    </group>
                    <group>
                        <group string="Result">
                            <field name="value" invisible="value_text" readonly="status != 'none'" />
                            <field name="value_decimals" invisible="value_text" readonly="status != 'none'" />
                            <field name="value_text" readonly="status != 'none'" />
                            <field name="unit_id" />
                            <field name="value_display" invisible="not id" />
                        </group>
                        <group string="Regulation" invisible="not regulation_id">
                            <field name="regulation_id" />
                            <field name="limit_min_set" invisible="1" />
                            <field name="limit_max_set" invisible="1" />
                            <field name="limit_min" invisible="not limit_min_set" />
                            <field name="limit_max" invisible="not limit_max_set" />
                            <field name="limit_text" invisible="not limit_text" />
                            <field name="limit_unit_id" invisible="not limit_unit_id" />
                            <field name="conclusion" widget="radio" readonly="status != 'none'" />
                        </group>
                    </group>
                    <field name="approval_can_sign" invisible="1" />
                    <field name="approval_can_reject" invisible="1" />
                    <field name="approval_can_withdraw" invisible="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_test_result_search" model="ir.ui.view">
        <field name="name">medilab.test.result.search</field>
        <field name="model">medilab.test.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="sample_id" />
                <field name="parameter_id" />
                <field name="entered_by_id" />
                <filter name="awaiting_approval" string="Awaiting Approval" domain="[('status', '=', 'requested')]" />
                <filter name="rejected" string="Rejected" domain="[('status', '=', 'rejected')]" />
                <filter name="mine" string="Entered by Me" domain="[('entered_by_id', '=', uid)]" />
                <group>
                    <filter name="group_sample_test" string="Sample Test" context="{'group_by': 'sample_test_id'}" />
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_test_result" model="ir.actions.act_window">
        <field name="name">Test Results</field>
        <field name="res_model">medilab.test.result</field>
        <field name="path">test-results</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
