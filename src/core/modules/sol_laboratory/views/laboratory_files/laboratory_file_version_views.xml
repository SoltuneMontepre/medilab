<?xml version="1.0" encoding="utf-8"?>
<!-- Versions never change; the back office reads them. -->
<odoo>
    <record id="view_medilab_laboratory_file_version_list" model="ir.ui.view">
        <field name="name">medilab.laboratory.file.version.list</field>
        <field name="model">medilab.laboratory.file.version</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" duplicate="0" decoration-warning="source == 'conflict'">
                <field name="file_id" />
                <field name="number" />
                <field name="source" widget="badge" decoration-warning="source == 'conflict'" />
                <field name="user_id" widget="many2one_avatar_user" />
                <field name="device_id" optional="show" />
                <field name="size" />
                <field name="create_date" string="Saved On" />
                <field name="sha256" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_medilab_laboratory_file_version_form" model="ir.ui.view">
        <field name="name">medilab.laboratory.file.version.form</field>
        <field name="model">medilab.laboratory.file.version</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <button name="action_download" type="object" string="Download" icon="fa-download" />
                    <field name="source" widget="badge" decoration-warning="source == 'conflict'" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" /></h1>
                    </div>
                    <group>
                        <group name="version">
                            <field name="file_id" />
                            <field name="number" />
                            <field name="parent_version_id" invisible="not parent_version_id" />
                            <field name="restored_from_id" invisible="not restored_from_id" />
                        </group>
                        <group name="origin">
                            <field name="user_id" widget="many2one_avatar_user" />
                            <field name="device_id" invisible="not device_id" />
                            <field name="create_date" string="Saved On" />
                        </group>
                    </group>
                    <group name="content">
                        <field name="size" />
                        <field name="sha256" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_laboratory_file_version_search" model="ir.ui.view">
        <field name="name">medilab.laboratory.file.version.search</field>
        <field name="model">medilab.laboratory.file.version</field>
        <field name="arch" type="xml">
            <search>
                <field name="file_id" />
                <field name="user_id" />
                <field name="device_id" />
                <field name="sha256" />
                <filter name="conflicts" string="Conflicts" domain="[('source', '=', 'conflict')]" />
                <filter name="restored" string="Restored" domain="[('source', '=', 'restored')]" />
                <filter name="edited_online" string="Edited Online" domain="[('source', '=', 'edited_online')]" />
                <separator />
                <filter name="group_by_file" string="File" context="{'group_by': 'file_id'}" />
                <filter name="group_by_user" string="Saved By" context="{'group_by': 'user_id'}" />
            </search>
        </field>
    </record>

    <record id="action_medilab_laboratory_file_version" model="ir.actions.act_window">
        <field name="name">File Versions</field>
        <field name="res_model">medilab.laboratory.file.version</field>
        <field name="path">laboratory-file-versions</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
