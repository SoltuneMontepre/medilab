<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_laboratory_folder_list" model="ir.ui.view">
        <field name="name">medilab.laboratory.folder.list</field>
        <field name="model">medilab.laboratory.folder</field>
        <field name="arch" type="xml">
            <list duplicate="0" delete="0" decoration-muted="status == 'archived'">
                <field name="name" />
                <field name="status" widget="badge" decoration-danger="status == 'turned_off'" />
                <field name="owner_id" widget="many2one_avatar_user" />
                <field name="sync_mode" />
                <field name="sample_id" optional="show" />
                <field name="category" optional="show" />
                <field name="retention_until" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_medilab_laboratory_folder_form" model="ir.ui.view">
        <field name="name">medilab.laboratory.folder.form</field>
        <field name="model">medilab.laboratory.folder</field>
        <field name="arch" type="xml">
            <form duplicate="0" delete="0">
                <header>
                    <button
                        name="action_turn_off"
                        type="object"
                        string="Turn Off"
                        class="btn-danger"
                        invisible="status != 'in_use'"
                        groups="sol_laboratory.group_permission_laboratory_folder_edit_all"
                        confirm="Nobody can upload to the folder until it is turned on again; its members still read it. Turn it off?"
                    />
                    <button
                        name="action_turn_on"
                        type="object"
                        string="Turn On"
                        class="btn-primary"
                        invisible="status != 'turned_off'"
                        groups="sol_laboratory.group_permission_laboratory_folder_edit_all"
                    />
                    <button
                        name="action_archive_folder"
                        type="object"
                        string="Archive"
                        class="btn-secondary"
                        invisible="status == 'archived'"
                        groups="sol_laboratory.group_permission_laboratory_folder_edit_all"
                        confirm="The folder becomes read only for good and keeps its files until its retention date. Only its members can still be removed. Archive it?"
                    />
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="status == 'archived'" /></h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="owner_id"
                                widget="many2one_avatar_user"
                                readonly="status == 'archived'"
                                groups="sol_laboratory.group_permission_laboratory_folder_edit_all"
                            />
                            <field
                                name="owner_id"
                                widget="many2one_avatar_user"
                                readonly="1"
                                groups="!sol_laboratory.group_permission_laboratory_folder_edit_all"
                            />
                            <field name="root" />
                            <field name="sync_mode" readonly="status == 'archived'" />
                        </group>
                        <group>
                            <field name="sample_id" invisible="not sample_id" />
                            <field name="category" invisible="not sample_id" />
                            <field name="archived_at" invisible="not archived_at" />
                            <field name="retention_until" invisible="not archived_at" />
                            <field name="created_by_device_id" invisible="not created_by_device_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Members" name="members">
                            <field name="member_ids" readonly="status == 'archived'">
                                <list editable="bottom">
                                    <field name="user_id" widget="many2one_avatar_user" />
                                    <field name="role" readonly="1" />
                                </list>
                            </field>
                        </page>
                        <page string="Sync Rules" name="rules">
                            <field name="rule_ids" readonly="status == 'archived'">
                                <list editable="bottom">
                                    <field name="kind" />
                                    <field name="pattern" />
                                    <field name="recursive" />
                                    <field name="enabled" widget="boolean_toggle" />
                                </list>
                            </field>
                        </page>
                        <page string="Files" name="files">
                            <field name="file_ids" readonly="1">
                                <list>
                                    <field name="path" />
                                    <field name="current_number" />
                                    <field name="current_size" />
                                    <field name="current_user_id" widget="many2one_avatar_user" />
                                    <field name="write_date" string="Last Saved" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_laboratory_folder_search" model="ir.ui.view">
        <field name="name">medilab.laboratory.folder.search</field>
        <field name="model">medilab.laboratory.folder</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="owner_id" />
                <field name="member_ids" string="Member" filter_domain="[('member_ids.user_id', 'ilike', self)]" />
                <field name="sample_id" />
                <filter name="mine" string="My Folders" domain="[('owner_id', '=', uid)]" />
                <filter name="shared_with_me" string="Shared with Me" domain="[('owner_id', '!=', uid), ('member_ids.user_id', '=', uid)]" />
                <separator />
                <filter name="in_use" string="In Use" domain="[('archived_at', '=', False), ('enabled', '=', True)]" />
                <filter name="turned_off" string="Turned Off" domain="[('archived_at', '=', False), ('enabled', '=', False)]" />
                <filter name="archived" string="Archived" domain="[('archived_at', '!=', False)]" />
                <separator />
                <filter name="group_by_owner" string="Owner" context="{'group_by': 'owner_id'}" />
                <filter name="group_by_sync_mode" string="Sync Mode" context="{'group_by': 'sync_mode'}" />
            </search>
        </field>
    </record>

    <record id="action_medilab_laboratory_folder" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">medilab.laboratory.folder</field>
        <field name="path">laboratory-folders</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
