<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_laboratory_files" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sol_laboratory.laboratory_files</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sol_laboratory']" position="inside">
                <block title="Laboratory Files" name="laboratory_files_setting_container">
                    <setting id="laboratory_folder_retention_setting">
                        <field name="laboratory_folder_retention_days" class="o_light_label" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
