<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_laboratory_uploads" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sol_laboratory.laboratory_uploads</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="res_config_settings_view_form_laboratory_files" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='laboratory_files_setting_container']" position="inside">
                <setting id="laboratory_upload_setting">
                    <field name="laboratory_upload_hours" class="o_light_label" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
