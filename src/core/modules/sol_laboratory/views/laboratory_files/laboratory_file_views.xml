<?xml version="1.0" encoding="utf-8"?>
<!-- Files are made by saving them from Medilab Sync or online; the back office reads them. -->
<odoo>
    <record id="view_medilab_laboratory_file_list" model="ir.ui.view">
        <field name="name">medilab.laboratory.file.list</field>
        <field name="model">medilab.laboratory.file</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" duplicate="0">
                <field name="path" />
                <field name="folder_id" />
                <field name="current_number" />
                <field name="current_size" />
                <field name="current_user_id" widget="many2one_avatar_user" optional="show" />
                <field name="write_date" string="Last Saved" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_medilab_laboratory_file_form" model="ir.ui.view">
        <field name="name">medilab.laboratory.file.form</field>
        <field name="model">medilab.laboratory.file</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="path" /></h1>
                    </div>
                    <group>
                        <group name="file">
                            <field name="folder_id" />
                            <field name="current_number" />
                        </group>
                        <group name="current_version">
                            <field name="current_size" />
                            <field name="current_user_id" widget="many2one_avatar_user" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Versions" name="versions">
                            <field name="version_ids">
                                <list decoration-warning="source == 'conflict'">
                                    <field name="number" />
                                    <field name="source" widget="badge" decoration-warning="source == 'conflict'" />
                                    <field name="user_id" widget="many2one_avatar_user" />
                                    <field name="device_id" />
                                    <field name="size" />
                                    <field name="create_date" string="Saved On" />
                                    <field name="sha256" optional="hide" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_laboratory_file_search" model="ir.ui.view">
        <field name="name">medilab.laboratory.file.search</field>
        <field name="model">medilab.laboratory.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="path" />
                <field name="folder_id" />
                <field name="current_user_id" />
                <filter name="group_by_folder" string="Folder" context="{'group_by': 'folder_id'}" />
            </search>
        </field>
    </record>

    <record id="action_medilab_laboratory_file" model="ir.actions.act_window">
        <field name="name">Files</field>
        <field name="res_model">medilab.laboratory.file</field>
        <field name="path">laboratory-files</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
