<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_committed_date_change_form" model="ir.ui.view">
        <field name="name">medilab.committed.date.change.form</field>
        <field name="model">medilab.committed.date.change</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Change the expected return date only after the customer agreed to the new date.</p>
                <group>
                    <field name="request_id" readonly="1" force_save="1" />
                    <field name="current_date" />
                    <field name="new_date" />
                    <field name="confirmation" placeholder="Such as the email or call the customer agreed in" />
                </group>
                <footer>
                    <button name="action_record" type="object" string="Change Return Date" class="btn-primary" />
                    <button special="cancel" string="Discard" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_committed_date_change" model="ir.actions.act_window">
        <field name="name">Change Return Date</field>
        <field name="res_model">medilab.committed.date.change</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
