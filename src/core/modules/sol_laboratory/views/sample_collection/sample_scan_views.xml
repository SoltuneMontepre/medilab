<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_sample_scan_form" model="ir.ui.view">
        <field name="name">medilab.sample.scan.form</field>
        <field name="model">medilab.sample.scan</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="code" placeholder="PTN.2026.0001" />
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Receive" class="btn-success" />
                    <button special="cancel" string="Discard" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_sample_scan" model="ir.actions.act_window">
        <field name="name">Scan Label</field>
        <field name="res_model">medilab.sample.scan</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
