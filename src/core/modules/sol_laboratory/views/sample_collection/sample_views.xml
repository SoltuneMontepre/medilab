<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_sample_list" model="ir.ui.view">
        <field name="name">medilab.sample.list</field>
        <field name="model">medilab.sample</field>
        <field name="arch" type="xml">
            <list duplicate="0" decoration-muted="status in ('cancelled', 'disposed', 'returned')">
                <field name="code" />
                <field name="request_id" />
                <field name="customer_sample_name" />
                <field name="sample_type_id" />
                <field name="physical_state" optional="show" />
                <field name="regulation_id" optional="show" />
                <field
                    name="status"
                    widget="badge"
                    decoration-info="status in ('received', 'testing')"
                    decoration-warning="status in ('expected', 'on_hold', 'awaiting_approval')"
                    decoration-success="status in ('completed', 'reported', 'retained')"
                    decoration-danger="status in ('rejected', 'cancelled')"
                />
            </list>
        </field>
    </record>

    <record id="view_medilab_sample_form" model="ir.ui.view">
        <field name="name">medilab.sample.form</field>
        <field name="model">medilab.sample</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <!-- Staff decide the condition first; its button receives, rejects or holds the sample. -->
                    <button
                        name="action_receive_entered"
                        type="object"
                        string="Receive"
                        class="btn-primary"
                        invisible="status != 'expected' or condition not in (False, 'good')"
                        groups="sol_laboratory.group_permission_sample_edit_all,sol_laboratory.group_permission_sample_handover_create_all"
                    />
                    <button
                        name="action_receive_entered"
                        type="object"
                        string="Reject"
                        class="btn-danger"
                        invisible="status != 'expected' or condition != 'unusable'"
                        groups="sol_laboratory.group_permission_sample_edit_all,sol_laboratory.group_permission_sample_handover_create_all"
                    />
                    <button
                        name="action_receive_entered"
                        type="object"
                        string="Put On Hold"
                        class="btn-secondary"
                        invisible="status != 'expected' or condition != 'insufficient'"
                        groups="sol_laboratory.group_permission_sample_edit_all,sol_laboratory.group_permission_sample_handover_create_all"
                    />
                    <button
                        name="action_receive_more_entered"
                        type="object"
                        string="Receive More"
                        class="btn-primary"
                        invisible="status != 'on_hold'"
                        groups="sol_laboratory.group_permission_sample_edit_all,sol_laboratory.group_permission_sample_handover_create_all"
                    />
                    <button
                        name="action_request_recollection"
                        type="object"
                        string="Collect Again"
                        class="btn-primary"
                        invisible="not can_collect_again"
                        groups="sol_laboratory.group_permission_sample_edit_all"
                    />
                    <button
                        name="action_open_return"
                        type="object"
                        string="Return"
                        class="btn-primary"
                        invisible="not returnable"
                        groups="sol_laboratory.group_permission_sample_return_create_all"
                    />
                    <button
                        name="action_dispose"
                        type="object"
                        string="Dispose"
                        class="btn-danger"
                        invisible="status not in ('reported', 'retained', 'cancelled')"
                        confirm="Dispose of this sample? This cannot be undone."
                        groups="sol_laboratory.group_permission_sample_edit_all"
                    />
                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="expected,received,testing,awaiting_approval,completed,reported"
                    />
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="status != 'expected'">
                        Enter the physical state, the amount received and the condition under Receipt, then press Receive.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not regulation_notice">
                        <field name="regulation_notice" />
                    </div>
                    <div class="oe_title">
                        <label for="code" />
                        <h1><field name="code" required="0" placeholder="Given when the sample is saved" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="agreed_on_order" invisible="1" />
                            <field name="request_id" readonly="agreed_on_order" />
                            <field name="customer_sample_name" readonly="agreed_on_order" />
                            <field name="sample_type_id" readonly="agreed_on_order" />
                            <field name="physical_state" />
                            <field
                                name="regulation_id"
                                readonly="agreed_on_order"
                                domain="[
                                    ('sample_type_ids', 'parent_of', sample_type_id),
                                    '|', ('valid_from', '=', False), ('valid_from', '&lt;=', context_today().strftime('%Y-%m-%d')),
                                    '|', ('valid_until', '=', False), ('valid_until', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                ]"
                            />
                        </group>
                        <group>
                            <field
                                name="storage_location"
                                readonly="status not in ('expected', 'on_hold')"
                                invisible="not storage_location and status not in ('expected', 'on_hold')"
                            />
                            <field
                                name="sampling_location_id"
                                readonly="status != 'expected'"
                                invisible="not sampling_location_id and status != 'expected'"
                            />
                            <field name="received_at" invisible="not received_at" />
                        </group>
                    </group>
                    <!-- Receipt is entered inline while reception works on the sample, then kept in its own page. -->
                    <group string="Receipt" invisible="status not in ('expected', 'on_hold')">
                        <group>
                            <field name="received_quantity" />
                            <field name="condition" readonly="status != 'expected'" />
                            <field name="condition_note" readonly="status != 'expected'" />
                            <field name="sample_form" />
                            <field name="container_type" />
                        </group>
                        <group>
                            <field name="received_by_id" />
                            <field name="recollection_requested_at" />
                            <field name="recollection_requested_by_id" />
                        </group>
                    </group>
                    <group
                        string="Retention"
                        invisible="status not in ('reported', 'retained', 'cancelled', 'disposed', 'returned')"
                    >
                        <group>
                            <field name="retained_until" />
                            <field name="disposal_note" readonly="status == 'disposed'" />
                        </group>
                        <group>
                            <field name="disposed_at" />
                            <field name="disposed_by_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Tests" name="tests">
                            <field name="test_ids" readonly="agreed_on_order">
                                <list editable="bottom" decoration-bf="can_enter_result">
                                    <field name="parameter_id" />
                                    <field name="parameter_method_id" readonly="1" optional="show" />
                                    <field name="quantity" />
                                    <field name="due_date" readonly="1" decoration-danger="priority == 'urgent'" />
                                    <field name="priority" column_invisible="1" />
                                    <field name="is_accredited" optional="show" />
                                    <field
                                        name="status"
                                        widget="badge"
                                        decoration-warning="status in ('waiting', 'result_entered')"
                                        decoration-info="status in ('assigned', 'testing', 'outsourced')"
                                        decoration-success="status == 'approved'"
                                        decoration-danger="status == 'cancelled'"
                                    />
                                    <field name="can_claim" column_invisible="1" />
                                    <field name="can_enter_result" column_invisible="1" />
                                    <button
                                        name="action_claim_testing_task"
                                        type="object"
                                        string="Claim"
                                        invisible="not can_claim"
                                    />
                                    <button
                                        name="action_enter_result"
                                        type="object"
                                        string="Enter Result"
                                        class="btn-primary"
                                        invisible="not can_enter_result"
                                        groups="sol_laboratory.group_permission_test_result_create_all"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Receipt" name="receipt" invisible="status in ('expected', 'on_hold')">
                            <group>
                                <group>
                                    <field name="received_quantity" readonly="1" />
                                    <field name="condition" readonly="1" />
                                    <field name="condition_note" readonly="1" />
                                    <field name="sample_form" />
                                    <field name="container_type" />
                                </group>
                                <group>
                                    <field name="received_by_id" />
                                    <field name="recollection_requested_at" />
                                    <field name="recollection_requested_by_id" />
                                    <field
                                        name="retained_until"
                                        invisible="status in ('reported', 'retained', 'cancelled', 'disposed', 'returned')"
                                    />
                                </group>
                            </group>
                        </page>
                        <page
                            string="Expected Sampling"
                            name="expected_sampling"
                            groups="sol_laboratory.group_permission_expected_sampling_read_all"
                            invisible="not expected_sampling_ids"
                        >
                            <group>
                                <field name="expected_sample_count" />
                            </group>
                            <field name="expected_sampling_ids" readonly="1">
                                <list decoration-warning="not group_number">
                                    <field name="group_number" />
                                    <field name="objects" />
                                    <field name="container_type" />
                                    <field name="preservation" />
                                    <field name="amount" invisible="not unit_id" />
                                    <field name="unit_id" />
                                    <field name="method_ids" widget="many2many_tags" />
                                </list>
                            </field>
                        </page>
                        <page string="Handovers" name="handovers">
                            <field name="handover_ids">
                                <list editable="bottom">
                                    <field name="department_id" />
                                    <field name="received_at" />
                                    <field name="received_by_id" />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Handover Records"
                            name="handover_records"
                            invisible="not handover_line_ids"
                            groups="sol_laboratory.group_permission_handover_record_sample_read_all"
                        >
                            <field name="handover_line_ids" readonly="1">
                                <list>
                                    <field name="record_id" />
                                    <field name="expected_count" width="[120]" />
                                    <field name="actual_count" width="[120]" />
                                    <field name="extra_count" width="[120]" />
                                    <field name="missing_count" width="[120]" decoration-warning="missing_count" />
                                    <field name="quantity" />
                                    <field name="excess_material" />
                                    <field name="condition" />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Returns"
                            name="returns"
                            invisible="not return_ids"
                            groups="sol_laboratory.group_permission_sample_return_read_all"
                        >
                            <field name="return_ids" readonly="1">
                                <list>
                                    <field name="kind" />
                                    <field name="description" />
                                    <field name="returned_at" />
                                    <field name="returned_by_id" />
                                    <field name="returned_to_name" />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Photos"
                            name="photos"
                            groups="sol_laboratory.group_permission_test_request_read_all"
                        >
                            <field name="photo_ids" widget="many2many_binary" />
                        </page>
                        <page string="Note" name="note">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
                <div class="o_audit_aside" groups="sol_laboratory.group_permission_sample_read_all">
                    <h3>Audit Log</h3>
                    <field name="log_ids" mode="kanban" readonly="1">
                        <kanban>
                            <templates>
                                <t t-name="card" class="flex-row">
                                    <aside>
                                        <field name="user_id" widget="many2one_avatar_user" invisible="not user_id" />
                                        <span class="o_audit_system_avatar" invisible="user_id">
                                            <i class="oi" data-icon="settings" />
                                        </span>
                                    </aside>
                                    <main>
                                        <div class="o_audit_entry_head">
                                            <field name="user_id" class="fw-semibold text-truncate" invisible="not user_id" />
                                            <field name="source" class="fw-semibold" invisible="user_id" />
                                            <field name="create_date" class="ms-auto text-muted text-nowrap" />
                                        </div>
                                        <div class="text-muted">
                                            <field name="action" />
                                            ·
                                            <field name="document_model" />
                                        </div>
                                        <field name="change_ids" widget="many2many_tags" />
                                        <field name="note" class="text-muted" />
                                    </main>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </div>
            </form>
        </field>
    </record>

    <record id="view_medilab_sample_search" model="ir.ui.view">
        <field name="name">medilab.sample.search</field>
        <field name="model">medilab.sample</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="request_id" />
                <field name="customer_sample_name" />
                <field name="sample_type_id" />
                <filter name="expected" string="Expected" domain="[('status', '=', 'expected')]" />
                <filter name="on_hold" string="On Hold" domain="[('status', '=', 'on_hold')]" />
                <filter name="rejected" string="Rejected" domain="[('status', '=', 'rejected')]" />
                <filter name="retained" string="Retained" domain="[('status', '=', 'retained')]" />
                <filter name="returned" string="Returned" domain="[('status', '=', 'returned')]" />
                <filter
                    name="open"
                    string="Open"
                    domain="[('status', 'not in', ('rejected', 'reported', 'retained', 'disposed', 'returned', 'cancelled'))]"
                />
                <group>
                    <filter name="group_by_request" string="Test Request" context="{'group_by': 'request_id'}" />
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_sample" model="ir.actions.act_window">
        <field name="name">Samples</field>
        <field name="res_model">medilab.sample</field>
        <field name="path">samples</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
