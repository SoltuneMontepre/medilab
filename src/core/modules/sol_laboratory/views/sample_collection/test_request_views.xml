<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_test_request_list" model="ir.ui.view">
        <field name="name">medilab.test.request.list</field>
        <field name="model">medilab.test.request</field>
        <field name="arch" type="xml">
            <list duplicate="0" decoration-muted="status == 'cancelled'">
                <field name="code" />
                <field name="customer_id" />
                <field name="request_date" />
                <field name="expected_date" />
                <field name="report_language" optional="hide" />
                <field name="delivery_method" optional="hide" />
                <field
                    name="status"
                    widget="badge"
                    decoration-info="status in ('confirmed', 'paid', 'sample_received', 'testing')"
                    decoration-warning="status == 'awaiting_approval'"
                    decoration-success="status in ('completed', 'reported')"
                    decoration-danger="status == 'cancelled'"
                />
            </list>
        </field>
    </record>

    <record id="view_medilab_test_request_form" model="ir.ui.view">
        <field name="name">medilab.test.request.form</field>
        <field name="model">medilab.test.request</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-success"
                        invisible="status != 'draft'"
                        groups="sol_laboratory.group_permission_test_request_edit_all"
                    />
                    <button
                        name="action_print_labels"
                        type="object"
                        string="Print Labels"
                        class="btn-secondary"
                        invisible="not sample_ids"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-danger"
                        invisible="status not in ('draft', 'confirmed', 'paid', 'sample_received', 'testing')"
                        confirm="Cancel this test request with its samples and sample tests?"
                        groups="sol_laboratory.group_permission_test_request_edit_all"
                    />
                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,sample_received,testing,awaiting_approval,completed,reported"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="code" />
                        <h1><field name="code" required="0" placeholder="Filled from the sequence when left empty" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" />
                            <field name="request_date" />
                            <field name="expected_date" />
                        </group>
                        <group string="Report">
                            <field name="report_language" />
                            <field name="delivery_method" />
                            <field name="delivery_note" invisible="delivery_method == 'in_person'" />
                            <field name="report_recipient_id" placeholder="The customer's contact" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Samples" name="samples">
                            <field name="sample_ids">
                                <list>
                                    <field name="code" required="0" />
                                    <field name="customer_sample_name" />
                                    <field name="sample_type_id" />
                                    <field name="physical_state" />
                                    <field name="regulation_id" />
                                    <field name="test_ids" widget="many2many_tags" string="Parameters" />
                                    <field name="status" widget="badge" />
                                </list>
                            </field>
                        </page>
                        <page string="Cancelled Tests" name="cancelled_tests" invisible="not cancelled_test_ids">
                            <field name="cancelled_test_ids">
                                <list>
                                    <field name="sample_id" />
                                    <field name="parameter_id" />
                                    <field name="cancel_reason" />
                                    <field name="cancelled_by_id" />
                                    <field name="cancelled_at" />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Test Reports"
                            name="reports"
                            invisible="not report_ids"
                            groups="sol_laboratory.group_permission_test_report_read_all"
                        >
                            <field name="report_ids">
                                <list>
                                    <field name="display_name" string="Report Number" />
                                    <field name="version" />
                                    <field name="language" />
                                    <field name="status" />
                                    <field name="issued_at" />
                                    <field name="delivered_at" />
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_test_request_search" model="ir.ui.view">
        <field name="name">medilab.test.request.search</field>
        <field name="model">medilab.test.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="customer_id" />
                <filter name="open" string="Open" domain="[('status', 'not in', ('reported', 'cancelled'))]" />
                <filter name="cancelled" string="Cancelled" domain="[('status', '=', 'cancelled')]" />
                <group>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}" />
                    <filter name="group_by_customer" string="Customer" context="{'group_by': 'customer_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_test_request" model="ir.actions.act_window">
        <field name="name">Test Requests</field>
        <field name="res_model">medilab.test.request</field>
        <field name="path">test-requests</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
