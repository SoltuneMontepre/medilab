<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_test_request_list" model="ir.ui.view">
        <field name="name">medilab.test.request.list</field>
        <field name="model">medilab.test.request</field>
        <field name="arch" type="xml">
            <list duplicate="0" default_order="priority desc, request_date desc, id desc" decoration-bf="priority" decoration-muted="status == 'cancelled'">
                <field name="priority" column_invisible="1" />
                <field name="code" />
                <field
                    name="priority_badge"
                    widget="badge"
                    class="o_medilab_priority_badge"
                    decoration-danger="priority_badge == 'priority'"
                    decoration-muted="priority_badge == 'standard'"
                    optional="show"
                />
                <field name="customer_id" />
                <field name="request_date" />
                <field name="requested_date" optional="hide" />
                <field name="committed_date" />
                <field name="report_language" optional="hide" />
                <field name="delivery_method" optional="hide" />
                <field
                    name="status"
                    widget="badge"
                    decoration-info="status in ('confirmed', 'sample_received', 'testing')"
                    decoration-warning="status == 'awaiting_approval'"
                    decoration-success="status in ('completed', 'reported')"
                    decoration-danger="status == 'cancelled'"
                />
            </list>
        </field>
    </record>

    <record id="view_medilab_test_request_form" model="ir.ui.view">
        <field name="name">medilab.test.request.form</field>
        <field name="model">medilab.test.request</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-success"
                        invisible="status != 'draft'"
                        groups="sol_laboratory.group_permission_test_request_edit_all"
                    />
                    <button
                        name="%(action_medilab_committed_date_change)d"
                        type="action"
                        string="Change Return Date"
                        class="btn-secondary"
                        context="{'default_request_id': id}"
                        invisible="status in ('completed', 'reported', 'cancelled')"
                        groups="sol_laboratory.group_permission_committed_date_change_create_all"
                    />
                    <button
                        name="action_print_labels"
                        type="object"
                        string="Print Labels"
                        class="btn-secondary"
                        invisible="not sample_ids"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-danger"
                        invisible="status not in ('draft', 'confirmed', 'sample_received', 'testing')"
                        confirm="Cancel this test request with its samples and sample tests?"
                        groups="sol_laboratory.group_permission_test_request_edit_all"
                    />
                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,sample_received,testing,awaiting_approval,completed,reported"
                    />
                </header>
                <sheet>
                    <field name="can_open_collection_tasks" invisible="1" />
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_collection_tasks"
                            type="object"
                            class="oe_stat_button"
                            icon="calendar_today"
                            invisible="not can_open_collection_tasks"
                        >
                            <field name="collection_task_count" widget="statinfo" string="Collection" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="code" />
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h1><field name="code" required="0" placeholder="Filled from the sequence when left empty" /></h1>
                            <field
                                name="priority_badge"
                                widget="badge"
                                class="o_medilab_priority_badge"
                                decoration-danger="priority_badge == 'priority'"
                                decoration-muted="priority_badge == 'standard'"
                            />
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" />
                            <field name="request_date" />
                            <field name="requested_date" readonly="id" />
                            <field name="committed_date" readonly="id" />
                            <field name="turnaround_days" readonly="id" />
                        </group>
                        <group string="Report">
                            <field name="report_language" />
                            <field name="delivery_method" />
                            <field name="delivery_note" invisible="delivery_method == 'in_person'" />
                            <field name="report_recipient_id" placeholder="The customer's contact" />
                        </group>
                        <group string="Sample Collection" invisible="not collection_task_count">
                            <field name="collection_appointment_display" readonly="1" />
                            <field name="collection_place" readonly="1" invisible="not collection_place" />
                            <field name="collection_assignee_id" readonly="1" invisible="not collection_assignee_id" />
                            <field name="customer_contact_display" readonly="1" invisible="not customer_contact_display" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Samples" name="samples">
                            <field name="sample_ids">
                                <list>
                                    <field name="code" required="0" />
                                    <field name="customer_sample_name" />
                                    <field name="sample_type_id" />
                                    <field name="physical_state" />
                                    <field name="regulation_id" />
                                    <field name="test_ids" widget="many2many_tags" string="Parameters" />
                                    <field name="status" widget="badge" />
                                </list>
                            </field>
                        </page>
                        <page string="Cancelled Tests" name="cancelled_tests" invisible="not cancelled_test_ids">
                            <field name="cancelled_test_ids">
                                <list>
                                    <field name="sample_id" />
                                    <field name="parameter_id" />
                                    <field name="cancel_reason" />
                                    <field name="cancelled_by_id" />
                                    <field name="cancelled_at" />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Test Reports"
                            name="reports"
                            invisible="not report_ids"
                            groups="sol_laboratory.group_permission_test_report_read_all"
                        >
                            <field name="report_ids">
                                <list>
                                    <field name="display_name" string="Report Number" />
                                    <field name="version" />
                                    <field name="language" />
                                    <field name="status" />
                                    <field name="issued_at" />
                                    <field name="delivered_at" />
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" />
                        </page>
                        <page string="Committed Date Changes" name="committed_date_changes" invisible="not committed_date_change_ids">
                            <field name="committed_date_change_ids">
                                <list>
                                    <field name="create_date" string="Recorded On" />
                                    <field name="create_uid" string="Recorded By" />
                                    <field name="old_date" />
                                    <field name="new_date" />
                                    <field name="confirmation" />
                                </list>
                            </field>
                        </page>
                        <page string="Audit Log" name="audit_log" groups="sol_laboratory.group_permission_audit_entry_read_all">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Date" />
                                    <field name="user_id" />
                                    <field name="action" />
                                    <field name="document_model" />
                                    <field name="change_ids" widget="many2many_tags" />
                                    <field name="note" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_medilab_test_request_search" model="ir.ui.view">
        <field name="name">medilab.test.request.search</field>
        <field name="model">medilab.test.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="customer_id" />
                <filter name="open" string="Open" domain="[('status', 'not in', ('reported', 'cancelled'))]" />
                <filter name="priority" string="Priority" domain="[('priority', '=', True)]" />
                <filter name="cancelled" string="Cancelled" domain="[('status', '=', 'cancelled')]" />
                <group>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}" />
                    <filter name="group_by_customer" string="Customer" context="{'group_by': 'customer_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_test_request" model="ir.actions.act_window">
        <field name="name">Test Requests</field>
        <field name="res_model">medilab.test.request</field>
        <field name="path">test-requests</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
