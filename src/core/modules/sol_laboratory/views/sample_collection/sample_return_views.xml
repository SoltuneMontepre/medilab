<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_sample_return_list" model="ir.ui.view">
        <field name="name">medilab.sample.return.list</field>
        <field name="model">medilab.sample.return</field>
        <field name="arch" type="xml">
            <list create="0" duplicate="0">
                <field name="sample_id" />
                <field name="kind" />
                <field name="description" />
                <field name="returned_at" />
                <field name="returned_by_id" />
                <field name="returned_to_name" />
            </list>
        </field>
    </record>

    <!-- Opened from a sample in a dialog: staff record what they hand back and to whom. -->
    <record id="view_medilab_sample_return_form" model="ir.ui.view">
        <field name="name">medilab.sample.return.form</field>
        <field name="model">medilab.sample.return</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <group>
                        <group>
                            <field name="sample_id" readonly="1" />
                            <field name="kind" readonly="id" />
                            <field name="returned_to_name" readonly="id" />
                        </group>
                        <group>
                            <field name="returned_at" />
                            <field name="returned_by_id" invisible="not id" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="description"
                            readonly="id"
                            placeholder="Such as 1 extra 500 mL bottle and 300 mL of excess material"
                        />
                    </group>
                </sheet>
                <footer invisible="id">
                    <button special="save" string="Record Return" class="btn-success" />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_medilab_sample_return_search" model="ir.ui.view">
        <field name="name">medilab.sample.return.search</field>
        <field name="model">medilab.sample.return</field>
        <field name="arch" type="xml">
            <search>
                <field name="sample_id" />
                <field name="returned_to_name" />
                <field name="returned_by_id" />
                <filter name="extras" string="Extra Samples and Excess Material" domain="[('kind', '=', 'extras')]" />
                <filter name="retained" string="Retained Samples" domain="[('kind', '=', 'retained')]" />
                <group>
                    <filter name="group_by_kind" string="Returned" context="{'group_by': 'kind'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_sample_return" model="ir.actions.act_window">
        <field name="name">Sample Returns</field>
        <field name="res_model">medilab.sample.return</field>
        <field name="path">sample-returns</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
