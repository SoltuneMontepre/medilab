<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Actions whose context has view_switcher_left show the view switcher after the title instead of on the right. -->
    <t t-name="sol_laboratory.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.env.config.viewSwitcherEntries?.length &gt; 1']" position="attributes">
            <attribute name="t-if">this.env.config.viewSwitcherEntries?.length &gt; 1 and !(this.env.searchModel?.globalContext?.view_switcher_left and !this.uiService.isSmall)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_control_panel_breadcrumbs')]/div[hasclass('me-auto')]" position="before">
            <nav t-if="this.env.searchModel?.globalContext?.view_switcher_left and this.env.config.viewSwitcherEntries?.length &gt; 1"
                 class="o_cp_switch_buttons o_cp_switch_buttons_left d-print-none d-inline-flex btn-group">
                <t t-foreach="this.env.config.viewSwitcherEntries" t-as="view" t-key="view.type">
                    <button class="btn btn-secondary o_switch_view"
                            t-att-class="{ 'active': view.active }"
                            t-attf-class="o_{{view.type}}"
                            t-att-aria-pressed="view.active ? 'true' : 'false'"
                            t-custom-click="(ev, isMiddleClick) => this.switchView(view.type, isMiddleClick)">
                        <i class="oi oi-fw" t-att-data-icon="view.icon" aria-hidden="true"/>
                        <span t-if="view.type === 'list'">List</span>
                        <span t-elif="view.type === 'calendar'">Calendar</span>
                        <span t-elif="view.type === 'timeline'">Timeline</span>
                        <span t-else="" t-out="view.name"/>
                    </button>
                </t>
            </nav>
        </xpath>
    </t>

</templates>
