<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sol_laboratory.TaskViewButtons">
        <div class="o_task_views btn-group" role="group" aria-label="Show as">
            <t t-foreach="this.views" t-as="view" t-key="view.type">
                <button type="button" class="btn btn-secondary btn-sm"
                        t-att-title="view.label"
                        t-on-click="() => this.props.onOpen(this.props.tile, view.type)">
                    <i class="oi" t-att-data-icon="view.icon" aria-hidden="true"/>
                    <span t-out="view.label"/>
                </button>
            </t>
        </div>
    </t>

    <t t-name="sol_laboratory.TaskDashboard">
        <div class="o_action o_task_dashboard h-100 overflow-auto">
            <div t-if="this.data" class="o_task_dashboard_inner">
                <header class="o_task_dashboard_head">
                    <p class="o_task_dashboard_date" t-out="this.todayLabel"/>
                    <h1 t-out="this.greeting"/>
                    <p class="o_task_dashboard_summary" t-out="this.summary"/>
                </header>

                <div class="o_task_bento">
                    <section class="o_task_tile o_task_tile_mine" aria-labelledby="o_task_tile_mine_title">
                        <div class="o_task_tile_head">
                            <h2 id="o_task_tile_mine_title">
                                <button type="button" class="o_task_tile_link" t-on-click="() => this.openTile('mine')">
                                    <span>My tasks</span>
                                    <i class="oi" data-icon="chevron_right" aria-hidden="true"/>
                                </button>
                            </h2>
                            <TaskViewButtons tile="'mine'" onOpen.bind="this.openTile"/>
                        </div>

                        <t t-set="ribbon" t-value="this.ribbon"/>
                        <div class="o_task_ribbon">
                            <div class="o_task_ribbon_hours">
                                <t t-foreach="ribbon.hours" t-as="hour" t-key="hour.key">
                                    <span t-att-style="'left: ' + hour.left + '%'" t-out="hour.label"/>
                                </t>
                            </div>
                            <div class="o_task_ribbon_track" t-att-style="'height: ' + ribbon.height + 'px'">
                                <t t-foreach="ribbon.hours" t-as="hour" t-key="hour.key">
                                    <i class="o_task_ribbon_line" t-att-style="'left: ' + hour.left + '%'"/>
                                </t>
                                <div t-if="ribbon.now !== null" class="o_task_ribbon_now"
                                     t-att-style="'left: ' + ribbon.now + '%'"/>
                                <t t-foreach="ribbon.blocks" t-as="block" t-key="block.id">
                                    <button type="button" class="o_task_ribbon_block"
                                            t-att-class="'o_task_status_' + block.status"
                                            t-att-style="block.style"
                                            t-att-title="block.name + ' ' + block.time"
                                            t-on-click="() => this.openTask(block)">
                                        <span class="o_task_ribbon_block_name text-truncate" t-out="block.name"/>
                                        <span class="o_task_ribbon_block_time text-truncate" t-out="block.time"/>
                                    </button>
                                </t>
                                <p t-if="!ribbon.blocks.length" class="o_task_ribbon_empty">
                                    Nothing planned today. Give a task a planned start to see it here.
                                </p>
                            </div>
                        </div>

                        <h3 class="o_task_list_title">Next up</h3>
                        <ul t-if="this.data.next_up.length" class="o_task_list list-unstyled mb-0">
                            <t t-foreach="this.data.next_up" t-as="task" t-key="task.id">
                                <t t-set="next" t-value="this.nextAction(task)"/>
                                <li class="o_task_row" t-att-class="{ o_task_row_overdue: this.isOverdue(task) }">
                                    <i class="o_task_dot" t-att-class="'o_task_status_' + task.status" aria-hidden="true"/>
                                    <button type="button" class="o_task_row_main" t-on-click="() => this.openTask(task)">
                                        <span class="o_task_row_name" t-out="task.name"/>
                                        <span class="o_task_row_due" t-out="this.dueLabel(task)"/>
                                    </button>
                                    <button t-if="next" type="button" class="btn btn-sm"
                                            t-att-class="next.className"
                                            t-att-disabled="this.state.busy"
                                            t-on-click="() => this.run(task, next.method)"
                                            t-out="next.label"/>
                                </li>
                            </t>
                        </ul>
                        <p t-else="" class="o_task_empty">
                            No open tasks. Tasks you are given or claim appear here.
                        </p>
                    </section>

                    <section class="o_task_tile o_task_tile_all" aria-labelledby="o_task_tile_all_title">
                        <div class="o_task_tile_head">
                            <h2 id="o_task_tile_all_title">
                                <button type="button" class="o_task_tile_link" t-on-click="() => this.openTile('all')">
                                    <span>All tasks</span>
                                    <i class="oi" data-icon="chevron_right" aria-hidden="true"/>
                                </button>
                            </h2>
                        </div>
                        <p class="o_task_figure">
                            <strong t-out="this.data.claimable_count"/>
                            <span>waiting in your queues</span>
                        </p>
                        <ul t-if="this.data.claimable.length" class="o_task_list list-unstyled">
                            <t t-foreach="this.data.claimable" t-as="task" t-key="task.id">
                                <li class="o_task_row">
                                    <i class="o_task_dot o_task_status_open" aria-hidden="true"/>
                                    <button type="button" class="o_task_row_main" t-on-click="() => this.openTask(task)">
                                        <span class="o_task_row_name" t-out="task.name"/>
                                        <span class="o_task_row_due" t-out="this.dueLabel(task)"/>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-primary"
                                            t-att-disabled="this.state.busy"
                                            t-on-click="() => this.run(task, 'action_claim')">Claim</button>
                                </li>
                            </t>
                        </ul>
                        <button t-if="this.data.claimable_count" type="button" class="btn btn-link o_task_more"
                                t-on-click="() => this.openTile('awaiting')">Show awaiting tasks</button>
                        <p class="o_task_note">
                            <t t-out="this.data.unfinished_count"/> unfinished tasks you can see.
                        </p>
                        <TaskViewButtons tile="'all'" onOpen.bind="this.openTile"/>
                    </section>

                    <section class="o_task_tile o_task_tile_finished" aria-labelledby="o_task_tile_finished_title">
                        <div class="o_task_tile_head">
                            <h2 id="o_task_tile_finished_title">
                                <button type="button" class="o_task_tile_link" t-on-click="() => this.openTile('finished')">
                                    <span>Finished tasks</span>
                                    <i class="oi" data-icon="chevron_right" aria-hidden="true"/>
                                </button>
                            </h2>
                        </div>
                        <p class="o_task_figure">
                            <strong t-out="this.data.finished_week_count"/>
                            <span>finished in the last 7 days</span>
                        </p>
                        <p class="o_task_note">
                            <t t-out="this.data.finished_count"/> finished in all.
                        </p>
                        <TaskViewButtons tile="'finished'" onOpen.bind="this.openTile"/>
                    </section>
                </div>
            </div>
        </div>
    </t>

</templates>
