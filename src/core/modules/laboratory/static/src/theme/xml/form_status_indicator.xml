<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.FormStatusIndicator" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_form_status_indicator_buttons')]" position="replace">
            <div class="o_form_status_indicator_buttons d-flex align-items-center gap-2"
                 t-att-class="{ invisible: !(props.model.root.isNew or displayButtons) }">
                <button
                    type="button"
                    class="o_form_button_save btn btn-success"
                    data-hotkey="s"
                    t-on-click.stop="save"
                    data-tooltip="Save manually"
                    aria-label="Save manually"
                    t-ref="save">
                    Save
                </button>
                <button
                    type="button"
                    class="o_form_button_cancel btn btn-secondary"
                    data-hotkey="j"
                    t-on-click.stop="discard"
                    data-tooltip="Discard all changes"
                    aria-label="Discard all changes">
                    Discard
                </button>
            </div>
        </xpath>
    </t>

</templates>
