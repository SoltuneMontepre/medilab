<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_permission_list" model="ir.ui.view">
        <field name="name">medilab.permission.list</field>
        <field name="model">medilab.permission</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="code" />
                <field name="name" />
                <field name="document_model" optional="show" />
                <field name="action" optional="show" />
                <field name="scope" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_medilab_permission_form" model="ir.ui.view">
        <field name="name">medilab.permission.form</field>
        <field name="model">medilab.permission</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_model" readonly="id" />
                            <field name="action" readonly="id" />
                            <field name="scope" readonly="id" />
                        </group>
                        <group>
                            <field name="code" />
                            <field name="group_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Roles" name="roles" groups="laboratory.group_role_administrator">
                            <field name="role_ids">
                                <list>
                                    <field name="code" />
                                    <field name="name" />
                                </list>
                            </field>
                        </page>
                        <page string="People" name="people" groups="laboratory.group_role_administrator">
                            <field name="person_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="department_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_permission_search" model="ir.ui.view">
        <field name="name">medilab.permission.search</field>
        <field name="model">medilab.permission</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="document_model" />
                <filter name="own_department" string="Own Department" domain="[('scope', '=', 'own_department')]" />
                <filter name="group_by_document_model" string="Document Type" context="{'group_by': 'document_model'}" />
                <filter name="group_by_action" string="Action" context="{'group_by': 'action'}" />
            </search>
        </field>
    </record>

    <record id="action_medilab_permission" model="ir.actions.act_window">
        <field name="name">Permissions</field>
        <field name="res_model">medilab.permission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
