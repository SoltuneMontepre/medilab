<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_scheduled_job_list" model="ir.ui.view">
        <field name="name">medilab.scheduled.job.list</field>
        <field name="model">medilab.scheduled.job</field>
        <field name="arch" type="xml">
            <list duplicate="0" create="0" delete="0">
                <field name="name" />
                <field name="key" />
                <field name="interval_number" string="Every" />
                <field name="interval_type" />
                <field name="nextcall" />
                <field name="last_run_status" />
                <field name="last_run_duration" string="Last Duration (s)" />
                <field name="pending_count" />
                <field name="failed_count" decoration-danger="failed_count" />
                <field name="cron_active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_medilab_scheduled_job_form" model="ir.ui.view">
        <field name="name">medilab.scheduled.job.form</field>
        <field name="model">medilab.scheduled.job</field>
        <field name="arch" type="xml">
            <form duplicate="0" create="0" delete="0">
                <header>
                    <button name="action_run" type="object" string="Run now" class="btn-primary" groups="laboratory.group_permission_scheduled_job_edit_all" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group string="Schedule" name="schedule">
                            <field name="key" readonly="1" />
                            <field name="cron_active" widget="boolean_toggle" />
                            <label for="interval_number" string="Every" />
                            <div class="o_row">
                                <field name="interval_number" />
                                <field name="interval_type" />
                            </div>
                            <field name="nextcall" />
                            <field name="lastcall" />
                        </group>
                        <group string="Limits" name="limits">
                            <field name="batch_size" />
                            <field name="max_attempts" />
                            <field name="claim_timeout_minutes" />
                            <field name="retry_delay_minutes" />
                        </group>
                        <group string="Last Run" name="last_run">
                            <field name="last_run_id" />
                            <field name="last_run_status" />
                            <field name="last_run_duration" string="Duration (s)" />
                            <field name="progress_done" />
                            <field name="progress_remaining" />
                        </group>
                        <group string="Queue" name="queue">
                            <field name="pending_count" />
                            <field name="failed_count" />
                            <field name="run_requested_by_id" invisible="not run_requested_by_id" />
                            <field name="run_requested_at" invisible="not run_requested_at" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="item_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="item_key" />
                                    <field name="status" />
                                    <field name="attempts" />
                                    <field name="next_attempt_at" />
                                    <field name="claimed_at" />
                                    <field name="done_at" />
                                    <field name="last_error" />
                                    <button name="action_retry" type="object" string="Retry" icon="fa-repeat" invisible="status != 'failed'" groups="laboratory.group_permission_job_item_edit_all" />
                                    <button name="action_cancel" type="object" string="Cancel" icon="fa-times" invisible="status not in ('pending', 'failed')" groups="laboratory.group_permission_job_item_edit_all" />
                                </list>
                            </field>
                        </page>
                        <page string="Runs" name="runs">
                            <field name="run_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="started_at" />
                                    <field name="ended_at" />
                                    <field name="status" />
                                    <field name="duration" string="Duration (s)" />
                                    <field name="done_count" />
                                    <field name="failed_count" />
                                    <field name="triggered_by_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_scheduled_job_search" model="ir.ui.view">
        <field name="name">medilab.scheduled.job.search</field>
        <field name="model">medilab.scheduled.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="key" />
                <filter name="failed_items" string="Has failed items" domain="[('item_ids.status', '=', 'failed')]" />
                <filter name="inactive" string="Schedule off" domain="[('cron_id.active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_scheduled_job" model="ir.actions.act_window">
        <field name="name">Scheduled Jobs</field>
        <field name="res_model">medilab.scheduled.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
