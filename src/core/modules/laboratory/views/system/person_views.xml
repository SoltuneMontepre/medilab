<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_person_list" model="ir.ui.view">
        <field name="name">medilab.person.list</field>
        <field name="model">medilab.person</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="name" />
                <field name="department_id" />
                <field name="email" optional="show" />
                <field name="phone" optional="show" />
                <field name="login" optional="show" />
                <field name="role_ids" widget="many2many_tags" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_medilab_person_form" model="ir.ui.view">
        <field name="name">medilab.person.form</field>
        <field name="model">medilab.person</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_user"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-user"
                            string="User"
                            invisible="not user_id"
                            groups="laboratory.group_role_administrator"
                        />
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id" />
                            <field name="email" />
                            <field name="phone" />
                        </group>
                        <group>
                            <field name="login" />
                            <field name="user_id" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Roles" name="roles" groups="laboratory.group_role_administrator">
                            <field name="role_ids">
                                <list>
                                    <field name="code" />
                                    <field name="name" />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Direct Permissions"
                            name="permissions"
                            groups="laboratory.group_role_administrator"
                        >
                            <field name="permission_ids">
                                <list>
                                    <field name="code" />
                                    <field name="name" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_person_search" model="ir.ui.view">
        <field name="name">medilab.person.search</field>
        <field name="model">medilab.person</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="email" />
                <field name="department_id" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
                <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}" />
            </search>
        </field>
    </record>

    <record id="action_medilab_person" model="ir.actions.act_window">
        <field name="name">People</field>
        <field name="res_model">medilab.person</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
