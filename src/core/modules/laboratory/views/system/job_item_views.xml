<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_job_item_list" model="ir.ui.view">
        <field name="name">medilab.job.item.list</field>
        <field name="model">medilab.job.item</field>
        <field name="arch" type="xml">
            <list duplicate="0" create="0" delete="0">
                <field name="job_id" />
                <field name="item_key" />
                <field name="status" />
                <field name="attempts" />
                <field name="next_attempt_at" />
                <field name="claimed_at" />
                <field name="done_at" />
                <button name="action_retry" type="object" string="Retry" icon="fa-repeat" invisible="status != 'failed'" groups="laboratory.group_permission_job_item_edit_all" />
                <button name="action_cancel" type="object" string="Cancel" icon="fa-times" invisible="status not in ('pending', 'failed')" groups="laboratory.group_permission_job_item_edit_all" />
            </list>
        </field>
    </record>

    <record id="view_medilab_job_item_form" model="ir.ui.view">
        <field name="name">medilab.job.item.form</field>
        <field name="model">medilab.job.item</field>
        <field name="arch" type="xml">
            <form duplicate="0" create="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Retry" class="btn-primary" invisible="status != 'failed'" groups="laboratory.group_permission_job_item_edit_all" />
                    <button name="action_cancel" type="object" string="Cancel" invisible="status not in ('pending', 'failed')" groups="laboratory.group_permission_job_item_edit_all" />
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="item_key" />
                        <h1><field name="item_key" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_id" readonly="1" />
                            <field name="document_model" readonly="1" />
                            <field name="document_id" readonly="1" />
                        </group>
                        <group>
                            <field name="attempts" readonly="1" />
                            <field name="next_attempt_at" readonly="1" />
                            <field name="claimed_at" readonly="1" />
                            <field name="done_at" readonly="1" />
                        </group>
                    </group>
                    <group string="Payload" name="payload">
                        <field name="payload" nolabel="1" colspan="2" widget="json" readonly="1" />
                    </group>
                    <group string="Last Error" name="last_error" invisible="not last_error">
                        <field name="last_error" nolabel="1" colspan="2" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_job_item_search" model="ir.ui.view">
        <field name="name">medilab.job.item.search</field>
        <field name="model">medilab.job.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="item_key" />
                <field name="job_id" />
                <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]" />
                <filter name="running" string="Running" domain="[('status', '=', 'running')]" />
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]" />
                <filter name="done" string="Done" domain="[('status', '=', 'done')]" />
                <filter name="group_by_job" string="Job" context="{'group_by': 'job_id'}" />
                <filter name="group_by_status" string="Status" context="{'group_by': 'status'}" />
            </search>
        </field>
    </record>

    <record id="action_medilab_job_item" model="ir.actions.act_window">
        <field name="name">Job Items</field>
        <field name="res_model">medilab.job.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_group_by_job": 1}</field>
    </record>
</odoo>
