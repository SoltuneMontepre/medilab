<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_task_type_list" model="ir.ui.view">
        <field name="name">medilab.task.type.list</field>
        <field name="model">medilab.task.type</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" duplicate="0">
                <field name="code" />
                <field name="name" />
                <field name="trigger" />
                <field name="route" />
                <field name="role_id" optional="show" />
                <field name="deadline_hours" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_medilab_task_type_form" model="ir.ui.view">
        <field name="name">medilab.task.type.form</field>
        <field name="model">medilab.task.type</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="trigger" />
                            <field name="document_model" />
                            <field name="action" />
                        </group>
                        <group>
                            <field name="route" />
                            <field name="role_id" invisible="route != 'role'" required="route == 'role'" />
                            <field name="deadline_hours" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_task_type_search" model="ir.ui.view">
        <field name="name">medilab.task.type.search</field>
        <field name="model">medilab.task.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="trigger" />
                <group>
                    <filter name="group_route" string="Route" context="{'group_by': 'route'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_task_type" model="ir.actions.act_window">
        <field name="name">Task Types</field>
        <field name="res_model">medilab.task.type</field>
        <field name="path">task-types</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
