<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_regulation_list" model="ir.ui.view">
        <field name="name">medilab.regulation.list</field>
        <field name="model">medilab.regulation</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="code" />
                <field name="name" />
                <field name="issuing_authority" />
                <field name="sample_type_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="view_medilab_regulation_form" model="ir.ui.view">
        <field name="name">medilab.regulation.form</field>
        <field name="model">medilab.regulation</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="code" />
                        <h1><field name="code" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="issuing_authority" />
                        </group>
                        <group>
                            <field name="sample_type_ids" widget="many2many_tags" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Limits" name="limits">
                            <field name="limit_ids">
                                <list editable="bottom">
                                    <field name="parameter_id" />
                                    <field name="min_value" />
                                    <field name="max_value" />
                                    <field name="unit_id" />
                                    <field name="decimals" />
                                    <field name="limit_text" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_regulation_search" model="ir.ui.view">
        <field name="name">medilab.regulation.search</field>
        <field name="model">medilab.regulation</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Name" />
                <field name="sample_type_ids" operator="child_of" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_regulation" model="ir.actions.act_window">
        <field name="name">Regulations</field>
        <field name="res_model">medilab.regulation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
