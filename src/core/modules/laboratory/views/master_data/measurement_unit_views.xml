<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_measurement_unit_list" model="ir.ui.view">
        <field name="name">medilab.measurement.unit.list</field>
        <field name="model">medilab.measurement.unit</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="name" />
                <field name="category_id" />
                <field name="factor" />
            </list>
        </field>
    </record>

    <record id="view_medilab_measurement_unit_form" model="ir.ui.view">
        <field name="name">medilab.measurement.unit.form</field>
        <field name="model">medilab.measurement.unit</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <group>
                        <field name="name" />
                        <field name="category_id" />
                        <field name="factor" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_measurement_unit_search" model="ir.ui.view">
        <field name="name">medilab.measurement.unit.search</field>
        <field name="model">medilab.measurement.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="category_id" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
                <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}" />
            </search>
        </field>
    </record>

    <record id="action_medilab_measurement_unit" model="ir.actions.act_window">
        <field name="name">Measurement Units</field>
        <field name="res_model">medilab.measurement.unit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
