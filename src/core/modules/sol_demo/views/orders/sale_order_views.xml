<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inventory is out of scope for now, so orders hide the warehouse and shipping policy Odoo adds when Sales and
         Inventory are both installed. -->
    <record id="view_order_form_without_stock" model="ir.ui.view">
        <field name="name">sale.order.form.without.stock</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock" />
        <field name="arch" type="xml">
            <field name="warehouse_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="picking_policy" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>
