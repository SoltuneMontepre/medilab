<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="machine_aas" model="medilab.machine">
        <field name="code">AAS-01</field>
        <field name="name">Atomic absorption spectrometer 1</field>
        <field name="model">PinAAcle 900T</field>
        <field name="manufacturer">PerkinElmer</field>
        <field name="serial_number">PAA900T-1042</field>
        <field name="location">Room 203, bench 2</field>
        <field name="maintenance_interval_days">180</field>
    </record>
    <record id="machine_service_aas_calibration" model="medilab.machine.service">
        <field name="machine_id" ref="machine_aas" />
        <field name="kind">calibration</field>
        <field name="service_date" eval="(DateTime.today() - relativedelta(months=2)).strftime('%Y-%m-%d')" />
        <field name="next_due_date" eval="(DateTime.today() + relativedelta(months=10)).strftime('%Y-%m-%d')" />
        <field name="performed_by">Quality Assurance and Testing Centre</field>
        <field name="reference">HC-2026-0412</field>
    </record>
    <record id="machine_service_aas_maintenance" model="medilab.machine.service">
        <field name="machine_id" ref="machine_aas" />
        <field name="kind">maintenance</field>
        <field name="service_date" eval="(DateTime.today() - relativedelta(months=1)).strftime('%Y-%m-%d')" />
        <field name="performed_by">PerkinElmer Vietnam</field>
        <field name="reference">BT-2026-118</field>
        <field name="note">Replaced the lamp and cleaned the burner.</field>
    </record>

    <record id="machine_icpms" model="medilab.machine">
        <field name="code">ICPMS-01</field>
        <field name="name">ICP-MS 1</field>
        <field name="model">7900</field>
        <field name="manufacturer">Agilent</field>
        <field name="serial_number">JP-7900-2231</field>
        <field name="location">Room 205</field>
    </record>
    <record id="machine_service_icpms_calibration" model="medilab.machine.service">
        <field name="machine_id" ref="machine_icpms" />
        <field name="kind">calibration</field>
        <field name="service_date" eval="(DateTime.today() - relativedelta(months=13)).strftime('%Y-%m-%d')" />
        <field name="next_due_date" eval="(DateTime.today() - relativedelta(months=1)).strftime('%Y-%m-%d')" />
        <field name="performed_by">Quality Assurance and Testing Centre</field>
        <field name="reference">HC-2025-0907</field>
    </record>

    <record id="machine_incubator" model="medilab.machine">
        <field name="code">INC-01</field>
        <field name="name">Incubator 1</field>
        <field name="model">IN110</field>
        <field name="manufacturer">Memmert</field>
        <field name="serial_number">B416.0123</field>
        <field name="location">Microbiology room</field>
        <field name="status">under_repair</field>
    </record>
    <record id="machine_service_incubator_calibration" model="medilab.machine.service">
        <field name="machine_id" ref="machine_incubator" />
        <field name="kind">calibration</field>
        <field name="service_date" eval="(DateTime.today() - relativedelta(months=4)).strftime('%Y-%m-%d')" />
        <field name="next_due_date" eval="(DateTime.today() + relativedelta(months=8)).strftime('%Y-%m-%d')" />
        <field name="performed_by">Quality Assurance and Testing Centre</field>
        <field name="reference">HC-2026-0233</field>
    </record>
    <record id="machine_service_incubator_repair" model="medilab.machine.service">
        <field name="machine_id" ref="machine_incubator" />
        <field name="kind">repair</field>
        <field name="service_date" eval="DateTime.today().strftime('%Y-%m-%d')" />
        <field name="performed_by">Memmert service partner</field>
        <field name="note">Temperature drifts by 2 °C; controller board sent for repair.</field>
    </record>

    <record id="machine_run_lead_aas" model="medilab.parameter.method.machine">
        <field name="parameter_method_id" ref="parameter_method_lead_aas" />
        <field name="machine_id" ref="machine_aas" />
        <field name="run_minutes">30</field>
    </record>
    <record id="machine_run_lead_icpms" model="medilab.parameter.method.machine">
        <field name="parameter_method_id" ref="parameter_method_lead_icpms" />
        <field name="machine_id" ref="machine_icpms" />
        <field name="run_minutes">20</field>
    </record>
    <record id="machine_run_coliforms_incubator" model="medilab.parameter.method.machine">
        <field name="parameter_method_id" ref="parameter_method_coliforms_mpn" />
        <field name="machine_id" ref="machine_incubator" />
        <field name="run_minutes">2880</field>
    </record>
    <record id="machine_run_e_coli_incubator" model="medilab.parameter.method.machine">
        <field name="parameter_method_id" ref="parameter_method_e_coli_membrane" />
        <field name="machine_id" ref="machine_incubator" />
        <field name="run_minutes">1440</field>
    </record>

