<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_product_product_nitric_acid" model="product.product">
        <field name="name">Nitric acid 65%</field>
        <field name="item_kind">chemical</field>
        <field name="item_tracking">container</field>
        <field name="uom_id" ref="uom.product_uom_milliliter" />
        <field name="chemical_id" ref="demo_chemical_nitric_acid" />
        <field name="use_expiration_date" eval="True" />
        <field name="shelf_life_after_opening_days">180</field>
    </record>
    <record id="demo_product_product_sodium_chloride" model="product.product">
        <field name="name">Sodium chloride</field>
        <field name="item_kind">chemical</field>
        <field name="item_tracking">container</field>
        <field name="uom_id" ref="uom.product_uom_gram" />
        <field name="chemical_id" ref="demo_chemical_sodium_chloride" />
        <field name="use_expiration_date" eval="True" />
    </record>
    <record id="demo_product_product_acetonitrile" model="product.product">
        <field name="name">Acetonitrile, HPLC grade</field>
        <field name="item_kind">chemical</field>
        <field name="item_tracking">container</field>
        <field name="uom_id" ref="uom.product_uom_milliliter" />
        <field name="chemical_id" ref="demo_chemical_acetonitrile" />
        <field name="use_expiration_date" eval="True" />
        <field name="shelf_life_after_opening_days">90</field>
    </record>
    <record id="demo_product_product_agar_plates" model="product.product">
        <field name="name">Plate count agar plates</field>
        <field name="item_kind">consumable</field>
        <field name="item_tracking">lot</field>
        <field name="uom_id" ref="uom.product_uom_unit" />
        <field name="use_expiration_date" eval="True" />
    </record>
    <record id="demo_product_product_nitrile_gloves" model="product.product">
        <field name="name">Nitrile gloves, size M</field>
        <field name="item_kind">consumable</field>
        <field name="item_tracking">quantity</field>
        <field name="uom_id" ref="uom.product_uom_unit" />
    </record>
    <record id="demo_product_product_aas_lamp" model="product.product">
        <field name="name">Lead hollow cathode lamp for AAS</field>
        <field name="item_kind">spare_part</field>
        <field name="item_tracking">quantity</field>
        <field name="uom_id" ref="uom.product_uom_unit" />
    </record>
    <record id="demo_product_product_cotton_swabs" model="product.product">
        <field name="name">Cotton swabs, 15 cm</field>
        <field name="item_kind">consumable</field>
        <field name="item_tracking">lot</field>
        <field name="uom_id" ref="uom.product_uom_unit" />
        <field name="use_expiration_date" eval="True" />
        <field name="active" eval="False" />
    </record>
</odoo>
