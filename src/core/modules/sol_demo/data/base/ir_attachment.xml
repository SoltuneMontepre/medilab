<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_ir_attachment_sample_photo_collected" model="ir.attachment">
        <field name="name">an-phu-collected.png</field>
        <field name="raw">iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAEUlEQVR4nGNwa9qCFTEMLQkAA3NfAQ/ZfWEAAAAASUVORK5CYII=</field>
        <field name="mimetype">image/png</field>
    </record>
    <record id="demo_ir_attachment_sample_photo_received" model="ir.attachment">
        <field name="name">an-phu-received.png</field>
        <field name="raw">iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAEUlEQVR4nGOwWRCFFTEMLQkAQQpNgcbvKH4AAAAASUVORK5CYII=</field>
        <field name="mimetype">image/png</field>
    </record>
    <!-- Photos are set on their sample once they exist. -->
    <record id="demo_sample_reception_good" model="medilab.sample">
        <field name="photo_ids" eval="[Command.set([ref('demo_ir_attachment_sample_photo_collected'), ref('demo_ir_attachment_sample_photo_received')])]" />
    </record>
    <record id="demo_ir_attachment_handover_signature" model="ir.attachment">
        <field name="name">BBGN-signature.png</field>
        <field name="raw">iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAD0lEQVR4nGMQwQEYhpYEAN0TDwGnz5/SAAAAAElFTkSuQmCC</field>
        <field name="mimetype">image/png</field>
        <field name="res_model">medilab.handover.record</field>
        <field name="res_id" eval="ref('demo_handover_record_signed')" />
    </record>
    <record id="demo_ir_attachment_handover_signed" model="ir.attachment">
        <field name="name">BBGN-signed.pdf</field>
        <field name="raw"></field>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">medilab.handover.record</field>
        <field name="res_id" eval="ref('demo_handover_record_signed')" />
    </record>
    <!-- The handover record is signed once its attachments exist. -->
    <record id="demo_handover_record_signed" model="medilab.handover.record">
        <field name="status">signed</field>
        <field name="signed_at" eval="DateTime.now().strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="signed_device_id" ref="demo_mobile_device_sample_delivery_staff" />
        <field name="signature_attachment_id" ref="demo_ir_attachment_handover_signature" />
        <field name="attachment_id" ref="demo_ir_attachment_handover_signed" />
        <field name="sent_at" eval="DateTime.now().strftime('%Y-%m-%d %H:%M:%S')" />
    </record>
    <!-- The manufacturer's certificate of the nitric acid lot a demo receipt brings in; the receipt attaches it to the lot. -->
    <record id="demo_ir_attachment_certificate_nitric_acid" model="ir.attachment">
        <field name="name">Certificate K55012345.pdf</field>
        <field name="raw" type="bytes" file="sol_demo/static/demo/certificate_k55012345.pdf" />
        <field name="mimetype">application/pdf</field>
    </record>
    <!-- Pages the onboarding demo runs fetched; each points at its snapshot once the snapshot exists. -->
    <record id="demo_ir_attachment_onboarding_organisation_earlier" model="ir.attachment">
        <field name="name">https://www.boa.gov.vn/vi/timkiem/tochuc/9901</field>
        <field name="raw"></field>
        <field name="mimetype">text/html</field>
        <field name="res_model">medilab.onboarding.snapshot</field>
    </record>
    <record id="demo_ir_attachment_onboarding_organisation" model="ir.attachment">
        <field name="name">https://www.boa.gov.vn/vi/timkiem/tochuc/9901</field>
        <field name="raw"></field>
        <field name="mimetype">text/html</field>
        <field name="res_model">medilab.onboarding.snapshot</field>
    </record>
    <record id="demo_ir_attachment_onboarding_food" model="ir.attachment">
        <field name="name">https://www.boa.gov.vn/vi/timkiem/phamvi/thuc-pham</field>
        <field name="raw"></field>
        <field name="mimetype">text/html</field>
        <field name="res_model">medilab.onboarding.snapshot</field>
    </record>
    <record id="demo_ir_attachment_onboarding_environment" model="ir.attachment">
        <field name="name">https://www.boa.gov.vn/en/search/scope/environment</field>
        <field name="raw"></field>
        <field name="mimetype">text/html</field>
        <field name="res_model">medilab.onboarding.snapshot</field>
    </record>
    <record id="demo_ir_attachment_onboarding_cosmetics" model="ir.attachment">
        <field name="name">https://www.boa.gov.vn/en/search/scope/cosmetics</field>
        <field name="raw"></field>
        <field name="mimetype">text/html</field>
        <field name="res_model">medilab.onboarding.snapshot</field>
    </record>
</odoo>
