<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="unit_category_liquid_concentration" model="medilab.unit.category">
        <field name="name">Mass concentration in liquid</field>
    </record>
    <record id="unit_category_mass_fraction" model="medilab.unit.category">
        <field name="name">Mass fraction</field>
    </record>
    <record id="unit_category_count_per_mass" model="medilab.unit.category">
        <field name="name">Microbial count per mass</field>
    </record>
    <record id="unit_category_count_per_volume" model="medilab.unit.category">
        <field name="name">Microbial count per volume</field>
    </record>
    <record id="unit_category_acidity" model="medilab.unit.category">
        <field name="name">Acidity</field>
    </record>
    <record id="unit_category_volume" model="medilab.unit.category">
        <field name="name">Volume</field>
    </record>
    <record id="unit_category_mass" model="medilab.unit.category">
        <field name="name">Mass</field>
    </record>

    <record id="unit_mg_l" model="medilab.measurement.unit">
        <field name="name">mg/L</field>
        <field name="category_id" ref="unit_category_liquid_concentration" />
        <field name="factor">1</field>
    </record>
    <record id="unit_ug_l" model="medilab.measurement.unit">
        <field name="name">µg/L</field>
        <field name="category_id" ref="unit_category_liquid_concentration" />
        <field name="factor">0.001</field>
    </record>
    <record id="unit_ppb" model="medilab.measurement.unit">
        <field name="name">ppb</field>
        <field name="category_id" ref="unit_category_liquid_concentration" />
        <field name="factor">0.001</field>
        <field name="active" eval="False" />
    </record>
    <record id="unit_mg_kg" model="medilab.measurement.unit">
        <field name="name">mg/kg</field>
        <field name="category_id" ref="unit_category_mass_fraction" />
        <field name="factor">1</field>
    </record>
    <record id="unit_ug_kg" model="medilab.measurement.unit">
        <field name="name">µg/kg</field>
        <field name="category_id" ref="unit_category_mass_fraction" />
        <field name="factor">0.001</field>
    </record>
    <record id="unit_cfu_g" model="medilab.measurement.unit">
        <field name="name">CFU/g</field>
        <field name="category_id" ref="unit_category_count_per_mass" />
        <field name="factor">1</field>
    </record>
    <record id="unit_mpn_100ml" model="medilab.measurement.unit">
        <field name="name">MPN/100 mL</field>
        <field name="category_id" ref="unit_category_count_per_volume" />
        <field name="factor">1</field>
    </record>
    <record id="unit_cfu_100ml" model="medilab.measurement.unit">
        <field name="name">CFU/100 mL</field>
        <field name="category_id" ref="unit_category_count_per_volume" />
        <field name="factor">1</field>
    </record>
    <record id="unit_ph" model="medilab.measurement.unit">
        <field name="name">pH</field>
        <field name="category_id" ref="unit_category_acidity" />
        <field name="factor">1</field>
    </record>
    <record id="unit_ml" model="medilab.measurement.unit">
        <field name="name">mL</field>
        <field name="category_id" ref="unit_category_volume" />
        <field name="factor">1</field>
    </record>
    <record id="unit_g" model="medilab.measurement.unit">
        <field name="name">g</field>
        <field name="category_id" ref="unit_category_mass" />
        <field name="factor">1</field>
    </record>
</odoo>
