<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The Firebase tokens of the demo phones. -->
    <record id="demo_mobile_device_active" model="medilab.mobile.device">
        <field name="laboratory_device_id" ref="demo_laboratory_device_sales_phone" />
        <field name="token">demo-device-active</field>
        <field name="active" eval="True" />
    </record>
    <record id="demo_mobile_device_off" model="medilab.mobile.device">
        <field name="laboratory_device_id" ref="demo_laboratory_device_tester_old_phone" />
        <field name="token">demo-device-off</field>
        <field name="active" eval="False" />
    </record>
    <record id="demo_mobile_device_failed" model="medilab.mobile.device">
        <field name="laboratory_device_id" ref="demo_laboratory_device_sales_tablet" />
        <field name="token">demo-device-failed</field>
        <field name="active" eval="True" />
    </record>
    <record id="demo_mobile_device_sample_delivery_staff" model="medilab.mobile.device">
        <field name="laboratory_device_id" ref="demo_laboratory_device_sample_delivery_staff_phone" />
        <field name="token">demo-device-sample-delivery-staff</field>
    </record>
</odoo>
