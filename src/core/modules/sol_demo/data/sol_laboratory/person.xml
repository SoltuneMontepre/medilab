<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_person_administrator" model="medilab.person">
        <field name="user_id" ref="demo_res_users_administrator" />
        <field name="role_ids" eval="[Command.set([ref('sol_laboratory.role_administrator')])]" />
    </record>
    <record id="demo_person_sales" model="medilab.person">
        <field name="user_id" ref="demo_res_users_sales" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_sales')])]" />
    </record>
    <record id="demo_person_sales_2" model="medilab.person">
        <field name="user_id" ref="demo_res_users_sales_2" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_sales')])]" />
    </record>
    <record id="demo_person_head_of_sales" model="medilab.person">
        <field name="user_id" ref="demo_res_users_head_of_sales" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_head_of_sales')])]" />
    </record>
    <record id="demo_person_accountant" model="medilab.person">
        <field name="user_id" ref="demo_res_users_accountant" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_accountant')])]" />
    </record>
    <record id="demo_person_sample_delivery_staff" model="medilab.person">
        <field name="user_id" ref="demo_res_users_sample_delivery_staff" />
        <field name="department_id" ref="demo_hr_department_sample_reception" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_sample_delivery_staff')])]" />
    </record>
    <record id="demo_person_tester" model="medilab.person">
        <field name="user_id" ref="demo_res_users_tester" />
        <field name="department_id" ref="demo_hr_department_chemistry" />
        <field name="team_id" ref="demo_hr_department_pesticide_residues" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_tester')])]" />
        <field
            name="permission_ids"
            eval="[Command.set([
                ref('sol_laboratory.permission_department_read_all'),
                ref('sol_laboratory.permission_person_read_own_team'),
            ])]"
        />
    </record>
    <record id="demo_person_head_of_department" model="medilab.person">
        <field name="user_id" ref="demo_res_users_head_of_department" />
        <field name="department_id" ref="demo_hr_department_chemistry" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_head_of_department'), ref('demo_role_tester')])]" />
    </record>
    <record id="demo_person_lab_head" model="medilab.person">
        <field name="user_id" ref="demo_res_users_lab_head" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_lab_head')])]" />
    </record>
    <record id="demo_person_storekeeper" model="medilab.person">
        <field name="user_id" ref="demo_res_users_storekeeper" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_storekeeper')])]" />
    </record>
    <record id="demo_person_auditor" model="medilab.person">
        <field name="user_id" ref="demo_res_users_auditor" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_auditor')])]" />
    </record>
    <record id="demo_person_microbiology_tester" model="medilab.person">
        <field name="name">Ngo Thi Mai</field>
        <field name="work_contact_id" ref="demo_res_partner_microbiology_tester" />
        <field name="department_id" ref="demo_hr_department_microbiology" />
        <field name="team_id" ref="demo_hr_department_pathogens" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_tester')])]" />
    </record>
    <record id="demo_person_chemistry_tester" model="medilab.person">
        <field name="name">Ly Van Hung</field>
        <field name="user_id" ref="demo_res_users_chemistry_tester" />
        <field name="work_contact_id" ref="demo_res_partner_chemistry_tester" />
        <field name="department_id" ref="demo_hr_department_chemistry" />
        <field name="team_id" ref="demo_hr_department_pesticide_residues" />
        <field name="role_ids" eval="[Command.set([ref('demo_role_tester')])]" />
    </record>
    <record id="demo_hr_department_chemistry" model="hr.department">
        <field
            name="manager_id"
            model="hr.employee"
            search="[('user_id', '=', ref('demo_res_users_head_of_department'))]"
        />
    </record>
    <!-- Team leads are employees, so they are set once the people exist. -->
    <record id="demo_hr_department_pesticide_residues" model="hr.department">
        <field name="manager_id" model="hr.employee" search="[('user_id', '=', ref('demo_res_users_tester'))]" />
    </record>
    <record id="demo_hr_department_pathogens" model="hr.department">
        <field
            name="manager_id"
            model="hr.employee"
            search="[('work_contact_id', '=', ref('demo_res_partner_microbiology_tester'))]"
        />
    </record>
</odoo>
