<?xml version="1.0" encoding="utf-8"?>
<!-- The seeding code turns the old GC folder off and archives the 2025 report drafts. -->
<odoo noupdate="1">
    <record id="demo_laboratory_folder_hplc_results" model="medilab.laboratory.folder">
        <field name="name">Kết quả HPLC</field>
        <field name="owner_id" ref="demo_res_users_tester" />
        <field name="sync_mode">two_way</field>
    </record>
    <record id="demo_laboratory_folder_aas_raw_data" model="medilab.laboratory.folder">
        <field name="name">AAS-01 dữ liệu thô</field>
        <field name="owner_id" ref="demo_res_users_chemistry_tester" />
        <field name="sync_mode">upload_only</field>
    </record>
    <record id="demo_laboratory_folder_gc_old" model="medilab.laboratory.folder">
        <field name="name">GC-02 cũ</field>
        <field name="owner_id" ref="demo_res_users_tester" />
        <field name="sync_mode">upload_only</field>
    </record>
    <record id="demo_laboratory_folder_report_drafts_2025" model="medilab.laboratory.folder">
        <field name="name">Bản nháp báo cáo 2025</field>
        <field name="owner_id" ref="demo_res_users_tester" />
        <field name="sync_mode">two_way</field>
    </record>
</odoo>
