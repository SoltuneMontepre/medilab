<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Two bottles expected for each: the reception sample is handed over with one extra, the paid one with one missing. -->
    <record id="demo_expected_sampling_reception_good" model="medilab.expected.sampling">
        <field name="sample_id" ref="demo_sample_reception_good" />
        <field name="objects">2</field>
        <field name="group_number">1</field>
        <field name="container_type">Polyethylene bottle</field>
        <field name="preservation">Chilled at 2–8 °C</field>
        <field name="amount">100</field>
        <field name="unit_id" ref="demo_measurement_unit_ml" />
        <field name="method_ids" eval="[Command.set([ref('demo_testing_method_tcvn_6492')])]" />
    </record>
    <record id="demo_expected_sampling_bottled_water_paid" model="medilab.expected.sampling">
        <field name="sample_id" ref="demo_sample_bottled_water_paid" />
        <field name="objects">2</field>
        <field name="group_number">1</field>
        <field name="container_type">Polyethylene bottle</field>
        <field name="preservation">Chilled at 2–8 °C</field>
        <field name="amount">100</field>
        <field name="unit_id" ref="demo_measurement_unit_ml" />
        <field name="method_ids" eval="[Command.set([ref('demo_testing_method_tcvn_6492')])]" />
    </record>
</odoo>
