<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_test_parameter_form" model="ir.ui.view">
        <field name="name">medilab.test.parameter.form.commerce</field>
        <field name="model">medilab.test.parameter</field>
        <field name="inherit_id" ref="laboratory.view_medilab_test_parameter_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Price" name="price">
                    <field name="price_ids" context="{'active_test': False}">
                        <list editable="bottom" decoration-muted="not active">
                            <field name="currency_id" column_invisible="1" />
                            <field name="list_price" />
                            <field name="tax_id" />
                            <field name="active" widget="boolean_toggle" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
