<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_receipt_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Receipt <span t-field="o.receipt_code" /></h2>
                <div class="row mt-4">
                    <div class="col-6">
                        <strong>Received from</strong>
                        <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["name", "address", "vat"], "no_marker": True}' />
                    </div>
                    <div class="col-6">
                        <strong>Received by</strong>
                        <div t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["name", "address", "vat"], "no_marker": True}' />
                    </div>
                </div>
                <table class="table table-sm table-borderless mt-4 w-auto">
                    <tr><th>Date</th><td><span t-field="o.payment_date" /></td></tr>
                    <tr><th>Invoice</th><td><span t-field="o.invoice_id.code" /></td></tr>
                    <tr><th>Method</th><td><span t-field="o.method" /></td></tr>
                    <tr t-if="o.payment_link_id"><th>PayOS order code</th><td><span t-field="o.payment_link_id.provider_order_code" /></td></tr>
                    <tr><th>Amount</th><td><strong><span t-field="o.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}' /></strong></td></tr>
                    <tr><th>Still owed on the invoice</th><td><span t-field="o.invoice_id.amount_owed" t-options='{"widget": "monetary", "display_currency": o.currency_id}' /></td></tr>
                    <tr t-if="o.reviewed_by_id"><th>Confirmed by</th><td><span t-field="o.reviewed_by_id.name" /> on <span t-field="o.reviewed_at" t-options='{"widget": "date"}' /></td></tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="commerce.report_receipt_document" t-lang="o.partner_id.lang" />
            </t>
        </t>
    </template>

    <record id="action_report_receipt" model="ir.actions.report">
        <field name="name">Receipt</field>
        <field name="model">medilab.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">commerce.report_receipt</field>
        <field name="print_report_name">(object.receipt_code or 'Receipt').replace('/', '-')</field>
        <field name="binding_model_id" ref="model_medilab_payment" />
        <field name="binding_type">report</field>
    </record>
</odoo>
