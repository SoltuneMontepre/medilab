<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The generated accesses of the order permissions are not updated on upgrade, so a function sets their
         domains on install and upgrade. -->
    <function model="sale.order" name="_scope_permission_accesses" />

    <record id="access_sale_order_all" model="ir.access">
        <field name="name">All orders</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="group_id" ref="group_all_orders" />
        <field name="operation">crud</field>
        <field name="domain">[(1, "=", 1)]</field>
    </record>
    <record id="access_cancellation_request_all" model="ir.access">
        <field name="name">All cancellation requests</field>
        <field name="model_id" ref="model_medilab_cancellation_request" />
        <field name="group_id" ref="group_all_orders" />
        <field name="operation">crud</field>
        <field name="domain">[(1, "=", 1)]</field>
    </record>
    <record id="access_order_sample_all" model="ir.access">
        <field name="name">All order samples</field>
        <field name="model_id" ref="model_medilab_order_sample" />
        <field name="group_id" ref="group_all_orders" />
        <field name="operation">crud</field>
        <field name="domain">[(1, "=", 1)]</field>
    </record>
    <record id="access_quotation_all" model="ir.access">
        <field name="name">All quotations</field>
        <field name="model_id" ref="model_medilab_quotation" />
        <field name="group_id" ref="group_all_orders" />
        <field name="operation">crud</field>
        <field name="domain">[(1, "=", 1)]</field>
    </record>

    <!-- The sales dashboard and Odoo's sales analyses read sale.report, which has no order access of its own. -->
    <record id="access_sale_report_read" model="ir.access">
        <field name="name">sale.report follows the order owner</field>
        <field name="model_id" ref="sale.model_sale_report" />
        <field name="group_id" ref="sol_laboratory.group_permission_order_read_all" />
        <field name="operation">r</field>
        <field name="domain">[("user_id", "=", user.id)]</field>
    </record>
    <record id="access_sale_report_read_own" model="ir.access">
        <field name="name">sale.report follows the order owner for own orders</field>
        <field name="model_id" ref="sale.model_sale_report" />
        <field name="group_id" ref="sol_laboratory.group_permission_order_read_own" />
        <field name="operation">r</field>
        <field name="domain">[("user_id", "=", user.id)]</field>
    </record>
    <record id="access_sale_report_all" model="ir.access">
        <field name="name">All orders analysis</field>
        <field name="model_id" ref="sale.model_sale_report" />
        <field name="group_id" ref="group_all_orders" />
        <field name="operation">r</field>
        <field name="domain">[(1, "=", 1)]</field>
    </record>

    <record id="access_sale_order_line_read" model="ir.access">
        <field name="name">sale.order.line follows the order</field>
        <field name="model_id" ref="sale.model_sale_order_line" />
        <field name="group_id" ref="sol_laboratory.group_permission_order_read_all" />
        <field name="operation">r</field>
        <field name="domain">[("order_id", "access", "read")]</field>
    </record>
    <record id="access_sale_order_line_read_own" model="ir.access">
        <field name="name">sale.order.line follows own orders</field>
        <field name="model_id" ref="sale.model_sale_order_line" />
        <field name="group_id" ref="sol_laboratory.group_permission_order_read_own" />
        <field name="operation">r</field>
        <field name="domain">[("order_id", "access", "read")]</field>
    </record>
    <record id="access_sale_order_line_create" model="ir.access">
        <field name="name">sale.order.line create</field>
        <field name="model_id" ref="sale.model_sale_order_line" />
        <field name="group_id" ref="sol_laboratory.group_permission_order_create_all" />
        <field name="operation">c</field>
        <field name="domain">[(1, "=", 1)]</field>
    </record>
    <record id="access_sale_order_line_edit" model="ir.access">
        <field name="name">sale.order.line follows order edit</field>
        <field name="model_id" ref="sale.model_sale_order_line" />
        <field name="group_id" ref="sol_laboratory.group_permission_order_edit_all" />
        <field name="operation">u</field>
        <field name="domain">[("order_id", "access", "write")]</field>
    </record>
    <record id="access_sale_order_line_edit_own" model="ir.access">
        <field name="name">sale.order.line follows own order edit</field>
        <field name="model_id" ref="sale.model_sale_order_line" />
        <field name="group_id" ref="sol_laboratory.group_permission_order_edit_own" />
        <field name="operation">u</field>
        <field name="domain">[("order_id", "access", "write")]</field>
    </record>
    <record id="access_sale_order_line_delete" model="ir.access">
        <field name="name">sale.order.line follows order delete</field>
        <field name="model_id" ref="sale.model_sale_order_line" />
        <field name="group_id" ref="sol_laboratory.group_permission_order_delete_all" />
        <field name="operation">d</field>
        <field name="domain">[("order_id", "access", "unlink")]</field>
    </record>
</odoo>
