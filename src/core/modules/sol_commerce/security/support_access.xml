<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <function model="medilab.support.request" name="_scope_permission_accesses" />
    <record id="access_support_request_all" model="ir.access">
        <field name="name">All support requests</field>
        <field name="model_id" ref="model_medilab_support_request" />
        <field name="group_id" ref="group_all_orders" />
        <field name="operation">crud</field>
        <field name="domain">[(1, "=", 1)]</field>
    </record>
    <record id="access_support_request_portal" model="ir.access">
        <field name="name">Support requests of the customer</field>
        <field name="model_id" ref="model_medilab_support_request" />
        <field name="group_id" ref="base.group_portal" />
        <field name="operation">r</field>
        <field name="domain">[("customer_id.partner_id", "=", user.commercial_partner_id.id)]</field>
    </record>
    <!-- Odoo lets every internal user read, create and change any rating, and only administrators delete one.
         Feedback on an order is read only by those who read the order, and is created and changed only by the system. -->
    <record id="access_rating_order_read" model="ir.access">
        <field name="name">Order feedback follows the order</field>
        <field name="model_id" ref="rating.model_rating_rating" />
        <field name="operation">r</field>
        <field name="domain">["|", ("res_model", "!=", "sale.order"), ("order_id", "access", "read")]</field>
    </record>
    <record id="access_rating_order_write" model="ir.access">
        <field name="name">Order feedback is given by the customer only</field>
        <field name="model_id" ref="rating.model_rating_rating" />
        <field name="operation">cu</field>
        <field name="domain">[("res_model", "!=", "sale.order")]</field>
    </record>
</odoo>
