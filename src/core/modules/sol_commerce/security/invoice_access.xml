<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo's order screens read the order's invoices. A person who reads orders reads the customer invoices
         whose salesperson they are, and the Head of Sales every customer invoice. -->
    <record id="access_account_move_order_read" model="ir.access">
        <field name="name">Customer invoices of the salesperson</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="group_id" ref="sol_laboratory.group_permission_order_read_all" />
        <field name="operation">r</field>
        <field name="domain">[("move_type", "in", ("out_invoice", "out_refund")), ("invoice_user_id", "=", user.id)]</field>
    </record>
    <record id="access_account_move_all_orders" model="ir.access">
        <field name="name">All customer invoices</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="group_id" ref="group_all_orders" />
        <field name="operation">r</field>
        <field name="domain">[("move_type", "in", ("out_invoice", "out_refund"))]</field>
    </record>
    <!-- Odoo's Create Invoices dialog; confirming it checks the order's invoice permission. -->
    <record id="access_advance_payment_inv_order_invoice" model="ir.access">
        <field name="name">Create invoices from orders</field>
        <field name="model_id" ref="sale.model_sale_advance_payment_inv" />
        <field name="group_id" ref="sol_laboratory.group_permission_order_invoice_all" />
        <field name="operation">crud</field>
        <field name="domain">[(1, "=", 1)]</field>
    </record>
    <record id="access_account_move_line_order_read" model="ir.access">
        <field name="name">Invoice lines follow the invoice</field>
        <field name="model_id" ref="account.model_account_move_line" />
        <field name="group_id" ref="sol_laboratory.group_permission_order_read_all" />
        <field name="operation">r</field>
        <field name="domain">[("move_id", "access", "read")]</field>
    </record>
</odoo>
