<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_parameter_price_list" model="ir.ui.view">
        <field name="name">medilab.parameter.price.list</field>
        <field name="model">medilab.parameter.price</field>
        <field name="arch" type="xml">
            <list editable="bottom" duplicate="0">
                <field name="parameter_id" />
                <field name="currency_id" column_invisible="1" />
                <field name="list_price" />
                <field name="tax_id" />
            </list>
        </field>
    </record>

    <record id="view_medilab_parameter_price_form" model="ir.ui.view">
        <field name="name">medilab.parameter.price.form</field>
        <field name="model">medilab.parameter.price</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <group>
                        <group>
                            <field name="parameter_id" />
                            <field name="tax_id" />
                        </group>
                        <group>
                            <field name="currency_id" invisible="1" />
                            <field name="list_price" readonly="1" />
                        </group>
                    </group>
                    <separator string="Price Periods" />
                    <field name="period_ids">
                        <list editable="bottom" default_order="valid_from desc" decoration-success="is_current">
                            <field name="currency_id" column_invisible="1" />
                            <field name="valid_from" />
                            <field name="valid_until" placeholder="Until further notice" />
                            <field name="list_price" />
                            <field name="is_current" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_parameter_price_search" model="ir.ui.view">
        <field name="name">medilab.parameter.price.search</field>
        <field name="model">medilab.parameter.price</field>
        <field name="arch" type="xml">
            <search>
                <field name="parameter_id" />
                <field name="tax_id" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
                <filter name="group_by_tax" string="Tax" context="{'group_by': 'tax_id'}" />
            </search>
        </field>
    </record>

    <record id="action_medilab_parameter_price" model="ir.actions.act_window">
        <field name="name">Parameter Prices</field>
        <field name="res_model">medilab.parameter.price</field>
        <field name="path">parameter-prices</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
