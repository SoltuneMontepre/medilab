<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_service_package_list" model="ir.ui.view">
        <field name="name">medilab.service.package.list</field>
        <field name="model">medilab.service.package</field>
        <field name="arch" type="xml">
            <list duplicate="0" decoration-warning="is_overpriced">
                <field name="code" />
                <field name="name" />
                <field name="currency_id" column_invisible="1" />
                <field name="list_price" />
                <field name="parts_price" optional="show" />
                <field name="tax_id" />
            </list>
        </field>
    </record>

    <record id="view_medilab_service_package_form" model="ir.ui.view">
        <field name="name">medilab.service.package.form</field>
        <field name="model">medilab.service.package</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <div class="alert alert-warning mb-0" role="alert" invisible="not is_overpriced">
                    The package costs more than its parameters bought one by one.
                </div>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="tax_id" />
                        </group>
                        <group>
                            <field name="currency_id" invisible="1" />
                            <field name="list_price" />
                            <field name="parts_price" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Parameters" name="parameters">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="parameter_id" />
                                    <field name="quantity" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_service_package_search" model="ir.ui.view">
        <field name="name">medilab.service.package.search</field>
        <field name="model">medilab.service.package</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Name" />
                <field name="line_ids" string="Parameter" filter_domain="[('line_ids.parameter_id', 'ilike', self)]" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_service_package" model="ir.actions.act_window">
        <field name="name">Service Packages</field>
        <field name="res_model">medilab.service.package</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
