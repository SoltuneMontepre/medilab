<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_subcontract_cost_list" model="ir.ui.view">
        <field name="name">medilab.subcontract.cost.list</field>
        <field name="model">medilab.subcontract.cost</field>
        <field name="arch" type="xml">
            <list editable="bottom" duplicate="0">
                <field name="parameter_method_id" />
                <field name="currency_id" column_invisible="1" />
                <field name="cost" />
            </list>
        </field>
    </record>

    <record id="view_medilab_subcontract_cost_form" model="ir.ui.view">
        <field name="name">medilab.subcontract.cost.form</field>
        <field name="model">medilab.subcontract.cost</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <group>
                        <field name="parameter_method_id" />
                        <field name="currency_id" invisible="1" />
                        <field name="cost" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_subcontract_cost_search" model="ir.ui.view">
        <field name="name">medilab.subcontract.cost.search</field>
        <field name="model">medilab.subcontract.cost</field>
        <field name="arch" type="xml">
            <search>
                <field name="parameter_method_id" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_subcontract_cost" model="ir.actions.act_window">
        <field name="name">Subcontract Costs</field>
        <field name="res_model">medilab.subcontract.cost</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
