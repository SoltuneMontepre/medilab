<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_tax_list" model="ir.ui.view">
        <field name="name">medilab.tax.list</field>
        <field name="model">medilab.tax</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="code" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_medilab_tax_form" model="ir.ui.view">
        <field name="name">medilab.tax.form</field>
        <field name="model">medilab.tax</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <label for="code" />
                        <h1><field name="code" /></h1>
                    </div>
                    <group>
                        <field name="name" />
                    </group>
                    <notebook>
                        <page string="Rates" name="rates">
                            <field name="rate_ids">
                                <list editable="bottom">
                                    <field name="rate" />
                                    <field name="valid_from" />
                                    <field name="valid_until" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_tax_search" model="ir.ui.view">
        <field name="name">medilab.tax.search</field>
        <field name="model">medilab.tax</field>
        <field name="arch" type="xml">
            <search>
                <field name="display_name" string="Name" />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_tax" model="ir.actions.act_window">
        <field name="name">Taxes</field>
        <field name="res_model">medilab.tax</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
