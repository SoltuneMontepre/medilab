<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_support_request_list" model="ir.ui.view">
        <field name="name">medilab.support.request.list</field>
        <field name="model">medilab.support.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="status == 'open'" decoration-info="status == 'answered'" decoration-muted="status == 'closed'">
                <field name="code" />
                <field name="subject" />
                <field name="customer_id" />
                <field name="order_id" />
                <field name="status" />
                <field name="handled_by_id" />
                <field name="create_date" string="Opened" />
                <button name="action_take" type="object" string="Take" class="btn-primary" invisible="handled_by_id or status == 'closed'" />
            </list>
        </field>
    </record>

    <record id="view_medilab_support_request_form" model="ir.ui.view">
        <field name="name">medilab.support.request.form</field>
        <field name="model">medilab.support.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_take"
                        type="object"
                        string="Take"
                        class="btn-primary"
                        invisible="handled_by_id or status == 'closed'"
                    />
                    <button
                        name="action_close"
                        type="object"
                        string="Close"
                        class="btn-success"
                        invisible="status == 'closed'"
                    />
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="subject" placeholder="Subject" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" required="0" placeholder="Filled from the sequence when left empty" />
                            <field name="customer_id" />
                            <field name="customer_partner_id" invisible="1" />
                            <field name="order_id" domain="[('customer_id', 'child_of', customer_partner_id)]" />
                        </group>
                        <group>
                            <field name="opened_by_id" readonly="1" />
                            <field name="handled_by_id" readonly="1" />
                            <field name="closed_at" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_medilab_support_request_search" model="ir.ui.view">
        <field name="name">medilab.support.request.search</field>
        <field name="model">medilab.support.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="subject" />
                <field name="customer_id" />
                <field name="order_id" />
                <filter name="open" string="Open" domain="[('status', '=', 'open')]" />
                <filter name="answered" string="Answered" domain="[('status', '=', 'answered')]" />
                <filter name="closed" string="Closed" domain="[('status', '=', 'closed')]" />
                <separator />
                <filter name="untaken" string="Not taken" domain="[('handled_by_id', '=', False)]" />
                <filter name="mine" string="Mine" domain="[('handled_by_id', '=', uid)]" />
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}" />
                    <filter name="group_handler" string="Handled by" context="{'group_by': 'handled_by_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_support_request" model="ir.actions.act_window">
        <field name="name">Support requests</field>
        <field name="res_model">medilab.support.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1, 'search_default_answered': 1}</field>
        <field name="search_view_id" ref="view_medilab_support_request_search" />
    </record>
</odoo>
