<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="catalog_page" name="Catalog">
        <t t-call="portal.frontend_layout">
            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h1>Catalog</h1>
                    <a class="btn btn-primary" href="/cart"><iconify-icon icon="mdi:cart-outline" class="me-1" aria-hidden="true" />Cart (<t t-out="cart_quantity" />)</a>
                </div>
                <form method="get" action="/catalog" class="row g-2 mb-4">
                    <div class="col-md-3">
                        <select name="sample_type" class="form-select o_medilab_catalog_filter" aria-label="Sample type">
                            <option value="">All sample types</option>
                            <t t-foreach="sample_types" t-as="sample">
                                <option t-att-value="sample.id" t-att-selected="str(sample.id) == str(sample_type)" t-out="sample.name" />
                            </t>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="group" class="form-select o_medilab_catalog_filter" aria-label="Parameter group">
                            <option value="">All parameter groups</option>
                            <t t-foreach="parameter_groups" t-as="parameter_group">
                                <option t-att-value="parameter_group.id" t-att-selected="str(parameter_group.id) == str(group)" t-out="parameter_group.name" />
                            </t>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="text" name="name" class="form-control" placeholder="Name" t-att-value="name" />
                    </div>
                    <div class="col-md-1">
                        <input type="number" name="price_min" class="form-control" placeholder="Min" min="0" t-att-value="price_min" />
                    </div>
                    <div class="col-md-1">
                        <input type="number" name="price_max" class="form-control" placeholder="Max" min="0" t-att-value="price_max" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-secondary"><iconify-icon icon="mdi:filter-outline" class="me-1" aria-hidden="true" />Filter</button>
                    </div>
                </form>
                <t t-foreach="groups" t-as="entry">
                    <h2 t-out="entry[0].name" />
                    <t t-call="sol_commerce.catalog_products" products="entry[1]" />
                </t>
                <h2 t-if="packages">Service packages</h2>
                <t t-if="packages" t-call="sol_commerce.catalog_products" products="packages" />
            </div>
        </t>
    </template>

    <template id="catalog_products">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="text-end o_medilab_shrink">Price</th>
                        <th class="o_medilab_shrink" />
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="products" t-as="product">
                        <tr>
                            <td t-out="product.name" />
                            <td class="text-end o_medilab_shrink" t-out="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}" />
                            <td class="text-end o_medilab_shrink">
                                <form action="/catalog/add" method="post" class="d-flex justify-content-end gap-2">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                    <input type="hidden" name="product_tmpl_id" t-att-value="product.id" />
                                    <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 5rem" />
                                    <button type="submit" class="btn btn-primary"><iconify-icon icon="mdi:cart-plus" class="me-1" aria-hidden="true" />Add</button>
                                </form>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </template>

    <template id="cart_page" name="Cart">
        <t t-call="portal.frontend_layout">
            <div class="container py-4">
                <h1>Cart</h1>
                <p t-if="error" class="text-danger" t-out="error" />
                <t t-if="not lines">
                    <p>The cart is empty. <a href="/catalog">Browse the catalog</a>.</p>
                </t>
                <div class="table-responsive" t-if="lines">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="line">
                                <t t-set="quantity" t-value="int(line.product_uom_qty)" />
                                <tr>
                                    <td t-out="line.product_id.display_name" />
                                    <td class="text-end" t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                    <td>
                                        <form action="/cart/line" method="post" class="d-flex flex-wrap justify-content-end gap-2">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                            <input type="hidden" name="line_id" t-att-value="line.id" />
                                            <div class="btn-group" role="group">
                                                <button type="submit" name="quantity" t-att-value="quantity - 1" class="btn btn-secondary" t-att-disabled="quantity &lt;= 1" title="Decrease the quantity" aria-label="Decrease the quantity">−</button>
                                                <span class="btn btn-light disabled text-body" t-out="quantity" />
                                                <button type="submit" name="quantity" t-att-value="quantity + 1" class="btn btn-secondary" title="Increase the quantity" aria-label="Increase the quantity">+</button>
                                            </div>
                                            <button type="submit" name="quantity" value="0" class="btn btn-danger">Remove</button>
                                        </form>
                                    </td>
                                    <td class="text-end text-nowrap" t-out="line.price_unit * line.product_uom_qty" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3">Total excluding VAT</th>
                                <th class="text-end text-nowrap" t-out="order.catalog_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <form t-if="lines" action="/cart/submit" method="post" class="mt-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <div t-if="public" class="row g-2 mb-3">
                        <div class="col-md-4">
                            <input type="text" name="name" class="form-control" placeholder="Name" required="required" />
                        </div>
                        <div class="col-md-4">
                            <input type="email" name="email" class="form-control" placeholder="E-mail address" required="required" />
                        </div>
                        <div class="col-md-4">
                            <input type="text" name="phone" class="form-control" placeholder="Phone" />
                        </div>
                    </div>
                    <div t-if="contacts" class="mb-3">
                        <label for="contact_id" class="form-label">Contact for this order</label>
                        <select name="contact_id" id="contact_id" class="form-select">
                            <t t-foreach="contacts" t-as="contact">
                                <option t-att-value="contact.id" t-att-selected="contact == chosen_contact" t-out="contact.name" />
                            </t>
                        </select>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary"><iconify-icon icon="mdi:send" class="me-1" aria-hidden="true" />Submit</button>
                        <button type="submit" class="btn btn-secondary" formaction="/cart/save"><iconify-icon icon="mdi:content-save-outline" class="me-1" aria-hidden="true" />Save as draft</button>
                        <a class="btn btn-secondary" href="/catalog">Continue</a>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="order_submitted" name="Order submitted">
        <t t-call="portal.frontend_layout">
            <div class="container py-4">
                <h1>Order submitted</h1>
                <p>Your order <t t-out="order.name" /> is in the sales queue.</p>
                <a class="btn btn-secondary" href="/catalog">Back to the catalog</a>
            </div>
        </t>
    </template>

    <template id="order_list" name="Orders">
        <t t-call="portal.frontend_layout">
            <div class="container py-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h1 class="mb-0">My orders</h1>
                    <a class="btn btn-secondary" href="/catalog"><iconify-icon icon="mdi:flask" class="me-1" aria-hidden="true" />Catalog</a>
                </div>
                <div t-if="saved" class="alert alert-success" role="status">
                    Your draft is saved. It is listed here as Draft and stays in the cart until you submit it.
                </div>
                <t t-call="sol_commerce.order_table" />
                <div t-if="pager['page_count'] &gt; 1" class="mt-3">
                    <t t-call="portal.pager" />
                </div>
            </div>
        </t>
    </template>

    <template id="order_page" name="Order">
        <t t-call="portal.frontend_layout">
            <t t-set="cancel_mode" t-value="order.customer_cancel_mode()" />
            <t t-set="open_request" t-value="order.open_cancellation_request()" />
            <t t-set="quotation" t-value="order._latest_quotation()" />
            <div class="container py-4">
                <p t-if="request.params.get('error')" class="text-danger" t-out="request.params.get('error')" />
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <h1 class="mb-0" t-out="order.name" />
                    <t t-call="sol_commerce.order_status" />
                </div>
                <dl id="order_dates" class="row mb-2">
                    <t t-if="order.submitted_at">
                        <dt class="col-sm-3">Submitted</dt>
                        <dd class="col-sm-9" t-out="order.submitted_at" t-options="{'widget': 'datetime'}" />
                    </t>
                    <t t-else="">
                        <dt class="col-sm-3">Created</dt>
                        <dd class="col-sm-9" t-out="order.create_date" t-options="{'widget': 'datetime'}" />
                    </t>
                    <t t-if="quotation and order.payment_deadline">
                        <dt class="col-sm-3">Quotation deadline</dt>
                        <dd class="col-sm-9" t-out="order.payment_deadline" t-options="{'widget': 'datetime'}" />
                    </t>
                    <t t-if="order.expected_result_date">
                        <dt class="col-sm-3">Expected results</dt>
                        <dd class="col-sm-9" t-out="order.expected_result_date" t-options="{'widget': 'date'}" />
                    </t>
                </dl>
                <p t-if="quotation"><a t-att-href="'/orders/%s/quotation' % order.id">View quotation</a></p>
                <p t-if="order.reorder_note" t-out="order.reorder_note" />
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="line">
                                <tr>
                                    <td t-out="line.product_id.display_name" />
                                    <td class="text-end" t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                    <td class="text-end" t-out="int(line.product_uom_qty)" />
                                    <td class="text-end" t-out="line.price_unit * line.product_uom_qty" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3">Total excluding VAT</th>
                                <th class="text-end" t-out="order.catalog_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <t t-foreach="requests" t-as="cancellation">
                    <div class="border rounded p-3 mb-3">
                        <p>Cancellation: <t t-out="cancellation.status" /></p>
                        <p t-out="cancellation.reason" />
                        <p t-if="cancellation.reply">Reply: <t t-out="cancellation.reply" /></p>
                    </div>
                </t>
                <div id="order_actions" class="d-flex flex-wrap gap-2 mb-4">
                    <button t-if="cancel_mode == 'cancel'" type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#order_cancel_dialog">Cancel</button>
                    <button t-if="cancel_mode == 'request' and not open_request" type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#order_cancellation_dialog">Request cancellation</button>
                    <form t-if="open_request" t-att-action="'/orders/%s/cancellation/withdraw' % order.id" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                        <button type="submit" class="btn btn-secondary">Withdraw request</button>
                    </form>
                    <form t-if="order.can_reorder()" t-att-action="'/orders/%s/reorder' % order.id" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                        <button type="submit" class="btn btn-primary"><iconify-icon icon="mdi:repeat" class="me-1" aria-hidden="true" />Reorder</button>
                    </form>
                </div>
                <div t-if="cancel_mode == 'cancel'" class="modal fade" id="order_cancel_dialog" tabindex="-1" aria-labelledby="order_cancel_title" aria-hidden="true">
                    <div class="modal-dialog">
                        <form class="modal-content" t-att-action="'/orders/%s/cancel' % order.id" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                            <div class="modal-header">
                                <h2 class="modal-title fs-5" id="order_cancel_title">Cancel <t t-out="order.name" />?</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
                            </div>
                            <div class="modal-body">
                                <p class="mb-0">The order is cancelled and the laboratory will not work on it. This cannot be undone.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep the order</button>
                                <button type="submit" class="btn btn-danger">Cancel the order</button>
                            </div>
                        </form>
                    </div>
                </div>
                <div t-if="cancel_mode == 'request' and not open_request" class="modal fade" id="order_cancellation_dialog" tabindex="-1" aria-labelledby="order_cancellation_title" aria-hidden="true">
                    <div class="modal-dialog">
                        <form class="modal-content" t-att-action="'/orders/%s/cancellation' % order.id" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                            <div class="modal-header">
                                <h2 class="modal-title fs-5" id="order_cancellation_title">Request the cancellation of <t t-out="order.name" /></h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
                            </div>
                            <div class="modal-body">
                                <p>Sales decides on the request. Testing continues until the request is accepted.</p>
                                <p class="text-muted">If an advance was paid, it stays on the invoice and is settled outside the system.</p>
                                <textarea name="reason" class="form-control" placeholder="Reason" required="required" />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                <button type="submit" class="btn btn-danger">Request cancellation</button>
                            </div>
                        </form>
                    </div>
                </div>
                <h2 class="mt-4">Support</h2>
                <t t-set="statuses" t-value="dict(support_requests._fields['status']._description_selection(support_requests.env))" />
                <ul t-if="support_requests">
                    <li t-foreach="support_requests" t-as="support_request">
                        <a t-att-href="'/support/%s' % support_request.id" t-out="support_request.code" />
                        <t t-out="support_request.subject" /> (<t t-out="statuses[support_request.status]" />)
                    </li>
                </ul>
                <p><a class="btn btn-secondary" t-att-href="'/support/new?order_id=%s' % order.id">Ask for help about this order</a></p>
                <h2 class="mt-4" t-if="order.feedback_rating or order.can_give_feedback()">Feedback</h2>
                <div t-if="order.feedback_rating" class="border rounded p-3 mb-3">
                    <p>Your rating: <t t-out="order.feedback_rating" />/5</p>
                    <p t-if="order.feedback_comment" t-out="order.feedback_comment" />
                </div>
                <form t-if="order.can_give_feedback()" t-att-action="'/orders/%s/feedback' % order.id" method="post" class="mb-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <div class="mb-2">
                        <t t-foreach="range(1, 6)" t-as="star">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="rating" t-att-id="'rating-%s' % star" t-att-value="star" required="required" />
                                <label class="form-check-label" t-att-for="'rating-%s' % star" t-out="star" />
                            </div>
                        </t>
                    </div>
                    <textarea name="comment" class="form-control mb-2" placeholder="Comment" />
                    <button type="submit" class="btn btn-success">Send feedback</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
