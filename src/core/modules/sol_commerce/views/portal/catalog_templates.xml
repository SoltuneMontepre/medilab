<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="catalog_page" name="Catalog">
        <t t-call="portal.frontend_layout">
            <div class="container py-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h1>Catalog</h1>
                    <a class="btn btn-primary" href="/cart"><i class="oi me-1" data-icon="shopping_cart" aria-hidden="true" />Cart (<t t-out="cart_quantity" />)</a>
                </div>
                <p t-if="request.params.get('error')" class="text-danger" t-out="request.params.get('error')" />
                <form method="get" action="/catalog" class="row g-2 mb-4">
                    <div class="col-md-3">
                        <select name="sample_type" class="form-select o_medilab_catalog_filter" aria-label="Sample type">
                            <option value="">All sample types</option>
                            <t t-foreach="sample_types" t-as="sample">
                                <option t-att-value="sample.id" t-att-selected="str(sample.id) == str(sample_type)" t-out="sample.name" />
                            </t>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="group" class="form-select o_medilab_catalog_filter" aria-label="Parameter group">
                            <option value="">All parameter groups</option>
                            <t t-foreach="parameter_groups" t-as="parameter_group">
                                <option t-att-value="parameter_group.id" t-att-selected="str(parameter_group.id) == str(group)" t-out="parameter_group.name" />
                            </t>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="text" name="name" class="form-control" placeholder="Name" t-att-value="name" />
                    </div>
                    <div class="col-md-1">
                        <input type="number" name="price_min" class="form-control" placeholder="Min" min="0" t-att-value="price_min" />
                    </div>
                    <div class="col-md-1">
                        <input type="number" name="price_max" class="form-control" placeholder="Max" min="0" t-att-value="price_max" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-secondary"><i class="oi me-1" data-icon="filter_alt" aria-hidden="true" />Filter</button>
                    </div>
                </form>
                <t t-if="packages">
                    <h2 class="h4 mt-4 mb-3">Service packages</h2>
                    <t t-call="sol_commerce.catalog_products" products="packages" />
                </t>
                <t t-foreach="groups" t-as="entry">
                    <h2 class="h4 mt-4 mb-3" t-out="entry[0].name" />
                    <t t-call="sol_commerce.catalog_products" products="entry[1]" />
                </t>
                <p t-if="not packages and not groups" class="text-muted">No parameter or package matches the filters.</p>
            </div>
        </t>
    </template>

    <template id="catalog_products">
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            <t t-foreach="products" t-as="product">
                <t t-set="offer" t-value="product._catalog_offer()" />
                <t t-set="currency" t-value="product.currency_id" />
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column gap-2">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <h3 class="h6 mb-0" t-out="offer['name']" />
                                <span class="fs-5 fw-semibold text-nowrap" t-out="offer['price']" t-options="{'widget': 'monetary', 'display_currency': currency}" />
                            </div>
                            <t t-if="offer['lines']">
                                <span class="badge text-bg-light border align-self-start"><t t-out="len(offer['lines'])" /> parameters</span>
                                <ul class="list-unstyled small mb-0">
                                    <t t-foreach="offer['lines'][:5]" t-as="part" t-call="sol_commerce.catalog_package_part" />
                                </ul>
                                <details t-if="len(offer['lines']) &gt; 5" class="small">
                                    <summary class="text-primary">Show all parameters</summary>
                                    <ul class="list-unstyled mb-0 mt-1">
                                        <t t-foreach="offer['lines'][5:]" t-as="part" t-call="sol_commerce.catalog_package_part" />
                                    </ul>
                                </details>
                            </t>
                            <p t-elif="offer['sample_types']" class="small text-muted mb-0" t-out="offer['sample_types']" />
                            <p t-if="offer['next_date']" class="small text-muted mb-0">
                                From <t t-out="offer['next_date']" t-options="{'widget': 'date'}" />:
                                <t t-out="offer['next_price']" t-options="{'widget': 'monetary', 'display_currency': currency}" />
                            </p>
                            <a t-if="offer['lines']" class="btn btn-secondary align-self-start" t-attf-href="/catalog/packages/{{ product.id }}"><i class="oi me-1" data-icon="tune" aria-hidden="true" />Choose parameters</a>
                            <form action="/catalog/add" method="post" class="mt-auto pt-2">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                <input type="hidden" name="product_tmpl_id" t-att-value="product.id" />
                                <div class="input-group">
                                    <label class="input-group-text" t-att-for="'quantity_%s' % product.id">Quantity</label>
                                    <input type="number" name="quantity" value="1" min="1" class="form-control" t-att-id="'quantity_%s' % product.id" />
                                    <button type="submit" class="btn btn-primary"><i class="oi me-1" data-icon="add_shopping_cart" aria-hidden="true" />Add</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </template>

    <template id="catalog_package_part">
        <li class="d-flex gap-1">
            <i class="oi text-success" data-icon="check" aria-hidden="true" />
            <span t-out="part.parameter_id.name" /><span t-if="part.quantity &gt; 1" class="text-muted">× <t t-out="part.quantity" /></span>
        </li>
    </template>

    <template id="catalog_package_page" name="Service Package">
        <t t-call="portal.frontend_layout">
            <t t-set="currency" t-value="product.currency_id" />
            <div class="container py-4 o_medilab_package_page">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <a href="/catalog" class="btn btn-secondary"><i class="oi me-1" data-icon="arrow_back" aria-hidden="true" />Catalog</a>
                    <a class="btn btn-primary" href="/cart"><i class="oi me-1" data-icon="shopping_cart" aria-hidden="true" />Cart (<t t-out="cart_quantity" />)</a>
                </div>
                <p t-if="request.params.get('error')" class="alert alert-danger" t-out="request.params.get('error')" />
                <p t-if="request.params.get('added')" class="alert alert-success">The package is in the cart.</p>
                <form action="/catalog/add" method="post" class="row g-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <input type="hidden" name="product_tmpl_id" t-att-value="product.id" />
                    <input type="hidden" name="parameters_chosen" value="1" />
                    <div class="col-lg-8">
                        <h1 class="h3" t-out="offer['name']" />
                        <p class="text-muted"><span class="o_medilab_package_count" t-out="len(offer['lines'])" /> parameters chosen. Untick a parameter you do not need, or add another one; the price is the sum of the parameters.</p>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th class="o_medilab_shrink" />
                                        <th>Parameter</th>
                                        <th class="text-end o_medilab_shrink">Price</th>
                                    </tr>
                                </thead>
                                <tbody class="o_medilab_package_parts">
                                    <tr t-foreach="offer['lines']" t-as="part">
                                        <t t-call="sol_commerce.catalog_package_row" parameter="part.parameter_id" times="part.quantity" />
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div t-if="extras" class="input-group">
                            <label class="input-group-text" for="package_extra">Add a parameter</label>
                            <select id="package_extra" class="form-select o_medilab_package_extra">
                                <option value="">Choose a parameter</option>
                                <option t-foreach="extras" t-as="extra" t-att-value="extra.parameter_id.id" t-att-data-price="extra.list_price" t-out="extra.parameter_id.name" />
                            </select>
                            <button type="button" class="btn btn-secondary o_medilab_package_add"><i class="oi me-1" data-icon="add" aria-hidden="true" />Add</button>
                        </div>
                        <template class="o_medilab_package_row_template">
                            <tr>
                                <td class="o_medilab_shrink"><input type="checkbox" class="form-check-input" name="parameter_ids" checked="checked" data-quantity="1" /></td>
                                <td class="o_medilab_package_name" />
                                <td class="text-end text-nowrap o_medilab_package_price" />
                            </tr>
                        </template>
                    </div>
                    <div class="col-lg-4">
                        <div class="card position-sticky" style="top: 1rem">
                            <div class="card-body d-flex flex-column gap-3">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <span>Total</span>
                                    <span class="fs-4 fw-semibold o_medilab_package_total" t-att-data-currency="currency.symbol" t-out="offer['price']" t-options="{'widget': 'monetary', 'display_currency': currency}" />
                                </div>
                                <p t-if="offer['next_date']" class="small text-muted mb-0">
                                    From <t t-out="offer['next_date']" t-options="{'widget': 'date'}" />:
                                    <t t-out="offer['next_price']" t-options="{'widget': 'monetary', 'display_currency': currency}" /> for the whole package
                                </p>
                                <div class="input-group">
                                    <label class="input-group-text" for="package_quantity">Quantity</label>
                                    <input type="number" id="package_quantity" name="quantity" value="1" min="1" class="form-control o_medilab_package_quantity" />
                                </div>
                                <button type="submit" class="btn btn-secondary"><i class="oi me-1" data-icon="add_shopping_cart" aria-hidden="true" />Add to cart</button>
                                <button type="submit" name="buy_now" value="1" class="btn btn-primary"><i class="oi me-1" data-icon="shopping_cart_checkout" aria-hidden="true" />Buy now</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="catalog_package_row">
        <t t-set="price" t-value="parameter.price_ids[:1].list_price * times" />
        <td class="o_medilab_shrink">
            <input type="checkbox" class="form-check-input" name="parameter_ids" t-att-value="parameter.id" t-att-data-price="price" t-att-aria-label="parameter.name" checked="checked" />
        </td>
        <td><t t-out="parameter.name" /><span t-if="times &gt; 1" class="text-muted"> × <t t-out="times" /></span></td>
        <td class="text-end text-nowrap" t-out="price" t-options="{'widget': 'monetary', 'display_currency': currency}" />
    </template>

    <template id="cart_page" name="Cart">
        <t t-call="portal.frontend_layout">
            <div class="container py-4">
                <h1>Cart</h1>
                <p t-if="error" class="text-danger" t-out="error" />
                <t t-if="not lines">
                    <p>The cart is empty. <a href="/catalog">Browse the catalog</a>.</p>
                </t>
                <div class="table-responsive" t-if="lines">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="line">
                                <t t-set="quantity" t-value="int(line.product_uom_qty)" />
                                <tr>
                                    <td>
                                        <t t-out="line.product_id.display_name" />
                                        <div t-if="line.linked_line_ids" class="small text-muted" t-out="', '.join(line.linked_line_ids.product_id.mapped('name'))" />
                                    </td>
                                    <td class="text-end" t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                    <td>
                                        <form action="/cart/line" method="post" class="d-flex flex-wrap justify-content-end gap-2">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                            <input type="hidden" name="line_id" t-att-value="line.id" />
                                            <div class="btn-group" role="group">
                                                <button type="submit" name="quantity" t-att-value="quantity - 1" class="btn btn-secondary" t-att-disabled="quantity &lt;= 1" title="Decrease the quantity" aria-label="Decrease the quantity">−</button>
                                                <span class="btn btn-light disabled text-body" t-out="quantity" />
                                                <button type="submit" name="quantity" t-att-value="quantity + 1" class="btn btn-secondary" title="Increase the quantity" aria-label="Increase the quantity">+</button>
                                            </div>
                                            <button type="submit" name="quantity" value="0" class="btn btn-danger"><i class="oi me-1" data-icon="delete" aria-hidden="true" />Remove</button>
                                        </form>
                                    </td>
                                    <td class="text-end text-nowrap" t-out="line.price_unit * line.product_uom_qty" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3">Total excluding VAT</th>
                                <th class="text-end text-nowrap" t-out="order.catalog_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <form t-if="lines" action="/cart/submit" method="post" class="mt-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <div t-if="public" class="row g-2 mb-3">
                        <div class="col-md-4">
                            <input type="text" name="name" class="form-control" placeholder="Name" required="required" t-att-value="submitted.get('name', '')" />
                        </div>
                        <div class="col-md-4">
                            <input type="email" name="email" class="form-control" placeholder="E-mail address" required="required" t-att-value="submitted.get('email', '')" />
                        </div>
                        <div class="col-md-4">
                            <input type="text" name="phone" class="form-control" placeholder="Phone" t-att-value="submitted.get('phone', '')" />
                        </div>
                    </div>
                    <div t-if="contacts" class="mb-3">
                        <label for="contact_id" class="form-label">Contact for this order</label>
                        <select name="contact_id" id="contact_id" class="form-select">
                            <t t-foreach="contacts" t-as="contact">
                                <option t-att-value="contact.id" t-att-selected="contact == chosen_contact" t-out="contact.name" />
                            </t>
                        </select>
                    </div>
                    <t t-set="dated" t-value="order.sudo()" />
                    <t t-set="requested_date_value" t-value="submitted.get('requested_date') if 'requested_date' in submitted else request.params.get('requested_date') or (dated.requested_date and dated.requested_date.isoformat())" />
                    <t t-set="priority_requested" t-value="submitted.get('priority') if 'priority' in submitted else request.params.get('priority') or dated.priority_request == 'requested'" />
                    <div class="row g-2 mb-3 align-items-end">
                        <div class="col-md-4">
                            <label for="requested_date" class="form-label">Date you want the results</label>
                            <input type="date" name="requested_date" id="requested_date" class="form-control" t-att-value="requested_date_value" />
                        </div>
                        <div class="col-md-8">
                            <div class="form-check">
                                <input type="checkbox" name="priority" id="priority" value="1" class="form-check-input" t-att-checked="priority_requested" />
                                <label for="priority" class="form-check-label">Ask for priority: Sales confirms whether the laboratory can meet this date</label>
                            </div>
                        </div>
                        <p t-if="dated.turnaround_days" class="text-muted mb-0">Results within <t t-out="dated.turnaround_days" /> working days of receiving the samples.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary"><i class="oi me-1" data-icon="send" aria-hidden="true" />Submit</button>
                        <button type="submit" class="btn btn-secondary" formaction="/cart/save"><i class="oi me-1" data-icon="save" aria-hidden="true" />Save as draft</button>
                        <a class="btn btn-secondary" href="/catalog"><i class="oi me-1" data-icon="science" aria-hidden="true" />Continue</a>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="order_submitted" name="Order submitted">
        <t t-call="portal.frontend_layout">
            <div class="container py-4">
                <h1>Order submitted</h1>
                <p>Your order <t t-out="order.name" /> is in the sales queue.</p>
                <a class="btn btn-secondary" href="/catalog"><i class="oi me-1" data-icon="science" aria-hidden="true" />Back to the catalog</a>
            </div>
        </t>
    </template>

    <template id="order_list" name="Orders">
        <t t-call="portal.frontend_layout">
            <div class="container py-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h1 class="mb-0">My orders</h1>
                    <a class="btn btn-secondary" href="/catalog"><i class="oi me-1" data-icon="science" aria-hidden="true" />Catalog</a>
                </div>
                <div t-if="saved" class="alert alert-success" role="status">
                    Your draft is saved. It is listed here as Draft and stays in the cart until you submit it.
                </div>
                <form t-if="has_orders" method="get" action="/orders" class="row g-2 mb-3">
                    <div class="col-md-3">
                        <select name="status" class="form-select o_medilab_catalog_filter" aria-label="Status">
                            <option value="">All statuses</option>
                            <t t-foreach="statuses" t-as="status">
                                <option t-att-value="status[0]" t-att-selected="status[0] == filters.get('status')" t-out="status[1]" />
                            </t>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <input type="search" name="search" class="form-control" placeholder="Order number, parameter or package" aria-label="Search" t-att-value="filters.get('search')" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-secondary"><i class="oi me-1" data-icon="filter_alt" aria-hidden="true" />Filter</button>
                    </div>
                </form>
                <t t-call="sol_commerce.order_table" />
                <div t-if="pager['page_count'] &gt; 1" class="mt-3">
                    <t t-call="portal.pager" />
                </div>
            </div>
        </t>
    </template>

    <template id="order_page" name="Order">
        <t t-call="portal.frontend_layout">
            <t t-set="cancel_mode" t-value="order.customer_cancel_mode()" />
            <t t-set="open_request" t-value="order.open_cancellation_request()" />
            <t t-set="quotation" t-value="order._latest_quotation()" />
            <div class="container py-4">
                <a t-att-href="orders_url" class="d-inline-block mb-2"><i class="oi me-1" data-icon="arrow_back" aria-hidden="true" />My orders</a>
                <p t-if="request.params.get('error')" class="text-danger" t-out="request.params.get('error')" />
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <h1 class="mb-0" t-out="order.name" />
                    <t t-call="sol_commerce.order_status" />
                </div>
                <dl id="order_dates" class="d-flex flex-wrap column-gap-4 row-gap-1 mb-3">
                    <div t-if="order.submitted_at" class="d-flex gap-2">
                        <dt class="fw-normal text-muted">Submitted</dt>
                        <dd class="mb-0" t-out="order.submitted_at" t-options="{'widget': 'datetime'}" />
                    </div>
                    <div t-else="" class="d-flex gap-2">
                        <dt class="fw-normal text-muted">Created</dt>
                        <dd class="mb-0" t-out="order.create_date" t-options="{'widget': 'datetime'}" />
                    </div>
                    <div t-if="quotation and order.payment_deadline" class="d-flex gap-2">
                        <dt class="fw-normal text-muted">Quotation deadline</dt>
                        <dd class="mb-0" t-out="order.payment_deadline" t-options="{'widget': 'datetime'}" />
                    </div>
                    <div t-if="order.requested_date" class="d-flex gap-2">
                        <dt class="fw-normal text-muted">Requested date</dt>
                        <dd class="mb-0" t-out="order.requested_date" t-options="{'widget': 'date'}" />
                    </div>
                    <div t-if="order.priority_request" class="d-flex gap-2">
                        <dt class="fw-normal text-muted">Priority</dt>
                        <dd class="mb-0" t-out="dict(order._fields['priority_request']._description_selection(order.env))[order.priority_request]" />
                    </div>
                    <t t-set="committed" t-value="order.test_request_id.sudo().committed_date or order.committed_date" />
                    <div t-if="committed" class="d-flex gap-2">
                        <dt class="fw-normal text-muted">Expected return date</dt>
                        <dd class="mb-0" t-out="committed" t-options="{'widget': 'date'}" />
                    </div>
                    <div t-elif="order.turnaround_days" class="d-flex gap-2">
                        <dt class="fw-normal text-muted">Results</dt>
                        <dd class="mb-0">Within <t t-out="order.turnaround_days" /> working days of receiving the samples</dd>
                    </div>
                </dl>
                <p t-if="quotation"><a t-att-href="'/orders/%s/quotation' % order.id">View quotation</a></p>
                <t t-if="payment_request.kind == 'balance'" t-call="sol_commerce.payment_request_summary" />
                <p t-if="order.reorder_note" t-out="order.reorder_note" />
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="line">
                                <tr>
                                    <td>
                                        <span t-out="line.product_id.display_name" />
                                        <t t-set="tested" t-value="(line.linked_line_ids or line).sudo()" />
                                        <div t-if="line.sample_type_id" class="small text-muted">
                                            <t t-out="line.sample_type_id.name" />
                                            <t t-foreach="tested.filtered('parameter_method_id')" t-as="part">
                                                · <t t-out="part.parameter_method_id.display_name" />
                                            </t>
                                        </div>
                                    </td>
                                    <td class="text-end" t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                    <td class="text-end" t-out="int(line.product_uom_qty)" />
                                    <td class="text-end" t-out="line.price_unit * line.product_uom_qty" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3">Total excluding VAT</th>
                                <th class="text-end" t-out="order.catalog_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <section t-if="lines.filtered('sample_type_id')" class="mb-4">
                    <h2 class="h4">Expected samples</h2>
                    <t t-set="entries" t-value="order.sudo()._expected_sampling()" />
                    <t t-call="sol_commerce.expected_sampling" />
                </section>
                <t t-foreach="requests" t-as="cancellation">
                    <div class="border rounded p-3 mb-3">
                        <p>Cancellation: <t t-out="cancellation.status" /></p>
                        <p t-out="cancellation.reason" />
                        <p t-if="cancellation.reply">Reply: <t t-out="cancellation.reply" /></p>
                    </div>
                </t>
                <div id="order_actions" class="d-flex flex-wrap gap-2 mb-4">
                    <button t-if="cancel_mode == 'cancel'" type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#order_cancel_dialog"><i class="oi me-1" data-icon="cancel" aria-hidden="true" />Cancel</button>
                    <button t-if="cancel_mode == 'request' and not open_request" type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#order_cancellation_dialog"><i class="oi me-1" data-icon="cancel" aria-hidden="true" />Request cancellation</button>
                    <form t-if="open_request" t-att-action="'/orders/%s/cancellation/withdraw' % order.id" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                        <button type="submit" class="btn btn-secondary"><i class="oi me-1" data-icon="undo" aria-hidden="true" />Withdraw request</button>
                    </form>
                    <form t-if="order.can_reorder()" t-att-action="'/orders/%s/reorder' % order.id" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                        <t t-call="sol_commerce.order_filter_inputs" />
                        <button type="submit" class="btn btn-secondary"><i class="oi me-1" data-icon="repeat" aria-hidden="true" />Reorder</button>
                    </form>
                </div>
                <div t-if="cancel_mode == 'cancel'" class="modal fade" id="order_cancel_dialog" tabindex="-1" aria-labelledby="order_cancel_title" aria-hidden="true">
                    <div class="modal-dialog">
                        <form class="modal-content" t-att-action="'/orders/%s/cancel' % order.id" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                            <div class="modal-header">
                                <h2 class="modal-title fs-5" id="order_cancel_title">Cancel <t t-out="order.name" />?</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
                            </div>
                            <div class="modal-body">
                                <p class="mb-0">The order is cancelled and the laboratory will not work on it. This cannot be undone.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep the order</button>
                                <button type="submit" class="btn btn-danger"><i class="oi me-1" data-icon="cancel" aria-hidden="true" />Cancel the order</button>
                            </div>
                        </form>
                    </div>
                </div>
                <div t-if="cancel_mode == 'request' and not open_request" class="modal fade" id="order_cancellation_dialog" tabindex="-1" aria-labelledby="order_cancellation_title" aria-hidden="true">
                    <div class="modal-dialog">
                        <form class="modal-content" t-att-action="'/orders/%s/cancellation' % order.id" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                            <div class="modal-header">
                                <h2 class="modal-title fs-5" id="order_cancellation_title">Request the cancellation of <t t-out="order.name" /></h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
                            </div>
                            <div class="modal-body">
                                <p>Sales decides on the request. Testing continues until the request is accepted.</p>
                                <p class="text-muted">If an advance was paid, it stays on the invoice and is settled outside the system.</p>
                                <textarea name="reason" class="form-control" placeholder="Reason" required="required" />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                <button type="submit" class="btn btn-danger"><i class="oi me-1" data-icon="cancel" aria-hidden="true" />Request cancellation</button>
                            </div>
                        </form>
                    </div>
                </div>
                <h2 class="mt-4">Support</h2>
                <t t-set="statuses" t-value="dict(support_requests._fields['status']._description_selection(support_requests.env))" />
                <ul t-if="support_requests">
                    <li t-foreach="support_requests" t-as="support_request">
                        <a t-att-href="'/support/%s' % support_request.id" t-out="support_request.code" />
                        <t t-out="support_request.subject" /> <t t-call="sol_commerce.support_status" />
                    </li>
                </ul>
                <p><a class="btn btn-secondary" t-att-href="'/support/new?order_id=%s' % order.id"><i class="oi me-1" data-icon="support" aria-hidden="true" />Ask for help about this order</a></p>
                <h2 class="mt-4" t-if="order.feedback_rating or order.can_give_feedback()">Feedback</h2>
                <div t-if="order.feedback_rating" class="border rounded p-3 mb-3">
                    <p>Your rating: <t t-out="order.feedback_rating" />/5</p>
                    <p t-if="order.feedback_comment" t-out="order.feedback_comment" />
                </div>
                <form t-if="order.can_give_feedback()" t-att-action="'/orders/%s/feedback' % order.id" method="post" class="mb-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <div class="mb-2">
                        <t t-foreach="range(1, 6)" t-as="star">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="rating" t-att-id="'rating-%s' % star" t-att-value="star" required="required" />
                                <label class="form-check-label" t-att-for="'rating-%s' % star" t-out="star" />
                            </div>
                        </t>
                    </div>
                    <textarea name="comment" class="form-control mb-2" placeholder="Comment" />
                    <button type="submit" class="btn btn-success"><i class="oi me-1" data-icon="send" aria-hidden="true" />Send feedback</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
