<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="quotation_page" name="Quotation">
        <t t-call="portal.frontend_layout">
            <t t-set="statuses" t-value="dict(quotation._fields['status']._description_selection(quotation.env))" />
            <div class="container py-4">
                <p t-if="request.params.get('error')" class="text-danger" t-out="request.params.get('error')" />
                <p><a t-att-href="'/orders/%s' % order.id">Back to the order</a></p>
                <h1>Quotation <t t-out="quotation.code" /></h1>
                <div t-if="len(quotations) &gt; 1" class="alert alert-info" role="alert">
                    This is revision <t t-out="quotation.revision" />. Earlier revisions were replaced and no longer apply.
                </div>
                <p>Status: <t t-out="statuses[quotation.status]" /></p>
                <div t-if="revising" class="alert alert-warning" role="alert">
                    This quotation is being revised. Its items are shown again when the new revision is sent.
                </div>
                <div t-if="advance and not revising" class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
                    <div t-if="advance.amount_residual or advance.amount_owed &gt; 0">
                        <p class="mb-1">Advance invoice <t t-out="advance.name" />: <span t-field="advance.amount_owed" t-options='{"widget": "monetary", "display_currency": advance.currency_id}' /></p>
                        <p t-if="order.payment_deadline and quotation.status == 'sent'" class="mb-0">Pay the advance before <t t-out="order.payment_deadline" t-options="{'widget': 'datetime'}" />.</p>
                    </div>
                    <p t-else="" class="mb-0">Advance invoice <t t-out="advance.name" /> is paid.</p>
                    <!-- Paying accepts only a sent quotation, so a declined or expired one offers no payment. -->
                    <a t-if="advance.amount_residual and quotation.status == 'sent'" class="btn btn-primary" t-att-href="advance_url">Pay the advance</a>
                </div>
                <p t-if="order.payment_deadline and not quotation.advance_invoice_id">Accept the quotation before <t t-out="order.payment_deadline" t-options="{'widget': 'datetime'}" />.</p>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody t-if="not revising">
                            <t t-foreach="lines" t-as="line">
                                <tr>
                                    <td t-out="line.product_id.display_name" />
                                    <td class="text-end" t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                    <td class="text-end" t-out="int(line.product_uom_qty)" />
                                    <td class="text-end" t-out="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                </tr>
                                <tr t-foreach="line.linked_line_ids" t-as="part">
                                    <td class="ps-4 text-muted" t-out="part.product_id.display_name" />
                                    <td />
                                    <td class="text-end text-muted" t-out="int(part.product_uom_qty)" />
                                    <td />
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3">Total including VAT</th>
                                <th class="text-end" t-out="quotation.amount_total" t-options="{'widget': 'monetary', 'display_currency': quotation.currency_id}" />
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <p t-if="quotation.decline_reason">Reason for declining: <t t-out="quotation.decline_reason" /></p>
                <form t-if="quotation.status == 'sent' and not quotation.advance_invoice_id and not revising" t-att-action="'/orders/%s/quotation/accept' % order.id" method="post" class="mb-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <button type="submit" class="btn btn-success">Accept quotation</button>
                </form>
                <form t-if="quotation.status == 'sent'" t-att-action="'/orders/%s/quotation/decline' % order.id" method="post" class="mb-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <textarea name="reason" class="form-control mb-2" placeholder="Reason" required="required" />
                    <button type="submit" class="btn btn-danger">Decline quotation</button>
                </form>
                <h2>Revisions</h2>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Revision</th>
                                <th>Number</th>
                                <th>Status</th>
                                <th>Sent</th>
                                <th class="text-end">Total including VAT</th>
                                <th />
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="quotations" t-as="revision">
                                <td t-out="revision.revision" />
                                <td t-out="revision.code" />
                                <td t-out="statuses[revision.status]" />
                                <td t-out="revision.sent_at" t-options="{'widget': 'datetime'}" />
                                <td class="text-end" t-out="revision.amount_total" t-options="{'widget': 'monetary', 'display_currency': revision.currency_id}" />
                                <td class="text-end"><a t-att-href="'/orders/%s/quotation/%s/pdf' % (order.id, revision.id)">PDF</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>
