<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="quotation_page" name="Quotation">
        <t t-call="portal.frontend_layout">
            <t t-set="statuses" t-value="dict(quotation._fields['status']._description_selection(quotation.env))" />
            <div class="container py-4">
                <p t-if="request.params.get('error')" class="text-danger" t-out="request.params.get('error')" />
                <p><a t-att-href="'/orders/%s' % order.id">Back to the order</a></p>
                <h1>Quotation <t t-out="quotation.code" /></h1>
                <div t-if="len(quotations) &gt; 1" class="alert alert-info" role="alert">
                    This is revision <t t-out="quotation.revision" />. Earlier revisions were replaced and no longer apply.
                </div>
                <p>Status: <t t-out="statuses[quotation.status]" /></p>
                <p t-if="order.payment_deadline">Pay the advance before <t t-out="order.payment_deadline" t-options="{'widget': 'datetime'}" />.</p>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Parameter</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines" t-as="line">
                            <tr>
                                <td t-out="line.product_id.display_name" />
                                <td class="text-end" t-out="line.price_unit" />
                                <td class="text-end" t-out="line.product_uom_qty" />
                                <td class="text-end" t-out="line.price_unit * line.product_uom_qty" />
                            </tr>
                            <tr t-foreach="line.linked_line_ids" t-as="part">
                                <td class="ps-4 text-muted" t-out="part.product_id.display_name" />
                                <td />
                                <td class="text-end text-muted" t-out="part.product_uom_qty" />
                                <td />
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3">Total including VAT</th>
                            <th class="text-end" t-out="quotation.amount_total" />
                        </tr>
                    </tfoot>
                </table>
                <p t-if="quotation.decline_reason">Reason for declining: <t t-out="quotation.decline_reason" /></p>
                <form t-if="quotation.status == 'sent'" t-att-action="'/orders/%s/quotation/decline' % order.id" method="post" class="mb-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <textarea name="reason" class="form-control mb-2" placeholder="Reason" required="required" />
                    <button type="submit" class="btn btn-danger">Decline quotation</button>
                </form>
                <h2>Revisions</h2>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Revision</th>
                            <th>Number</th>
                            <th>Status</th>
                            <th>Sent</th>
                            <th class="text-end">Total including VAT</th>
                            <th />
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="quotations" t-as="revision">
                            <td t-out="revision.revision" />
                            <td t-out="revision.code" />
                            <td t-out="statuses[revision.status]" />
                            <td t-out="revision.sent_at" t-options="{'widget': 'datetime'}" />
                            <td class="text-end" t-out="revision.amount_total" />
                            <td class="text-end"><a t-att-href="'/orders/%s/quotation/%s/pdf' % (order.id, revision.id)">PDF</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
