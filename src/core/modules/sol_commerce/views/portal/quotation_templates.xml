<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="quotation_page" name="Quotation">
        <t t-call="portal.frontend_layout">
            <t t-set="statuses" t-value="dict(quotation._fields['status']._description_selection(quotation.env))" />
            <div class="container py-4">
                <p t-if="request.params.get('error')" class="text-danger" t-out="request.params.get('error')" />
                <p><a t-att-href="'/orders/%s' % order.id">Back to the order</a></p>
                <h1>Quotation <t t-out="quotation.code" /></h1>
                <div t-if="len(quotations) &gt; 1" class="alert alert-info" role="alert">
                    This is revision <t t-out="quotation.revision" />. Earlier revisions were replaced and no longer apply.
                </div>
                <p>Status: <t t-out="statuses[quotation.status]" /></p>
                <div t-if="revising" class="alert alert-warning" role="alert">
                    This quotation is being revised. Its items are shown again when the new revision is sent.
                </div>
                <t t-if="advance and not revising" t-call="sol_commerce.payment_request_summary" />
                <p t-if="legacy_invoice and not revising">
                    <a t-if="legacy_invoice.amount_residual and quotation.status == 'sent'" class="btn btn-primary" t-att-href="legacy_invoice_url"><i class="oi me-1" data-icon="credit_card" aria-hidden="true" />Pay the advance</a>
                </p>
                <p t-if="order.payment_deadline and not advance and not legacy_invoice">Accept the quotation before <t t-out="order.payment_deadline" t-options="{'widget': 'datetime'}" />.</p>
                <dl class="d-flex flex-wrap column-gap-4 row-gap-1 mb-3">
                    <div t-if="order.requested_date" class="d-flex gap-2">
                        <dt class="fw-normal text-muted">Requested date</dt>
                        <dd class="mb-0" t-out="order.requested_date" t-options="{'widget': 'date'}" />
                    </div>
                    <div t-if="order.priority_request" class="d-flex gap-2">
                        <dt class="fw-normal text-muted">Priority</dt>
                        <dd class="mb-0" t-out="dict(order._fields['priority_request']._description_selection(order.env))[order.priority_request]" />
                    </div>
                    <div t-if="order.committed_date" class="d-flex gap-2">
                        <dt class="fw-normal text-muted">Committed return date</dt>
                        <dd class="mb-0" t-out="order.committed_date" t-options="{'widget': 'date'}" />
                    </div>
                    <div t-elif="order.turnaround_days" class="d-flex gap-2">
                        <dt class="fw-normal text-muted">Results</dt>
                        <dd class="mb-0">Within <t t-out="order.turnaround_days" /> working days of receiving the samples</dd>
                    </div>
                </dl>
                <t t-set="show_discount" t-value="any(lines.mapped('discount'))" />
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Quantity</th>
                                <th t-if="show_discount" class="text-end">Discount</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody t-if="not revising">
                            <t t-foreach="lines" t-as="line">
                                <tr>
                                    <td t-out="line.product_id.display_name" />
                                    <td class="text-end" t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                    <td class="text-end" t-out="int(line.product_uom_qty)" />
                                    <td t-if="show_discount" class="text-end"><t t-out="line.discount" />%</td>
                                    <td class="text-end" t-out="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                                </tr>
                                <tr t-foreach="line.linked_line_ids" t-as="part">
                                    <td class="ps-4 text-muted" t-out="part.product_id.display_name" />
                                    <td />
                                    <td class="text-end text-muted" t-out="int(part.product_uom_qty)" />
                                    <td t-if="show_discount" />
                                    <td />
                                </tr>
                            </t>
                            <tr t-foreach="discount_lines" t-as="line">
                                <td t-att-colspan="4 if show_discount else 3" t-out="line.name" />
                                <td class="text-end" t-out="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}" />
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th t-att-colspan="4 if show_discount else 3">Total including VAT</th>
                                <th class="text-end" t-out="quotation.amount_total" t-options="{'widget': 'monetary', 'display_currency': quotation.currency_id}" />
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <section t-if="not revising" class="mb-3">
                    <h2 class="h4">Expected samples</h2>
                    <t t-set="entries" t-value="quotation.sudo().sampling_ids._sampling_entries()" />
                    <t t-call="sol_commerce.expected_sampling" />
                </section>
                <p t-if="quotation.decline_reason">Reason for declining: <t t-out="quotation.decline_reason" /></p>
                <form t-if="quotation.status == 'sent' and not advance.amount and not legacy_invoice and not revising" t-att-action="'/orders/%s/quotation/accept' % order.id" method="post" class="mb-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <input type="hidden" name="quotation_id" t-att-value="quotation.id" />
                    <button type="submit" class="btn btn-success"><i class="oi me-1" data-icon="check" aria-hidden="true" />Accept quotation</button>
                </form>
                <form t-if="quotation.status == 'sent'" t-att-action="'/orders/%s/quotation/decline' % order.id" method="post" class="mb-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <input type="hidden" name="quotation_id" t-att-value="quotation.id" />
                    <textarea name="reason" class="form-control mb-2" placeholder="Reason" required="required" />
                    <button type="submit" class="btn btn-danger"><i class="oi me-1" data-icon="close" aria-hidden="true" />Decline quotation</button>
                </form>
                <h2>Revisions</h2>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Revision</th>
                                <th>Number</th>
                                <th>Status</th>
                                <th>Sent</th>
                                <th class="text-end">Total including VAT</th>
                                <th />
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="quotations" t-as="revision">
                                <td t-out="revision.revision" />
                                <td t-out="revision.code" />
                                <td t-out="statuses[revision.status]" />
                                <td t-out="revision.sent_at" t-options="{'widget': 'datetime'}" />
                                <td class="text-end" t-out="revision.amount_total" t-options="{'widget': 'monetary', 'display_currency': revision.currency_id}" />
                                <td class="text-end"><a t-att-href="'/orders/%s/quotation/%s/pdf' % (order.id, revision.id)">PDF</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>
