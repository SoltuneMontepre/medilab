<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo shows its Sales app only once sale_management is installed; the E-commerce menus live in it. -->
    <record id="sale.sale_menu_root" model="ir.ui.menu">
        <field name="active" eval="True" />
        <field name="web_icon">sale,static/description/icon.png</field>
    </record>

    <menuitem id="menu_sale_order_queue" name="Unclaimed queue" parent="sale.sale_menu_root" action="action_medilab_sale_order_queue" sequence="15" />
    <menuitem id="menu_sale_order" name="Orders" parent="sale.sale_menu_root" action="action_medilab_sale_order" sequence="16" />
    <menuitem id="menu_cancellation_request" name="Cancellation requests" parent="sale.sale_menu_root" action="action_medilab_cancellation_request" sequence="17" />
    <menuitem id="menu_support_request" name="Support requests" parent="sale.sale_menu_root" action="action_medilab_support_request" sequence="18" />
    <menuitem
        id="menu_order_feedback"
        name="Feedback"
        parent="sale.sale_menu_root"
        action="action_medilab_order_feedback"
        groups="sol_laboratory.group_permission_order_read_all,group_all_orders"
        sequence="19"
    />

    <menuitem id="menu_commerce_root" name="E-commerce" sequence="40">
        <menuitem id="menu_invoice" action="action_medilab_invoice" sequence="5" />
        <menuitem id="menu_payment" action="action_medilab_payment" sequence="6" />
        <menuitem id="menu_reconciliation" action="action_medilab_reconciliation_day" sequence="7" />
        <menuitem id="menu_prices" name="Prices" sequence="10">
            <menuitem id="menu_parameter_price" action="action_medilab_parameter_price" sequence="10" />
            <menuitem id="menu_service_package" action="action_medilab_service_package" sequence="20" />
            <menuitem id="menu_subcontract_cost" action="action_medilab_subcontract_cost" sequence="30" />
            <menuitem id="menu_tax" action="action_medilab_tax" sequence="40" />
        </menuitem>
        <menuitem id="menu_customer_sales_terms" action="action_medilab_customer_sales_terms" sequence="20" />
    </menuitem>
</odoo>
