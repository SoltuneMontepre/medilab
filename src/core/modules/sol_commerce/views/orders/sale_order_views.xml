<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_sale_order_list" model="ir.ui.view">
        <field name="name">sale.order.list.medilab</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="order_status == 'cancelled'"
                decoration-success="order_status == 'completed'"
                decoration-warning="order_status == 'submitted'"
                decoration-info="order_status in ('claimed', 'confirmed')"
            >
                <field name="name" />
                <field name="customer_id" />
                <field name="partner_id" string="Contact" />
                <field name="user_id" />
                <field name="source" />
                <field name="order_status" />
                <field name="submitted_at" />
                <field name="currency_id" column_invisible="1" />
                <field name="catalog_total" />
            </list>
        </field>
    </record>

    <record id="view_medilab_sale_order_queue" model="ir.ui.view">
        <field name="name">sale.order.list.queue</field>
        <field name="model">sale.order</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="false" default_order="submitted_at asc, id" decoration-warning="order_status == 'submitted'">
                <field name="name" />
                <field name="customer_id" />
                <field name="partner_id" string="Contact" />
                <field name="submitted_at" />
                <field name="currency_id" column_invisible="1" />
                <field name="catalog_total" />
                <button name="action_claim" type="object" string="Claim" class="btn-primary" />
            </list>
        </field>
    </record>

    <record id="view_order_form_medilab" model="ir.ui.view">
        <field name="name">sale.order.form.medilab</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="order_status" widget="statusbar" statusbar_visible="draft,submitted,claimed,confirmed,completed" />
                <button
                    name="action_claim"
                    type="object"
                    string="Claim"
                    class="btn-primary"
                    invisible="order_status != 'submitted' or user_id"
                />
                <button
                    name="action_sales_cancel"
                    type="object"
                    string="Cancel"
                    class="btn-danger"
                    invisible="order_status in ('completed', 'cancelled')"
                    confirm="Cancel this order?"
                />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="customer_id" />
                <field name="source" readonly="1" />
                <field name="expected_result_date" />
                <field name="submitted_at" readonly="1" />
                <field name="claimed_at" readonly="1" />
                <field name="reordered_from_id" readonly="1" />
                <field name="approval_status" readonly="1" />
                <field name="currency_id" invisible="1" />
                <field name="catalog_total" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Cancellation" name="cancellation">
                    <field name="reorder_note" invisible="not reorder_note" />
                    <field name="cancellation_request_ids">
                        <list>
                            <field name="status" />
                            <field name="reason" />
                            <field name="reply" />
                            <field name="decided_at" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_medilab_sale_order_search" model="ir.ui.view">
        <field name="name">sale.order.search.medilab</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="customer_id" />
                <field name="partner_id" />
                <filter name="unclaimed" string="Unclaimed" domain="[('order_status', '=', 'submitted'), ('user_id', '=', False)]" />
                <filter name="draft" string="Draft" domain="[('order_status', '=', 'draft')]" />
                <filter name="confirmed" string="Confirmed" domain="[('order_status', '=', 'confirmed')]" />
                <filter name="cancelled" string="Cancelled" domain="[('order_status', '=', 'cancelled')]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_sale_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'medilab_sales_order': True}</field>
        <field name="search_view_id" ref="view_medilab_sale_order_search" />
    </record>
    <record id="action_medilab_sale_order_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_medilab_sale_order_list" />
        <field name="act_window_id" ref="action_medilab_sale_order" />
    </record>

    <record id="action_medilab_sale_order_queue" model="ir.actions.act_window">
        <field name="name">Unclaimed queue</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('order_status', '=', 'submitted'), ('user_id', '=', False)]</field>
        <field name="search_view_id" ref="view_medilab_sale_order_search" />
    </record>
    <record id="action_medilab_sale_order_queue_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_medilab_sale_order_queue" />
        <field name="act_window_id" ref="action_medilab_sale_order_queue" />
    </record>
</odoo>
