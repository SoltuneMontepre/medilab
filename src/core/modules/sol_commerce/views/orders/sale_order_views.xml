<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_sale_order_list" model="ir.ui.view">
        <field name="name">sale.order.list.medilab</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="order_status == 'cancelled'"
                decoration-success="order_status == 'completed'"
                decoration-warning="order_status == 'submitted'"
                decoration-info="order_status in ('claimed', 'confirmed')"
            >
                <field name="name" />
                <field name="customer_id" />
                <field name="partner_id" string="Contact" />
                <field name="user_id" />
                <field name="source" />
                <field name="order_status" />
                <field
                    name="customer_status"
                    string="Progress"
                    widget="badge"
                    decoration-success="customer_status == 'completed'"
                    decoration-warning="customer_status == 'waiting'"
                    decoration-info="customer_status == 'testing'"
                    decoration-danger="customer_status == 'cancelled'"
                />
                <field
                    name="quotation_follow_up"
                    widget="badge"
                    decoration-success="quotation_follow_up in ('paid', 'accepted')"
                    decoration-warning="quotation_follow_up == 'unpaid'"
                    decoration-danger="quotation_follow_up in ('declined', 'expired')"
                />
                <field name="submitted_at" />
                <field name="currency_id" column_invisible="1" />
                <field name="catalog_total" />
            </list>
        </field>
    </record>

    <record id="view_medilab_sale_order_queue" model="ir.ui.view">
        <field name="name">sale.order.list.queue</field>
        <field name="model">sale.order</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="false" default_order="submitted_at asc, id" decoration-warning="order_status == 'submitted'">
                <field name="name" />
                <field name="customer_id" />
                <field name="partner_id" string="Contact" />
                <field name="submitted_at" />
                <field name="currency_id" column_invisible="1" />
                <field name="catalog_total" />
                <button name="action_claim" type="object" string="Claim" class="btn-primary" />
            </list>
        </field>
    </record>

    <record id="view_order_form_medilab" model="ir.ui.view">
        <field name="name">sale.order.form.medilab</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_invoice']" position="attributes">
                <attribute name="groups">account.group_account_invoice</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="can_save_order_template" invisible="1" />
                <field name="order_status" widget="statusbar" statusbar_visible="draft,submitted,claimed,confirmed,completed" />
                <button
                    name="action_claim"
                    type="object"
                    string="Claim"
                    class="btn-primary"
                    invisible="order_status != 'submitted' or user_id"
                />
                <button
                    name="action_send_quotation"
                    type="object"
                    string="Send quotation"
                    class="btn-primary"
                    invisible="order_status in ('draft', 'submitted', 'completed', 'cancelled') or quotation_follow_up in ('unpaid', 'paid', 'accepted') and state != 'draft'"
                />
                <button
                    name="action_revise_quotation"
                    type="object"
                    string="Revise quotation"
                    class="btn-secondary"
                    invisible="quotation_follow_up != 'unpaid' or state != 'sent'"
                />
                <button
                    name="action_confirm_order"
                    type="object"
                    string="Confirm order"
                    class="btn-success"
                    invisible="order_status != 'claimed' or quotation_follow_up not in ('paid', 'accepted')"
                />
                <button
                    name="action_request_approval"
                    type="object"
                    string="Request approval"
                    class="btn-primary"
                    invisible="order_status != 'confirmed' or approval_status != 'none' or not approval_can_sign"
                />
                <button
                    name="action_sign"
                    type="object"
                    string="Approve"
                    class="btn-success"
                    invisible="order_status != 'confirmed' or approval_status != 'requested' or not approval_can_sign"
                />
                <button
                    name="%(action_medilab_order_reject)d"
                    type="action"
                    string="Reject"
                    class="btn-danger"
                    context="{'default_order_id': id}"
                    invisible="order_status != 'confirmed' or approval_status != 'requested' or not approval_can_reject"
                />
                <button
                    name="action_withdraw"
                    type="object"
                    string="Withdraw signature"
                    class="btn-secondary"
                    invisible="not approval_can_withdraw"
                />
                <button
                    name="action_start_sample_collection"
                    type="object"
                    string="Start sample collection"
                    class="btn-primary"
                    invisible="order_status != 'confirmed' or approval_status != 'approved'"
                />
                <button name="action_save_as_template" type="object" string="Save as template" class="btn-secondary" invisible="not can_save_order_template" groups="sol_laboratory.group_permission_order_template_create_all" />
                <button
                    name="action_sales_cancel"
                    type="object"
                    string="Cancel"
                    class="btn-danger"
                    invisible="order_status in ('completed', 'cancelled')"
                    confirm="Cancel this order?"
                />
            </xpath>
            <!-- Odoo's own sending, confirming, cancelling and state go around MediLab's flow, which the buttons above follow. -->
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@id='quotation_send_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@id='quotation_send']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@id='send_proforma_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@id='send_proforma']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@id='action_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm'][not(@id)]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='sale.action_report_saleorder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_preview_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_draft']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" invisible="not template_omission_note" groups="base.group_user">
                    <strong>Skipped catalog selections</strong>
                    <field name="template_omission_note" nolabel="1" readonly="1" />
                </div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not show_unpaid_warning or order_status not in ('claimed', 'confirmed')"
                >
                    Nothing has been paid on this order. It can still be confirmed.
                </div>
            </xpath>
            <!-- Each status says what it is about, and a requested approval names the role it waits for. -->
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <div class="d-flex flex-wrap align-items-center column-gap-4 row-gap-1">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted">Customer sees</span>
                        <field
                            name="customer_status"
                            widget="badge"
                            decoration-info="customer_status in ('quoted', 'waiting', 'testing')"
                            decoration-success="customer_status == 'completed'"
                            decoration-danger="customer_status == 'cancelled'"
                        />
                    </div>
                    <div class="d-flex align-items-center gap-2" invisible="not quotation_follow_up">
                        <span class="text-muted">Quotation</span>
                        <field
                            name="quotation_follow_up"
                            widget="badge"
                            decoration-warning="quotation_follow_up == 'unpaid'"
                            decoration-success="quotation_follow_up in ('paid', 'accepted')"
                            decoration-danger="quotation_follow_up in ('declined', 'expired')"
                        />
                    </div>
                    <div class="d-flex align-items-center gap-2" invisible="approval_status == 'none'">
                        <span class="text-muted">Approval</span>
                        <field
                            name="approval_status"
                            widget="badge"
                            decoration-warning="approval_status == 'requested'"
                            decoration-success="approval_status == 'approved'"
                            decoration-danger="approval_status == 'rejected'"
                        />
                        <span class="d-inline-flex align-items-center gap-1 text-muted" invisible="not approval_waiting_for">
                            waiting for <field name="approval_waiting_for" class="text-muted" />
                        </span>
                    </div>
                </div>
            </xpath>
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="before">
                <field name="customer_id" domain="[('customer_ids', '!=', False)]" options="{'no_create': True}" />
                <field name="customer_is_company" invisible="1" />
            </xpath>
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="attributes">
                <attribute name="widget">many2one</attribute>
                <attribute name="context">{}</attribute>
                <attribute name="options">{'no_create': True}</attribute>
                <attribute name="domain">[('id', 'child_of', customer_id)]</attribute>
                <attribute name="invisible">customer_id and not customer_is_company</attribute>
                <attribute name="readonly">not customer_id or state in ['cancel', 'sale']</attribute>
            </xpath>
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="source" readonly="1" />
                <field name="reordered_from_id" readonly="1" invisible="not reordered_from_id" />
                <field name="test_request_id" readonly="1" invisible="not test_request_id" />
                <field name="test_request_status" invisible="not test_request_id" />
                <field name="show_unpaid_warning" invisible="1" />
                <field name="approval_can_sign" invisible="1" />
                <field name="approval_can_reject" invisible="1" />
                <field name="approval_can_withdraw" invisible="1" />
            </xpath>
            <xpath expr="//group[@name='order_details']/field[@name='validity_date']" position="before">
                <field name="user_id" widget="many2one_avatar_user" />
            </xpath>
            <xpath expr="//group[@name='order_details']/field[@name='validity_date']" position="after">
                <field name="payment_deadline" />
                <field name="expected_result_date" />
            </xpath>
            <xpath expr="//group[@name='sales_person']/field[@name='user_id']" position="replace" />
            <!-- There are no customer price lists: special prices are discounts on the quotation. -->
            <xpath expr="//group[@name='order_details']/label[@for='pricelist_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='order_details']/div[field[@name='pricelist_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Prices are in VND, excluding VAT, so the tax-included switch does not apply. -->
            <xpath expr="//field[@id='document_tax_mode']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@id='document_tax_mode_mobile']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- A line is a parameter or a package tested on a sample; sections, notes, Odoo's catalog dialog, variants, free-text descriptions and delivered quantities do not apply. -->
            <xpath expr="//list[@name='sol_list']/control/create[@name='add_section_control']" position="replace" />
            <xpath expr="//list[@name='sol_list']/control/create[@name='add_note_control']" position="replace" />
            <xpath expr="//list[@name='sol_list']/control/button[@name='action_add_from_catalog']" position="replace" />
            <xpath expr="//field[@name='order_line']/kanban/control/create[@name='add_section_control']" position="replace" />
            <xpath expr="//field[@name='order_line']/kanban/control/create[@name='add_note_control']" position="replace" />
            <xpath expr="//field[@name='order_line']/kanban/control/button[@name='action_add_from_catalog']" position="replace" />
            <xpath expr="//div[@name='so_button_below_order_lines']/widget[@name='combo_menu']" position="replace" />
            <xpath expr="//list[@name='sol_list']/control/create[@name='add_product_control']" position="attributes">
                <attribute name="string">Add a parameter or package</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/kanban/control/create[@name='add_product_control']" position="attributes">
                <attribute name="string">Add a parameter or package</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/kanban//main/div[hasclass('text-muted')]" position="after">
                <div class="text-muted" invisible="not sample_id">Sample: <field name="sample_id" /></div>
            </xpath>
            <xpath expr="//list[@name='sol_list']/column[@name='product_and_description']" position="attributes">
                <attribute name="string">Parameter or package</attribute>
            </xpath>
            <xpath expr="//list[@name='sol_list']//field[@name='product_template_id']" position="attributes">
                <attribute name="optional" />
                <attribute name="required">not display_type and not is_downpayment</attribute>
                <attribute name="domain">[('sale_ok', '=', True), '|', ('parameter_id', '!=', False), ('service_package_id', '!=', False)]</attribute>
                <attribute name="placeholder">Type to find a parameter or package...</attribute>
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>
            <xpath expr="//list[@name='sol_list']//field[@name='product_id']" position="attributes">
                <attribute name="optional" />
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//list[@name='sol_list']//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//list[@name='sol_list']//field[@name='label']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//list[@name='sol_list']/column[field[@name='qty_delivered']]" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//list[@name='sol_list']/column[@name='product_and_description']" position="after">
                <field name="sample_id" domain="[('order_id', '=', parent.id)]" options="{'no_create': True}" />
            </xpath>
            <!-- The form of a line, used when the window is narrow, follows the list. -->
            <xpath expr="//field[@name='order_line']/form//label[@for='product_id']" position="attributes">
                <attribute name="string">Parameter or package</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('sale_ok', '=', True), '|', ('parameter_id', '!=', False), ('service_package_id', '!=', False)]</attribute>
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form/group/group/field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form/group/group/field[@name='name']" position="after">
                <field name="sample_id" domain="[('order_id', '=', parent.id)]" options="{'no_create': True}" />
            </xpath>
            <xpath expr="//field[@name='order_line']/form//label[@for='qty_delivered']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//div[@name='delivered_qty']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Samples" name="samples">
                    <field name="sample_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="customer_sample_name" />
                            <field name="sample_type_id" />
                            <field name="physical_state" />
                            <field name="regulation_id" />
                            <button name="action_copy_sample" type="object" string="Copy" class="btn-secondary" />
                        </list>
                    </field>
                </page>
                <page string="Revisions" name="revisions">
                    <field name="quotation_ids" readonly="1">
                        <list decoration-muted="status == 'replaced'">
                            <field name="revision" />
                            <field name="code" />
                            <field name="status" />
                            <field name="sent_at" />
                            <field name="currency_id" column_invisible="1" />
                            <field name="amount_total" />
                            <field name="decline_reason" />
                            <field name="attachment_id" />
                        </list>
                    </field>
                </page>
                <page string="Payment" name="payment">
                    <group>
                        <group>
                            <field name="advance_method" />
                            <field name="advance_mode" invisible="not advance_method or advance_method == 'none'" />
                            <field name="advance_value" invisible="advance_mode not in ('percentage', 'fixed')" />
                        </group>
                        <group>
                            <field name="payment_status" />
                            <field name="pending_amount" />
                            <field name="catalog_total" />
                        </group>
                    </group>
                    <separator string="Advance payments" invisible="not downpayment_line_ids" />
                    <field name="downpayment_line_ids" invisible="not downpayment_line_ids">
                        <list>
                            <field name="downpayment_invoice_id" />
                            <field name="currency_id" column_invisible="1" />
                            <field name="price_unit" string="Untaxed amount" widget="monetary" />
                        </list>
                        <form>
                            <group>
                                <field name="downpayment_invoice_id" />
                                <field name="currency_id" invisible="1" />
                                <field name="price_unit" string="Untaxed amount" widget="monetary" />
                            </group>
                        </form>
                    </field>
                </page>
                <page string="Tracking" name="tracking">
                    <group>
                        <group>
                            <field name="submitted_at" readonly="1" />
                            <field name="claimed_at" readonly="1" />
                            <field name="quoted_at" invisible="not quoted_at" />
                            <field name="accepted_at" invisible="not accepted_at" />
                        </group>
                        <group>
                            <field name="approved_at" invisible="not approved_at" />
                            <field name="document_version" readonly="1" />
                        </group>
                    </group>
                </page>
                <page string="Cancellation" name="cancellation">
                    <field name="reorder_note" invisible="not reorder_note" />
                    <field name="cancellation_request_ids">
                        <list>
                            <field name="status" />
                            <field name="reason" />
                            <field name="reply" />
                            <field name="decided_at" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Runs after every other change to the order form, so they all still find Odoo's order lines field. -->
    <record id="view_order_form_medilab_product_lines" model="ir.ui.view">
        <field name="name">sale.order.form.medilab.product.lines</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <!-- The Order Lines tab edits the ordered parameters and packages; the Payment tab lists the down payments. -->
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']" position="attributes">
                <attribute name="name">product_line_ids</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_medilab_sale_order_search" model="ir.ui.view">
        <field name="name">sale.order.search.medilab</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="customer_id" />
                <field name="partner_id" />
                <field name="user_id" />
                <filter name="unclaimed" string="Unclaimed" domain="[('order_status', '=', 'submitted'), ('user_id', '=', False)]" />
                <filter name="draft" string="Draft" domain="[('order_status', '=', 'draft')]" />
                <filter name="confirmed" string="Confirmed" domain="[('order_status', '=', 'confirmed')]" />
                <filter name="cancelled" string="Cancelled" domain="[('order_status', '=', 'cancelled')]" />
                <separator />
                <filter name="unpaid" string="Quotation unpaid" domain="[('quotation_follow_up', '=', 'unpaid')]" />
                <filter name="paid" string="Quotation paid" domain="[('quotation_follow_up', '=', 'paid')]" />
                <filter name="quotation_accepted" string="Quotation accepted" domain="[('quotation_follow_up', '=', 'accepted')]" />
                <filter name="quotation_declined" string="Quotation declined" domain="[('quotation_follow_up', '=', 'declined')]" />
                <filter name="quotation_expired" string="Quotation expired" domain="[('quotation_follow_up', '=', 'expired')]" />
                <separator />
                <filter name="date_order" string="Order date" date="date_order" />
                <group>
                    <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}" />
                    <filter name="group_pipeline_stage" string="Pipeline stage" context="{'group_by': 'pipeline_stage'}" />
                    <filter name="group_date_order" string="Order date" context="{'group_by': 'date_order:month'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_sale_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sale.order</field>
        <field name="path">lab-orders</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'medilab_sales_order': True}</field>
        <field name="search_view_id" ref="view_medilab_sale_order_search" />
    </record>
    <record id="action_medilab_sale_order_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_medilab_sale_order_list" />
        <field name="act_window_id" ref="action_medilab_sale_order" />
    </record>

    <record id="action_medilab_sale_order_queue" model="ir.actions.act_window">
        <field name="name">Unclaimed queue</field>
        <field name="res_model">sale.order</field>
        <field name="path">unclaimed-orders</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('order_status', '=', 'submitted'), ('user_id', '=', False)]</field>
        <field name="search_view_id" ref="view_medilab_sale_order_search" />
    </record>
    <record id="action_medilab_sale_order_queue_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_medilab_sale_order_queue" />
        <field name="act_window_id" ref="action_medilab_sale_order_queue" />
    </record>
</odoo>
