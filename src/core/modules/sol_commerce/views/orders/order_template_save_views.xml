<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_template_save_form" model="ir.ui.view">
        <field name="name">medilab.order.template.save.form</field>
        <field name="model">medilab.order.template.save</field>
        <field name="arch" type="xml">
            <form string="Save as template">
                <group><field name="order_id" invisible="1" /><field name="name" /></group>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
