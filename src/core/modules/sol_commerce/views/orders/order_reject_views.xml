<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_order_reject_form" model="ir.ui.view">
        <field name="name">medilab.order.reject.form</field>
        <field name="model">medilab.order.reject</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="order_id" invisible="1" />
                    <field name="reason" />
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" />
                    <button special="cancel" string="Discard" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_order_reject" model="ir.actions.act_window">
        <field name="name">Reject the approval</field>
        <field name="res_model">medilab.order.reject</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>