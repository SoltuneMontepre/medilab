<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_cancellation_request_list" model="ir.ui.view">
        <field name="name">medilab.cancellation.request.list</field>
        <field name="model">medilab.cancellation.request</field>
        <field name="arch" type="xml">
            <list create="false" decoration-warning="status == 'requested'" decoration-success="status == 'accepted'" decoration-danger="status == 'declined'">
                <field name="order_id" />
                <field name="status" />
                <field name="reason" />
                <field name="reply" />
                <field name="decided_at" />
            </list>
        </field>
    </record>

    <record id="view_medilab_cancellation_request_form" model="ir.ui.view">
        <field name="name">medilab.cancellation.request.form</field>
        <field name="model">medilab.cancellation.request</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button
                        name="action_accept"
                        type="object"
                        string="Accept"
                        class="btn-success"
                        invisible="status != 'requested'"
                        confirm="Accepting cancels the order. A paid advance is not returned."
                    />
                    <button
                        name="action_decline"
                        type="object"
                        string="Decline"
                        class="btn-danger"
                        invisible="status != 'requested'"
                    />
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id" readonly="1" />
                            <field name="requested_by_id" readonly="1" />
                            <field name="reason" readonly="1" />
                        </group>
                        <group>
                            <field name="decided_by_id" readonly="1" />
                            <field name="decided_at" readonly="1" />
                            <field name="reply" readonly="status != 'requested'" />
                        </group>
                    </group>
                    <p class="text-muted">
                        If an advance was paid, it stays on the invoice and is settled outside the system.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medilab_cancellation_request_search" model="ir.ui.view">
        <field name="name">medilab.cancellation.request.search</field>
        <field name="model">medilab.cancellation.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id" />
                <filter name="open" string="Open" domain="[('status', '=', 'requested')]" />
                <filter name="accepted" string="Accepted" domain="[('status', '=', 'accepted')]" />
                <filter name="declined" string="Declined" domain="[('status', '=', 'declined')]" />
            </search>
        </field>
    </record>

    <record id="action_medilab_cancellation_request" model="ir.actions.act_window">
        <field name="name">Cancellation requests</field>
        <field name="res_model">medilab.cancellation.request</field>
        <field name="path">cancellation-requests</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
