<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_quotation_send_form" model="ir.ui.view">
        <field name="name">medilab.quotation.send.form</field>
        <field name="model">medilab.quotation.send</field>
        <field name="arch" type="xml">
            <form>
                <field name="order_id" invisible="1" force_save="1" />
                <field name="customer_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="on_credit" invisible="1" />
                <group>
                    <group>
                        <field name="partner_id" domain="[('id', 'child_of', customer_id)]" options="{'no_create': True}" context="{'partner_display_name_hide_company': True}" required="1" />
                        <field name="partner_email" />
                    </group>
                    <group>
                        <field name="payment_deadline" />
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="product_template_id" string="Parameter or package" readonly="1" />
                        <field name="sample_id" readonly="1" />
                        <field name="product_uom_qty" string="Quantity" readonly="1" digits="[16, 0]" />
                        <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}" />
                        <field name="discount" string="Discount (%)" digits="[16, 0]" />
                        <field name="tax_ids" widget="many2many_tags" readonly="1" />
                        <field name="currency_id" column_invisible="1" />
                        <field name="price_subtotal" />
                    </list>
                </field>
                <group>
                    <group string="Payment">
                        <field name="advance_method" required="1" />
                        <field name="advance_mode" invisible="not advance_method or advance_method == 'none'" />
                        <field name="advance_value" invisible="advance_mode not in ('percentage', 'fixed')" />
                        <field name="balance_due" invisible="not advance_method or advance_mode == 'full' or on_credit" />
                    </group>
                    <group string="Total">
                        <label for="discount_type" />
                        <div class="d-flex align-items-center gap-2">
                            <field name="discount_type" class="w-auto" />
                            <field name="discount_percentage" class="w-25" digits="[16, 0]" invisible="discount_type != 'percentage'" />
                            <field name="discount_amount" class="w-50" invisible="discount_type != 'amount'" />
                            <button name="action_apply_discount" type="object" string="Apply" class="btn-secondary" invisible="not discount_percentage and not discount_amount" />
                        </div>
                        <field name="tax_totals" widget="account-tax-totals-field" nolabel="1" colspan="2" readonly="1" />
                    </group>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send quotation" class="btn-primary" />
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary" />
                    <button special="cancel" string="Discard" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medilab_quotation_send" model="ir.actions.act_window">
        <field name="name">Send Quotation</field>
        <field name="res_model">medilab.quotation.send</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
