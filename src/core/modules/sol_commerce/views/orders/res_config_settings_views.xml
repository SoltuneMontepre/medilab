<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_orders" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sol_commerce.orders</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sol_commerce']" position="inside">
                <block title="Quotations" name="quotation_setting_container">
                    <setting id="payment_deadline_setting">
                        <field name="payment_deadline_days" class="o_light_label" />
                    </setting>
                </block>
                <block title="Priority Orders" name="priority_setting_container">
                    <setting id="priority_orders_setting" help="Customers and Sales may ask for results earlier than the standard turnaround.">
                        <field name="priority_orders" widget="radio" options="{'horizontal': true}" />
                    </setting>
                    <setting id="priority_min_turnaround_setting" invisible="priority_orders != 'on'">
                        <field name="priority_min_turnaround_days" class="o_light_label" />
                    </setting>
                    <setting id="priority_surcharge_setting" invisible="priority_orders != 'on'">
                        <field name="priority_surcharge_percent" class="o_light_label" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>