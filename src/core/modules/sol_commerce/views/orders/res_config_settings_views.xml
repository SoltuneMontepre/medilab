<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_orders" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sol_commerce.orders</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sol_commerce']" position="inside">
                <block title="Quotations" name="quotation_setting_container">
                    <setting id="payment_deadline_setting">
                        <field name="payment_deadline_days" class="o_light_label" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>