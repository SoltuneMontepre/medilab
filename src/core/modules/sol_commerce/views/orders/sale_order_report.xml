<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_customer_logo" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='address']/*[1]" position="before">
            <img
                t-if="doc.partner_id.commercial_partner_id.image_128"
                t-att-src="image_data_uri(doc.partner_id.commercial_partner_id.image_128)"
                class="mb-2"
                style="max-height: 60px"
                alt="Logo"
            />
        </xpath>
        <!-- The quotation prints its own number, not the order's. -->
        <xpath expr="//t[@t-set='layout_document_title']/span[@t-field='doc.name']" position="replace">
            <span t-out="env.context.get('quotation_code') or doc.quotation_code or doc.name" />
        </xpath>
        <xpath expr="//div[@t-if='doc.user_id.name']/strong" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@t-if='doc.user_id.name']" position="inside">
            <div class="fw-bold">Salesperson</div>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="inside">
            <span>Parameter or package</span>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="inside">
            <span>Quantity</span>
        </xpath>
        <xpath expr="//td[@name='td_product_quantity']/span[@t-field='line.product_uom_id']" position="replace" />
    </template>
</odoo>
