<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.medilab</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id'][1]" position="after">
                <field name="method" readonly="state != 'draft'" />
                <field name="reviewed_by_id" />
                <field name="reviewed_at" />
                <field name="rejection_reason" readonly="state != 'draft'" />
                <field name="exceeds_residual" invisible="not exceeds_residual" />
            </xpath>
            <button name="action_post" position="after">
                <button
                    name="action_reject_payment"
                    type="object"
                    string="Reject"
                    invisible="state != 'draft' or not method"
                    groups="account.group_account_invoice"
                />
            </button>
        </field>
    </record>

    <record id="action_medilab_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">account.payment</field>
        <field name="path">payments</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("method", "!=", False)]</field>
    </record>
</odoo>
