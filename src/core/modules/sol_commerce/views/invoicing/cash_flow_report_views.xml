<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_cash_flow_report_list" model="ir.ui.view">
        <field name="name">medilab.cash.flow.report.list</field>
        <field name="model">medilab.cash.flow.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="name" />
                <field name="partner_id" />
                <field name="invoices" />
                <field name="method" />
                <field name="user_id" optional="hide" />
                <field name="currency_id" column_invisible="True" />
                <field name="amount" sum="Total" />
            </list>
        </field>
    </record>

    <record id="view_medilab_cash_flow_report_pivot" model="ir.ui.view">
        <field name="name">medilab.cash.flow.report.pivot</field>
        <field name="model">medilab.cash.flow.report</field>
        <field name="arch" type="xml">
            <pivot string="Cash Flow">
                <field name="date" interval="month" type="row" />
                <field name="method" type="col" />
                <field name="amount" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_medilab_cash_flow_report_graph" model="ir.ui.view">
        <field name="name">medilab.cash.flow.report.graph</field>
        <field name="model">medilab.cash.flow.report</field>
        <field name="arch" type="xml">
            <graph string="Cash Flow" type="bar" stacked="1">
                <field name="date" interval="month" />
                <field name="method" />
                <field name="amount" type="measure" />
            </graph>
        </field>
    </record>

    <record id="view_medilab_cash_flow_report_search" model="ir.ui.view">
        <field name="name">medilab.cash.flow.report.search</field>
        <field name="model">medilab.cash.flow.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="invoices" />
                <field name="user_id" />
                <filter name="date" string="Payment date" date="date" />
                <group>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}" />
                    <filter name="group_method" string="Payment method" context="{'group_by': 'method'}" />
                    <filter name="group_date" string="Payment date" context="{'group_by': 'date:month'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_cash_flow_report" model="ir.actions.act_window">
        <field name="name">Cash Flow</field>
        <field name="res_model">medilab.cash.flow.report</field>
        <field name="path">cash-flow-reports</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('status', '=', 'confirmed')]</field>
    </record>

    <record id="action_medilab_pending_payment_report" model="ir.actions.act_window">
        <field name="name">Pending Payments</field>
        <field name="res_model">medilab.cash.flow.report</field>
        <field name="path">pending-payment-reports</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('status', '=', 'pending')]</field>
    </record>
</odoo>
