<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_revenue_report_list" model="ir.ui.view">
        <field name="name">medilab.revenue.report.list</field>
        <field name="model">medilab.revenue.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="name" />
                <field name="partner_id" />
                <field name="parameter_id" />
                <field name="group_id" />
                <field name="currency_id" column_invisible="True" />
                <field name="invoiced" sum="Total" />
                <field name="collected" sum="Total" />
            </list>
        </field>
    </record>

    <record id="view_medilab_revenue_report_pivot" model="ir.ui.view">
        <field name="name">medilab.revenue.report.pivot</field>
        <field name="model">medilab.revenue.report</field>
        <field name="arch" type="xml">
            <pivot string="Revenue">
                <field name="group_id" type="row" />
                <field name="date" interval="month" type="col" />
                <field name="invoiced" type="measure" />
                <field name="collected" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_medilab_revenue_report_graph" model="ir.ui.view">
        <field name="name">medilab.revenue.report.graph</field>
        <field name="model">medilab.revenue.report</field>
        <field name="arch" type="xml">
            <graph string="Revenue" type="bar">
                <field name="date" interval="month" />
                <field name="invoiced" type="measure" />
            </graph>
        </field>
    </record>

    <record id="view_medilab_revenue_report_search" model="ir.ui.view">
        <field name="name">medilab.revenue.report.search</field>
        <field name="model">medilab.revenue.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="group_id" />
                <field name="parameter_id" />
                <field name="name" />
                <filter name="date" string="Invoice date" date="date" />
                <group>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}" />
                    <filter name="group_group" string="Main group" context="{'group_by': 'group_id'}" />
                    <filter name="group_date" string="Invoice date" context="{'group_by': 'date:month'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_medilab_revenue_report" model="ir.actions.act_window">
        <field name="name">Revenue</field>
        <field name="res_model">medilab.revenue.report</field>
        <field name="path">revenue-reports</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>
</odoo>
