<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_reconciliation_day_list" model="ir.ui.view">
        <field name="name">medilab.reconciliation.day.list</field>
        <field name="model">medilab.reconciliation.day</field>
        <field name="arch" type="xml">
            <list>
                <field name="day" />
                <field name="status" />
                <field name="missing_payment_count" />
                <field name="locked_at" />
            </list>
        </field>
    </record>

    <record id="view_medilab_reconciliation_day_form" model="ir.ui.view">
        <field name="name">medilab.reconciliation.day.form</field>
        <field name="model">medilab.reconciliation.day</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post_missing_payments" type="object" string="Post missing payments" invisible="status == 'locked'" />
                    <button name="action_lock" type="object" string="Lock" invisible="status == 'locked'" />
                    <button name="action_print" type="object" string="Print" />
                    <field name="status" widget="statusbar" />
                </header>
                <group>
                    <field name="day" readonly="status == 'locked'" />
                    <field name="locked_by_id" />
                    <field name="locked_at" />
                    <field name="missing_payment_count" />
                    <field name="mismatch_count" />
                    <field name="discrepancies_acknowledged" readonly="status == 'locked'" />
                </group>
                <field name="transaction_ids">
                    <list>
                        <field name="reference" />
                        <field name="provider_reference" />
                        <field name="amount" />
                        <field name="payos_settlement" />
                        <field name="payos_transferred_at" />
                        <field name="state" />
                        <field name="payos_bank_reference" />
                        <field name="recorded_after_lock" />
                        <field name="payment_id" />
                    </list>
                </field>
            </form>
        </field>
    </record>

    <record id="action_medilab_reconciliation_day" model="ir.actions.act_window">
        <field name="name">Reconciliation</field>
        <field name="res_model">medilab.reconciliation.day</field>
        <field name="path">reconciliation-days</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
