<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_collection_form" model="ir.ui.view">
        <field name="name">medilab.payment.collection.form</field>
        <field name="model">medilab.payment.collection</field>
        <field name="arch" type="xml">
            <form>
                <field name="currency_id" invisible="1" />
                <field name="payment_request_id" invisible="1" />
                <group>
                    <group string="Quotation">
                        <field name="order_id" options="{'no_open': True}" />
                        <field name="customer_id" options="{'no_open': True}" />
                        <field name="order_total" />
                        <field name="request_kind" invisible="not payment_request_id" />
                        <field name="request_amount" invisible="not payment_request_id or not verified_amount" />
                        <field name="verified_amount" invisible="not verified_amount" />
                        <field name="remaining_amount" invisible="not payment_request_id" />
                        <field name="deadline" invisible="not deadline" />
                    </group>
                    <group string="Payment">
                        <field name="amount" />
                        <field name="method" />
                        <field name="received_at" />
                        <field name="reference" />
                    </group>
                </group>
                <footer>
                    <button name="action_record" type="object" string="Record payment" class="btn-success" />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_payment_collection" model="ir.actions.act_window">
        <field name="name">Record payment</field>
        <field name="res_model">medilab.payment.collection</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
