<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medilab_invoice_list" model="ir.ui.view">
        <field name="name">account.move.list.medilab.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date'][contains(@column_invisible, 'out_invoice')]" position="after">
                <field name="invoice_kind" optional="show" />
                <field name="order_id" optional="hide" />
                <field name="amount_owed" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="view_medilab_invoice_form" model="ir.ui.view">
        <field name="name">account.move.form.medilab.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <button name="action_reverse" position="after">
                <button
                    name="%(action_medilab_invoice_adjustment)d"
                    type="action"
                    string="Adjust"
                    invisible="state != 'posted' or move_type != 'out_invoice' or invoice_kind not in ('advance', 'final')"
                    groups="account.group_account_invoice"
                    context="{'default_move_id': id}"
                />
            </button>
            <xpath expr="//group[@id='header_right_group']/field[@name='invoice_date'][1]" position="after">
                <field name="invoice_kind" readonly="state != 'draft'" />
                <field name="order_id" readonly="state != 'draft'" />
                <field
                    name="adjusted_invoice_id"
                    invisible="invoice_kind != 'adjustment' or move_type != 'out_invoice'"
                />
                <field name="amount_owed" invisible="invoice_kind not in ('advance', 'final')" />
            </xpath>
        </field>
    </record>

    <record id="action_medilab_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("move_type", "in", ("out_invoice", "out_refund")), ("invoice_kind", "!=", False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>
</odoo>
