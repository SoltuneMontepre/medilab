"Sales decides on the request. Testing continues until the request is "
"accepted."
msgstr "Nhân viên kinh doanh sẽ quyết định yêu cầu này. Việc thử nghiệm vẫn tiếp tục cho đến khi yêu cầu được chấp nhận."

#. module: sol_commerce
#: model_terms:ir.ui.view,arch_db:sol_commerce.order_page
msgid ""
"The order is cancelled and the laboratory will not work on it. This cannot "
"be undone."
msgstr "Đơn hàng sẽ bị hủy và phòng thí nghiệm sẽ không thực hiện đơn hàng này. Thao tác này không thể hoàn tác."

#. module: sol_commerce
#: model:portal.entry,name:sol_commerce.portal_entry_orders
msgid "Your Orders"
msgstr "Đơn hàng của bạn"

#. module: sol_commerce
#: model_terms:ir.ui.view,arch_db:sol_commerce.order_list
msgid ""
"Your draft is saved. It is listed here as Draft and stays in the cart until "
"you submit it."
msgstr "Bản nháp đã được lưu. Bản nháp có trong danh sách này với trạng thái Nháp và vẫn nằm trong giỏ hàng cho đến khi bạn gửi."

#. module: sol_commerce
#. odoo-python
#: code:addons/sol_commerce/models/orders/sale_order_freeze.py:0
msgid "A confirmed order cannot be changed."
msgstr "Không thể thay đổi đơn hàng đã xác nhận."

#. module: sol_commerce
#: model:ir.model.fields,field_description:sol_commerce.field_sale_order__confirmed_at
msgid "Confirmed At"
msgstr "Thời Điểm Xác Nhận"

#. module: sol_commerce
#: model:ir.model.fields,field_description:sol_commerce.field_sale_order__days_to_confirmation
msgid "Days to Confirmation"
msgstr "Số Ngày Đến Xác Nhận"

#. module: sol_commerce
#. odoo-python
#: code:addons/sol_commerce/models/orders/sale_order.py:0
msgid ""
"The samples of this order are collected, so cancelling it needs a change "
"request the Head of Sales approves."
msgstr "Mẫu của đơn hàng này đã được thu, nên việc hủy đơn cần yêu cầu thay đổi được Trưởng Phòng Kinh Doanh phê duyệt."

#. module: sol_commerce
#. odoo-python
#: code:addons/sol_commerce/models/orders/sale_order_confirmation.py:0
msgid "The order must be confirmed before the samples are collected."
msgstr "Đơn hàng phải được xác nhận trước khi thu mẫu."

#. module: sol_commerce
#. odoo-python
#: code:addons/sol_commerce/models/orders/sale_order.py:0
msgid "You cannot cancel a locked order. Please unlock it first."
msgstr "Không thể hủy đơn hàng đã khóa. Hãy mở khóa trước."

#. module: sol_commerce
#: model:ir.model.fields,field_description:sol_commerce.field_sale_order_line__default_way_notice
msgid "Default Way"
msgstr "Cách thử mặc định"
