<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_quotation" model="ir.sequence">
        <field name="name">Quotation</field>
        <field name="code">medilab.quotation</field>
        <field name="padding">4</field>
        <field name="suffix"> %(y)s/BG-VTT</field>
        <field name="use_date_range" eval="True" />
    </record>
    <record id="sequence_support_request" model="ir.sequence">
        <field name="name">Support Request</field>
        <field name="code">medilab.support.request</field>
        <field name="prefix">HT.</field>
        <field name="padding">4</field>
    </record>
</odoo>