<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="task_type_order_cancellation" model="medilab.task.type">
        <field name="code">order_cancellation</field>
        <field name="name">Order cancellation</field>
        <field name="trigger">order_cancellation_requested</field>
        <field name="document_model">medilab.cancellation.request</field>
        <field name="action">decide</field>
        <field name="route">person</field>
    </record>
    <record id="task_type_support_request" model="medilab.task.type">
        <field name="code">support_request</field>
        <field name="name">Support request</field>
        <field name="trigger">support_request_opened</field>
        <field name="document_model">medilab.support.request</field>
        <field name="action">answer</field>
        <field name="route">person</field>
        <field name="deadline_hours">24</field>
    </record>
    <record id="task_type_order_quotation" model="medilab.task.type">
        <field name="code">order_quotation</field>
        <field name="name">Order quotation</field>
        <field name="trigger">order_submitted</field>
        <field name="document_model">sale.order</field>
        <field name="action">quote</field>
        <field name="route">role</field>
        <field name="role_id" ref="sol_laboratory.role_administrator" />
        <field name="deadline_hours">24</field>
    </record>
    <record id="task_type_invoice_posting" model="medilab.task.type">
        <field name="code">invoice_posting</field>
        <field name="name">Invoice posting</field>
        <field name="trigger">invoice_drafted</field>
        <field name="document_model">account.move</field>
        <field name="action">post</field>
        <field name="route">role</field>
        <field name="role_id" ref="sol_laboratory.role_administrator" />
        <field name="deadline_hours">24</field>
    </record>
</odoo>
