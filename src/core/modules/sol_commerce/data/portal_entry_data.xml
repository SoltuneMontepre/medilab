<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="portal_entry_notifications" model="portal.entry">
            <field name="name">Notification preferences</field>
            <field name="description">Choose which updates you receive and where</field>
            <field name="url">/my/notifications</field>
            <field name="image" type="bytes" file="portal/static/src/img/portal-connection.svg" />
            <field name="is_config_card" eval="True" />
        </record>
        <record id="portal_entry_orders" model="portal.entry">
            <field name="name">Your Orders</field>
            <field name="description">Follow your orders and quotations</field>
            <field name="url">/orders</field>
            <field name="image" type="bytes" file="sale/static/src/img/bag.svg" />
            <field name="placeholder_count">medilab_order_count</field>
            <field name="category">client_category</field>
            <field name="sequence" eval="50" />
        </record>
        <record id="portal_entry_support" model="portal.entry">
            <field name="name">Support</field>
            <field name="description">Ask the laboratory for help and follow the conversation</field>
            <field name="url">/support</field>
            <field name="image" type="bytes" file="sol_commerce/static/src/img/portal-support.svg" />
            <field name="category">client_category</field>
            <field name="sequence" eval="60" />
        </record>
    </data>
    <!-- Customers follow their orders on /orders, so Odoo's sales cards are not offered. -->
    <record id="sale.portal_quotations_to_review" model="portal.entry">
        <field name="show_in_portal" eval="False" />
    </record>
    <record id="sale.portal_your_orders" model="portal.entry">
        <field name="show_in_portal" eval="False" />
    </record>
</odoo>
