<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_payos_order" model="ir.sequence">
        <field name="name">PayOS order code</field>
        <field name="code">medilab.payos.order</field>
        <field name="padding">1</field>
        <field name="number_next">100000</field>
    </record>

    <record id="payment_provider_payos" model="payment.provider">
        <field name="name">PayOS</field>
        <field name="code">payos</field>
        <field name="is_published" eval="False" />
    </record>

    <record id="payment_method_payos_qr" model="payment.method">
        <field name="name">PayOS QR</field>
        <field name="code">qr</field>
        <field name="provider_id" ref="payment_provider_payos" />
        <field name="active" eval="False" />
    </record>
</odoo>
