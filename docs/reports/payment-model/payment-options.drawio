<mxfile host="drawio"><diagram name="1. Ba cách xử lý tạm ứng" id="1. Ba cá"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="#214: ghi nhận tiền tạm ứng thế nào? Ba cách ở năm thời điểm của một đơn. ĐÃ CHỌN C" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;text;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Sales gửi báo giá" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="110" width="210" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Sửa báo giá khi khách chưa trả" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="210" height="44" as="geometry"/></mxCell><mxCell id="c4" value="Khách trả tạm ứng, kế toán xác nhận" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="110" width="210" height="44" as="geometry"/></mxCell><mxCell id="c5" value="Xác nhận đơn, thu số dư" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="210" height="44" as="geometry"/></mxCell><mxCell id="c6" value="Sau kiểm nghiệm" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="210" height="44" as="geometry"/></mxCell><mxCell id="c7" value="A. Cách main đang chạy&lt;br&gt;(post hoá đơn khi gửi báo giá)" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#E5E7EB;strokeColor=#9CA3AF;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="164" width="210" height="100" as="geometry"/></mxCell><mxCell id="c8" value="Ghi sổ HOÁ ĐƠN tạm ứng ngay, dù chưa thu đồng nào" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FDECEC;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="240" y="164" width="210" height="100" as="geometry"/></mxCell><mxCell id="c9" value="HUỶ hoá đơn đã ghi sổ (ngoại lệ do hệ thống làm)" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FDECEC;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="460" y="164" width="210" height="100" as="geometry"/></mxCell><mxCell id="c10" value="Hoá đơn tạm ứng ghi là đã trả; báo giá thành Paid" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="680" y="164" width="210" height="100" as="geometry"/></mxCell><mxCell id="c11" value="Ghi sổ HOÁ ĐƠN số dư lúc xác nhận đơn, chưa thu tiền" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FDECEC;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="900" y="164" width="210" height="100" as="geometry"/></mxCell><mxCell id="c12" value="Không thêm gì; khách trả sau thì có hoá đơn cuối" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="1120" y="164" width="210" height="100" as="geometry"/></mxCell><mxCell id="c13" value="B. Ghi sổ ngay, sửa bằng hoá đơn giảm" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#E5E7EB;strokeColor=#9CA3AF;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="274" width="210" height="100" as="geometry"/></mxCell><mxCell id="c14" value="Ghi sổ HOÁ ĐƠN tạm ứng ngay, dù chưa thu đồng nào" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FDECEC;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="240" y="274" width="210" height="100" as="geometry"/></mxCell><mxCell id="c15" value="Không huỷ: lập HOÁ ĐƠN GIẢM (credit note) cả số tiền, rồi hoá đơn mới cho bản sửa" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFF7E6;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="460" y="274" width="210" height="100" as="geometry"/></mxCell><mxCell id="c16" value="Hoá đơn tạm ứng ghi là đã trả; báo giá thành Paid" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="680" y="274" width="210" height="100" as="geometry"/></mxCell><mxCell id="c17" value="Ghi sổ HOÁ ĐƠN số dư lúc xác nhận đơn, chưa thu tiền" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FDECEC;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="900" y="274" width="210" height="100" as="geometry"/></mxCell><mxCell id="c18" value="Không thêm gì; khách trả sau thì có hoá đơn cuối" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="1120" y="274" width="210" height="100" as="geometry"/></mxCell><mxCell id="c19" value="C. ĐÃ CHỌN: yêu cầu thanh toán trước,&lt;br&gt;hoá đơn khi thu tiền" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#E5E7EB;strokeColor=#9CA3AF;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="384" width="210" height="100" as="geometry"/></mxCell><mxCell id="c20" value="Tạo YÊU CẦU THANH TOÁN: giấy báo cần trả, chưa ghi sổ, chưa phải hoá đơn" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E8F5E9;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="240" y="384" width="210" height="100" as="geometry"/></mxCell><mxCell id="c21" value="Rút yêu cầu chưa trả; không có hoá đơn nào phải huỷ" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E8F5E9;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="460" y="384" width="210" height="100" as="geometry"/></mxCell><mxCell id="c22" value="Ghi TIỀN KHÁCH ỨNG TRƯỚC (lab đang giữ tiền của khách, chưa là doanh thu); hoá đơn lập lúc thu tiền" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E8F5E9;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="680" y="384" width="210" height="100" as="geometry"/></mxCell><mxCell id="c23" value="YÊU CẦU THANH TOÁN số dư; tiền về được xác nhận thì lập HOÁ ĐƠN cuối" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E8F5E9;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="900" y="384" width="210" height="100" as="geometry"/></mxCell><mxCell id="c24" value="Không thêm gì: mọi khoản đã có hoá đơn lúc thu tiền; khách trả sau thì có hoá đơn cuối" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E8F5E9;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="1120" y="384" width="210" height="100" as="geometry"/></mxCell><mxCell id="c25" value="Công sức" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#E5E7EB;strokeColor=#9CA3AF;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="494" width="210" height="80" as="geometry"/></mxCell><mxCell id="c26" value="A: đã có code trên main, không phải làm gì thêm.  B: thêm bước lập hoá đơn giảm khi sửa báo giá.  C: chuyển luồng gửi báo giá, cổng khách hàng, PayOS và nhắc quá hạn từ hoá đơn sang yêu cầu thanh toán." style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="240" y="494" width="650" height="80" as="geometry"/></mxCell><mxCell id="c27" value="Luật (Nghị định 254/2026, theo #214): khi thu tiền trước hoặc trong lúc làm dịch vụ, hoá đơn lập lúc THU TIỀN. Hoá đơn đã lập thì không huỷ, chỉ điều chỉnh." style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="900" y="494" width="430" height="80" as="geometry"/></mxCell><mxCell id="c28" value="Từ điển nhanh:  HOÁ ĐƠN = chứng từ ghi nhận đã bán, phát sinh thuế, không được huỷ.  YÊU CẦU THANH TOÁN = giấy báo cần trả tiền, không ghi sổ.  HOÁ ĐƠN GIẢM (credit note) = chứng từ trừ bớt một hoá đơn đã lập.  TIỀN KHÁCH ỨNG TRƯỚC = tiền lab đang giữ hộ khách, trừ dần khi lập hoá đơn dịch vụ." style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="20" y="594" width="1320" height="70" as="geometry"/></mxCell><mxCell id="c29" value="Đúng luật / gọn" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E8F5E9;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="20" y="674" width="150" height="30" as="geometry"/></mxCell><mxCell id="c30" value="Chấp nhận được, tốn công" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFF7E6;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="180" y="674" width="150" height="30" as="geometry"/></mxCell><mxCell id="c31" value="Vướng luật hoặc quy tắc" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FDECEC;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="340" y="674" width="150" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Khoản trả đang chờ (#310)" id="2. Khoản"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Khoản trả chờ kế toán xác nhận mà báo giá bị sửa, bị từ chối hoặc đơn bị huỷ. ĐÃ CHỌN A" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;text;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Sales ghi nhận tiền mặt hoặc chuyển khoản: khoản trả ĐANG CHỜ kế toán" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="70" as="geometry"/></mxCell><mxCell id="c3" value="Báo giá bị sửa,&lt;br&gt;khách từ chối,&lt;br&gt;hoặc đơn bị huỷ?" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rhombus;fillColor=#FFFFFF;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="260" height="130" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="A. ĐÃ CHỌN: chặn thao tác cho tới khi kế toán xác nhận hoặc từ chối" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E8F5E9;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="620" y="230" width="260" height="80" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="270"/></Array></mxGeometry></mxCell><mxCell id="c7" value="Không cần chính sách hoàn tiền. Đổi lại: Sales và khách phải chờ kế toán; khách chưa từ chối được ngay. PR #287 cũng chọn cách này khi sửa báo giá." style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="900" y="230" width="300" height="80" as="geometry"/></mxCell><mxCell id="c8" value="B. Cho làm, hệ thống tự từ chối khoản trả" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FDECEC;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="620" y="350" width="260" height="80" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="390"/></Array></mxGeometry></mxCell><mxCell id="c10" value="Tiền khách thật sự đã đưa bị từ chối, trong khi chưa có quy trình hoàn tiền." style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="900" y="350" width="300" height="80" as="geometry"/></mxCell><mxCell id="c11" value="C. Cho làm, khoản trả vẫn treo trên báo giá hoặc đơn cũ" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFF7E6;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="260" height="80" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="510"/></Array></mxGeometry></mxCell><mxCell id="c13" value="Cần chính sách chuyển tiền sang bản sửa hoặc hoàn tiền; hiện chưa có." style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;text;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="300" height="80" as="geometry"/></mxCell><mxCell id="c14" value="Tiền được xác nhận SAU khi báo giá hết hạn: ĐÃ CHỌN tính theo ngày nhận tiền" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;text;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1160" height="30" as="geometry"/></mxCell><mxCell id="c15" value="Tiền NHẬN trước hạn, kế toán xác nhận sau hạn: vẫn tính là khách chấp nhận báo giá (PR #287 đã ghi như vậy)." style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E8F5E9;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="560" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Tiền NHẬN sau hạn: Sales gia hạn báo giá trước, rồi mới tính." style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFF7E6;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="640" y="640" width="560" height="70" as="geometry"/></mxCell><mxCell id="c17" value="Đúng luật / gọn" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E8F5E9;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="150" height="30" as="geometry"/></mxCell><mxCell id="c18" value="Chấp nhận được, tốn công" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFF7E6;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="200" y="730" width="150" height="30" as="geometry"/></mxCell><mxCell id="c19" value="Vướng luật hoặc quy tắc" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FDECEC;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="360" y="730" width="150" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Khách mua chịu (trả sau)" id="3. Khách"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Khách được Head of Sales cho mua chịu: trả sau khi kiểm nghiệm. Trạng thái ở từng bước" style="fontFamily=Helvetica;fontSize=12;fontColor=#111827;whiteSpace=wrap;html=1;text;fontSize=18;fontStyle=1;align=left;ve