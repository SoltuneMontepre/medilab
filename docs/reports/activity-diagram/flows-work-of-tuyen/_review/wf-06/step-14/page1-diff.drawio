<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-06 Workflow: 9 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Đổi nhãn: Request reported → Report downloaded&lt;br&gt;• Thêm ⊗ flow final “→ SF-03 Change request on a signed document”&lt;br&gt;• Thêm text “→ SF-03 Change request on a signed document”&lt;br&gt;• Thêm ⊗ flow final “→ SF-04 Sample retention, return and disposal”&lt;br&gt;• Thêm text “→ SF-04 Sample retention, return and disposal”&lt;br&gt;• Thêm system activity “Issue report and make reserved number official” → ⊗ flow final “→ SF-04 Sample retention, return and disposal”&lt;br&gt;• Thêm system activity “Issue report and make reserved number official” → ⊗ flow final “→ SF-03 Change request on a signed document” [a mistake in the issued report]&lt;br&gt;• Thêm ⊗ flow final&lt;br&gt;• Thêm text “Flow final”" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="3620" height="276" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="304" width="1770" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="1870" y="304" width="1770" height="28" as="geometry" /></mxCell><mxCell id="l_wf06_lane_hod" value="Head of department" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#FAF5FF;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="336" width="300" heig