<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-06 Workflow: 6 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Xoá decision “Digital signing enabled?”&lt;br&gt;• Xoá decision “Digital signing enabled?” → system activity “Digitally sign the reviewed PDF” [yes]&lt;br&gt;• Xoá decision “Digital signing enabled?” → system activity “Store reviewed PDF without digital signature” [no]&lt;br&gt;• Xoá system activity “Store reviewed PDF without digital signature” → system activity “Issue report”&lt;br&gt;• Đổi đầu cạnh: system activity “Keep final internal approval bound to reviewed PDF” → decision “Digital signing enabled?” → system activity “Keep final internal approval bound to reviewed PDF” → system activity “Digitally sign the reviewed PDF”&lt;br&gt;• Xoá system activity “Store reviewed PDF without digital signature”" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="3860" height="198" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="226" width="2010" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="2110" y="226" width="1770" height="28" as="geometry" /></mxCell><mxCell id="l_wf06_lane_hod" value="Head of department" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#FAF5FF;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="258" width="300" height=