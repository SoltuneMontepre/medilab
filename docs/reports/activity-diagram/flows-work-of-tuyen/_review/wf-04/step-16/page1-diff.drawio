<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-04 Workflow: 5 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Thêm ⊗ flow final “→ SF-03 Change request on a signed document”&lt;br&gt;• Thêm text “→ SF-03 Change request on a signed document”&lt;br&gt;• Thêm activity “Approve result” → ⊗ flow final “→ SF-03 Change request on a signed document” [a mistake after completion]&lt;br&gt;• Thêm ⊗ flow final&lt;br&gt;• Thêm text “Flow final”" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="2420" height="172" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="200" width="1170" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="1270" y="200" width="1170" height="28" as="geometry" /></mxCell><mxCell id="l_wf04_lane_tes" value="Tester" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#ECFEFF;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="232" width="300" height="1718" as="geometry" /></mxCell><mxCell id="l_wf04_lane_sys" value="System" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#F8FAFC;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="360" y="232" width="300" height="1718" as="geometry" /></mxCell><mxCell id="l_wf04_lane_hod" value="Head of department" style="swimlane