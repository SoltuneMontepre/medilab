<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-04 Workflow: 8 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Thêm decision “Based on current file version?”&lt;br&gt;• Thêm activity “Keep both conflict versions and take the server version with a local backup”&lt;br&gt;• Thêm decision “Based on current file version?” → activity “Keep both conflict versions and take the server version with a local backup” [no]&lt;br&gt;• Thêm activity “Keep both conflict versions and take the server version with a local backup” → activity “Save result file”&lt;br&gt;• Thêm decision “Based on current file version?” → system activity “New current version” [yes]&lt;br&gt;• Thêm system activity “New current version” → activity “Enter result”&lt;br&gt;• Đổi đầu cạnh: system activity “Sync file version” → activity “Enter result” → system activity “Sync file version” → decision “Based on current file version?”&lt;br&gt;• Thêm system activity “New current version”" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="2420" height="250" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="278" width="1170" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="1270" y="278" width="1170" height="28" as="geometry" /></mxCell><mxCell id="l_wf04_lane_tes" value="Tester" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#ECFEFF;strok