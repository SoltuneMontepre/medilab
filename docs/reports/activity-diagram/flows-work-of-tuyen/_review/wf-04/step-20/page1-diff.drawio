<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-04 Workflow: 8 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Xoá activity “Follow the method and measure in the booking”&lt;br&gt;• Đổi đầu cạnh: ● initial node “Booked test starts (WF-03 Testing assignment and scheduling); sample folders bound in Medilab Sync (SF-11 Laboratory file administration)” → activity “Follow the method and measure in the booking” → ● initial node “Booked test starts (WF-03 Testing assignment and scheduling); sample folders bound in Medilab Sync (SF-11 Laboratory file administration)” → system activity “Start booking; mark machine busy”&lt;br&gt;• Đổi đầu cạnh: notification “✉ Notify tester” → activity “Follow the method and measure in the booking” [retest with a new booking] → notification “✉ Notify tester” → system activity “Start booking; mark machine busy” [retest with a new booking]&lt;br&gt;• Đổi đầu cạnh: activity “Follow the method and measure in the booking” → decision “Testing produces files?” → system activity “Start booking; mark machine busy” → decision “Testing produces files?”&lt;br&gt;• Đổi đầu cạnh: system activity “Close testing task” → notification “✉ Notify head” → system activity “Close testing task” → system activity “Mark machine available”&lt;br&gt;• Thêm system activity “Mark machine available” → notification “✉ Notify head”&lt;br&gt;• Thêm system activity “Start booking; mark machine busy”&lt;br&gt;• Thêm system activity “Mark machine available”" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="2420" height="250" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="278" width="1170" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="1270" y="278" width="1170" height="28" as="geometry" /></mxCell><mxCell id="l_wf04_lane_tes" value="Tester" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#ECFEFF;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="300" height="1718" as="geometry" /></mxCell><mxCell id="l_wf04_lane_sys" value="System" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#F8FAFC;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="360" y="310" width="300" height="1718" as="geometry" /></mxCell><mxCell id="l_wf04_lane_hod" value="Head of department" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#FAF5FF;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="660" y="310" width="300" height="1718" as="geometry" /></mxCell><mxCell id="l_s" value="" style="ellipse;html=1;fillColor=#111827;strokeColor=#111827;opacity=22;textOpacity=35;" vertex="1" parent="1"><mxGeometry x="198" y="376" width="24" height="24" as="geometry" /></mxCell><mxCell id="l_s_t" value="Booked test starts (WF-03 Testing assignment and scheduling); sample folders bound in Medilab Sync (SF-11 Laboratory file administration)" style="text;html=1;whiteSpace=wrap;fontSize=11;verticalAlign=middle;align=left;opacity=22;textOpacity=35;" vertex="1" parent="1"><mxGeometry x="237" y="356" width="240" height="64" as="geometry" /></mxCell><mxCell id="l_s2" value="" style="ellipse;html=1;fillColor=#111827;strokeColor=#111827;opacity=22;textOpacity=35;" vertex="1" parent="1"><mxGeomet