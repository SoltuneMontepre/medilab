<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-01 Workflow: 9 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Thêm activity “Confirm payment”&lt;br&gt;• Thêm decision “Pay online?”&lt;br&gt;• Thêm activity “Record transfer or cash payment”&lt;br&gt;• Đổi đầu cạnh: decision “Accept quotation?” → activity “Pay advance (PayOS)” [yes] → decision “Accept quotation?” → decision “Pay online?” [yes]&lt;br&gt;• Thêm decision “Pay online?” → activity “Pay advance (PayOS)” [yes]&lt;br&gt;• Thêm decision “Pay online?” → activity “Record transfer or cash payment” [no]&lt;br&gt;• Thêm activity “Record transfer or cash payment” → activity “Confirm payment”&lt;br&gt;• Thêm activity “Confirm payment” → system activity “Accept quotation”&lt;br&gt;• Thêm lane “Accountant”" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="3320" height="276" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="304" width="1470" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="1570" y="304" width="1770" height="28" as="geometry" /></mxCell><mxCell id="l_wf01_lane_cus" value="Customer" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#FFFBEB;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="336" width="300" height="1720" as="geometry" /></mxCell><mxCell id="l_wf01_lane_sal" value="Sa