<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-01 Workflow: 11 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Thêm ⊗ flow final “→ SF-02 Order cancellation”&lt;br&gt;• Thêm text “→ SF-02 Order cancellation”&lt;br&gt;• Thêm ⊗ flow final “→ SF-07 Result dates and priority orders”&lt;br&gt;• Thêm text “→ SF-07 Result dates and priority orders”&lt;br&gt;• Thêm ⊗ flow final “→ SF-07 Result dates and priority orders”&lt;br&gt;• Thêm text “→ SF-07 Result dates and priority orders”&lt;br&gt;• Thêm activity “Submit order” → ⊗ flow final “→ SF-02 Order cancellation” [the customer wants to cancel]&lt;br&gt;• Thêm activity “Fill cart” → ⊗ flow final “→ SF-07 Result dates and priority orders” [requested date or priority]&lt;br&gt;• Thêm activity “Confirm ways and expected samples” → ⊗ flow final “→ SF-07 Result dates and priority orders” [estimate the return date]&lt;br&gt;• Thêm ⊗ flow final&lt;br&gt;• Thêm text “Flow final”" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="3620" height="328" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="356" width="1770" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="1870" y="356" width="1770" height="28" as="geometry" /></mxCell><mxCell id="l_wf01_lane_cus" value="Customer" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#FFFBEB;strokeColor=#9CA3AF;fontSty