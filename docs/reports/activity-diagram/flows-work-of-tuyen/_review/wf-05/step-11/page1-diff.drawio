<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-05 Workflow: 7 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Thêm ◉ activity final “Wait for other tests”&lt;br&gt;• Thêm text “Wait for other tests”&lt;br&gt;• Đổi nhãn: Result approved → WF-06 Report signing, release and delivery → Sample completed → WF-06 Report signing, release and delivery; SF-01 Invoicing and payment collection&lt;br&gt;• Đổi nhãn:  → yes&lt;br&gt;• Thêm decision “Every test of the sample approved or cancelled?” → ◉ activity final “Wait for other tests” [no]&lt;br&gt;• Đổi nhãn: Close outsourced test → Every test of the sample approved or cancelled?&lt;br&gt;• Đổi hình: system activity system activity “Close outsourced test” → decision" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="3020" height="224" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="252" width="1470" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="1570" y="252" width="1470" height="28" as="geometry" /></mxCell><mxCell id="l_wf05_lane_hod" value="Head of department" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#FAF5FF;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="284" width="300" height="1288" as="geometry" /></mxCell><mxCell id="l_wf05_lane_sys" value="System" style="swimlane;startSize=40;con