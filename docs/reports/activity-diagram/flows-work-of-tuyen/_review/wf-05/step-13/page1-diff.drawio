<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-05 Workflow: 9 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Thêm decision “Delivered?”&lt;br&gt;• Thêm ⊗ flow final “Delivery failed → WF-02 Sample reception and handover”&lt;br&gt;• Thêm text “Delivery failed → WF-02 Sample reception and handover”&lt;br&gt;• Thêm activity “Carry the dispatch to the subcontractor” → decision “Delivered?”&lt;br&gt;• Thêm decision “Delivered?” → ⊗ flow final “Delivery failed → WF-02 Sample reception and handover” [no]&lt;br&gt;• Đổi nhãn:  → yes&lt;br&gt;• Đổi đầu cạnh: activity “Carry the dispatch to the subcontractor” → system activity “Record when it is sent, who took it and the expected date” → decision “Delivered?” → system activity “Record when it is sent, who took it and the expected date” [yes]&lt;br&gt;• Thêm ⊗ flow final&lt;br&gt;• Thêm text “Flow final”" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="3020" height="276" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="304" width="1470" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="1570" y="304" width="1470" height="28" as="geometry" /></mxCell><mxCell id="l_wf05_lane_hod" value="Head of department" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#FAF5FF;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x