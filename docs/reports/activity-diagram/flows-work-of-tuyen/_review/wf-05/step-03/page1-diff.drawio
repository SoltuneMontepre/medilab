<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-05 Workflow: 7 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Xoá decision “Already the agreed way?”&lt;br&gt;• Xoá activity “Obtain customer agreement through a revised quotation”&lt;br&gt;• Đổi đầu cạnh: system activity “Suggest outsourcing” → decision “Already the agreed way?” → system activity “Suggest outsourcing” → activity “Accept suggestion”&lt;br&gt;• Xoá decision “Already the agreed way?” → activity “Accept suggestion” [yes]&lt;br&gt;• Xoá decision “Already the agreed way?” → activity “Obtain customer agreement through a revised quotation” [no]&lt;br&gt;• Xoá activity “Obtain customer agreement through a revised quotation” → activity “Accept suggestion”&lt;br&gt;• Xoá lane “Sales”" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="3320" height="224" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="252" width="1770" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="1870" y="252" width="1470" height="28" as="geometry" /></mxCell><mxCell id="l_wf05_lane_sal" value="Sales" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#FEE2E2;swimlaneFillColor=#F0FDF4;strokeColor=#DC2626;fontStyle=1;fontSize=14;html=1;strokeWidth=3;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="60" y="284" width="300" height="1072" as="geometry" /></mxCell><mxCell id="l_wf05_lane_h