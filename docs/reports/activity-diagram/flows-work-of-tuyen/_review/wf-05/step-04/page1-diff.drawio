<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-05 Workflow: 5 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Thêm activity “Outsource urgently with a reason”&lt;br&gt;• Thêm ● initial node “Emergency, no suggestion yet (WF-03 Testing assignment and scheduling)”&lt;br&gt;• Thêm text “Emergency, no suggestion yet (WF-03 Testing assignment and scheduling)”&lt;br&gt;• Thêm ● initial node “Emergency, no suggestion yet (WF-03 Testing assignment and scheduling)” → activity “Outsource urgently with a reason”&lt;br&gt;• Thêm activity “Outsource urgently with a reason” → system activity “Create dispatch draft”" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="3020" height="172" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="200" width="1470" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="1570" y="200" width="1470" height="28" as="geometry" /></mxCell><mxCell id="l_wf05_lane_hod" value="Head of department" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#FAF5FF;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="232" width="300" height="1000" as="geometry" /></mxCell><mxCell id="l_wf05_lane_sys" value="System" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#F8FAFC;strokeColor=#9CA3AF;fontStyle=1;fontSize