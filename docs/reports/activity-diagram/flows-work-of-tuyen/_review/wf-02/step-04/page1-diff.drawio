<mxfile><diagram id="diff" name="diff"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="notes" value="WF-02 Workflow: 4 thay đổi. Xanh lá = thêm · Đỏ = xoá · Vàng cam = đổi; phần còn lại làm mờ.&lt;br&gt;• Thêm activity “Claim the collection task and plan its time”&lt;br&gt;• Đổi đầu cạnh: decision “How are the samples handed over?” → system activity “Create collection task” [collected at the customer&amp;#x27;s site] → decision “How are the samples handed over?” → activity “Claim the collection task and plan its time” [collected at the customer&amp;#x27;s site]&lt;br&gt;• Đổi đầu cạnh: system activity “Create collection task” → notification “✉ Remind staff” → system activity “Create collection task” → activity “Claim the collection task and plan its time”&lt;br&gt;• Thêm activity “Claim the collection task and plan its time” → notification “✉ Remind staff”" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#111827;"><mxGeometry x="20" y="20" width="3020" height="146" as="geometry" /></mxCell><mxCell id="cap_l" value="Trước" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="20" y="174" width="1470" height="28" as="geometry" /></mxCell><mxCell id="cap_r" value="Sau" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontFamily=Helvetica;fontColor=#111827;fontStyle=1;"><mxGeometry x="1570" y="174" width="1470" height="28" as="geometry" /></mxCell><mxCell id="l_wf02_lane_cus" value="Customer" style="swimlane;startSize=40;container=0;collapsible=0;fillColor=#F3F4F6;swimlaneFillColor=#FFFBEB;strokeColor=#9CA3AF;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="206" width="300" height="1000" as="geometry" /></mxCell><mxCell id="l_wf02_lane_stf"