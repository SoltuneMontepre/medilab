C5A24;padding:4px;background:#D9D99A"&gt;Scheduling&lt;/td&gt;&lt;td style="border:1px solid #9C5A24;padding:4px"&gt;Entity of this area&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9C5A24;padding:4px;background:#F4A9A9"&gt;Testing&lt;/td&gt;&lt;td style="border:1px solid #9C5A24;padding:4px"&gt;Entity of this area&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9C5A24;padding:4px;background:#BFC0EC"&gt;Approval&lt;/td&gt;&lt;td style="border:1px solid #9C5A24;padding:4px"&gt;Entity of this area&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9C5A24;padding:4px;background:#A9D4EE"&gt;Sales&lt;/td&gt;&lt;td style="border:1px solid #9C5A24;padding:4px"&gt;Entity of this area&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9C5A24;padding:4px;background:#DDB4DD"&gt;Finance&lt;/td&gt;&lt;td style="border:1px solid #9C5A24;padding:4px"&gt;Entity of this area&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #9C5A24;padding:4px;background:#E8E8E8"&gt;Grey dashed box&lt;/td&gt;&lt;td style="border:1px solid #9C5A24;padding:4px"&gt;Copy of Signature or ChangeRequest next to the area that uses it&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="3905.75" y="2112.12" width="695.25" height="336.75" as="geometry"/></mxCell><mxCell id="E0-E3-edge5" style="endArrow=none;html=1;rounded=0;strokeColor=#9C5A24;strokeWidth=1;exitX=1.0020;exitY=0.8372;exitDx=0;exitDy=0;exitPerimeter=0;entryX=-0.0022;entryY=0.0947;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="E0" target="E3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="E0-E3-edge5-label" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;labelBackgroundColor=none;" vertex="1" connectable="0" parent="E0-E3-edge5"><mxGeometry x="-0.9778" relative="1" as="geometry"><mxPoint x="-2.26" y="9.74" as="offset"/></mxGeo