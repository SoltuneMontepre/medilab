// Inventory module tables as the Odoo ORM creates them: stock items, locations and stores, lots, containers, stock, moves, consumption, recipes and preparations, requisitions and transfers, stock takes, cost centres, budgets, charges, suppliers, purchase orders and receipts. Odoo owns the schema; this file only draws it.
// Money columns are Odoo Monetary fields in VND, rounded by the currency.
// Laboratory tables appear only with the columns this module uses; the full tables are in ../laboratory/laboratory.prisma.

datasource db {
  provider = "postgresql"
}

/// Laboratory's chemical, shown with the columns this module uses.
model Chemical {
  /// Row identifier.
  id         Int        @id @default(autoincrement())
  /// Unique code of the chemical.
  code       String     @unique @db.VarChar
  /// The stock item that stocks the chemical.
  stock_item StockItem?

  @@map("medilab_chemical")
}

/// Laboratory's testing method, shown with the columns this module uses.
model TestingMethod {
  /// Row identifier.
  id           Int                 @id @default(autoincrement())
  /// Unique standard reference of the method.
  code         String              @unique @db.VarChar
  /// Items one test of the method uses.
  consumptions MethodConsumption[]

  @@map("medilab_testing_method")
}

/// Laboratory's measurement unit, shown with the columns this module uses.
model MeasurementUnit {
  /// Row identifier.
  id          Int         @id @default(autoincrement())
  /// Unique unit symbol, such as mL or g.
  name        String      @unique @db.VarChar
  /// Items counted in this unit.
  stock_items StockItem[]

  @@map("medilab_measurement_unit")
}

/// Laboratory's department, shown with the columns this module uses.
model Department {
  /// Row identifier.
  id              Int             @id @default(autoincrement())
  /// Department name.
  name            String          @db.VarChar
  /// Stores the department holds.
  stores          StockLocation[]
  /// Purchase orders the department asked for.
  purchase_orders PurchaseOrder[]
  /// The department's cost centre.
  cost_centre     CostCentre?

  @@map("medilab_department")
}

/// Laboratory's team, shown with the columns this module uses.
model Team {
  /// Row identifier.
  id          Int             @id @default(autoincrement())
  /// Team name.
  name        String          @db.VarChar
  /// Stores the team holds.
  stores      StockLocation[]
  /// The team's cost centre.
  cost_centre CostCentre?

  @@map("medilab_team")
}

/// Laboratory's person, shown with the columns this module uses.
model Person {
  /// Row identifier.
  id             Int             @id @default(autoincrement())
  /// Stores the person manages.
  managed_stores StockLocation[]

  @@map("medilab_person")
}

/// Laboratory's test result, shown with the columns this module uses.
model TestResult {
  /// Row identifier.
  id    Int         @id @default(autoincrement())
  /// Stock used by the test, with its lots.
  moves StockMove[]

  @@map("medilab_test_result")
}

/// Laboratory's machine service record, shown with the columns this module uses.
model MachineService {
  /// Row identifier.
  id    Int         @id @default(autoincrement())
  /// Spare parts used in the service.
  moves StockMove[]

  @@map("medilab_machine_service")
}

/// Odoo's contact table, shown with the columns this module uses.
model Contact {
  /// Row identifier.
  id                      Int        @id @default(autoincrement())
  /// Name of the company or person.
  name                    String     @db.VarChar
  /// The supplier record when this company is a supplier.
  supplier                Supplier?  @relation("SupplierCompany")
  /// Suppliers for which this person is the contact person.
  supplier_contact_for    Supplier[] @relation("SupplierContactPerson")

  @@map("res_partner")
}

/// Something the laboratory keeps in stock: a chemical or reagent, a consumable, or a machine spare part.
/// A trigram index on name serves search.
model StockItem {
  /// Row identifier.
  id                           Int                 @id @default(autoincrement())
  /// Unique code of the item; filled from a sequence when left empty.
  code                         String              @unique @db.VarChar
  /// Item name in each language.
  name                         Json
  /// chemical, consumable, spare_part or solution; a solution is made by a recipe.
  kind                         String              @db.VarChar
  /// container, lot or quantity: whether stock is kept per container, per lot, or as a quantity only.
  tracking                     String              @db.VarChar
  /// The Laboratory chemical the item stocks; set only for a chemical.
  chemical_id                  Int?                @unique
  /// The unit stock of the item is counted in, such as mL, g or piece.
  unit_id                      Int
  /// Quantity below which a warning is raised and a purchase is suggested; empty for no minimum.
  minimum_quantity             Decimal?            @db.Decimal
  /// Days an opened container stays usable; empty when opening does not shorten its life.
  shelf_life_after_opening_days Int?
  /// False when the item is archived.
  active                       Boolean             @default(true)
  /// The Laboratory chemical the item stocks.
  chemical                     Chemical?           @relation(fields: [chemical_id], references: [id], onDelete: Restrict)
  /// The unit stock is counted in.
  unit                         MeasurementUnit     @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  /// Lots of the item.
  lots                         StockLot[]
  /// Containers of the item.
  containers                   StockContainer[]
  /// The recipe that makes the item; set only for a solution.
  recipe                       Recipe?             @relation("RecipeSolution")
  /// Recipe lines that use the item.
  recipe_lines                 RecipeLine[]
  /// Requisition and transfer lines of the item.
  transfer_lines               StockTransferLine[]
  /// Stock of the item per location and lot.
  quants                       StockQuant[]
  /// Moves of the item.
  moves                        StockMove[]
  /// Methods that use the item per test.
  consumptions                 MethodConsumption[]
  /// Suppliers that sell the item.
  suppliers                    SupplierItem[]
  /// Purchase order lines of the item.
  purchase_lines               PurchaseOrderLine[]
  /// Receipt lines of the item.
  receipt_lines                ReceiptLine[]
  /// Stock take lines of the item.
  take_lines                  StockTakeLine[]

  @@index([kind])
  @@map("medilab_stock_item")
}

/// A place stock is kept, such as Central store > Room 203 > Fridge 2. A location marked as a store is held by a department or team and has a manager; the locations inside it belong to it.
model StockLocation {
  /// Row identifier.
  id            Int             @id @default(autoincrement())
  /// Unique code of the location.
  code          String          @unique @db.VarChar
  /// Location name in each language.
  name          Json
  /// The location this one is inside; empty for a top-level location.
  parent_id     Int?
  /// Ids of the location and all its ancestors, so stock in a location and everything inside it is found in one query.
  parent_path   String?         @db.VarChar
  /// True when the location is a store.
  is_store      Boolean         @default(false)
  /// The department that holds the store; empty for the central store, a team store and locations inside a store.
  department_id Int?
  /// The team that holds the store; empty unless it is a team store.
  team_id       Int?
  /// The person who manages the store.
  manager_id    Int?
  /// Storage conditions of the location, such as "2–8 °C".
  conditions    String?         @db.VarChar
  /// False when the location is archived.
  active        Boolean         @default(true)
  /// The location this one is inside.
  parent        StockLocation?  @relation("LocationTree", fields: [parent_id], references: [id], onDelete: Restrict)
  /// Locations inside this one.
  children      StockLocation[] @relation("LocationTree")
  /// The department that holds the store.
  department    Department?     @relation(fields: [department_id], references: [id], onDelete: Restrict)
  /// The team that holds the store.
  team          Team?           @relation(fields: [team_id], references: [id], onDelete: Restrict)
  /// The person who manages the store.
  manager       Person?         @relation(fields: [manager_id], references: [id], onDelete: Restrict)
  /// Containers in the location.
  containers    StockContainer[]
  /// Requisitions and transfers the store sends stock in.
  transfers_out StockTransfer[] @relation("TransferFrom")
  /// Requisitions and transfers the store receives stock in.
  transfers_in  StockTransfer[] @relation("TransferTo")
  /// Preparations made in the store.
  preparations  Preparation[]
  /// Stock in the location.
  quants        StockQuant[]
  /// Moves out of the location.
  moves_out     StockMove[]     @relation("MoveFrom")
  /// Moves into the location.
  moves_in      StockMove[]     @relation("MoveTo")
  /// Receipts put away in the location.
  receipts      Receipt[]
  /// Stock takes of the location.
  stock_takes   StockTake[]
  /// Stock take lines at the location.
  take_lines   StockTakeLine[] @relation("TakeLineLocation")

  @@index([parent_path])
  @@map("medilab_stock_location")
}

/// One lot of an item, as received from a supplier, with its expiry. Unique on (item_id, lot_number).
/// A lot is usable until its expiry date; opened containers of it have their own usable date.
model StockLot {
  /// Row identifier.
  id                Int          @id @default(autoincrement())
  /// The item.
  item_id           Int
  /// Lot number printed by the manufacturer.
  lot_number        String       @db.VarChar
  /// Expiry date printed on the container; empty when it has none.
  expiry_date       DateTime?    @db.Date
  /// available, expired or disposed. An expired lot cannot be used.
  status            String       @db.VarChar
  /// Purchase price of one unit, excluding VAT, from its receipt; used to cost stock.
  unit_cost         Decimal?     @db.Decimal
  /// The manufacturer's certificate of analysis.
  certificate_id    Int?
  /// The item.
  item              StockItem    @relation(fields: [item_id], references: [id], onDelete: Restrict)
  /// Stock of the lot per location.
  quants            StockQuant[]
  /// Moves of the lot.
  moves             StockMove[]
  /// Containers of the lot.
  containers        StockContainer[]
  /// Stock take lines of the lot.
  take_lines       StockTakeLine[]

  @@unique([item_id, lot_number])
  @@index([status, expiry_date])
  @@map("medilab_stock_lot")
}

/// The quantity of one item, in one lot, at one location, kept up to date by done moves.
/// Unique on (item_id, COALESCE(lot_id, 0), location_id).
model StockQuant {
  /// Row identifier.
  id          Int           @id @default(autoincrement())
  /// The item.
  item_id     Int
  /// The lot; empty for an item not tracked by lot, such as gloves.
  lot_id      Int?
  /// The location.
  location_id Int
  /// Quantity on hand, in the item's unit.
  quantity    Decimal       @db.Decimal
  /// The item.
  item        StockItem     @relation(fields: [item_id], references: [id], onDelete: Restrict)
  /// The lot.
  lot         StockLot?     @relation(fields: [lot_id], references: [id], onDelete: Restrict)
  /// The location.
  location    StockLocation @relation(fields: [location_id], references: [id], onDelete: Restrict)

  @@index([item_id])
  @@index([location_id])
  @@map("medilab_stock_quant")
}

/// One bottle or vial of an item tracked by container, or one prepared solution, with its own code and QR label.
model StockContainer {
  /// Row identifier.
  id                 Int            @id @default(autoincrement())
  /// Unique code printed in the QR label, such as Lot123-01.
  code               String         @unique @db.VarChar
  /// The item.
  item_id            Int
  /// The lot; empty for a prepared solution.
  lot_id             Int?
  /// The location the container is in.
  location_id        Int
  /// sealed, opened, depleted, disposed or missing.
  status             String         @db.VarChar
  /// Quantity left in the container, in the item's unit.
  remaining_quantity Decimal        @db.Decimal
  /// When the container was opened or prepared.
  opened_at          DateTime?
  /// The Odoo user who opened or prepared the container.
  opened_by_id       Int?
  /// Last day the container can be used: its lot's expiry date while sealed, then the earlier of that and its opening date plus the item's shelf life after opening; for a solution, the earlier of its preparation date plus the recipe's shelf life and the usable dates of what it was made from.
  usable_until       DateTime?      @db.Date
  /// Cost of one unit; for a solution, the cost of what its preparation deducted divided by the quantity made.
  unit_cost          Decimal?       @db.Decimal
  /// The preparation that made the solution.
  preparation_id     Int?           @unique
  /// The item.
  item               StockItem      @relation(fields: [item_id], references: [id], onDelete: Restrict)
  /// The lot.
  lot                StockLot?      @relation(fields: [lot_id], references: [id], onDelete: Restrict)
  /// The location the container is in.
  location           StockLocation  @relation(fields: [location_id], references: [id], onDelete: Restrict)
  /// The preparation that made the solution.
  preparation        Preparation?   @relation("PreparationOutput", fields: [preparation_id], references: [id], onDelete: Restrict)
  /// Moves of the container.
  moves              StockMove[]
  /// Stock take lines of the container.
  take_lines         StockTakeLine[]

  @@index([lot_id])
  @@index([location_id, status])
  @@index([status, usable_until])
  @@map("medilab_stock_container")
}

/// One movement of stock: a receipt, an issue to a lower store, a transfer, a move inside a store, a preparation, a use, waste, a disposal or a stock take correction. Moves are never edited; a mistake is corrected by another move.
/// Who made it and when are Odoo's creation fields. An issue or transfer is done when the receiving side confirms receipt; stock on hand follows done moves.
model StockMove {
  /// Row identifier.
  id                Int             @id @default(autoincrement())
  /// receipt, issue, transfer, relocation, preparation, consumption, waste, disposal or adjustment.
  kind              String          @db.VarChar
  /// The item moved.
  item_id           Int
  /// The lot moved; empty for an item not tracked by lot.
  lot_id            Int?
  /// The container moved or used; empty for an item not tracked by container.
  container_id      Int?
  /// Quantity moved, in the item's unit; always positive.
  quantity          Decimal         @db.Decimal
  /// Location the stock leaves; empty for a receipt.
  from_location_id  Int?
  /// Location the stock enters; empty for a consumption or a disposal.
  to_location_id    Int?
  /// The test result the stock was used for.
  test_result_id    Int?
  /// The machine service the spare part was used in.
  machine_service_id Int?
  /// The receipt line the stock came in on.
  receipt_line_id   Int?
  /// The requisition or transfer line the stock was issued on.
  transfer_line_id  Int?
  /// The preparation the stock was deducted for.
  preparation_id    Int?
  /// When the move was applied to stock on hand; empty while issued stock is in transit.
  done_at           DateTime?
  /// True when the system made the move from the method's usual use, rather than a person.
  automatic         Boolean         @default(false)
  /// Why the move was made, such as a calibration, cleaning or a spill.
  reason            String?         @db.Text
  /// The item moved.
  item              StockItem       @relation(fields: [item_id], references: [id], onDelete: Restrict)
  /// The lot moved.
  lot               StockLot?       @relation(fields: [lot_id], references: [id], onDelete: Restrict)
  /// The container moved or used.
  container         StockContainer? @relation(fields: [container_id], references: [id], onDelete: Restrict)
  /// Location the stock leaves.
  from_location     StockLocation?  @relation("MoveFrom", fields: [from_location_id], references: [id], onDelete: Restrict)
  /// Location the stock enters.
  to_location       StockLocation?  @relation("MoveTo", fields: [to_location_id], references: [id], onDelete: Restrict)
  /// The test result the stock was used for.
  test_result       TestResult?     @relation(fields: [test_result_id], references: [id], onDelete: Restrict)
  /// The machine service the spare part was used in.
  machine_service   MachineService? @relation(fields: [machine_service_id], references: [id], onDelete: Restrict)
  /// The receipt line the stock came in on.
  receipt_line      ReceiptLine?    @relation(fields: [receipt_line_id], references: [id], onDelete: Restrict)
  /// The requisition or transfer line the stock was issued on.
  transfer_line     StockTransferLine? @relation(fields: [transfer_line_id], references: [id], onDelete: Restrict)
  /// The preparation the stock was deducted for.
  preparation       Preparation?    @relation("PreparationInput", fields: [preparation_id], references: [id], onDelete: Restrict)
  /// Charges the move made to cost centres.
  charges           StockCharge[]
  /// The stock take line the correction came from.
  take_line        StockTakeLine?

  @@index([item_id])
  @@index([lot_id])
  @@index([container_id])
  @@index([test_result_id])
  @@map("medilab_stock_move")
}

/// How one solution is prepared: the chemicals and amounts one preparation uses, and the solution's shelf life.
model Recipe {
  /// Row identifier.
  id               Int           @id @default(autoincrement())
  /// Unique code of the recipe.
  code             String        @unique @db.VarChar
  /// The solution item the recipe makes.
  solution_item_id Int           @unique
  /// Quantity one preparation makes, in the solution item's unit.
  yield_quantity   Decimal       @db.Decimal
  /// Days the solution stays usable after it is prepared.
  shelf_life_days  Int
  /// False when the recipe is archived.
  active           Boolean       @default(true)
  /// The solution item the recipe makes.
  solution_item    StockItem     @relation("RecipeSolution", fields: [solution_item_id], references: [id], onDelete: Restrict)
  /// Ingredients of the recipe.
  lines            RecipeLine[]
  /// Preparations made from the recipe.
  preparations     Preparation[]

  @@map("medilab_recipe")
}

/// One ingredient of a recipe and the amount one preparation uses. Unique on (recipe_id, item_id).
model RecipeLine {
  /// Row identifier.
  id        Int       @id @default(autoincrement())
  /// The recipe.
  recipe_id Int
  /// The ingredient item.
  item_id   Int
  /// Amount one preparation uses, in the item's unit.
  quantity  Decimal   @db.Decimal
  /// The recipe.
  recipe    Recipe    @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  /// The ingredient item.
  item      StockItem @relation(fields: [item_id], references: [id], onDelete: Restrict)

  @@unique([recipe_id, item_id])
  @@map("medilab_recipe_line")
}

/// One preparation of a solution from its recipe. Who prepared it and when are Odoo's creation fields.
model Preparation {
  /// Row identifier.
  id          Int             @id @default(autoincrement())
  /// The recipe followed.
  recipe_id   Int
  /// The store the solution was prepared in.
  location_id Int
  /// The recipe followed.
  recipe      Recipe          @relation(fields: [recipe_id], references: [id], onDelete: Restrict)
  /// The store the solution was prepared in.
  location    StockLocation   @relation(fields: [location_id], references: [id], onDelete: Restrict)
  /// The solution container the preparation made.
  container   StockContainer? @relation("PreparationOutput")
  /// Moves that deducted the ingredients and waste.
  moves       StockMove[]     @relation("PreparationInput")

  @@index([recipe_id])
  @@map("medilab_preparation")
}

/// A requisition of stock from the store directly above, or a sideways transfer of sealed stock between two stores of the same level. Who did each step and when is in the audit trail.
model StockTransfer {
  /// Row identifier.
  id               Int                 @id @default(autoincrement())
  /// Unique code; filled from a sequence.
  code             String              @unique @db.VarChar
  /// requisition or transfer.
  kind             String              @db.VarChar
  /// The store the stock leaves.
  from_location_id Int
  /// The store the stock enters.
  to_location_id   Int
  /// draft, requested, escalated, approved, issued, received, refused or cancelled.
  status           String              @db.VarChar
  /// True when the requisition takes its cost centre over budget and needs the over-budget role's approval.
  over_budget      Boolean             @default(false)
  /// Why the requisition was refused.
  refusal_reason   String?             @db.Text
  /// The store the stock leaves.
  from_location    StockLocation       @relation("TransferFrom", fields: [from_location_id], references: [id], onDelete: Restrict)
  /// The store the stock enters.
  to_location      StockLocation       @relation("TransferTo", fields: [to_location_id], references: [id], onDelete: Restrict)
  /// Lines of the requisition or transfer.
  lines            StockTransferLine[]

  @@index([from_location_id, status])
  @@index([to_location_id, status])
  @@map("medilab_stock_transfer")
}

/// One item asked for or moved, with the quantity asked and issued. The containers issued are on its moves.
model StockTransferLine {
  /// Row identifier.
  id                 Int           @id @default(autoincrement())
  /// The requisition or transfer.
  transfer_id        Int
  /// The item.
  item_id            Int
  /// Quantity asked for, in the item's unit.
  requested_quantity Decimal       @db.Decimal
  /// Quantity issued so far.
  issued_quantity    Decimal       @default(0) @db.Decimal
  /// The requisition or transfer.
  transfer           StockTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  /// The item.
  item               StockItem     @relation(fields: [item_id], references: [id], onDelete: Restrict)
  /// Moves that issued the line.
  moves              StockMove[]

  @@index([transfer_id])
  @@map("medilab_stock_transfer_line")
}

/// A department or team that stock is charged to. Exactly one of department_id and team_id is set.
model CostCentre {
  /// Row identifier.
  id            Int           @id @default(autoincrement())
  /// Code that matches the one in the laboratory's accounting software.
  code          String        @unique @db.VarChar
  /// The department.
  department_id Int?          @unique
  /// The team.
  team_id       Int?          @unique
  /// The department.
  department    Department?   @relation(fields: [department_id], references: [id], onDelete: Restrict)
  /// The team.
  team          Team?         @relation(fields: [team_id], references: [id], onDelete: Restrict)
  /// Budgets of the cost centre.
  budgets       Budget[]
  /// Charges to the cost centre.
  charges       StockCharge[]

  @@map("medilab_cost_centre")
}

/// The supply budget of one cost centre for one quarter or year. Budgets of one cost centre do not overlap.
model Budget {
  /// Row identifier.
  id             Int        @id @default(autoincrement())
  /// The cost centre.
  cost_centre_id Int
  /// First day of the period.
  date_from      DateTime   @db.Date
  /// Last day of the period.
  date_to        DateTime   @db.Date
  /// Amount the cost centre may be charged in the period.
  amount         Decimal    @db.Decimal
  /// The cost centre.
  cost_centre    CostCentre @relation(fields: [cost_centre_id], references: [id], onDelete: Cascade)

  @@index([cost_centre_id, date_from])
  @@map("medilab_budget")
}

/// One charge or credit of a move to a cost centre, as the accounting export lists it. A transfer of charged stock makes a credit to the sending cost centre and a debit to the receiving one.
model StockCharge {
  /// Row identifier.
  id             Int        @id @default(autoincrement())
  /// The move that made the charge.
  move_id        Int
  /// The cost centre charged or credited.
  cost_centre_id Int
  /// Date the charge is posted.
  posting_date   DateTime   @db.Date
  /// issue, consumption, waste, disposal, adjustment or transfer.
  charge_type    String     @db.VarChar
  /// True for consumption by a test result.
  billable       Boolean    @default(false)
  /// Quantity charged, in the item's unit; negative for a credit.
  quantity       Decimal    @db.Decimal
  /// Cost of one unit, from the costing method at the time.
  unit_cost      Decimal    @db.Decimal
  /// Quantity times unit cost.
  value          Decimal    @db.Decimal
  /// The move that made the charge.
  move           StockMove  @relation(fields: [move_id], references: [id], onDelete: Restrict)
  /// The cost centre charged or credited.
  cost_centre    CostCentre @relation(fields: [cost_centre_id], references: [id], onDelete: Restrict)

  @@index([cost_centre_id, posting_date])
  @@index([posting_date])
  @@map("medilab_stock_charge")
}

/// A key the accounting software uses to fetch charges through the REST API.
model AccountingApiKey {
  /// Row identifier.
  id         Int       @id @default(autoincrement())
  /// Name of the key, such as the software it is for.
  name       String    @db.VarChar
  /// Hash of the key; the key itself is shown once when it is issued.
  key_hash   String    @unique @db.VarChar
  /// When the key was revoked; empty while it works.
  revoked_at DateTime?

  @@map("medilab_accounting_api_key")
}

/// How much of an item one test of a method usually uses; entering a result deducts it. Unique on (method_id, item_id).
model MethodConsumption {
  /// Row identifier.
  id        Int           @id @default(autoincrement())
  /// The testing method.
  method_id Int
  /// The item used.
  item_id   Int
  /// Quantity one test uses, in the item's unit.
  quantity  Decimal       @db.Decimal
  /// The testing method.
  method    TestingMethod @relation(fields: [method_id], references: [id], onDelete: Cascade)
  /// The item used.
  item      StockItem     @relation(fields: [item_id], references: [id], onDelete: Restrict)

  @@unique([method_id, item_id])
  @@index([item_id])
  @@map("medilab_method_consumption")
}

/// A company the laboratory buys stock from. Its name, address and people are its contact.
model Supplier {
  /// Row identifier.
  id                Int             @id @default(autoincrement())
  /// Unique code of the supplier; filled from a sequence when left empty.
  code              String          @unique @db.VarChar
  /// The company contact of the supplier.
  partner_id        Int             @unique
  /// The person the laboratory deals with by default.
  contact_person_id Int?
  /// Free notes about the supplier.
  note              String?         @db.Text
  /// False when the laboratory no longer buys from the supplier.
  active            Boolean         @default(true)
  /// The company contact of the supplier.
  partner           Contact         @relation("SupplierCompany", fields: [partner_id], references: [id], onDelete: Restrict)
  /// The person the laboratory deals with by default.
  contact_person    Contact?        @relation("SupplierContactPerson", fields: [contact_person_id], references: [id], onDelete: SetNull)
  /// Items the supplier sells.
  items             SupplierItem[]
  /// Purchase orders to the supplier.
  purchase_orders   PurchaseOrder[]
  /// Receipts from the supplier.
  receipts          Receipt[]

  @@map("medilab_supplier")
}

/// An item a supplier sells, with the supplier's own reference and last price. Unique on (supplier_id, item_id).
model SupplierItem {
  /// Row identifier.
  id             Int       @id @default(autoincrement())
  /// The supplier.
  supplier_id    Int
  /// The item.
  item_id        Int
  /// The supplier's reference for the item.
  supplier_code  String?   @db.VarChar
  /// Last price paid for one unit, excluding VAT.
  last_price     Decimal?  @db.Decimal
  /// The supplier.
  supplier       Supplier  @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  /// The item.
  item           StockItem @relation(fields: [item_id], references: [id], onDelete: Restrict)

  @@unique([supplier_id, item_id])
  @@index([item_id])
  @@map("medilab_supplier_item")
}

/// An order for stock to one supplier, signed through its approval chain before it is sent.
model PurchaseOrder {
  /// Row identifier.
  id            Int                 @id @default(autoincrement())
  /// Unique purchase order number; filled from a sequence.
  code          String              @unique @db.VarChar
  /// The supplier ordered from.
  supplier_id   Int
  /// The department that asked for the stock.
  department_id Int?
  /// draft, signing, approved, sent, partially_received, received or cancelled.
  status        String              @db.VarChar
  /// When the order was sent to the supplier.
  sent_at       DateTime?
  /// Date the supplier is expected to deliver.
  expected_date DateTime?           @db.Date
  /// Total excluding VAT.
  amount_total  Decimal             @db.Decimal
  /// Free notes for the supplier.
  note          String?             @db.Text
  /// The supplier ordered from.
  supplier      Supplier            @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  /// The department that asked for the stock.
  department    Department?         @relation(fields: [department_id], references: [id], onDelete: Restrict)
  /// Lines of the order.
  lines         PurchaseOrderLine[]
  /// Receipts of the order.
  receipts      Receipt[]

  @@index([supplier_id, status])
  @@map("medilab_purchase_order")
}

/// One item ordered, its quantity, price and how much has arrived.
model PurchaseOrderLine {
  /// Row identifier.
  id                Int           @id @default(autoincrement())
  /// The purchase order.
  order_id          Int
  /// The item ordered.
  item_id           Int
  /// Quantity ordered, in the item's unit.
  quantity          Decimal       @db.Decimal
  /// Price of one unit, excluding VAT.
  unit_price        Decimal       @db.Decimal
  /// Quantity received so far, from the receipts.
  received_quantity Decimal       @default(0) @db.Decimal
  /// The purchase order.
  order             PurchaseOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  /// The item ordered.
  item              StockItem     @relation(fields: [item_id], references: [id], onDelete: Restrict)
  /// Receipt lines that received this line.
  receipt_lines     ReceiptLine[]

  @@index([order_id])
  @@map("medilab_purchase_order_line")
}

/// Goods that arrived from a supplier, put away in a location. Who received them and when are Odoo's creation fields.
model Receipt {
  /// Row identifier.
  id                Int            @id @default(autoincrement())
  /// Unique receipt number; filled from a sequence.
  code              String         @unique @db.VarChar
  /// The supplier the goods came from.
  supplier_id       Int
  /// The purchase order received; empty for goods received without one.
  purchase_order_id Int?
  /// The location the goods were put away in.
  location_id       Int
  /// draft or done; a done receipt has created its lots and moves.
  status            String         @db.VarChar
  /// The supplier the goods came from.
  supplier          Supplier       @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  /// The purchase order received.
  purchase_order    PurchaseOrder? @relation(fields: [purchase_order_id], references: [id], onDelete: Restrict)
  /// The location the goods were put away in.
  location          StockLocation  @relation(fields: [location_id], references: [id], onDelete: Restrict)
  /// Lines of the receipt.
  lines             ReceiptLine[]

  @@index([purchase_order_id])
  @@map("medilab_receipt")
}

/// One item received: its lot, expiry, quantity and price.
model ReceiptLine {
  /// Row identifier.
  id                     Int                @id @default(autoincrement())
  /// The receipt.
  receipt_id             Int
  /// The purchase order line received; empty for goods received without an order.
  purchase_order_line_id Int?
  /// The item received.
  item_id                Int
  /// Lot number printed on the containers; empty for an item not tracked by lot.
  lot_number             String?            @db.VarChar
  /// Expiry date printed on the containers.
  expiry_date            DateTime?          @db.Date
  /// Quantity received, in the item's unit.
  quantity               Decimal            @db.Decimal
  /// Price of one unit, excluding VAT.
  unit_price             Decimal?           @db.Decimal
  /// The manufacturer's certificate of analysis.
  certificate_id         Int?
  /// The receipt.
  receipt                Receipt            @relation(fields: [receipt_id], references: [id], onDelete: Cascade)
  /// The purchase order line received.
  purchase_order_line    PurchaseOrderLine? @relation(fields: [purchase_order_line_id], references: [id], onDelete: Restrict)
  /// The item received.
  item                   StockItem          @relation(fields: [item_id], references: [id], onDelete: Restrict)
  /// Moves the line created.
  moves                  StockMove[]

  @@index([receipt_id])
  @@map("medilab_receipt_line")
}

/// A stock take (kiểm kê kho): a physical check of one location and everything inside it. When it is done, every difference becomes a correction move.
model StockTake {
  /// Row identifier.
  id           Int              @id @default(autoincrement())
  /// Unique code of the stock take; filled from a sequence.
  code         String           @unique @db.VarChar
  /// The location counted, with every location inside it.
  location_id  Int
  /// Date the stock take is planned for.
  planned_date DateTime         @db.Date
  /// draft, in_progress, done or cancelled.
  status       String           @db.VarChar
  /// When the stock take was done.
  done_at      DateTime?
  /// The location counted.
  location     StockLocation    @relation(fields: [location_id], references: [id], onDelete: Restrict)
  /// Lines of the stock take.
  lines        StockTakeLine[]

  @@index([status, planned_date])
  @@map("medilab_stock_take")
}

/// One item, lot, container and location in a stock take: what the system expected and what was found.
/// Unique on (take_id, item_id, COALESCE(lot_id, 0), COALESCE(container_id, 0), location_id).
model StockTakeLine {
  /// Row identifier.
  id                Int           @id @default(autoincrement())
  /// The stock take.
  take_id          Int
  /// The item counted.
  item_id           Int
  /// The lot counted; empty for an item not tracked by lot.
  lot_id            Int?
  /// The container counted; empty for an item not tracked by container.
  container_id      Int?
  /// The location counted.
  location_id       Int
  /// Quantity on hand when the stock take started, in the item's unit.
  expected_quantity Decimal       @db.Decimal
  /// Quantity found; empty until counted.
  counted_quantity  Decimal?      @db.Decimal
  /// The correction move created for the difference, when there is one.
  move_id           Int?          @unique
  /// The stock take.
  take              StockTake    @relation(fields: [take_id], references: [id], onDelete: Cascade)
  /// The item counted.
  item              StockItem     @relation(fields: [item_id], references: [id], onDelete: Restrict)
  /// The lot counted.
  lot               StockLot?     @relation(fields: [lot_id], references: [id], onDelete: Restrict)
  /// The container counted.
  container         StockContainer? @relation(fields: [container_id], references: [id], onDelete: Restrict)
  /// The location counted.
  location          StockLocation @relation("TakeLineLocation", fields: [location_id], references: [id], onDelete: Restrict)
  /// The correction move created for the difference.
  move              StockMove?    @relation(fields: [move_id], references: [id], onDelete: Restrict)

  @@index([take_id])
  @@map("medilab_stock_take_line")
}
