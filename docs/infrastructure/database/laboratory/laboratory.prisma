// Laboratory module tables as the Odoo ORM creates them: master data, test requests, samples, results, signing, tasks, scheduling, reports, change requests, audit, locks, notifications, scheduled jobs and laboratory files. Tables of the Odoo apps the module builds on (hr, resource, calendar, mail and base) appear with the columns the module uses and the columns it adds, under their Odoo table names. System parameters are Odoo settings stored in ir.config_parameter. Odoo owns the schema; this file only draws it.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A single property the laboratory tests on a sample; the unit customers order and pay for. Trigram indexes on code and name serve catalog search.
model TestParameter {
  /// Row identifier.
  id           Int                       @id @default(autoincrement())
  /// Unique code staff and documents use for the parameter; filled from a sequence when left empty.
  code         String                    @unique @db.VarChar
  /// Parameter name in each language.
  name         Json
  /// The group revenue reports count the parameter under; one of the parameter's groups.
  main_group_id Int
  /// False when the parameter is archived and no longer offered.
  active       Boolean                   @default(true)
  /// The group revenue reports count the parameter under.
  main_group   ParameterGroup            @relation("MainGroup", fields: [main_group_id], references: [id], onDelete: Restrict)
  /// Groups the parameter belongs to.
  groups       TestParameterGroup[]
  /// Sample types the parameter can be tested on.
  sample_types TestParameterSampleType[]
  /// Ways the parameter can be tested.
  methods      ParameterMethod[]
  /// Limits regulations set for the parameter.
  regulation_limits RegulationLimit[]
  /// Sample tests of this parameter.
  sample_tests      SampleTest[]

  @@index([main_group_id])
  @@map("medilab_test_parameter")
}

/// A kind of analysis that organises the catalog, such as Pesticides with the sub-group Organophosphates. Sets no price. Trigram indexes on code and name serve search.
model ParameterGroup {
  /// Row identifier.
  id          Int                  @id @default(autoincrement())
  /// Unique code of the group, such as NCT.0001; filled from a sequence when left empty.
  code        String               @unique @db.VarChar
  /// Group name in each language.
  name        Json
  /// The group this one is a sub-group of; empty for a top-level group.
  parent_id   Int?
  /// Ids of the group and all its ancestors, such as 1/4/9/, so filtering by a group finds its sub-groups in one query.
  parent_path String?              @db.VarChar
  /// False when the group is archived.
  active      Boolean              @default(true)
  /// The group this one is a sub-group of.
  parent      ParameterGroup?      @relation("GroupTree", fields: [parent_id], references: [id], onDelete: Restrict)
  /// Sub-groups of this group.
  children    ParameterGroup[]     @relation("GroupTree")
  /// Parameters in the group.
  parameters  TestParameterGroup[]
  /// Parameters whose revenue is reported under this group.
  main_parameters TestParameter[]  @relation("MainGroup")

  @@index([parent_id])
  @@index([parent_path])
  @@map("medilab_parameter_group")
}

/// The kind of material a sample is, such as Vegetables with the child Cabbage; filters the catalog. Trigram indexes on code and name serve search.
model SampleType {
  /// Row identifier.
  id          Int                       @id @default(autoincrement())
  /// Unique code of the sample type, such as LM.0001; filled from a sequence when left empty.
  code        String                    @unique @db.VarChar
  /// Sample type name in each language.
  name        Json
  /// The broader sample type this one belongs to; empty for a top-level type.
  parent_id   Int?
  /// Ids of the sample type and all its ancestors, such as 2/7/, so filtering by a type finds its children in one query.
  parent_path String?                   @db.VarChar
  /// Smallest amount of sample to collect, in minimum_quantity_unit.
  minimum_quantity         Decimal? @db.Decimal
  /// Unit of the minimum amount, such as g or mL.
  minimum_quantity_unit_id Int?
  /// How to collect the sample, in each language.
  sampling_requirements    Json?
  /// How to store the sample before and after testing, such as "2–8 °C, away from light", in each language.
  storage_conditions       Json?
  /// True when the laboratory keeps the sample after testing.
  is_retained              Boolean                   @default(false)
  /// Number of days the sample is kept after testing.
  retention_days           Int?
  /// What to do with the sample right after testing, in each language.
  post_test_requirements   Json?
  /// How to dispose of the sample after the retention period, in each language.
  disposal_method          Json?
  /// False when the sample type is archived.
  active      Boolean                   @default(true)
  /// The broader sample type this one belongs to.
  parent      SampleType?               @relation("SampleTypeTree", fields: [parent_id], references: [id], onDelete: Restrict)
  /// Narrower sample types under this one.
  children    SampleType[]              @relation("SampleTypeTree")
  /// Unit of the minimum amount.
  minimum_quantity_unit    MeasurementUnit?          @relation(fields: [minimum_quantity_unit_id], references: [id], onDelete: Restrict)
  /// Parameters that can be tested on this sample type.
  parameters  TestParameterSampleType[]
  /// Samples of this type.
  samples     Sample[]
  /// Regulations that apply to this sample type.
  regulations RegulationSampleType[]

  @@index([parent_id])
  @@index([parent_path])
  @@index([minimum_quantity_unit_id])
  @@map("medilab_sample_type")
}

/// A regulation the results are compared against, such as QCVN 6-1:2010/BYT, with a limit per parameter. Trigram indexes on code and name serve search.
model Regulation {
  /// Row identifier.
  id                Int                    @id @default(autoincrement())
  /// Unique reference of the regulation, such as QCVN 6-1:2010/BYT.
  code              String                 @unique @db.VarChar
  /// Title of the regulation in each language.
  name              Json
  /// The ministry or body that issued the regulation.
  issuing_authority String?                @db.VarChar
  /// False when the regulation is archived.
  active            Boolean                @default(true)
  /// Sample types the regulation applies to.
  sample_types      RegulationSampleType[]
  /// Limits the regulation sets, one per parameter.
  limits            RegulationLimit[]
  /// Samples compared with the regulation.
  samples           Sample[]

  @@map("medilab_regulation")
}

/// The limit a regulation sets for one parameter. Unique on (regulation_id, parameter_id).
/// A minimum or maximum may be empty or any number, including 0. min_set and max_set say which are set.
/// At least one of those and limit_text is set; unit_id is set when a minimum or maximum is set.
model RegulationLimit {
  /// Row identifier.
  id            Int             @id @default(autoincrement())
  /// The regulation that sets the limit.
  regulation_id Int
  /// The parameter the limit applies to.
  parameter_id  Int
  /// The unit of min_value and max_value; empty for a text-only limit.
  unit_id       Int?
  /// True when a minimum is set. The minimum may be 0.
  min_set       Boolean         @default(false)
  /// Lowest allowed value, including 0. Meaningful when min_set is set.
  min_value     Decimal? @db.Decimal
  /// True when a maximum is set. The maximum may be 0.
  max_set       Boolean         @default(false)
  /// Highest allowed value, including 0. Meaningful when max_set is set.
  max_value     Decimal? @db.Decimal
  /// Decimals the limit shows on the report, such as 2 for 0.50.
  decimals      Int?
  /// The limit as printed on the report when it is not a number, such as "Not detected", in each language.
  limit_text    Json?
  /// The regulation that sets the limit.
  regulation    Regulation      @relation(fields: [regulation_id], references: [id], onDelete: Cascade)
  /// The parameter the limit applies to.
  parameter     TestParameter   @relation(fields: [parameter_id], references: [id], onDelete: Restrict)
  /// The unit of the limit values.
  unit          MeasurementUnit? @relation(fields: [unit_id], references: [id], onDelete: Restrict)

  @@unique([regulation_id, parameter_id])
  @@index([parameter_id])
  @@index([unit_id])
  @@map("medilab_regulation_limit")
}

/// Links regulations to the sample types they apply to.
model RegulationSampleType {
  /// The regulation.
  regulation_id  Int
  /// A sample type the regulation applies to.
  sample_type_id Int
  /// The regulation.
  regulation     Regulation @relation(fields: [regulation_id], references: [id], onDelete: Cascade)
  /// The sample type.
  sample_type    SampleType @relation(fields: [sample_type_id], references: [id], onDelete: Restrict)

  @@id([regulation_id, sample_type_id])
  @@index([sample_type_id])
  @@map("medilab_regulation_sample_type_rel")
}

/// The procedure the laboratory follows to test a parameter. Trigram indexes on code and name serve search.
model TestingMethod {
  /// Row identifier.
  id         Int               @id @default(autoincrement())
  /// Unique standard reference of the method, such as TCVN 6187-1:2009.
  code       String            @unique @db.VarChar
  /// Title of the standard in each language, such as "Water quality — Detection of coliforms".
  name       Json
  /// The testing field the method belongs to.
  field_id   Int
  /// False when the method is archived.
  active     Boolean           @default(true)
  /// The testing field the method belongs to.
  field      TestingField      @relation(fields: [field_id], references: [id], onDelete: Restrict)
  /// Parameters tested with this method.
  parameters ParameterMethod[]
  /// Chemicals the method uses.
  chemicals  ChemicalMethod[]
  /// Steps of the procedure, in step number order.
  steps      TestingMethodStep[]
  /// Accreditation certificates whose scope lists the method.
  certificates AccreditationCertificateMethod[]

  @@index([field_id])
  @@map("medilab_testing_method")
}

/// A step of a testing method's procedure.
model TestingMethodStep {
  /// Row identifier.
  id               Int           @id @default(autoincrement())
  /// The testing method the step belongs to.
  method_id        Int
  /// Step number; steps are shown in this order.
  sequence         Int
  /// Minutes the step takes.
  duration_minutes Int
  /// What to do in the step.
  instruction      String
  /// Remark on the step, such as a precaution.
  note             String?
  /// Where the step is done.
  location_id      Int?
  /// Where the step is done.
  location         Location? @relation(fields: [location_id], references: [id], onDelete: Restrict)
  /// Location bookings the scheduler made for the step.
  room_events      CalendarEvent[]
  /// The testing method the step belongs to.
  method           TestingMethod @relation(fields: [method_id], references: [id], onDelete: Cascade)

  @@index([location_id])
  @@unique([method_id, sequence])
  @@map("medilab_testing_method_step")
}

/// A place in the company's premises (Vị trí), such as a room, a bench, an area or a sampling point. Every module uses it.
model Location {
  /// Row identifier.
  id            Int               @id @default(autoincrement())
  /// Unique code of the location.
  code          String            @unique @db.VarChar
  /// Name of the location in each language.
  name          Json
  /// The broader location this one is in; empty for a top-level location.
  parent_id     Int?
  /// The department that uses the location.
  department_id Int?
  /// Picture of the location, such as a floor plan, an Odoo attachment; the map the locations inside it are placed on.
  image_attachment_id Int?
  /// Horizontal position on the parent location's image, as a share of its width from 0 to 1; empty when not placed.
  map_x         Float?
  /// Vertical position on the parent location's image, as a share of its height from 0 to 1; empty when not placed.
  map_y         Float?
  /// True when people can book the location on their calendar.
  is_bookable   Boolean           @default(false)
  /// False when the location is archived.
  active        Boolean           @default(true)
  /// The broader location this one is in.
  parent        Location?  @relation("LocationTree", fields: [parent_id], references: [id], onDelete: Restrict)
  /// Locations inside this one.
  children      Location[] @relation("LocationTree")
  /// The department that uses the location.
  department    Department?       @relation(fields: [department_id], references: [id], onDelete: SetNull)
  /// Steps done in the location.
  steps         TestingMethodStep[]
  /// Samples taken from the location.
  samples       Sample[]
  /// Calendar events that book the location.
  bookings      CalendarEvent[]
  /// Machines standing in the location.
  machines      Machine[]

  @@index([parent_id])
  @@index([department_id])
  @@map("medilab_location")
}

/// An ISO 17025 accreditation certificate of the laboratory (Giấy chứng nhận công nhận). Trigram index on code serves search.
model AccreditationCertificate {
  /// Row identifier.
  id           Int                             @id @default(autoincrement())
  /// Certificate number, such as VILAS 123.
  code         String                          @unique @db.VarChar
  /// The body that issued the certificate.
  issuing_body String?                         @db.VarChar
  /// First day the certificate is valid; empty means valid from any date.
  valid_from   DateTime?                       @db.Date
  /// Last day the certificate is valid; empty means valid until any date.
  valid_until  DateTime?                       @db.Date
  /// False when the certificate is archived.
  active       Boolean                         @default(true)
  /// Testing methods in the scope of the certificate.
  methods      AccreditationCertificateMethod[]

  @@map("medilab_accreditation_certificate")
}

/// Links an accreditation certificate to the testing methods in its scope.
model AccreditationCertificateMethod {
  /// The certificate.
  certificate_id Int
  /// A method in its scope.
  method_id      Int
  /// The certificate.
  certificate    AccreditationCertificate @relation(fields: [certificate_id], references: [id], onDelete: Cascade)
  /// The testing method.
  method         TestingMethod            @relation(fields: [method_id], references: [id], onDelete: Restrict)

  @@id([certificate_id, method_id])
  @@index([method_id])
  @@map("medilab_accreditation_certificate_method_rel")
}

/// A field of testing that classifies methods, such as Chemistry or Microbiology. Trigram indexes on code and name serve search.
model TestingField {
  /// Row identifier.
  id      Int             @id @default(autoincrement())
  /// Unique code of the field.
  code    String          @unique @db.VarChar
  /// Field name in each language.
  name    Json
  /// False when the field is archived.
  active  Boolean         @default(true)
  /// Methods in the field.
  methods TestingMethod[]

  @@map("medilab_testing_field")
}

/// Odoo's employee department (hr.department), shown with the columns this schema uses and the columns the laboratory adds. A team (tổ) is a department whose parent is its department.
model Department {
  /// Row identifier.
  id                Int               @id @default(autoincrement())
  /// Department or team name in each language.
  name              Json
  /// The department a team belongs to; empty for a department.
  parent_id         Int?
  /// The head of the department, or the lead of a team.
  manager_id        Int?
  /// False when the department is archived.
  active            Boolean           @default(true)
  /// The department a team belongs to.
  parent            Department?       @relation("DepartmentTeams", fields: [parent_id], references: [id], onDelete: Restrict)
  /// Teams the department is split into.
  teams             Department[]      @relation("DepartmentTeams")
  /// The head of the department, or the lead of a team.
  manager           Employee?         @relation("DepartmentManager", fields: [manager_id], references: [id], onDelete: SetNull)
  /// Parameter and method pairs the department tests in-house.
  parameter_methods ParameterMethod[]
  /// Employees in the department.
  employees         Employee[]        @relation("EmployeeDepartment")
  /// People of the team.
  team_people       Person[]          @relation("PersonTeam")
  /// Notification events whose notifications go to the department.
  notification_recipients NotificationEventRecipient[]
  /// Tasks in the department's queue.
  tasks             Task[]
  /// Wizards that move tasks into this department's queue.
  task_reassigns    TaskReassign[]
  /// Samples handed over to the department.
  handovers         SampleHandover[]
  /// Machine bookings of the department's testing tasks.
  bookings          MachineBooking[]
  /// Locations the department uses.
  locations         Location[]

  @@index([parent_id])
  @@map("hr_department")
}

/// The unit in which a measured value is expressed.
model MeasurementUnit {
  /// Row identifier.
  id                Int               @id @default(autoincrement())
  /// Unique unit symbol, such as mg/kg.
  name              String            @unique @db.VarChar
  /// The kind of quantity the unit measures; units convert only within one category.
  category_id       Int
  /// Number of reference units in one of this unit, such as 0.001 for µg/L when mg/L is the reference; 1 for the reference unit.
  factor            Decimal @db.Decimal             @default(1)
  /// False when the unit is archived.
  active            Boolean           @default(true)
  /// The kind of quantity the unit measures.
  category          UnitCategory      @relation(fields: [category_id], references: [id], onDelete: Restrict)
  /// Parameter and method pairs whose results use this unit.
  parameter_methods ParameterMethod[]
  /// Sample types whose minimum amount uses this unit.
  sample_types      SampleType[]
  /// Regulation limits expressed in this unit.
  regulation_limits RegulationLimit[]
  /// Results expressed in this unit.
  results           TestResult[] @relation("ResultUnit")
  /// Results whose copied limits are in this unit.
  result_limits     TestResult[] @relation("ResultLimitUnit")

  @@index([category_id])
  @@map("medilab_measurement_unit")
}

/// A kind of quantity, such as mass concentration in liquid; units in one category convert into each other.
model UnitCategory {
  /// Row identifier.
  id     Int               @id @default(autoincrement())
  /// Category name in each language.
  name   Json
  /// False when the category is archived.
  active Boolean           @default(true)
  /// Units in the category.
  units  MeasurementUnit[]

  @@map("medilab_unit_category")
}

/// How one parameter is tested with one method, by the laboratory or by a subcontractor, and the unit of its result.
/// Active rows are unique on (parameter_id, method_id, COALESCE(subcontractor_id, 0)) WHERE active.
/// At most one row per parameter is the default (partial unique index on parameter_id where is_default).
model ParameterMethod {
  /// Row identifier.
  id               Int             @id @default(autoincrement())
  /// The parameter being tested.
  parameter_id     Int
  /// The method used to test it.
  method_id        Int
  /// The unit the result is expressed in.
  unit_id          Int
  /// The subcontractor that tests it; empty when the laboratory tests it in-house.
  subcontractor_id Int?
  /// The department that tests it in-house; empty when a subcontractor tests it.
  department_id    Int?
  /// True while this in-house way of testing's method is on an accreditation certificate valid that day; worked out, never set by hand.
  is_accredited    Boolean         @default(false)
  /// Limit of detection: the lowest value this method can detect, in the row's unit.
  lod              Decimal? @db.Decimal
  /// Limit of quantification: the lowest value this method can measure reliably, in the row's unit.
  loq              Decimal? @db.Decimal
  /// Decimals a result of this way of testing shows, such as 2 for 0.50; results copy it.
  result_decimals  Int?
  /// True for the way the parameter is normally tested.
  is_default       Boolean         @default(false)
  /// False when this way of testing is archived.
  active           Boolean         @default(true)
  /// The parameter being tested.
  parameter        TestParameter   @relation(fields: [parameter_id], references: [id], onDelete: Restrict)
  /// The method used to test it.
  method           TestingMethod   @relation(fields: [method_id], references: [id], onDelete: Restrict)
  /// The unit the result is expressed in.
  unit             MeasurementUnit @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  /// The subcontractor that tests it.
  subcontractor    Subcontractor?  @relation(fields: [subcontractor_id], references: [id], onDelete: Restrict)
  /// The department that tests it in-house.
  department       Department?     @relation(fields: [department_id], references: [id], onDelete: Restrict)
  /// Machines that can run it.
  machines         ParameterMethodMachine[]
  /// Quality registration dossiers that cover it.
  registrations    QualityRegistrationParameterMethod[]
  /// Sample tests done this way.
  sample_tests     SampleTest[]

  @@index([method_id])
  @@index([unit_id])
  @@index([subcontractor_id])
  @@index([department_id])
  @@map("medilab_parameter_method")
}

/// An outside laboratory that tests parameters for the laboratory. Its name, address and people are its contact. A trigram index on code serves search; the name is the contact's.
model Subcontractor {
  /// Row identifier.
  id                    Int               @id @default(autoincrement())
  /// Unique code of the subcontractor, such as TP.0001; filled from a sequence when left empty.
  code                  String            @unique @db.VarChar
  /// The company contact of the subcontractor.
  partner_id            Int               @unique
  /// The person the laboratory deals with by default; usually one of the company's people, but any person contact is allowed.
  contact_person_id     Int?
  /// Number of the subcontractor's accreditation certificate, such as VILAS 123.
  accreditation_number  String?           @db.VarChar
  /// Date the accreditation certificate expires; empty when it does not expire.
  accreditation_expiry  DateTime?         @db.Date
  /// Reference of the contract between the laboratory and the subcontractor.
  contract_reference    String?           @db.VarChar
  /// Free notes about working with the subcontractor.
  note                  String?           @db.Text
  /// False when the laboratory no longer uses the subcontractor.
  active                Boolean           @default(true)
  /// The company contact of the subcontractor.
  partner               Contact           @relation("SubcontractorCompany", fields: [partner_id], references: [id], onDelete: Restrict)
  /// The person the laboratory deals with by default.
  contact_person       Contact?          @relation("SubcontractorContactPerson", fields: [contact_person_id], references: [id], onDelete: SetNull)
  /// Parameter and method pairs the subcontractor tests.
  parameter_methods     ParameterMethod[]
  /// Dispatches sent to the subcontractor.
  dispatches            SubcontractDispatch[]

  @@index([contact_person_id])
  @@map("medilab_subcontractor")
}

/// Odoo's contact table for companies and people, shown with the columns this schema uses. A trigram index on name serves search.
model Contact {
  /// Row identifier.
  id                         Int             @id @default(autoincrement())
  /// Name of the company or person.
  name                       String          @db.VarChar
  /// Tax ID of a company, or of an individual who has one: Odoo's own field.
  vat                        String?         @db.VarChar
  /// True for a company: computed by Odoo from the tax ID, and always true for a subcontractor's contact.
  is_company                 Boolean         @default(false)
  /// The company a person works for.
  parent_id                  Int?
  /// The company a person works for.
  company                    Contact?        @relation("CompanyPeople", fields: [parent_id], references: [id])
  /// People who work for this company.
  people                     Contact[]       @relation("CompanyPeople")
  /// The subcontractor record when this company is a subcontractor.
  subcontractor              Subcontractor?  @relation("SubcontractorCompany")
  /// Subcontractors for which this person is the contact person.
  subcontractor_contact_for  Subcontractor[] @relation("SubcontractorContactPerson")
  /// The customer whose details this contact holds.
  customer                   Customer?       @relation("CustomerPartner")
  /// Customers for which this person is the default contact.
  default_contact_for        Customer[]      @relation("CustomerDefaultContact")
  /// Test requests whose report this contact receives.
  received_reports           TestRequest[]   @relation("ReportRecipient")
  /// The employee whose details this contact holds.
  employee                   Employee?
  /// Odoo users whose details this contact holds.
  users                      User[]          @relation("UserPartner")
  /// True when Brevo reported a hard bounce or an invalid address for this contact.
  email_bounced              Boolean         @default(false)

  @@map("res_partner")
}

/// Links parameters to the groups they belong to.
model TestParameterGroup {
  /// The parameter.
  parameter_id Int
  /// A group the parameter belongs to.
  group_id     Int
  /// The parameter.
  parameter    TestParameter  @relation(fields: [parameter_id], references: [id], onDelete: Cascade)
  /// The group.
  group        ParameterGroup @relation(fields: [group_id], references: [id], onDelete: Restrict)

  @@id([parameter_id, group_id])
  @@index([group_id])
  @@map("medilab_test_parameter_group_rel")
}

/// Links parameters to the sample types they can be tested on.
model TestParameterSampleType {
  /// The parameter.
  parameter_id   Int
  /// A sample type the parameter can be tested on.
  sample_type_id Int
  /// The parameter.
  parameter      TestParameter @relation(fields: [parameter_id], references: [id], onDelete: Cascade)
  /// The sample type.
  sample_type    SampleType    @relation(fields: [sample_type_id], references: [id], onDelete: Restrict)

  @@id([parameter_id, sample_type_id])
  @@index([sample_type_id])
  @@map("medilab_test_parameter_sample_type_rel")
}

/// Laboratory equipment used to run tests. Trigram indexes on code, name and serial number serve search.
model Machine {
  /// Row identifier.
  id                    Int                    @id @default(autoincrement())
  /// Unique code of the machine.
  code                  String                 @unique @db.VarChar
  /// Name of the machine, such as "HPLC 1".
  name                  String                 @db.VarChar
  /// Model of the machine, as named by the manufacturer.
  model                 String?                @db.VarChar
  /// Company that made the machine.
  manufacturer          String?                @db.VarChar
  /// Serial number given by the manufacturer.
  serial_number         String?                @db.VarChar
  /// The location the machine stands in, such as a bench.
  location_id           Int?
  /// The location the machine stands in.
  location              Location?              @relation(fields: [location_id], references: [id], onDelete: Restrict)
  /// in_use, under_repair or retired.
  status                String                 @db.VarChar
  /// Date the next calibration is due, taken from the latest calibration record; the machine cannot be used after it.
  next_calibration_date DateTime?              @db.Date
  /// Days between two maintenance visits; empty when the machine has no schedule.
  maintenance_interval_days Int?
  /// Date the next maintenance is due, from the latest maintenance record and the interval.
  next_maintenance_date DateTime?              @db.Date
  /// False when the machine is archived.
  active                Boolean                @default(true)
  /// Calibration, maintenance and repair records of the machine.
  services              MachineService[]
  /// Parameter and method pairs the machine can run.
  parameter_methods     ParameterMethodMachine[]
  /// Bookings of the machine.
  bookings              MachineBooking[]
  /// Results measured on the machine.
  results               TestResult[]

  @@index([next_calibration_date])
  @@index([location_id])
  @@map("medilab_machine")
}

/// One calibration, maintenance or repair done on a machine.
model MachineService {
  /// Row identifier.
  id           Int       @id @default(autoincrement())
  /// The machine serviced.
  machine_id   Int
  /// calibration, maintenance or repair.
  kind         String    @db.VarChar
  /// Date the service was done.
  service_date DateTime  @db.Date
  /// Date the next service of this kind is due, such as the calibration certificate's expiry.
  next_due_date DateTime? @db.Date
  /// Person or company that did the service.
  performed_by String?   @db.VarChar
  /// Number of the calibration certificate or service report.
  reference    String?   @db.VarChar
  /// What was done and found.
  note         String?   @db.Text
  /// The machine serviced.
  machine      Machine   @relation(fields: [machine_id], references: [id], onDelete: Restrict)

  @@index([machine_id, kind, service_date])
  @@map("medilab_machine_service")
}

/// A machine that can run a parameter and method pair, and how long one run takes. Unique on (parameter_method_id, machine_id).
model ParameterMethodMachine {
  /// Row identifier.
  id                  Int             @id @default(autoincrement())
  /// The parameter and method pair.
  parameter_method_id Int
  /// A machine that can run it.
  machine_id          Int
  /// Minutes one run takes on the machine; the booking rounds it up to whole slots.
  run_minutes         Int
  /// The parameter and method pair.
  parameter_method    ParameterMethod @relation(fields: [parameter_method_id], references: [id], onDelete: Cascade)
  /// The machine.
  machine             Machine         @relation(fields: [machine_id], references: [id], onDelete: Restrict)

  @@unique([parameter_method_id, machine_id])
  @@index([machine_id])
  @@map("medilab_parameter_method_machine")
}

/// A chemical substance the laboratory keeps and uses for testing. Stock, expiry and suppliers are kept by Inventory. Trigram indexes on code, name and CAS number serve search.
model Chemical {
  /// Row identifier.
  id                 Int              @id @default(autoincrement())
  /// Unique code of the chemical.
  code               String           @unique @db.VarChar
  /// Chemical name in each language.
  name               Json
  /// CAS registry number, such as 7647-14-5.
  cas_number         String?          @db.VarChar
  /// Chemical formula, such as NaCl.
  formula            String?          @db.VarChar
  /// Grade or purity, such as "AR, ≥ 99.5 %".
  grade              String?          @db.VarChar
  /// How the chemical must be stored, in each language.
  storage_conditions Json?
  /// False when the chemical is archived.
  active             Boolean          @default(true)
  /// Testing methods that use the chemical.
  methods            ChemicalMethod[]

  @@index([cas_number])
  @@map("medilab_chemical")
}

/// Links chemicals to the testing methods that use them.
model ChemicalMethod {
  /// The chemical.
  chemical_id Int
  /// A testing method that uses it.
  method_id   Int
  /// The chemical.
  chemical    Chemical      @relation(fields: [chemical_id], references: [id], onDelete: Restrict)
  /// The testing method.
  method      TestingMethod @relation(fields: [method_id], references: [id], onDelete: Restrict)

  @@id([chemical_id, method_id])
  @@index([method_id])
  @@map("medilab_chemical_method_rel")
}

/// A quality registration dossier with an authority that covers some ways of testing; its mark is printed after the parameter name on the report. Trigram indexes on code and name serve search.
model QualityRegistration {
  /// Row identifier.
  id                Int                                  @id @default(autoincrement())
  /// Unique code of the dossier; filled from a sequence when left empty.
  code              String                               @unique @db.VarChar
  /// Dossier name in each language.
  name              Json
  /// The ministry or body the dossier is registered with.
  issuing_authority String?                              @db.VarChar
  /// First day the registration is valid.
  valid_from        DateTime?                            @db.Date
  /// Last day the registration is valid; it counts as expired after this date.
  valid_until       DateTime?                            @db.Date
  /// Mark printed after the name of each covered parameter on the report, such as (*).
  report_mark       String?                              @db.VarChar
  /// False when the dossier is archived.
  active            Boolean                              @default(true)
  /// Parameter and method pairs the dossier covers.
  parameter_methods QualityRegistrationParameterMethod[]

  @@index([valid_until])
  @@map("medilab_quality_registration")
}

/// Links quality registration dossiers to the parameter and method pairs they cover.
model QualityRegistrationParameterMethod {
  /// The dossier.
  registration_id     Int
  /// A parameter and method pair it covers.
  parameter_method_id Int
  /// The dossier.
  registration        QualityRegistration @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  /// The parameter and method pair.
  parameter_method    ParameterMethod     @relation(fields: [parameter_method_id], references: [id], onDelete: Restrict)

  @@id([registration_id, parameter_method_id])
  @@index([parameter_method_id])
  @@map("medilab_quality_registration_parameter_method_rel")
}

/// A company or individual who asks the laboratory for tests. Their details and their people are their contact; people who use the customer portal have Odoo users.
model Customer {
  /// Row identifier.
  id                  Int        @id @default(autoincrement())
  /// Unique code of the customer, such as KH.0001; filled from a sequence when left empty.
  code                String     @unique @db.VarChar
  /// The contact holding the customer's details: name, address, email, phone, and for a company its people.
  partner_id          Int        @unique
  /// Citizen ID of an individual: personal data, masked in the audit trail and read only by those who maintain customers.
  citizen_id          String?    @db.VarChar
  /// The person of a business the laboratory contacts by default; empty for an individual, who is their own contact.
  default_contact_id  Int?
  /// The existing customer a self-registered account matched on tax code or citizen ID; empty when not flagged or once sales reviewed it.
  duplicate_of_id     Int?
  /// False when the customer is archived.
  active              Boolean    @default(true)
  /// The contact holding the customer's details.
  partner             Contact    @relation("CustomerPartner", fields: [partner_id], references: [id], onDelete: Restrict)
  /// The person of a business the laboratory contacts by default.
  default_contact     Contact?   @relation("CustomerDefaultContact", fields: [default_contact_id], references: [id], onDelete: SetNull)
  /// The existing customer a self-registered account matched.
  duplicate_of        Customer?  @relation("CustomerDuplicate", fields: [duplicate_of_id], references: [id], onDelete: SetNull)
  /// Self-registered accounts flagged as possible duplicates of this customer.
  possible_duplicates Customer[] @relation("CustomerDuplicate")
  /// Test requests of the customer.
  test_requests       TestRequest[]

  @@map("medilab_customer")
}

/// A request for the laboratory to test the samples of one customer. E-commerce creates it from a confirmed order with the samples sales defined on the quotation; without E-commerce sample delivery staff create it.
model TestRequest {
  /// Row identifier.
  id           Int      @id @default(autoincrement())
  /// Unique code of the request, such as YC.2026.0001, numbered again each year; filled from a sequence when left empty.
  code         String   @unique @db.VarChar
  /// The customer who asks for the tests.
  customer_id  Int
  /// Date the request was made.
  request_date DateTime @db.Date
  /// Date sales promised the customer the results.
  expected_date DateTime? @db.Date
  /// True for a priority request: the expected date is earlier than the estimate and the check said it can be met, so its tests are urgent.
  priority      Boolean  @default(false)
  /// Language the customer wants the report in: vi, en or bilingual.
  report_language String @default("bilingual") @db.VarChar
  /// How the report reaches the customer: in_person, post, email or other.
  delivery_method String @default("in_person") @db.VarChar
  /// How to deliver when delivery_method is other, or details such as the postal address.
  delivery_note String? @db.Text
  /// The contact who receives the report; the customer's own contact when empty.
  report_recipient_id Int?
  /// draft, confirmed, paid, sample_received, testing, awaiting_approval, completed, reported or cancelled.
  status       String   @db.VarChar
  /// Free notes about the request.
  note         String?  @db.Text
  /// The customer who asks for the tests.
  customer     Customer @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  /// The contact who receives the report.
  report_recipient Contact? @relation("ReportRecipient", fields: [report_recipient_id], references: [id], onDelete: Restrict)
  /// Samples of the request.
  samples      Sample[]
  /// Reports of the request, one per version.
  reports      TestReport[]
  /// Handover records of the request's samples.
  handover_records HandoverRecord[]

  @@index([customer_id])
  @@index([request_date])
  @@index([status])
  @@index([report_recipient_id])
  @@map("medilab_test_request")
}

/// Material a customer submits to be tested: the thing someone holds in their hand.
model Sample {
  /// Row identifier.
  id                   Int          @id @default(autoincrement())
  /// Unique laboratory code (mã PTN) from a sequence, such as PTN.2026.0001, numbered again each year; the only name testers see.
  code                 String       @unique @db.VarChar
  /// The test request the sample belongs to.
  request_id           Int
  /// Name the customer gives the sample, such as "Lavie bottled water 1 L"; only people who can read test requests see it. A trigram index serves search.
  customer_sample_name String       @db.VarChar
  /// The sample type (nền mẫu), such as bottled drinking water.
  sample_type_id       Int
  /// solid, liquid, gas or semi_solid.
  physical_state       String       @db.VarChar
  /// Form the sample comes in, such as "whole bottle".
  sample_form          String?      @db.VarChar
  /// Container the sample comes in, such as "1 L bottle".
  container_type       String?      @db.VarChar
  /// The regulation the sample's results are compared with; empty when none.
  regulation_id        Int?
  /// Free notes about the sample.
  note                 String?      @db.Text
  /// expected, received, on_hold, rejected, testing, awaiting_approval, completed, reported, retained, disposed or cancelled.
  status               String       @db.VarChar
  /// When the laboratory received the sample.
  received_at          DateTime?
  /// Person who received the sample.
  received_by_id       Int?
  /// Amount received, such as "2 bottles of 1 L".
  received_quantity    String?      @db.VarChar
  /// Condition on arrival: good, damaged or insufficient.
  condition            String?      @db.VarChar
  /// What was wrong with the sample on arrival.
  condition_note       String?      @db.Text
  /// Where the sample is stored, such as "Fridge 2, shelf B".
  storage_location     String?      @db.VarChar
  /// The location the sample was taken from, such as a sampling point.
  sampling_location_id Int?
  /// The location the sample was taken from.
  sampling_location    Location? @relation(fields: [sampling_location_id], references: [id], onDelete: Restrict)
  /// When the head of department asked for the sample to be collected again because it arrived insufficient.
  recollection_requested_at DateTime?
  /// Head of department who asked for the sample to be collected again.
  recollection_requested_by_id Int?
  /// Last day the sample is kept: the report date plus the sample type's retention days.
  retained_until       DateTime?    @db.Date
  /// When the sample was disposed of.
  disposed_at          DateTime?
  /// Person who disposed of the sample.
  disposed_by_id       Int?
  /// How the sample was disposed of.
  disposal_note        String?      @db.Text
  /// The test request the sample belongs to.
  request              TestRequest  @relation(fields: [request_id], references: [id], onDelete: Cascade)
  /// The sample type.
  sample_type          SampleType   @relation(fields: [sample_type_id], references: [id], onDelete: Restrict)
  /// The regulation the results are compared with.
  regulation           Regulation?  @relation(fields: [regulation_id], references: [id], onDelete: Restrict)
  /// Parameters tested on the sample.
  tests                SampleTest[]
  /// Person who received the sample.
  received_by          Person?      @relation("SampleReceiver", fields: [received_by_id], references: [id], onDelete: Restrict)
  /// Head of department who asked for the sample to be collected again.
  recollection_requested_by Person? @relation("RecollectionRequester", fields: [recollection_requested_by_id], references: [id], onDelete: Restrict)
  /// Person who disposed of the sample.
  disposed_by          Person?      @relation("SampleDisposer", fields: [disposed_by_id], references: [id], onDelete: Restrict)
  /// Handovers of the sample to the departments that test it.
  handovers            SampleHandover[]
  /// Handover records that list the sample.
  handover_lines       HandoverRecordSample[]
  /// Photos of the sample taken when it was collected or received.
  photos               SamplePhoto[]
  /// Laboratory folders of the sample.
  folders              LaboratoryFolder[]

  @@index([request_id])
  @@index([sample_type_id])
  @@index([regulation_id])
  @@index([status])
  @@index([sampling_location_id])
  @@map("medilab_sample")
}

/// One parameter tested on one sample, and the way it is tested once the laboratory has chosen it.
model SampleTest {
  /// Row identifier.
  id                  Int              @id @default(autoincrement())
  /// The sample tested.
  sample_id           Int
  /// The parameter tested.
  parameter_id        Int
  /// The way of testing chosen for it; empty until the laboratory chooses. Must be a way of testing this parameter.
  parameter_method_id Int?
  /// How many times the parameter is tested on the sample; at least 1.
  quantity            Int              @default(1)
  /// waiting, assigned, testing, outsourced, result_entered, approved or cancelled.
  status              String           @db.VarChar
  /// When the laboratory plans to finish the test: the end of the day, in the company's time zone, the safety margin before the request's expected date, worked out when the sample test is created or that date changes and changeable afterwards. Changing the safety margin does not change due dates already worked out. A test whose due date is close is scheduled first.
  due_date            DateTime?
  /// Why the test was cancelled, such as the parameter cannot be tested on this sample.
  cancel_reason       String?          @db.Text
  /// Head of department who cancelled the test.
  cancelled_by_id     Int?
  /// When the test was cancelled.
  cancelled_at        DateTime?
  /// True when no machine can finish the test before its due date, so the scheduler suggests outsourcing it.
  outsourcing_suggested Boolean        @default(false)
  /// True when the test has no booking that finishes before its due date, or its booking ended without a result; its tester and head of department are told when it turns true.
  at_risk             Boolean          @default(false)
  /// True when a person marked the test urgent, so it is scheduled first whatever its due date.
  marked_urgent       Boolean          @default(false)
  /// Why the test was marked urgent.
  urgent_reason       String?          @db.Text
  /// Why the head of department outsourced the test straight away instead of from an outsourcing suggestion.
  emergency_outsource_reason String?   @db.Text
  /// Tester or head of department who marked the test urgent.
  marked_urgent_by_id Int?
  /// The sample tested.
  sample              Sample           @relation(fields: [sample_id], references: [id], onDelete: Cascade)
  /// The parameter tested.
  parameter           TestParameter    @relation(fields: [parameter_id], references: [id], onDelete: Restrict)
  /// The way of testing chosen.
  parameter_method    ParameterMethod? @relation(fields: [parameter_method_id], references: [id], onDelete: Restrict)
  /// Head of department who cancelled the test.
  cancelled_by        Person?          @relation("SampleTestCanceller", fields: [cancelled_by_id], references: [id], onDelete: Restrict)
  /// Tester or head of department who marked the test urgent.
  marked_urgent_by    Person?          @relation("SampleTestUrgencyMarker", fields: [marked_urgent_by_id], references: [id], onDelete: Restrict)
  /// Results of the test, one per attempt.
  results             TestResult[]
  /// Machine bookings for the test.
  bookings            MachineBooking[]
  /// Dispatches that send the test to a subcontractor.
  dispatches          SubcontractDispatchTest[]

  @@index([sample_id])
  @@index([parameter_id])
  @@index([parameter_method_id])
  @@index([status])
  @@index([outsourcing_suggested])
  @@map("medilab_sample_test")
}

/// One version of one attempt at measuring a sample test. Earlier attempts are kept; one per sample test is the reported result.
/// A change request on a result whose process is completed creates a new row with the next version that replaces it; the signed row stays unchanged and is marked as replaced.
/// At most one reported result per sample test among rows not replaced (partial unique index on sample_test_id where is_reported and not is_replaced).
model TestResult {
  /// Row identifier.
  id             Int              @id @default(autoincrement())
  /// The sample test measured.
  sample_test_id Int
  /// Attempt number, 1 for the first measurement and higher for retests.
  attempt        Int              @default(1)
  /// True for the result reported to the customer: the latest one entered for the sample test.
  is_reported    Boolean          @default(false)
  /// Measured value, in unit_id, stored exactly; 0 for a text result, whose text is the result.
  value          Decimal? @db.Decimal
  /// Decimals the value shows, between 0 and 15, such as 2 for 0.50, copied from the way of testing and correctable by the lab QA.
  value_decimals Int?
  /// Result as text when it is not a number, such as "Not detected", in each language.
  value_text     Json?
  /// The unit of the value, taken from the way of testing.
  unit_id        Int?
  /// The unit of limit_min and limit_max, copied from the sample's regulation.
  limit_unit_id  Int?
  /// True when the copied limit has a minimum, which may be 0.
  limit_min_set  Boolean          @default(false)
  /// Lowest allowed value, copied from the sample's regulation when the result is created. Meaningful when limit_min_set is set.
  limit_min      Decimal? @db.Decimal
  /// True when the copied limit has a maximum, which may be 0.
  limit_max_set  Boolean          @default(false)
  /// Highest allowed value, copied from the sample's regulation when the result is created. Meaningful when limit_max_set is set.
  limit_max      Decimal? @db.Decimal
  /// Decimals the copied minimum and maximum show on the report, such as 2 for 0.50, copied from the sample's regulation.
  limit_decimals Int?
  /// Limit as text, copied from the sample's regulation, in each language.
  limit_text     Json?
  /// The Odoo user who entered the result: a lab QA, or a subcontractor's user for an outsourced test.
  entered_by_id  Int
  /// When the result was entered, which is when the measurement counts as done.
  entered_at     DateTime
  /// The machine the measurement ran on, taken from the booking and correctable by the lab QA; empty for an outsourced test.
  machine_id     Int?
  /// When the measurement started, taken from the booking's start and correctable by the lab QA.
  started_at     DateTime?
  /// Why the sanity check found the value unusual when it was sent, shown to the approver; empty when nothing was found.
  check_warning  String?          @db.Text
  /// pass or fail, set by the tester; empty when the sample has no regulation.
  conclusion     String?          @db.VarChar
  /// none, requested, approved or rejected: where the result stands in its approval chain, kept in step with its signatures. Approved and rejected are final; only the lab head's rejection of the report sends an approved result back to none. Only the system writes it, with attempt, is_reported, entered_by_id, entered_at and the version fields.
  status         String           @default("none") @db.VarChar
  /// The version the next signature records; it grows when every signature is withdrawn.
  document_version Int            @default(1)
  /// Version of the result, 1 for the first and one higher for each version a change request creates.
  version        Int              @default(1)
  /// The version this row replaces; empty for version 1.
  replaces_id    Int?             @unique
  /// True when a newer version replaces this row.
  is_replaced    Boolean          @default(false)
  /// The sample test measured. A result cannot be deleted through its sample test, sample or request.
  sample_test    SampleTest       @relation(fields: [sample_test_id], references: [id], onDelete: Restrict)
  /// The Odoo user who entered the result.
  entered_by     User             @relation(fields: [entered_by_id], references: [id], onDelete: Restrict)
  /// The machine the measurement ran on.
  machine        Machine?         @relation(fields: [machine_id], references: [id], onDelete: Restrict)
  /// The unit of the value.
  unit           MeasurementUnit? @relation("ResultUnit", fields: [unit_id], references: [id], onDelete: Restrict)
  /// The unit of the copied limits.
  limit_unit     MeasurementUnit? @relation("ResultLimitUnit", fields: [limit_unit_id], references: [id], onDelete: Restrict)
  /// The version this row replaces.
  replaces       TestResult?      @relation("ResultVersions", fields: [replaces_id], references: [id], onDelete: Restrict)
  /// The version that replaces this row.
  replaced_by    TestResult?      @relation("ResultVersions")

  @@unique([sample_test_id, attempt, version])
  @@index([sample_test_id])
  @@index([status])
  @@map("medilab_test_result")
}

/// Someone who works for the laboratory (medilab.person). It delegates to their Odoo employee with _inherits: this table holds the employee link, and the employee their name, user, work contact and department.
model Person {
  /// Row identifier.
  id            Int          @id @default(autoincrement())
  /// The Odoo employee the person delegates to.
  employee_id   Int          @unique
  /// Team of the person, one of the teams of their department; empty when they belong to no team.
  team_id       Int?
  /// False when the person is archived.
  active        Boolean      @default(true)
  /// The Odoo employee the person delegates to.
  employee      Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  /// Team of the person.
  team          Department?  @relation("PersonTeam", fields: [team_id], references: [id], onDelete: Restrict)
  /// Roles the person holds.
  roles         PersonRole[]
  /// Tasks assigned to the person.
  tasks         Task[]           @relation("TaskAssignee")
  /// Tasks the person assigned.
  assigned_tasks Task[]          @relation("TaskAssigner")
  /// Permissions given to the person directly, on top of their roles.
  permissions   PersonPermission[]
  /// Sample tests the person cancelled.
  cancelled_sample_tests SampleTest[] @relation("SampleTestCanceller")
  /// Sample tests the person marked urgent.
  urgent_marked_sample_tests SampleTest[] @relation("SampleTestUrgencyMarker")
  /// Machine bookings the person runs.
  bookings      MachineBooking[]
  /// Samples the person received.
  received_samples Sample[]       @relation("SampleReceiver")
  /// Samples the person asked to be collected again.
  recollection_requests Sample[]  @relation("RecollectionRequester")
  /// Samples the person disposed of.
  disposed_samples Sample[]       @relation("SampleDisposer")
  /// Report deliveries the person recorded.
  delivered_reports TestReport[] @relation("ReportDeliverer")
  /// Subcontract dispatches the person carried.
  carried_dispatches SubcontractDispatch[] @relation("DispatchCourier")
  /// Sample handovers the person received for their department.
  received_handovers SampleHandover[] @relation("HandoverReceiver")
  /// Handover records of samples the person took from customers.
  handover_records   HandoverRecord[] @relation("HandoverRecordReceiver")
  /// Change requests the person asked for.
  change_requests ChangeRequest[] @relation("ChangeRequester")
  /// Signatures the person gave.
  signatures    Signature[]
  /// Wizards that assign tasks to the person.
  task_reassigns TaskReassign[]

  @@index([team_id])
  @@map("medilab_person")
}

/// Odoo's employee (hr.employee), shown with the columns this schema uses: the Odoo record a person delegates to. Trigram indexes on name and work email serve search.
model Employee {
  /// Row identifier.
  id              Int          @id @default(autoincrement())
  /// The contact holding the employee's details: name, email, phone, address; kept by Odoo's hr app.
  work_contact_id Int          @unique
  /// The Odoo user the employee logs in as; empty for people who never sign in.
  user_id         Int?         @unique
  /// Department of the employee.
  department_id   Int?
  /// False when the employee is archived.
  active          Boolean      @default(true)
  /// The contact holding the employee's details.
  work_contact    Contact      @relation(fields: [work_contact_id], references: [id], onDelete: Restrict)
  /// The Odoo user the employee logs in as.
  user            User?        @relation(fields: [user_id], references: [id], onDelete: Restrict)
  /// Department of the employee.
  department      Department?  @relation("EmployeeDepartment", fields: [department_id], references: [id], onDelete: Restrict)
  /// Departments the employee heads and teams the employee leads.
  managed_departments Department[] @relation("DepartmentManager")
  /// The MediLab person of the employee.
  person          Person?

  @@index([department_id])
  @@map("hr_employee")
}

/// Odoo's login account table, shown with the columns this schema uses. Each user has its own contact for its details.
model User {
  /// Row identifier.
  id         Int     @id @default(autoincrement())
  /// Login name, usually the email address.
  login      String  @unique @db.VarChar
  /// The contact Odoo creates for the user's details.
  partner_id Int
  /// The contact Odoo creates for the user's details.
  partner    Contact @relation("UserPartner", fields: [partner_id], references: [id], onDelete: Restrict)
  /// The employee this account belongs to.
  employee   Employee?
  /// Results the user entered.
  entered_results TestResult[]
  /// Audit entries of the user's actions.
  audit_entries  AuditEntry[] @relation("AuditUser")
  /// Locks the user holds or held.
  locks          DocumentLock[] @relation("LockHolder")
  /// Stuck locks the user released.
  released_locks DocumentLock[] @relation("LockReleaser")
  /// Locks the user waits on.
  watched_locks  DocumentLockWatcher[] @relation("LockWatcher")
  /// The user's notification channel choices.
  notification_preferences NotificationPreference[] @relation("PreferenceUser")
  /// Job runs the user started by hand.
  triggered_runs JobRun[]     @relation("JobTrigger")
  /// Mobile devices the user receives reminders on.
  devices    MobileDevice[]
  /// Laboratory folders the user owns.
  owned_folders      LaboratoryFolder[]         @relation("FolderOwner")
  /// Laboratory folders the user is a member of.
  folder_memberships LaboratoryFolderMember[]   @relation("FolderMember")
  /// Laboratory file versions the user saved.
  file_versions      LaboratoryFileVersion[]    @relation("VersionAuthor")
  /// Laboratory file uploads the user made.
  file_uploads       LaboratoryUpload[]         @relation("UploadUser")
  /// Computers the user signs in to the laboratory folders from.
  laboratory_devices LaboratoryDevice[]         @relation("LaboratoryDeviceUser")
  /// Online editing sessions the user opened.
  editing_sessions   LaboratoryEditingSession[] @relation("EditingOpener")
  /// Laboratory file locks the user holds or held.
  file_locks         LaboratoryFileLock[]       @relation("FileLockHolder")
  /// Laboratory file locks the user released as an administrator.
  released_file_locks LaboratoryFileLock[]      @relation("FileLockReleaser")

  @@map("res_users")
}

/// Odoo's group table, shown with the columns this schema uses. A group carries the access generated for one permission, or implies the permission groups of one role; users hold groups through their person's roles and direct permissions.
model Group {
  /// Row identifier.
  id         Int         @id @default(autoincrement())
  /// Group name in each language, such as "Permission: person.read.all".
  name       Json
  /// The permission whose access the group carries.
  permission Permission? @relation("PermissionGroup")
  /// The role whose permission groups the group implies.
  role       Role?       @relation("RoleGroup")

  @@map("res_groups")
}

/// A role the administrator defines, such as Tester or Head of department: a set of permissions. Signing levels are given to roles. Trigram indexes on code and name serve search.
model Role {
  /// Row identifier.
  id              Int              @id @default(autoincrement())
  /// Unique code of the role: lowercase letters, digits and underscores.
  code            String           @unique @db.VarChar
  /// Role name in each language.
  name            Json
  /// The Odoo group generated for the role, which implies the groups of its permissions.
  group_id        Int              @unique
  /// The Odoo group generated for the role.
  group           Group            @relation("RoleGroup", fields: [group_id], references: [id], onDelete: Restrict)
  /// People who hold the role.
  people          PersonRole[]
  /// Permissions the role contains.
  permissions     RolePermission[]
  /// Approval levels the role signs.
  approval_levels ApprovalLevel[]
  /// Task types whose tasks go to the role.
  task_types      TaskType[]
  /// Notification events whose notifications go to the role.
  notification_recipients NotificationEventRecipient[]

  @@map("medilab_role")
}

/// Links people to the roles they hold.
model PersonRole {
  /// The person.
  person_id Int
  /// A role the person holds.
  role_id   Int
  /// The person.
  person    Person @relation(fields: [person_id], references: [id], onDelete: Cascade)
  /// The role.
  role      Role   @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@id([person_id, role_id])
  @@index([role_id])
  @@map("medilab_person_role_rel")
}

/// One action on one document type, within a scope. Granted to people through roles or directly.
/// Unique on (document_model, action, scope).
model Permission {
  /// Row identifier.
  id             Int                @id @default(autoincrement())
  /// Unique code derived from the document type, action and scope, such as sample.edit.own_department.
  code           String             @unique @db.VarChar
  /// Permission name in each language.
  name           Json
  /// Technical name of the document type, such as medilab.sample; cannot change once the permission exists.
  document_model String             @db.VarChar
  /// read, create, edit, archive, delete or sign; cannot change once the permission exists.
  action         String             @db.VarChar
  /// all for every record, own_department for records of the person's department only, or own_team for records of the person's team only; cannot change once the permission exists.
  scope          String             @db.VarChar
  /// The Odoo group generated for the permission, which carries its access.
  group_id       Int                @unique
  /// The Odoo group generated for the permission.
  group          Group              @relation("PermissionGroup", fields: [group_id], references: [id], onDelete: Restrict)
  /// Roles that contain the permission.
  roles          RolePermission[]
  /// People given the permission directly.
  people         PersonPermission[]

  @@unique([document_model, action, scope])
  @@map("medilab_permission")
}

/// Links roles to the permissions they contain.
model RolePermission {
  /// The role.
  role_id       Int
  /// A permission the role contains.
  permission_id Int
  /// The role.
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  /// The permission.
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@map("medilab_role_permission_rel")
}

/// Links people to permissions given to them directly, on top of their roles.
model PersonPermission {
  /// The person.
  person_id     Int
  /// A permission given to the person directly.
  permission_id Int
  /// The person.
  person        Person     @relation(fields: [person_id], references: [id], onDelete: Cascade)
  /// The permission.
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([person_id, permission_id])
  @@index([permission_id])
  @@map("medilab_person_permission_rel")
}

/// The ordered signing levels a document type needs for one purpose, such as tester then head of department to sign a test result.
/// Unique on (document_model, purpose).
model ApprovalChain {
  /// Row identifier.
  id             Int             @id @default(autoincrement())
  /// Technical name of the document type, such as medilab.test.result.
  document_model String          @db.VarChar
  /// signing for the document itself, or change_request for change requests on it.
  purpose        String          @db.VarChar
  /// Chain name in each language.
  name           Json
  /// False when the chain is archived.
  active         Boolean         @default(true)
  /// Levels of the chain, in signing order.
  levels         ApprovalLevel[]

  @@unique([document_model, purpose])
  @@map("medilab_approval_chain")
}

/// One level of an approval chain. Unique on (chain_id, sequence).
model ApprovalLevel {
  /// Row identifier.
  id              Int           @id @default(autoincrement())
  /// The chain the level belongs to.
  chain_id        Int
  /// Position in the chain; lower levels sign first.
  sequence        Int
  /// Level name in each language, such as "Head of department".
  name            Json
  /// The role a person needs to sign at this level.
  role_id         Int
  /// True when the signer must belong to the department that did the work.
  same_department Boolean       @default(false)
  /// True when the signer may reject instead of signing.
  can_reject      Boolean       @default(true)
  /// The chain the level belongs to.
  chain           ApprovalChain @relation(fields: [chain_id], references: [id], onDelete: Cascade)
  /// The role a person needs to sign at this level.
  role            Role          @relation(fields: [role_id], references: [id], onDelete: Restrict)
  /// Signatures given at this level.
  signatures      Signature[]

  @@unique([chain_id, sequence])
  @@map("medilab_approval_level")
}

/// One signature or rejection on one version of a document. Records are never deleted; a withdrawal sets withdrawn_at.
/// Points to its document by document_model and document_id: partial index on them where withdrawn_at is empty, for the signatures in force.
/// When it was signed is Odoo's creation time of the row.
model Signature {
  /// Row identifier.
  id               Int           @id @default(autoincrement())
  /// Technical name of the signed document's model, such as medilab.test.result.
  document_model   String        @db.VarChar
  /// Id of the signed document.
  document_id      Int
  /// Version of the document that was signed.
  document_version Int
  /// SHA-256 of the content signed, for a document type whose content has one, such as a laboratory file version.
  document_hash    String?       @db.VarChar
  /// The level signed at.
  level_id         Int
  /// The person who signed.
  signer_id        Int
  /// Signer's name at the time of signing.
  signer_name      String        @db.VarChar
  /// Signer's role at the time of signing.
  signer_role      String        @db.VarChar
  /// Level name at the time of signing.
  level_name       String        @db.VarChar
  /// signed or rejected.
  decision         String        @db.VarChar
  /// Reason given for a rejection.
  reason           String?       @db.Text
  /// When the signer withdrew the signature; empty while it stands.
  withdrawn_at     DateTime?
  /// The level signed at.
  level            ApprovalLevel @relation(fields: [level_id], references: [id], onDelete: Restrict)
  /// The person who signed.
  signer           Person        @relation(fields: [signer_id], references: [id], onDelete: Restrict)

  @@index([signer_id])
  @@map("medilab_signature")
}

/// The laboratory's certificate (chứng thư số) that Viettel Sign holds and signs printed documents with. Read from Viettel Sign, never created or edited on the screen.
model SigningCertificate {
  /// Row identifier.
  id                 Int                @id @default(autoincrement())
  /// Name of the holder of the certificate, from its subject.
  name               String             @db.VarChar
  /// Viettel Sign's id of the certificate, which each signing names.
  credential_id      String             @unique @db.VarChar
  /// Serial number the certificate authority gave the certificate, in hexadecimal.
  serial_number      String?            @db.VarChar
  /// Whom the certificate was issued to.
  subject            String?            @db.VarChar
  /// The certificate authority that issued the certificate.
  issuer             String?            @db.VarChar
  /// When the validity of the certificate starts.
  valid_from         DateTime?
  /// When the validity of the certificate ends.
  valid_to           DateTime
  /// valid, expired or revoked as Viettel Sign reports.
  status             String             @db.VarChar
  /// The certificate and the authorities that issued it, in PEM, the certificate first.
  certificate_chain  String             @db.Text
  /// SHA-256 of the certificate itself, which finds it from the signature of a PDF.
  fingerprint        String             @db.VarChar
  /// When Viettel Sign last reported the certificate.
  checked_at         DateTime?
  /// The PDFs signed with the certificate.
  digital_signatures DigitalSignature[]

  @@index([fingerprint])
  @@map("medilab_signing_certificate")
}

/// The digital signature (chữ ký số) Viettel Sign applied to the PDF of one version of a fully signed document. Records are never edited or deleted.
/// Points to its document by document_model and document_id. Unique on (document_model, document_id, document_version).
model DigitalSignature {
  /// Row identifier.
  id               Int                @id @default(autoincrement())
  /// Technical name of the signed document's model, such as medilab.test.report.
  document_model   String             @db.VarChar
  /// Id of the signed document.
  document_id      Int
  /// Version of the document whose PDF was signed.
  document_version Int
  /// The laboratory's certificate Viettel Sign signed with.
  certificate_id   Int
  /// The PDF Viettel Sign signed, an Odoo attachment of the document.
  attachment_id    Int
  /// When Viettel Sign signed the PDF.
  signed_at        DateTime
  /// SHA-256 of the signed PDF, which finds it when someone verifies a file.
  file_hash        String             @unique @db.VarChar
  /// The laboratory's certificate Viettel Sign signed with.
  certificate      SigningCertificate @relation(fields: [certificate_id], references: [id], onDelete: Restrict)

  @@unique([document_model, document_id, document_version])
  @@map("medilab_digital_signature")
}

/// A kind of task, such as sample collection or testing a parameter, and how its tasks are created and routed. Task types come with the modules; on the screen only their route, role and default deadline change. Trigram indexes on code and name serve search.
model TaskType {
  /// Row identifier.
  id             Int      @id @default(autoincrement())
  /// Unique code of the task type.
  code           String   @unique @db.VarChar
  /// Task type name in each language.
  name           Json
  /// Event that creates its tasks, such as sample_received or signature_requested; manual for tasks people create.
  trigger        String   @db.VarChar
  /// Technical name of the document its tasks open, such as medilab.sample.test.
  document_model String?  @db.VarChar
  /// Action its tasks open on the document, such as enter_result or sign.
  action         String?  @db.VarChar
  /// Where a new task goes: department for the department the event names, role for people holding role_id, or person for the person the event names.
  route          String   @db.VarChar
  /// The role whose holders receive the task when route is role.
  role_id        Int?
  /// Hours from creation to the deadline, when the document gives no due date.
  deadline_hours Int?
  /// The role whose holders receive the task.
  role           Role?    @relation(fields: [role_id], references: [id], onDelete: Restrict)
  /// Tasks of this type.
  tasks          Task[]

  @@map("medilab_task_type")
}

/// Work waiting for a department, a role or a person, with a deadline, that opens the document and action to do it. Tasks are internal: the assignee is a person with an Odoo user.
/// Points to its document by document_model and document_id, indexed together.
model Task {
  /// Row identifier.
  id             Int          @id @default(autoincrement())
  /// The kind of task.
  type_id        Int
  /// Short description of the work, such as "Test lead on sample PTN-0042".
  name           String       @db.VarChar
  /// Details of the work.
  note           String?      @db.Text
  /// Technical name of the document the task opens.
  document_model String?      @db.VarChar
  /// Id of the document the task opens.
  document_id    Int?
  /// Action the task opens on the document, such as enter_result or sign.
  action         String?      @db.VarChar
  /// True when the system created the task with its type and document and nobody changed them since; only such tasks act on their document with full rights.
  linked_by_system Boolean    @default(false)
  /// Department whose queue holds the task until someone is assigned.
  department_id  Int?
  /// Person who does the task; empty while it waits in the department's queue.
  assignee_id    Int?
  /// Person who assigned the task; the assignee themselves when they claimed it.
  assigned_by_id Int?
  /// Why the task was last moved to another person or department.
  reassign_reason String?     @db.Text
  /// When the task must be done.
  deadline       DateTime?
  /// Planned start on the assignee's schedule.
  planned_start  DateTime?
  /// Planned end on the assignee's schedule.
  planned_end    DateTime?
  /// open, assigned, in_progress, done or cancelled.
  status         String       @db.VarChar
  /// When the task was done.
  done_at        DateTime?
  /// The calendar event showing the planned time on the assignee's schedule, with its reminder; kept in step both ways.
  calendar_event_id Int?      @unique
  /// The kind of task.
  type           TaskType     @relation(fields: [type_id], references: [id], onDelete: Restrict)
  /// Department whose queue holds the task.
  department     Department?  @relation(fields: [department_id], references: [id], onDelete: Restrict)
  /// Person who does the task.
  assignee       Person?      @relation("TaskAssignee", fields: [assignee_id], references: [id], onDelete: Restrict)
  /// Person who assigned the task.
  assigned_by    Person?      @relation("TaskAssigner", fields: [assigned_by_id], references: [id], onDelete: Restrict)
  /// The calendar event of the planned time.
  calendar_event CalendarEvent? @relation("TaskEvent", fields: [calendar_event_id], references: [id], onDelete: SetNull)
  /// Machine bookings made for the task.
  bookings       MachineBooking[]
  /// Assign-task wizards that include this task.
  reassign_wizards TaskReassignTask[]

  @@index([assignee_id, status])
  @@index([department_id, status])
  @@index([document_model, document_id])
  @@index([deadline])
  @@map("medilab_task")
}

/// Assigns tasks to a person or moves them to another department's queue. Odoo keeps the wizard only while it is open.
model TaskReassign {
  /// Row identifier.
  id            Int      @id @default(autoincrement())
  /// Department whose queue holds the tasks.
  department_id Int?
  /// Person who does the tasks; empty to leave them in the department's queue.
  assignee_id   Int?
  /// Why the tasks move to another person or department.
  reason        String?  @db.Text
  /// Department whose queue holds the tasks.
  department    Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  /// Person who does the tasks.
  assignee      Person?     @relation(fields: [assignee_id], references: [id], onDelete: SetNull)
  /// The tasks to assign or move.
  tasks         TaskReassignTask[]

  @@map("medilab_task_reassign")
}

/// Links an assign-task wizard to the tasks it assigns.
model TaskReassignTask {
  /// The wizard.
  medilab_task_reassign_id Int
  /// A task the wizard assigns.
  medilab_task_id          Int
  /// The wizard.
  wizard                   TaskReassign @relation(fields: [medilab_task_reassign_id], references: [id], onDelete: Cascade)
  /// The task.
  task                     Task         @relation(fields: [medilab_task_id], references: [id], onDelete: Cascade)

  @@id([medilab_task_reassign_id, medilab_task_id])
  @@index([medilab_task_id])
  @@map("medilab_task_medilab_task_reassign_rel")
}

/// Odoo's calendar event (calendar.event), shown with the columns this schema uses: the planned time of a task, a machine booking or a location booking on the attendees' calendars. It has no Odoo alarm: the reminder job reminds of it before it starts.
/// Events that book one location do not overlap: an exclusion constraint on (location_id, time range) where location_id is set and the event is active, using btree_gist.
model CalendarEvent {
  /// Row identifier.
  id        Int             @id @default(autoincrement())
  /// Title shown on the calendar.
  name      String          @db.VarChar
  /// Start of the event.
  start     DateTime
  /// End of the event.
  stop      DateTime
  /// User who organises the event.
  user_id   Int?
  /// The bookable location the event books.
  location_id Int?
  /// The bookable location the event books.
  booked_location Location?     @relation(fields: [location_id], references: [id], onDelete: Restrict)
  /// The machine booking whose step the location booking is for; empty for a booking people made.
  machine_booking_id Int?
  /// The method step the location booking is for.
  step_id   Int?
  /// The machine booking whose step the location booking is for.
  machine_booking MachineBooking? @relation("BookingRoomEvents", fields: [machine_booking_id], references: [id], onDelete: Cascade)
  /// The method step the location booking is for.
  step      TestingMethodStep? @relation(fields: [step_id], references: [id], onDelete: Restrict)
  /// The task whose planned time the event shows.
  task      Task?           @relation("TaskEvent")
  /// The machine booking the event shows.
  booking   MachineBooking? @relation("BookingEvent")

  @@index([start])
  @@index([location_id])
  @@index([machine_booking_id])
  @@map("calendar_event")
}

/// A sample test waiting for, or holding, a slot on a machine.
/// Scheduled and running bookings of one machine do not overlap: an exclusion constraint on (machine_id, time range) where status is scheduled or in_progress, using btree_gist.
model MachineBooking {
  /// Row identifier.
  id               Int        @id @default(autoincrement())
  /// The machine booked.
  machine_id       Int
  /// The sample test run on the machine.
  sample_test_id   Int
  /// The testing task the booking belongs to.
  task_id          Int?
  /// The department of the testing task, whose head sees and adjusts the booking.
  department_id    Int?
  /// Person who runs the test.
  person_id        Int?
  /// Due date of the sample test, copied so the queue is ordered without a join.
  due_date         DateTime?
  /// When the booking joined the machine's queue; earlier bookings come first among equally urgent ones.
  queued_at        DateTime
  /// Start of the slot; empty while the booking waits in the queue.
  starts_at        DateTime?
  /// End of the slot: the start plus the run time, rounded up to whole slots.
  ends_at          DateTime?
  /// queued, scheduled, in_progress, done or cancelled.
  status           String     @db.VarChar
  /// Why the head of department bumped the test to the earliest slot.
  bump_reason      String?    @db.Text
  /// The calendar event showing a scheduled booking on the person's schedule, with its reminder; empty while the booking waits in the queue.
  calendar_event_id Int?     @unique
  /// The calendar event of the booking.
  calendar_event   CalendarEvent? @relation("BookingEvent", fields: [calendar_event_id], references: [id], onDelete: SetNull)
  /// The machine booked.
  machine          Machine    @relation(fields: [machine_id], references: [id], onDelete: Restrict)
  /// The sample test run on the machine.
  sample_test      SampleTest @relation(fields: [sample_test_id], references: [id], onDelete: Restrict)
  /// The testing task the booking belongs to.
  task             Task?      @relation(fields: [task_id], references: [id], onDelete: Restrict)
  /// The department of the testing task.
  department       Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  /// Person who runs the test.
  person           Person?    @relation(fields: [person_id], references: [id], onDelete: Restrict)
  /// Calendar events booking the locations of the method's steps for this booking.
  room_events      CalendarEvent[] @relation("BookingRoomEvents")

  @@index([machine_id, starts_at])
  @@index([person_id, starts_at])
  @@index([machine_id, status, due_date, queued_at])
  @@index([department_id])
  @@map("medilab_machine_booking")
}

/// A batch of sample tests sent to one subcontractor, with when it was sent and when the results are expected back.
model SubcontractDispatch {
  /// Row identifier.
  id               Int                       @id @default(autoincrement())
  /// Unique code of the dispatch; filled from a sequence when left empty.
  code             String                    @unique @db.VarChar
  /// The subcontractor the tests are sent to.
  subcontractor_id Int
  /// Date the samples were sent.
  sent_date        DateTime?                 @db.Date
  /// Sample delivery staff (nhân viên giao nhận mẫu) who takes the samples; empty when a delivery service does.
  courier_id       Int?
  /// Delivery service and tracking number, when a delivery service takes the samples.
  delivery_service String?                   @db.VarChar
  /// Date the results are expected back.
  expected_date    DateTime?                 @db.Date
  /// Date the results came back.
  received_date    DateTime?                 @db.Date
  /// draft, sent, received or cancelled.
  status           String                    @db.VarChar
  /// Free notes about the dispatch.
  note             String?                   @db.Text
  /// The subcontractor the tests are sent to.
  subcontractor    Subcontractor             @relation(fields: [subcontractor_id], references: [id], onDelete: Restrict)
  /// Sample delivery staff who takes the samples.
  courier          Person?                   @relation("DispatchCourier", fields: [courier_id], references: [id], onDelete: Restrict)
  /// Sample tests in the dispatch.
  tests            SubcontractDispatchTest[]

  @@index([subcontractor_id])
  @@index([expected_date])
  @@map("medilab_subcontract_dispatch")
}

/// Links dispatches to the sample tests they send.
model SubcontractDispatchTest {
  /// The dispatch.
  dispatch_id    Int
  /// A sample test the dispatch sends.
  sample_test_id Int
  /// The dispatch.
  dispatch       SubcontractDispatch @relation(fields: [dispatch_id], references: [id], onDelete: Cascade)
  /// The sample test.
  sample_test    SampleTest          @relation(fields: [sample_test_id], references: [id], onDelete: Restrict)

  @@id([dispatch_id, sample_test_id])
  @@index([sample_test_id])
  @@map("medilab_subcontract_dispatch_test_rel")
}

/// The handover of a received sample to one department that tests it. Unique on (sample_id, department_id).
model SampleHandover {
  /// Row identifier.
  id             Int        @id @default(autoincrement())
  /// The sample handed over.
  sample_id      Int
  /// The department that receives it.
  department_id  Int
  /// When the department received it; empty while it is on its way.
  received_at    DateTime?
  /// Person in the department who received it.
  received_by_id Int?
  /// The sample handed over.
  sample         Sample     @relation(fields: [sample_id], references: [id], onDelete: Cascade)
  /// The department that receives it.
  department     Department @relation(fields: [department_id], references: [id], onDelete: Restrict)
  /// Person in the department who received it.
  received_by    Person?    @relation("HandoverReceiver", fields: [received_by_id], references: [id], onDelete: Restrict)

  @@unique([sample_id, department_id])
  @@index([department_id, received_at])
  @@map("medilab_sample_handover")
}

/// Links samples to their photos, Odoo attachments on the sample that only people who can read test requests see.
model SamplePhoto {
  /// The sample.
  sample_id     Int
  /// The photo's attachment.
  attachment_id Int
  /// The sample.
  sample        Sample @relation(fields: [sample_id], references: [id], onDelete: Cascade)

  @@id([sample_id, attachment_id])
  @@index([attachment_id])
  @@map("medilab_sample_photo_rel")
}

/// Handover record (biên bản giao nhận mẫu): the samples a customer hands to the laboratory, signed by the customer by hand on the mobile app. A signed record is never edited; a correction is a new record.
model HandoverRecord {
  /// Row identifier.
  id                   Int                    @id @default(autoincrement())
  /// Unique code of the record; filled from a sequence.
  code                 String                 @unique @db.VarChar
  /// The test request whose samples are handed over.
  request_id           Int
  /// When the samples were handed over.
  handed_over_at       DateTime
  /// Name of the customer's person who handed the samples over and signed.
  handed_over_by_name  String                 @db.VarChar
  /// Sample delivery staff who took the samples.
  received_by_id       Int
  /// draft or signed.
  status               String                 @default("draft") @db.VarChar
  /// When the customer signed.
  signed_at            DateTime?
  /// Image of the customer's handwritten signature.
  signature_attachment_id Int?
  /// The mobile device the customer signed on.
  signed_device_id     Int?
  /// The record's PDF.
  attachment_id        Int?
  /// When the PDF was emailed to the customer.
  sent_at              DateTime?
  /// The test request whose samples are handed over.
  request              TestRequest            @relation(fields: [request_id], references: [id], onDelete: Restrict)
  /// Sample delivery staff who took the samples.
  received_by          Person                 @relation("HandoverRecordReceiver", fields: [received_by_id], references: [id], onDelete: Restrict)
  /// The mobile device the customer signed on.
  signed_device        MobileDevice?          @relation(fields: [signed_device_id], references: [id], onDelete: SetNull)
  /// Samples on the record.
  samples              HandoverRecordSample[]

  @@index([request_id])
  @@map("medilab_handover_record")
}

/// Links a handover record to the samples it lists, with the amount and condition as they were handed over. Unique on (record_id, sample_id).
model HandoverRecordSample {
  /// Row identifier.
  id        Int            @id @default(autoincrement())
  /// The handover record.
  record_id Int
  /// The sample handed over.
  sample_id Int
  /// Amount handed over, such as "2 bottles of 1 L".
  quantity  String         @db.VarChar
  /// good, damaged or insufficient, as handed over.
  condition String         @db.VarChar
  /// What was wrong with the sample when handed over.
  condition_note String?   @db.Text
  /// The handover record.
  record    HandoverRecord @relation(fields: [record_id], references: [id], onDelete: Cascade)
  /// The sample handed over.
  sample    Sample         @relation(fields: [sample_id], references: [id], onDelete: Restrict)

  @@unique([record_id, sample_id])
  @@index([sample_id])
  @@map("medilab_handover_record_sample")
}

/// The test report (phiếu kết quả) of one test request, covering all its samples. A change request creates a new version that replaces it.
/// Unique on (request_id, version).
model TestReport {
  /// Row identifier.
  id              Int         @id @default(autoincrement())
  /// Unique report number; filled from a sequence when the report is issued.
  code            String?     @unique @db.VarChar
  /// The test request reported.
  request_id      Int
  /// Version of the report, 1 for the first and one higher for each version a change request creates.
  version         Int         @default(1)
  /// The version this report replaces; empty for version 1.
  replaces_id     Int?        @unique
  /// draft, signing, issued or replaced.
  status          String      @db.VarChar
  /// The version the next signature records; it grows when every signature is withdrawn or the report is signed again after a rejection.
  document_version Int         @default(1)
  /// Language the report is issued in, taken from the request: vi, en or bilingual for Vietnamese and English side by side.
  language        String      @db.VarChar
  /// When the report was issued.
  issued_at       DateTime?
  /// The PDF of the issued report, the one Viettel Sign signed while digital signing is on; empty until it is signed.
  attachment_id   Int?
  /// When the report was delivered to the customer by the request's delivery method.
  delivered_at    DateTime?
  /// Person who recorded the delivery.
  delivered_by_id Int?
  /// The test request reported.
  request         TestRequest @relation(fields: [request_id], references: [id], onDelete: Restrict)
  /// The version this report replaces.
  replaces        TestReport? @relation("ReportVersions", fields: [replaces_id], references: [id], onDelete: Restrict)
  /// The version that replaces this report.
  replaced_by     TestReport? @relation("ReportVersions")
  /// Person who recorded the delivery.
  delivered_by    Person?     @relation("ReportDeliverer", fields: [delivered_by_id], references: [id], onDelete: Restrict)

  @@unique([request_id, version])
  @@index([status])
  @@map("medilab_test_report")
}

/// A request to change a document whose process is completed (SH-07). It is signed through the change-request chain of the document's type; when approved, a new version of the document is created.
/// Points to its document by document_model and document_id, indexed together. Results and reports keep one row per version, so document_id names the version to change.
model ChangeRequest {
  /// Row identifier.
  id               Int       @id @default(autoincrement())
  /// Unique code of the change request, such as YCTD.2026.0001; filled from a sequence.
  code             String    @unique @db.VarChar
  /// Technical name of the document to change, such as medilab.test.result.
  document_model   String    @db.VarChar
  /// Id of the version of the document to change.
  document_id      Int
  /// The version the next signature of the change request records; it grows when every signature is withdrawn.
  document_version Int       @default(1)
  /// Person who asked for the change; when is Odoo's creation time of the row.
  requested_by_id  Int
  /// What to change.
  requested_change String    @db.Text
  /// Why the change is needed.
  reason           String    @db.Text
  /// requested while its chain signs, then approved, rejected or applied. Rejected and applied are final.
  status           String    @db.VarChar
  /// Reason given when the request was rejected.
  rejection_reason String?   @db.Text
  /// Id of the new version created when the change was applied.
  new_document_id  Int?
  /// Person who asked for the change.
  requested_by     Person    @relation("ChangeRequester", fields: [requested_by_id], references: [id], onDelete: Restrict)

  @@index([document_model, document_id])
  @@index([status])
  @@map("medilab_change_request")
}

/// A mobile device registered with Firebase Cloud Messaging to receive reminders for one Odoo user. Unique on token.
/// The cleanup job removes devices turned off longer than their retention period.
model MobileDevice {
  /// Row identifier.
  id           Int       @id @default(autoincrement())
  /// The Odoo user signed in on the device.
  user_id      Int
  /// Registration token Firebase Cloud Messaging gives the app on the device.
  token        String    @unique @db.VarChar
  /// android or ios.
  platform     String    @db.VarChar
  /// When the app last refreshed the token.
  last_seen_at DateTime
  /// False when the user signed out or the token was rejected; no reminder is pushed to it.
  active       Boolean   @default(true)
  /// Pushes sent to the device.
  pushes       PushDelivery[]
  /// Handover records customers signed on the device.
  signed_handover_records HandoverRecord[]
  /// The Odoo user signed in on the device.
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("medilab_mobile_device")
}

/// One recorded action or event (SH-05). Entries are never edited; only the cleanup job removes them after the audit retention period, once they are in an archive file.
/// Points to its document by document_model and document_id, indexed together. A BRIN index on create_date serves period reports.
/// An entry on a part of a document, such as a sample of a test request or a file attached to it, names that document in parent_model and parent_id, indexed together.
model AuditEntry {
  /// Row identifier.
  id             Int           @id @default(autoincrement())
  /// When it happened: Odoo's creation time of the entry.
  create_date    DateTime
  /// The Odoo user who acted; empty when the system or someone not signed in acted.
  user_id        Int?
  /// screen, api, job or system.
  source         String        @db.VarChar
  /// create, edit, delete, archive, approve, reject, sign, withdraw, download, job, integration or error.
  action         String        @db.VarChar
  /// Technical name of the document acted on; empty for an event without one, such as a refused webhook.
  document_model String?       @db.VarChar
  /// Id of the document acted on.
  document_id    Int?
  /// Technical name of the document the one acted on is a part of.
  parent_model   String?       @db.VarChar
  /// Id of the document the one acted on is a part of.
  parent_id      Int?
  /// The job run that acted, when a MediLab job acted; empty for another Odoo cron.
  job_run_id     Int?
  /// What happened, for actions without field changes, such as an integration error.
  note           String?       @db.Text
  /// The Odoo user who acted.
  user           User?         @relation("AuditUser", fields: [user_id], references: [id], onDelete: Restrict)
  /// The job run that acted.
  job_run        JobRun?       @relation(fields: [job_run_id], references: [id], onDelete: Restrict)
  /// Field changes of the entry.
  changes        AuditChange[]

  @@index([document_model, document_id])
  @@index([parent_model, parent_id])
  @@index([user_id, create_date])
  @@index([action, create_date])
  @@index([job_run_id])
  @@map("medilab_audit_entry")
}

/// The old and new value of one field changed by an audited action.
model AuditChange {
  /// Row identifier.
  id         Int        @id @default(autoincrement())
  /// The audit entry the change belongs to.
  entry_id   Int
  /// Technical name of the field changed.
  field_name String     @db.VarChar
  /// Value before the change, as text.
  old_value  String?    @db.Text
  /// Value after the change, as text.
  new_value  String?    @db.Text
  /// The audit entry the change belongs to.
  entry      AuditEntry @relation(fields: [entry_id], references: [id], onDelete: Restrict)

  @@index([entry_id])
  @@map("medilab_audit_change")
}

/// A lock on a document while one user edits it or a long operation runs on it (SH-06). When it was taken is Odoo's creation time of the row.
/// The cleanup job removes released and expired locks after their retention period.
/// At most one active lock per document (partial unique index on document_model, document_id where status is active).
model DocumentLock {
  /// Row identifier.
  id               Int                 @id @default(autoincrement())
  /// Technical name of the locked document.
  document_model   String              @db.VarChar
  /// Id of the locked document.
  document_id      Int
  /// The Odoo user holding the lock; for a long operation, the user who started it.
  user_id          Int
  /// edit for a user editing, or operation for a long operation such as sending a quotation.
  kind             String              @db.VarChar
  /// Last activity of the holder; the lock expires after the inactivity period from here.
  last_activity_at DateTime
  /// active, released or expired.
  status           String              @db.VarChar
  /// When the lock was released or expired.
  released_at      DateTime?
  /// saved, cancelled, left, completed for an operation that ended, expired or released_by_administrator.
  release_reason   String?             @db.VarChar
  /// Administrator who released a stuck lock.
  released_by_id   Int?
  /// The Odoo user holding the lock.
  user             User                @relation("LockHolder", fields: [user_id], references: [id], onDelete: Restrict)
  /// Administrator who released a stuck lock.
  released_by      User?               @relation("LockReleaser", fields: [released_by_id], references: [id], onDelete: Restrict)
  /// Users waiting to be told when the lock is released.
  watchers         DocumentLockWatcher[]

  @@index([document_model, document_id])
  @@index([status, last_activity_at])
  @@map("medilab_document_lock")
}

/// Links locks to the users who asked to be told when they are released.
model DocumentLockWatcher {
  /// The lock.
  lock_id Int
  /// A user waiting for the lock to be released.
  user_id Int
  /// The lock.
  lock    DocumentLock @relation(fields: [lock_id], references: [id], onDelete: Cascade)
  /// The user waiting.
  user    User         @relation("LockWatcher", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([lock_id, user_id])
  @@map("medilab_document_lock_watcher_rel")
}

/// Odoo's message subtype (mail.message.subtype), shown with the columns this schema uses and the columns the laboratory adds: a kind of event people are notified about, such as a booking reminder or a quotation sent.
model NotificationEvent {
  /// Row identifier.
  id            Int                      @id @default(autoincrement())
  /// Unique code of the event, such as booking.reminder.
  code          String                   @unique @db.VarChar
  /// Event name in each language.
  name          Json
  /// Technical name of the document type the event is about, such as medilab.machine.booking; empty for every type.
  res_model     String?                  @db.VarChar
  /// True for events people cannot turn off, such as a password reset or a payment receipt.
  mandatory     Boolean                  @default(false)
  /// False when the administrator turned the event off; no notification of it is created. Ignored for mandatory events.
  enabled       Boolean                  @default(true)
  /// Messages of this event.
  messages      Message[]
  /// People's channel choices for this event.
  preferences   NotificationPreference[]
  /// Roles and departments notified of this event.
  recipients    NotificationEventRecipient[]

  @@map("mail_message_subtype")
}

/// Who receives the notifications of one event: everyone holding a role, everyone in a department, or both. Configured by the administrator.
/// Exactly one of role_id and department_id is set.
model NotificationEventRecipient {
  /// Row identifier.
  id            Int               @id @default(autoincrement())
  /// The event.
  event_id      Int
  /// A role whose holders are notified.
  role_id       Int?
  /// A department whose people are notified.
  department_id Int?
  /// The event.
  event         NotificationEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  /// A role whose holders are notified.
  role          Role?             @relation(fields: [role_id], references: [id], onDelete: Cascade)
  /// A department whose people are notified.
  department    Department?       @relation(fields: [department_id], references: [id], onDelete: Cascade)

  @@index([event_id])
  @@map("medilab_notification_event_recipient")
}

/// Whether one user receives one event on one channel, extending Odoo's notification preference of the user (notification_type), which is the default for events without a row. Shown in the user's Odoo preferences. Unique on (user_id, event_id, channel).
model NotificationPreference {
  /// Row identifier.
  id       Int               @id @default(autoincrement())
  /// The Odoo user.
  user_id  Int
  /// The event.
  event_id Int
  /// popup, email or push.
  channel  String            @db.VarChar
  /// False when the user turned this channel off for the event; ignored for mandatory events.
  enabled  Boolean           @default(true)
  /// The Odoo user.
  user     User              @relation("PreferenceUser", fields: [user_id], references: [id], onDelete: Cascade)
  /// The event.
  event    NotificationEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_id, channel])
  @@map("medilab_notification_preference")
}

/// Odoo's message (mail.message), shown with the columns this schema uses and the column the laboratory adds: one notification of one event about one document, sent to its recipients.
/// Partial unique index on notification_key where it is set.
model Message {
  /// Row identifier.
  id               Int               @id @default(autoincrement())
  /// Technical name of the document the message is about.
  model            String?           @db.VarChar
  /// Id of the document the message is about.
  res_id           Int?
  /// The event notified.
  subtype_id       Int?
  /// Title of the notification.
  subject          String?           @db.VarChar
  /// Text of the notification.
  body             String?           @db.Text
  /// Unique key that stops the same notification being created twice, such as booking:42:reminder.
  notification_key String?           @db.VarChar
  /// The event notified.
  event            NotificationEvent? @relation(fields: [subtype_id], references: [id], onDelete: SetNull)
  /// One notification per recipient.
  notifications    Notification[]

  @@index([model, res_id])
  @@map("mail_message")
}

/// Odoo's notification (mail.notification), shown with the columns this schema uses and the column the laboratory adds: one message to one recipient, in their inbox or by e-mail.
/// The cleanup job removes read notifications after their retention period.
model Notification {
  /// Row identifier.
  id                  Int            @id @default(autoincrement())
  /// The message notified.
  mail_message_id     Int
  /// The contact of the user notified.
  res_partner_id      Int
  /// inbox for the pop-up in the application, or email.
  notification_type   String         @db.VarChar
  /// Odoo's sending status: ready, sent, bounce, exception or canceled.
  notification_status String         @db.VarChar
  /// Delivery status Brevo reported for an e-mail: delivered, opened, bounced or failed.
  brevo_status        String?        @db.VarChar
  /// True once the user read it in the application.
  is_read             Boolean        @default(false)
  /// When the user read it.
  read_date           DateTime?
  /// The message notified.
  message             Message        @relation(fields: [mail_message_id], references: [id], onDelete: Cascade)
  /// Pushes of the notification to the user's mobile devices.
  pushes              PushDelivery[]

  @@index([res_partner_id, is_read])
  @@map("mail_notification")
}

/// Pushing one notification to one mobile device through Firebase Cloud Messaging. Unique on (notification_id, mobile_device_id). Partial index on id where status is pending.
model PushDelivery {
  /// Row identifier.
  id               Int          @id @default(autoincrement())
  /// The notification pushed.
  notification_id  Int
  /// The mobile device pushed to.
  mobile_device_id Int
  /// pending, sent, failed or skipped.
  status           String       @db.VarChar
  /// When it was sent.
  sent_at          DateTime?
  /// Error Firebase returned on the last failed attempt.
  error            String?      @db.Text
  /// The notification pushed.
  notification     Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  /// The mobile device pushed to.
  mobile_device    MobileDevice @relation(fields: [mobile_device_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, mobile_device_id])
  @@map("medilab_push_delivery")
}

/// A recurring job identified by its key, scheduled by an Odoo cron and working through a queue of items (SH-09).
/// The cron holds the schedule and the on or off switch, and stops two runs overlapping; Odoo's cron progress counts the items done and remaining.
model ScheduledJob {
  /// Row identifier.
  id                  Int       @id @default(autoincrement())
  /// Unique key of the job, such as notifications.send or bookings.remind.
  key                 String    @unique @db.VarChar
  /// Job name in each language.
  name                Json
  /// The Odoo cron that runs the job; its schedule is the job's schedule.
  cron_id             Int       @unique
  /// Most items handled in one run.
  batch_size          Int       @default(100)
  /// Attempts before an item is marked failed and an administrator is told.
  max_attempts        Int       @default(5)
  /// Minutes after which an item still running is treated as abandoned and goes back to pending.
  claim_timeout_minutes Int     @default(30)
  /// Minutes before the first retry; each later retry waits twice as long.
  retry_delay_minutes Int       @default(5)
  /// Items queued for the job.
  items               JobItem[]
  /// Runs of the job.
  runs                JobRun[]

  @@map("medilab_scheduled_job")
}

/// One unit of work queued for a job, such as one reminder to send. Unique on (job_id, item_key), so the same work is never queued twice.
/// Points to its document by document_model and document_id.
/// Partial index on (job_id, next_attempt_at) where status is pending or running. The cleanup job removes finished items after their retention period.
model JobItem {
  /// Row identifier.
  id              Int          @id @default(autoincrement())
  /// The job the item is queued for.
  job_id          Int
  /// Key of the work within the job, such as delivery:812.
  item_key        String       @db.VarChar
  /// Technical name of the document the work is about.
  document_model  String?      @db.VarChar
  /// Id of the document the work is about.
  document_id     Int?
  /// Data the job needs to do the work.
  payload         Json?
  /// pending, running, done, failed or cancelled.
  status          String       @db.VarChar
  /// When a run took the item; a running item claimed longer ago than the job's claim timeout goes back to pending.
  claimed_at      DateTime?
  /// Attempts made so far.
  attempts        Int          @default(0)
  /// Earliest time the item is tried again.
  next_attempt_at DateTime
  /// Error of the last failed attempt.
  last_error      String?      @db.Text
  /// When the item was done.
  done_at         DateTime?
  /// The job the item is queued for.
  job             ScheduledJob @relation(fields: [job_id], references: [id], onDelete: Restrict)

  @@unique([job_id, item_key])
  @@map("medilab_job_item")
}

/// One run of a job, with its result and log (SH-09). Items done and remaining are counted by Odoo's cron progress.
model JobRun {
  /// Row identifier.
  id              Int          @id @default(autoincrement())
  /// The job run.
  job_id          Int
  /// When the run started.
  started_at      DateTime
  /// When the run ended; empty while it runs.
  ended_at        DateTime?
  /// running, succeeded, partly_failed or failed.
  status          String       @db.VarChar
  /// Log of the run.
  log             String?      @db.Text
  /// Administrator who ran the job by hand; empty for a scheduled run.
  triggered_by_id Int?
  /// The job run.
  job             ScheduledJob @relation(fields: [job_id], references: [id], onDelete: Restrict)
  /// Administrator who ran the job by hand.
  triggered_by    User?        @relation("JobTrigger", fields: [triggered_by_id], references: [id], onDelete: Restrict)
  /// Audit entries written by the run.
  audit_entries   AuditEntry[]
  /// Archive files the run wrote.
  archive_files   ArchiveFile[]

  @@index([job_id, started_at])
  @@map("medilab_job_run")
}

/// A compressed export of the records of one kind and period, written to object storage by the cleanup job before it removes them. Archives are read only: they can be listed and downloaded, never loaded back.
/// Unique on (kind, period_start, period_end).
model ArchiveFile {
  /// Row identifier.
  id           Int       @id @default(autoincrement())
  /// Kind of records archived, such as audit_entry.
  kind         String    @db.VarChar
  /// First day of the period archived.
  period_start DateTime  @db.Date
  /// Last day of the period archived.
  period_end   DateTime  @db.Date
  /// Number of records in the file.
  row_count    Int
  /// The Odoo attachment holding the file in object storage.
  attachment_id Int      @unique
  /// SHA-256 of the file, checked before the archived records are removed.
  checksum     String    @db.VarChar
  /// Size of the file in bytes.
  size_bytes   Int
  /// The cleanup run that wrote the file.
  job_run_id   Int
  /// The cleanup run that wrote the file.
  job_run      JobRun    @relation(fields: [job_run_id], references: [id], onDelete: Restrict)

  @@unique([kind, period_start, period_end])
  @@map("medilab_archive_file")
}

/// A folder of laboratory files: files under paths relative to it, owned by a person, with members who read and write it. It never stores a path on anyone's computer.
/// A folder has a category if and only if it has a sample, and a sample has one folder of each category.
/// Partial unique index on created_by_device_id and idempotency_key where idempotency_key is set.
model LaboratoryFolder {
  /// Row identifier.
  id               Int       @id @default(autoincrement())
  /// Name people see.
  name             String    @db.VarChar
  /// Name of the folder, in Unicode NFC, unique for its owner.
  root             String    @db.VarChar
  /// The user who owns the folder.
  owner_id         Int
  /// The sample the folder belongs to; empty for a folder of no sample.
  sample_id        Int?
  /// raw, working, result or report for a folder of a sample; empty for a folder of no sample.
  category         String?   @db.VarChar
  /// upload_only or two_way.
  sync_mode        String    @db.VarChar
  /// False when an administrator turned the folder off; uploads are refused and reading goes on.
  enabled          Boolean   @default(true)
  /// When the folder was archived; empty while in use.
  archived_at      DateTime?
  /// Date until which an archived folder keeps its files.
  retention_until  DateTime? @db.Date
  /// The device the folder was created from, for the audit.
  created_by_device_id Int?
  /// The Idempotency-Key the computer sent with the request that created the folder; empty when it sent none.
  idempotency_key String? @db.VarChar
  /// The user who owns the folder.
  owner            User      @relation("FolderOwner", fields: [owner_id], references: [id], onDelete: Restrict)
  /// The sample the folder belongs to.
  sample           Sample?   @relation(fields: [sample_id], references: [id], onDelete: Restrict)
  /// The device the folder was created from.
  created_by_device LaboratoryDevice? @relation(fields: [created_by_device_id], references: [id], onDelete: SetNull)
  /// People who can read and write the folder, the owner included.
  members          LaboratoryFolderMember[]
  /// Which files of a bound local folder are synced.
  rules            LaboratorySyncRule[]
  /// Files in the folder.
  files            LaboratoryFile[]
  /// Uploads into the folder.
  uploads          LaboratoryUpload[]
  /// Changes to the current versions of the folder's files, in order.
  changes          LaboratoryFileChange[]

  @@unique([owner_id, root])
  @@unique([sample_id, category])
  @@index([sample_id])
  @@map("medilab_laboratory_folder")
}

/// Links a folder to a person who can read and write it.
/// At most one owner row per folder (partial unique index on folder_id where role is owner).
model LaboratoryFolderMember {
  /// Row identifier.
  id        Int              @id @default(autoincrement())
  /// The folder.
  folder_id Int
  /// The member.
  user_id   Int
  /// owner or member; the owner's row cannot be removed.
  role      String           @db.VarChar
  /// The folder.
  folder    LaboratoryFolder @relation(fields: [folder_id], references: [id], onDelete: Cascade)
  /// The member.
  user      User             @relation("FolderMember", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([folder_id, user_id])
  @@map("medilab_laboratory_folder_member")
}

/// A rule limiting which files of a bound local folder are synced.
model LaboratorySyncRule {
  /// Row identifier.
  id        Int              @id @default(autoincrement())
  /// The folder the rule limits.
  folder_id Int
  /// prefix, glob or extension.
  kind      String           @db.VarChar
  /// The name prefix, pattern with * or extension the file must match.
  pattern   String           @db.VarChar
  /// True when files in subfolders count too.
  recursive Boolean          @default(true)
  /// False when the rule is turned off.
  enabled   Boolean          @default(true)
  /// The folder the rule limits.
  folder    LaboratoryFolder @relation(fields: [folder_id], references: [id], onDelete: Cascade)

  @@unique([folder_id, kind, pattern])
  @@index([folder_id])
  @@map("medilab_laboratory_sync_rule")
}

/// A file in a laboratory folder: a series of versions, one of them current. It is never renamed or deleted.
model LaboratoryFile {
  /// Row identifier.
  id                 Int              @id @default(autoincrement())
  /// The folder holding the file.
  folder_id          Int
  /// Path of the file relative to its folder, such as HPLC/run-01.csv, in Unicode NFC and the letter case it was first saved with.
  path               String           @db.VarChar
  /// The path in Unicode NFC and one letter case; unique in the folder, so paths that differ only in letter case are one file.
  path_key           String           @db.VarChar
  /// The version people get; a restore adds a new version instead of pointing back at an old one.
  current_version_id Int?             @unique
  /// The folder holding the file.
  folder             LaboratoryFolder @relation(fields: [folder_id], references: [id], onDelete: Restrict)
  /// The version people get.
  current_version    LaboratoryFileVersion? @relation("CurrentVersion", fields: [current_version_id], references: [id], onDelete: Restrict)
  /// Every version of the file.
  versions           LaboratoryFileVersion[] @relation("FileVersions")
  /// Uploads of the file.
  uploads            LaboratoryUpload[]
  /// Changes to the file's current version.
  changes            LaboratoryFileChange[]
  /// Online editing sessions of the file.
  editing_sessions   LaboratoryEditingSession[]
  /// Locks taken on the file.
  locks              LaboratoryFileLock[]

  @@unique([folder_id, path_key])
  @@map("medilab_laboratory_file")
}

/// One saved state of a file. Its number, content and origin never change once it is stored, and it is never deleted. When it was stored is Odoo's creation time of the row.
/// sha256 is checked to be 64 lowercase hexadecimal digits and size to be 0 or more.
model LaboratoryFileVersion {
  /// Row identifier.
  id                 Int            @id @default(autoincrement())
  /// The file.
  file_id            Int
  /// Version number within the file, never reused.
  number             Int
  /// The version that was current when this one was made.
  parent_version_id  Int?
  /// The version a restore copied.
  restored_from_id   Int?
  /// synced, conflict, restored or edited_online.
  source             String         @db.VarChar
  /// Size of the content in bytes, as the server computed it.
  size               BigInt
  /// SHA-256 of the content, in hexadecimal, as the server computed it.
  sha256             String         @db.VarChar
  /// The verified content the version holds; versions with the same content share it.
  content_id         Int
  /// The user who saved the version.
  user_id            Int
  /// The device it came from; empty for a version made online or by a restore in the back office.
  device_id          Int?
  /// The Idempotency-Key the device sent with the request that restored the version; unique for the device where it is set (a partial unique index).
  idempotency_key    String?        @db.VarChar
  /// none, requested, approved or rejected: where the version is in its signing.
  approval_state     String         @default("none") @db.VarChar
  /// Round of the version's signing that the next signature records; it grows when every signature is withdrawn.
  document_version   Int            @default(1)
  /// The file.
  file               LaboratoryFile @relation("FileVersions", fields: [file_id], references: [id], onDelete: Restrict)
  /// The verified content the version holds.
  content            LaboratoryContent @relation(fields: [content_id], references: [id], onDelete: Restrict)
  /// The file whose current version this is.
  current_of         LaboratoryFile? @relation("CurrentVersion")
  /// The version that was current when this one was made.
  parent_version     LaboratoryFileVersion? @relation("VersionParent", fields: [parent_version_id], references: [id], onDelete: Restrict)
  /// Versions made from this one.
  child_versions     LaboratoryFileVersion[] @relation("VersionParent")
  /// The version a restore copied.
  restored_from      LaboratoryFileVersion? @relation("VersionRestore", fields: [restored_from_id], references: [id], onDelete: Restrict)
  /// Versions restored from this one.
  restores           LaboratoryFileVersion[] @relation("VersionRestore")
  /// The user who saved the version.
  user               User           @relation("VersionAuthor", fields: [user_id], references: [id], onDelete: Restrict)
  /// The device it came from.
  device             LaboratoryDevice? @relation(fields: [device_id], references: [id], onDelete: Restrict)
  /// Uploads based on this version.
  based_uploads      LaboratoryUpload[] @relation("UploadBase")
  /// The upload that stored this version.
  upload             LaboratoryUpload? @relation("UploadResult")
  /// Change rows announcing this version.
  changes            LaboratoryFileChange[]
  /// Editing sessions opened on this version.
  editing_sessions   LaboratoryEditingSession[] @relation("EditingBase")
  /// The editing session that saved this version.
  saved_by_session   LaboratoryEditingSession? @relation("EditingResult")

  @@unique([file_id, number])
  @@index([content_id])
  @@map("medilab_laboratory_file_version")
}

/// One object of the laboratory files bucket, with the size and SHA-256 the server computed of it. Its object key and,
/// once settled, its state, size and SHA-256 never change, and it is never deleted. Only full rights reach it.
/// object_key is checked to be 32 lowercase hexadecimal digits, sha256 64; verified and duplicate content have a size
/// and a SHA-256, and the SHA-256 is unique among verified content (a partial unique index).
model LaboratoryContent {
  /// Row identifier.
  id         Int                     @id @default(autoincrement())
  /// Key of the object in the bucket: 32 hexadecimal digits the server made, which tell nothing about the content.
  object_key String                  @unique @db.VarChar
  /// pending, verified, duplicate or failed.
  state      String                  @default("pending") @db.VarChar
  /// Size of the content in bytes, as the server computed it; empty while pending.
  size       BigInt?
  /// SHA-256 of the content in hexadecimal, as the server computed it; empty while pending.
  sha256     String?                 @db.VarChar
  /// The versions that hold this content.
  versions   LaboratoryFileVersion[]
  /// The uploads of this content's object.
  uploads    LaboratoryUpload[]

  @@map("medilab_laboratory_content")
}

/// An upload of a file's content straight to the bucket, in the parts of a multipart upload the server made, from the version the computer's file was based on. Its path, claims, content, object and person never change, and it is never deleted.
/// claimed_sha256 is checked to be 64 lowercase hexadecimal digits and claimed_size to be from 0 to 5 GiB; idempotency_key is unique for the device where it is set (a partial unique index).
model LaboratoryUpload {
  /// Row identifier.
  id              Int              @id @default(autoincrement())
  /// The folder uploaded to.
  folder_id       Int
  /// The file, once known; empty for a new path until its version is stored.
  file_id         Int?
  /// Path of the file relative to the folder, in Unicode NFC.
  path            String           @db.VarChar
  /// The version the computer's file was based on; empty for a new file.
  base_version_id Int?
  /// Size of the content in bytes, as the computer claims it.
  claimed_size    BigInt
  /// SHA-256 of the content in hexadecimal, as the computer claims it.
  claimed_sha256  String           @db.VarChar
  /// The content of the upload's own object; empty when the file already had the content and nothing was uploaded.
  content_id      Int?
  /// The bucket's id of the multipart upload; empty when nothing was uploaded in parts.
  multipart_id    String?          @db.VarChar
  /// prepared, verifying, completed, conflict, unchanged, refused, failed or expired.
  status          String           @default("prepared") @db.VarChar
  /// Why the upload failed or was refused, as the code a computer acts on.
  failure_code    String?          @db.VarChar
  /// The version the upload stored.
  version_id      Int?             @unique
  /// The user uploading.
  user_id         Int
  /// The device uploading.
  device_id       Int
  /// The Idempotency-Key the device sent with the request that prepared the upload.
  idempotency_key String?          @db.VarChar
  /// When an upload not finalized by then expires and its parts are removed.
  expires_at      DateTime
  /// When the device last finalized the upload.
  finalized_at    DateTime?
  /// The folder uploaded to.
  folder          LaboratoryFolder @relation(fields: [folder_id], references: [id], onDelete: Restrict)
  /// The file.
  file            LaboratoryFile?  @relation(fields: [file_id], references: [id], onDelete: Restrict)
  /// The version the computer's file was based on.
  base_version    LaboratoryFileVersion? @relation("UploadBase", fields: [base_version_id], references: [id], onDelete: Restrict)
  /// The content of the upload's own object.
  content         LaboratoryContent? @relation(fields: [content_id], references: [id], onDelete: Restrict)
  /// The version the upload stored.
  version         LaboratoryFileVersion? @relation("UploadResult", fields: [version_id], references: [id], onDelete: Restrict)
  /// The user uploading.
  user            User             @relation("UploadUser", fields: [user_id], references: [id], onDelete: Restrict)
  /// The device uploading.
  device          LaboratoryDevice @relation(fields: [device_id], references: [id], onDelete: Restrict)

  @@index([status, expires_at])
  @@map("medilab_laboratory_upload")
}

/// A computer signed in to the laboratory folders with its own key.
model LaboratoryDevice {
  /// Row identifier.
  id           Int       @id @default(autoincrement())
  /// The user the device signs in as.
  user_id      Int
  /// Id the application generates once per installation.
  client_uid   String    @db.VarChar
  /// Name of the computer.
  name         String    @db.VarChar
  /// linux or windows.
  platform     String    @db.VarChar
  /// The Odoo API key of the device, in res_users_apikeys; the key itself is never stored here.
  api_key_id   Int?
  /// When the device last called the API.
  last_seen_at DateTime?
  /// When an administrator revoked the device; empty while it can sign in.
  revoked_at   DateTime?
  /// The user the device signs in as.
  user         User      @relation("LaboratoryDeviceUser", fields: [user_id], references: [id], onDelete: Cascade)
  /// Folders created from the device.
  created_folders LaboratoryFolder[]
  /// Versions uploaded from the device.
  versions     LaboratoryFileVersion[]
  /// Uploads from the device.
  uploads      LaboratoryUpload[]
  /// Locks taken from the device.
  locks        LaboratoryFileLock[]

  @@unique([user_id, client_uid])
  @@map("medilab_laboratory_device")
}

/// The failed sign-ins of a login through the laboratory files API, which slow its next ones.
model LaboratorySignInAttempt {
  /// Row identifier.
  id        Int      @id @default(autoincrement())
  /// The login the failed sign-ins were made with, as it was sent; it need not be anyone's.
  login     String   @unique @db.VarChar
  /// Failed sign-ins of the login since its failures were last forgotten.
  failures  Int
  /// When the last failed sign-in was made, to the microsecond.
  failed_at DateTime

  @@map("medilab_laboratory_sign_in_attempt")
}

/// A change to a file's current version, in order; a device asks for the changes after the last id it saw. When the version became current is Odoo's creation time of the row. Changes are only added, never changed or deleted.
model LaboratoryFileChange {
  /// Row identifier and the order devices read changes in.
  id         Int                   @id @default(autoincrement())
  /// The folder of the file.
  folder_id  Int
  /// The file whose current version changed.
  file_id    Int
  /// The new current version.
  version_id Int
  /// The folder of the file.
  folder     LaboratoryFolder      @relation(fields: [folder_id], references: [id], onDelete: Restrict)
  /// The file whose current version changed.
  file       LaboratoryFile        @relation(fields: [file_id], references: [id], onDelete: Restrict)
  /// The new current version.
  version    LaboratoryFileVersion @relation(fields: [version_id], references: [id], onDelete: Restrict)

  @@index([folder_id, id])
  @@map("medilab_laboratory_file_change")
}

/// A session editing an Office file together in the browser; one is open per file at a time.
model LaboratoryEditingSession {
  /// Row identifier.
  id                   Int            @id @default(autoincrement())
  /// The file edited.
  file_id              Int
  /// The version the session opened.
  base_version_id      Int
  /// Key the editing service identifies the document by.
  document_key         String         @unique @db.VarChar
  /// SHA-256 of the secret token in the address the editing service calls back on save.
  callback_token       String         @unique @db.VarChar
  /// open, saving, committed, conflict, closed, expired or error.
  status               String         @db.VarChar
  /// The user who opened the session.
  opened_by_id         Int
  /// The version the session saved.
  committed_version_id Int?           @unique
  /// When someone last worked in the session; a session idle for 12 hours expires.
  last_activity_at     DateTime
  /// The file edited.
  file                 LaboratoryFile @relation(fields: [file_id], references: [id], onDelete: Restrict)
  /// The version the session opened.
  base_version         LaboratoryFileVersion @relation("EditingBase", fields: [base_version_id], references: [id], onDelete: Restrict)
  /// The version the session saved.
  committed_version    LaboratoryFileVersion? @relation("EditingResult", fields: [committed_version_id], references: [id], onDelete: Restrict)
  /// The user who opened the session.
  opened_by            User           @relation("EditingOpener", fields: [opened_by_id], references: [id], onDelete: Restrict)

  @@index([file_id, status])
  @@map("medilab_laboratory_editing_session")
}

/// A lock one person holds on a file of working documents, results or no category while they edit it, for the lock duration (30 minutes by default) unless renewed. When it was taken is Odoo's creation time of the row.
/// At most one active lock per file (partial unique index on file_id where status is active).
model LaboratoryFileLock {
  /// Row identifier.
  id             Int            @id @default(autoincrement())
  /// The file locked.
  file_id        Int
  /// The user holding the lock.
  user_id        Int
  /// The device the lock was taken from.
  device_id      Int?
  /// active, released or expired; a file has at most one active lock.
  status         String         @db.VarChar
  /// When the lock expires unless renewed.
  expires_at     DateTime
  /// When the lock was released or expired.
  released_at    DateTime?
  /// The administrator who released a lock someone left; empty when its holder released it.
  released_by_id Int?
  /// The file locked.
  file           LaboratoryFile @relation(fields: [file_id], references: [id], onDelete: Restrict)
  /// The user holding the lock.
  user           User           @relation("FileLockHolder", fields: [user_id], references: [id], onDelete: Restrict)
  /// The device the lock was taken from.
  device         LaboratoryDevice? @relation(fields: [device_id], references: [id], onDelete: SetNull)
  /// The administrator who released it.
  released_by    User?          @relation("FileLockReleaser", fields: [released_by_id], references: [id], onDelete: Restrict)

  @@index([file_id, status])
  @@map("medilab_laboratory_file_lock")
}
