{
  "mcpServers": {
    "doppler": {
      "type": "stdio",
      "command": "doppler",
      "args": [
        "run",
        "--project",
        "medilab",
        "--config",
        "dev",
        "--",
        "npx",
        "-y",
        "@dopplerhq/mcp-server",
        "--project",
        "medilab"
      ]
    },
    "sonarqube": {
      "command": "doppler",
      "args": [
        "run",
        "--project",
        "medilab",
        "--config",
        "dev",
        "--",
        "docker",
        "run",
        "--init",
        "--pull=always",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG=soltunemontepre",
        "sonarsource/sonarqube-mcp"
      ]
    },
    "postgres": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "postgres-mcp",
        "--access-mode=unrestricted",
        "postgresql://root:root@localhost:15432/medilab"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "doppler",
      "args": [
        "run",
        "--project",
        "medilab",
        "--config",
        "dev",
        "--",
        "sh",
        "-c",
        "CONTEXT7_API_KEY=$CONTEXT7_TOKEN exec npx -y @upstash/context7-mcp"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        "."
      ]
    }
  }
}
