{
  "mcpServers": {
    "doppler": {
      "type": "stdio",
      "command": "doppler",
      "args": [
        "run",
        "--project",
        "medilab",
        "--config",
        "dev",
        "--",
        "npx",
        "-y",
        "@dopplerhq/mcp-server",
        "--project",
        "medilab"
      ]
    },
    "sonarqube": {
      "command": "doppler",
      "args": [
        "run",
        "--project",
        "medilab",
        "--config",
        "dev",
        "--",
        "docker",
        "run",
        "--init",
        "--pull=always",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG=soltunemontepre",
        "sonarsource/sonarqube-mcp"
      ]
    }
  }
}
