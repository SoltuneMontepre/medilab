{
  "mcpServers": {
    "doppler": {
      "type": "stdio",
      "command": "doppler",
      "args": [
        "run",
        "--project",
        "medilab",
        "--config",
        "dev",
        "--",
        "npx",
        "-y",
        "@dopplerhq/mcp-server",
        "--project",
        "medilab"
      ]
    },
    "sonarqube": {
      "command": "doppler",
      "args": [
        "run",
        "--project",
        "medilab",
        "--config",
        "dev",
        "--",
        "docker",
        "run",
        "--init",
        "--pull=always",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG=soltunemontepre",
        "sonarsource/sonarqube-mcp"
      ]
    },
    "postgres": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "--overrides",
        "tools/odoo-intelligence/postgres-overrides.txt",
        "--with",
        "mcp<2",
        "postgres-mcp==0.3.0",
        "--access-mode=restricted",
        "postgresql://root:root@localhost:15432/medilab"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "doppler",
      "args": [
        "run",
        "--project",
        "medilab",
        "--config",
        "dev",
        "--",
        "node",
        "-e",
        "process.env.CONTEXT7_API_KEY = process.env.CONTEXT7_TOKEN; require('child_process').spawn('npx -y @upstash/context7-mcp', { stdio: 'inherit', shell: true }).on('exit', process.exit)"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "python",
        "-c",
        "import runpy; from pathlib import Path; runpy.run_path(str(next(p / 'tools/odoo-intelligence/run.py' for p in [Path.cwd(), *Path.cwd().parents] if (p / 'tools/odoo-intelligence/run.py').is_file())), run_name='__main__')",
        "serena-claude-code"
      ]
    },
    "odoo": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "python",
        "-c",
        "import runpy; from pathlib import Path; runpy.run_path(str(next(p / 'tools/odoo-intelligence/run.py' for p in [Path.cwd(), *Path.cwd().parents] if (p / 'tools/odoo-intelligence/run.py').is_file())), run_name='__main__')",
        "mcp"
      ]
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "drawio": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@drawio/mcp@1.6.1"
      ]
    },
    "plantuml-js": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@plantuml/mcp-js@0.2.2"
      ]
    },
    "plantuml-java": {
      "type": "stdio",
      "command": "java",
      "args": [
        "-jar",
        ".local/plantuml-mcp/build/libs/plantuml-mcp-1.0.0.jar"
      ]
    },
    "plantuml-infobip": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "plantuml-mcp-server@0.2.4"
      ],
      "env": {
        "PLANTUML_SERVER_URL": "http://localhost:8090"
      }
    }
  }
}
